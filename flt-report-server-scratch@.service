# flt-report-server-scratch@.service — identical to
# flt-report-server@.service except that instances are rooted under
# /scratch/chend-flt/%i instead of %h/%i (Deyao, 2026-07-24: the home
# volume ran out of space — each worktree costs ~5.4G, 4.6G of it
# mathlib oleans in .lake/packages — so the second batch of 13 pool
# worktrees, flt-lean-14..26, lives on the 9.7T local scratch disk).
# The first 13 instances are UNCHANGED and keep using the %h/%i
# template; nothing about their operation is touched.
#
# Everything else — the FIFO protocol, the ExecStartPre state.json
# clearing, the O_RDWR <> redirection, Restart=on-failure — is copied
# verbatim from the home template; see that file for the full
# rationale.
#
# Manage an instance rooted at /scratch/chend-flt/<name>:
#   systemctl --user enable --now flt-report-server-scratch@<name>
#   journalctl --user -u flt-report-server-scratch@<name>

[Unit]
Description=FLT progress report server (lake serve on FIFOs) — scratch instance %i

[Service]
Type=exec
WorkingDirectory=/scratch/chend-flt/%i
Environment=PATH=/home/chend/.elan/bin:/home/chend/homebrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/bin/sh -c 'mkdir -p .report-server && rm -f .report-server/state.json && for f in req resp; do [ -p .report-server/$f.fifo ] || { rm -f .report-server/$f.fifo; mkfifo .report-server/$f.fifo; }; done'
ExecStart=/bin/sh -c 'exec lake serve -- 0<> .report-server/req.fifo 1<> .report-server/resp.fifo'
Restart=on-failure

[Install]
WantedBy=default.target
