            (Polynomial.C : ZMod p →+* Polynomial (ZMod p)))
          (Polynomial.X : Polynomial (Polynomial (Polynomial (ZMod p)))))
      = (Polynomial.C : Polynomial (ZMod p) →+* Polynomial (Polynomial (ZMod p))).comp
