    haveI : AlgebraicGeometry.IsProper fX := hXproper
    haveI : AlgebraicGeometry.GeometricallyIrreducible fX := hXgi
    have hCne : Nonempty ↥C := by
      obtain ⟨pt, -⟩ := hreal
