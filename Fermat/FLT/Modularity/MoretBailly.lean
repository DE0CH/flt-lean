theorem exists_bound_forall_zmodSolvable_of_planeCurveCount
    {n m : ℕ} (f : Fin m → MvPolynomial (Fin n) ℤ)
    (hcurve : ∀ (d : ℕ), 2 ≤ d → ∀ (p : ℕ) [Fact p.Prime], 250 * d ^ 5 < p →
      ∀ g : MvPolynomial (Fin 2) (ZMod p), g.totalDegree = d →
