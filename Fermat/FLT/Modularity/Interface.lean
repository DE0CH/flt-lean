    {ρO : GaloisRep ℚ O (Fin 2 → O)}
    (e : ((AlgebraicClosure ℚ_[p]) ⊗[O] (Fin 2 → O))
      ≃ₗ[AlgebraicClosure ℚ_[p]] ((AlgebraicClosure ℚ_[p]) ⊗[R] V))
    (he : ∀ g x, e ((ρO.baseChange (AlgebraicClosure ℚ_[p])) g x) =
      (ρ.baseChange (AlgebraicClosure ℚ_[p])) g (e x))
    (m : ℕ) :
