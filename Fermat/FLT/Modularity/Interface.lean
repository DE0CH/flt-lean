    [IsProper strX] [SmoothOfRelativeDimension 1 strX] [GeometricallyConnected strX] :
    ∃ P : Polynomial ℂ, P.coeff 0 = 1 ∧
      (PowerSeries.mk fun s => if s = 0 then 0 else
          (q : ℂ) ^ s + 1 - (pointCountGaloisField strX s : ℂ)) * (P : PowerSeries ℂ)
