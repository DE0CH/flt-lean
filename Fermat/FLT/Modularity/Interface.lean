  rw [GaloisRep.charFrob_eq_charpoly_globalFrob,
    (hcomp (globalFrob hq.toHeightOneSpectrumRingOfIntegersRat) i).1,
    ← GaloisRep.charFrob_eq_charpoly_globalFrob, htr i q hq hqS]

