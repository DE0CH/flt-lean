  -- `bᴺ⁻¹` is a unit, so `N ∈ 𝔪` — contradicting the hypothesis
  have hbunit : IsUnit (b ^ (N - 1)) := by
    have hmul : b ^ (N - 1) * b = 1 := by
      rw [← pow_succ, Nat.sub_add_cancel hNpos]
