        LinearMap.det f ∈ IsLocalRing.maximalIdeal O ∧
        (∀ g x, f (ρ'' g x) = ρ' g (f x)) ∧
        v'' ≠ 0 ∧
        (∀ g, (ρ''.baseChange kk') g v'' = v'') ∧
        (∀ g x, ∃ c : kk',
