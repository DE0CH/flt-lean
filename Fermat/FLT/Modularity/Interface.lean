    (hr : r ^ p ^ n = algebraMap ℚᵖᵥ (AlgebraicClosure ℚᵖᵥ) (q : ℚᵖᵥ))
    (hfix : ∀ σ : Field.absoluteGaloisGroup ℚᵖᵥ,
