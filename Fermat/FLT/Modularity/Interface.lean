    (ι : CF →ₐ[ℚ] AlgebraicClosure ℚ)
    (frobIdeal : Field.absoluteGaloisGroup ℚ →
      IsDedekindDomain.HeightOneSpectrum (𝓞 ℚ) → (Ideal (𝓞 CF))⁰)
