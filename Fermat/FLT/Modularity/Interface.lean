    intro j hmem
    rw [hmemM, hB10, hMZ] at hmem
    obtain ⟨t, ht⟩ := hmem
    have h1 : (M₀ : ℤ) * 1 = (M₀ : ℤ) * ((q : ℤ) * t) := by
