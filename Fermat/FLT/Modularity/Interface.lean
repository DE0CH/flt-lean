    have hEq : (σ * τ) r = (τ * σ) r := by
      conv_lhs => rw [hst]
      rw [AlgEquiv.mul_apply, hAr (τ * σ), map_mul, hcζ, hcr, ← hAr (τ * σ)]
    have key : ζ ^ (A (σ * τ)).val = ζ ^ (A (τ * σ)).val := by
