    (hglue : ∀ g : Field.absoluteGaloisGroup ℚ, ∃ x : T,
      ∀ i, (real i).toFun x = ((real i).ρ g).charpoly.coeff 1) :
    ∃ (ρT : GaloisRep ℚ T (Fin 2 → T))
