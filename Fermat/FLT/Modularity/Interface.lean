/-- The joint eigenspace of the prime-indexed operator family `t` for
the eigenvalue system `a`: the intersection over all primes `q` of
`ker (t q − a q)`. For the Eichler–Shimura package below this carves
the `κ`-eigencomponent of the newform `g` out of the Tate module of
the modular Jacobian. -/
def heckeEigenspace {A : Type*} [CommRing A] {V₀ : Type*}
    [AddCommGroup V₀] [Module A V₀] (t : ℕ → Module.End A V₀)
    (a : ℕ → A) : Submodule A V₀ :=
  ⨅ (q : ℕ) (_ : q.Prime),
    LinearMap.ker (t q - a q • (1 : Module.End A V₀))

/-- Membership in `heckeEigenspace`: a simultaneous eigenvector at
every prime index. -/
theorem mem_heckeEigenspace_iff {A : Type*} [CommRing A] {V₀ : Type*}
    [AddCommGroup V₀] [Module A V₀] {t : ℕ → Module.End A V₀}
    {a : ℕ → A} {x : V₀} :
    x ∈ heckeEigenspace t a ↔
      ∀ (q : ℕ), q.Prime → t q x = a q • x := by
  simp [heckeEigenspace, Submodule.mem_iInf, LinearMap.mem_ker,
    LinearMap.sub_apply, LinearMap.smul_apply, Module.End.one_apply,
    sub_eq_zero]

section CompressEnd

variable {A : Type*} [CommRing A] {V₀ : Type*} [AddCommGroup V₀]
    [Module A V₀] {n : ℕ} (W : Submodule A V₀) (πW : V₀ →ₗ[A] W)
    (e : W ≃ₗ[A] (Fin n → A))

/-- Compression of an endomorphism of `V₀` to the standard frame of a
distinguished subspace `W`, through a chosen projection `πW` and a
chosen frame `e`. As a map of endomorphism ALGEBRAS it is only
multiplicative on the stabilizer of `W` (`compressEnd_mul`), but as a
LINEAR map it is everywhere defined — which is what makes the
compressed Galois representation of the Eichler–Shimura assembly
continuous for the module topologies. -/
def compressEnd :
    Module.End A V₀ →ₗ[A] Module.End A (Fin n → A) where
  toFun φ :=
    e.toLinearMap ∘ₗ πW ∘ₗ φ ∘ₗ W.subtype ∘ₗ e.symm.toLinearMap
  map_add' φ ψ := by ext x; simp
  map_smul' c φ := by ext x; simp

/-- Evaluation of the compression. -/
theorem compressEnd_apply (φ : Module.End A V₀) (x : Fin n → A) :
    compressEnd W πW e φ x = e (πW (φ ↑(e.symm x))) := rfl

/-- The compression sends the identity to the identity, given that
`πW` retracts the inclusion of `W`. -/
theorem compressEnd_one (hπ : ∀ w : W, πW (w : V₀) = w) :
    compressEnd W πW e 1 = 1 := by
  refine LinearMap.ext fun x => ?_
  rw [compressEnd_apply, Module.End.one_apply, hπ (e.symm x),
    LinearEquiv.apply_symm_apply, Module.End.one_apply]

/-- The compression is multiplicative when the right factor
stabilizes `W`. -/
theorem compressEnd_mul (hπ : ∀ w : W, πW (w : V₀) = w)
    (φ ψ : Module.End A V₀) (hψ : ∀ x ∈ W, ψ x ∈ W) :
    compressEnd W πW e (φ * ψ) =
      compressEnd W πW e φ * compressEnd W πW e ψ := by
  refine LinearMap.ext fun x => ?_
  simp only [Module.End.mul_apply, compressEnd_apply,
    LinearEquiv.symm_apply_apply]
  have hmem : ψ ↑(e.symm x) ∈ W := hψ _ (SetLike.coe_mem (e.symm x))
  have hproj : πW (ψ ↑(e.symm x)) = ⟨ψ ↑(e.symm x), hmem⟩ :=
    hπ ⟨_, hmem⟩
  rw [hproj]

/-- The compression of an operator acting on `W` as the scalar `c` is
the scalar `c`. -/
theorem compressEnd_eq_smul_one (hπ : ∀ w : W, πW (w : V₀) = w)
    {φ : Module.End A V₀} {c : A} (hφ : ∀ x ∈ W, φ x = c • x) :
    compressEnd W πW e φ = c • 1 := by
  refine LinearMap.ext fun x => ?_
  rw [compressEnd_apply, hφ _ (SetLike.coe_mem (e.symm x)), map_smul,
    hπ (e.symm x), map_smul, LinearEquiv.apply_symm_apply,
    LinearMap.smul_apply, Module.End.one_apply]

/-- On the stabilizer of `W` the compression is conjugation of the
restriction by the frame — the bridge to `LinearMap.det_conj` for the
determinant transport of the Eichler–Shimura assembly. -/
theorem compressEnd_eq_conj_restrict (hπ : ∀ w : W, πW (w : V₀) = w)
    {φ : Module.End A V₀} (hφ : ∀ x ∈ W, φ x ∈ W) :
    compressEnd W πW e φ =
      (e : W →ₗ[A] (Fin n → A)) ∘ₗ φ.restrict hφ ∘ₗ
        (e.symm : (Fin n → A) →ₗ[A] W) := by
  refine LinearMap.ext fun x => ?_
  simp only [compressEnd_apply, LinearMap.comp_apply,
    LinearEquiv.coe_coe, LinearMap.restrict_apply]
  exact congrArg e
    (hπ ⟨φ ↑(e.symm x), hφ _ (SetLike.coe_mem (e.symm x))⟩)

end CompressEnd

section HeckeSubalgebra

/-! ##### The abstract Hecke subalgebra of an operator family

Pure-algebra support for the modular-Jacobian carrier below: the
`F`-subalgebra of `End(V₀)` generated by the prime-indexed members of
an operator family, together with the three facts the Eichler–Shimura
inhabitation assembly consumes — commutativity (from pairwise
commutation of the family), the scalar-action induction (members act
by a common scalar on joint eigen-elements), and self-adjointness
transport for a bilinear pairing. All three are `Algebra.adjoin`
inductions. -/

variable {F : Type*} [Field F] {V₀ : Type*} [AddCommGroup V₀]
    [Module F V₀]

/-- The `F`-subalgebra of `End(V₀)` generated by the prime-indexed
operators of the family `t`. For the modular-Jacobian package below
(`t` = the Hecke operators on the Tate module) this is the
base-changed Hecke algebra `𝕋 ⊗ ℚ̄_p`: generation by the prime-indexed
operators alone is the classical fact that the composite `T_n` are
polynomials in the `T_q`/`U_q` (the Hecke recursions, Diamond–Shurman
§5.2-5.3). -/
def heckeSubalgebra (t : ℕ → Module.End F V₀) :
    Subalgebra F (Module.End F V₀) :=
  Algebra.adjoin F {φ : Module.End F V₀ | ∃ q : ℕ, q.Prime ∧ φ = t q}

/-- The prime-indexed operators generate their Hecke subalgebra. -/
theorem hecke_mem_heckeSubalgebra {t : ℕ → Module.End F V₀} {q : ℕ}
    (hq : q.Prime) : t q ∈ heckeSubalgebra t :=
  Algebra.subset_adjoin ⟨q, hq, rfl⟩

/-- The Hecke subalgebra of a pairwise-commuting operator family is
commutative (two nested `adjoin` inductions). -/
theorem heckeSubalgebra_mul_comm {t : ℕ → Module.End F V₀}
    (hcomm : ∀ m n : ℕ, t m * t n = t n * t m) :
    ∀ a ∈ heckeSubalgebra t, ∀ b ∈ heckeSubalgebra t,
      a * b = b * a := by
  have hgen : ∀ (q : ℕ), q.Prime →
      ∀ a ∈ heckeSubalgebra t, t q * a = a * t q := by
    intro q hq a ha
    have ha' : a ∈ Algebra.adjoin F
        {φ : Module.End F V₀ | ∃ n : ℕ, n.Prime ∧ φ = t n} := ha
    clear ha
    induction ha' using Algebra.adjoin_induction with
    | mem x hx =>
        obtain ⟨n, hn, rfl⟩ := hx
        exact hcomm q n
    | algebraMap r => exact (Algebra.commutes r (t q)).symm
    | add x y hx hy ihx ihy => rw [mul_add, add_mul, ihx, ihy]
    | mul x y hx hy ihx ihy =>
        rw [← mul_assoc, ihx, mul_assoc, ihy, ← mul_assoc]
  intro a ha b hb
  have hb' : b ∈ Algebra.adjoin F
      {φ : Module.End F V₀ | ∃ n : ℕ, n.Prime ∧ φ = t n} := hb
  clear hb
  induction hb' using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨n, hn, rfl⟩ := hx
      exact (hgen n hn a ha).symm
  | algebraMap r => exact (Algebra.commutes r a).symm
  | add x y hx hy ihx ihy => rw [mul_add, add_mul, ihx, ihy]
  | mul x y hx hy ihx ihy =>
      rw [← mul_assoc, ihx, mul_assoc, ihy, ← mul_assoc]

/-- **Scalar-action induction**: if every prime-indexed operator acts
by left composition on the endomorphisms `e` and `a` through one
scalar system `lam`, then every member of the Hecke subalgebra acts
on `e` and `a` by a COMMON scalar. Instantiated at `a := e` it gives
the scalar action on the idempotent alone; with a genuine second
carrier it is the engine that identifies the joint eigenspace with
the idempotent's range in the Eichler–Shimura assembly (the "same
character on both carriers" trick: `c := e` forces `e * a = a`, then
`c := a` exhibits `a` as a scalar multiple of `e`). -/
theorem exists_smul_of_mem_heckeSubalgebra {t : ℕ → Module.End F V₀}
    {lam : ℕ → F} {e a : Module.End F V₀}
    (he : ∀ q : ℕ, q.Prime → t q * e = lam q • e)
    (ha : ∀ q : ℕ, q.Prime → t q * a = lam q • a) :
    ∀ c ∈ heckeSubalgebra t, ∃ γ : F, c * e = γ • e ∧ c * a = γ • a := by
  intro c hc
  have hc' : c ∈ Algebra.adjoin F
      {φ : Module.End F V₀ | ∃ q : ℕ, q.Prime ∧ φ = t q} := hc
  clear hc
  induction hc' using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨q, hq, rfl⟩ := hx
      exact ⟨lam q, he q hq, ha q hq⟩
  | algebraMap r =>
      refine ⟨r, ?_, ?_⟩ <;>
        rw [Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
  | add x y hx hy ihx ihy =>
      obtain ⟨γ₁, hx1, hx2⟩ := ihx
      obtain ⟨γ₂, hy1, hy2⟩ := ihy
      exact ⟨γ₁ + γ₂, by rw [add_mul, hx1, hy1, add_smul],
        by rw [add_mul, hx2, hy2, add_smul]⟩
  | mul x y hx hy ihx ihy =>
      obtain ⟨γ₁, hx1, hx2⟩ := ihx
      obtain ⟨γ₂, hy1, hy2⟩ := ihy
      refine ⟨γ₁ * γ₂, ?_, ?_⟩
      · rw [mul_assoc, hy1, mul_smul_comm, hx1, smul_smul,
          mul_comm γ₂ γ₁]
      · rw [mul_assoc, hy2, mul_smul_comm, hx2, smul_smul,
          mul_comm γ₂ γ₁]

/-- **Self-adjointness transport**: a bilinear pairing for which every
prime-indexed operator is self-adjoint is self-adjoint for the whole
Hecke subalgebra (commutativity of the family enters through the
product case). Applied to the Atkin–Lehner-twisted Weil pairing and
the newform idempotent in the Eichler–Shimura assembly. -/
theorem pair_comm_of_mem_heckeSubalgebra {t : ℕ → Module.End F V₀}
    (hcomm : ∀ m n : ℕ, t m * t n = t n * t m)
    {pair : V₀ →ₗ[F] V₀ →ₗ[F] F}
    (hpair : ∀ q : ℕ, q.Prime → ∀ x y : V₀,
      pair (t q x) y = pair x (t q y)) :
    ∀ c ∈ heckeSubalgebra t, ∀ x y : V₀,
      pair (c x) y = pair x (c y) := by
  intro c hc
  have hc' : c ∈ Algebra.adjoin F
      {φ : Module.End F V₀ | ∃ q : ℕ, q.Prime ∧ φ = t q} := hc
  clear hc
  induction hc' using Algebra.adjoin_induction with
  | mem φ hφ =>
      obtain ⟨q, hq, rfl⟩ := hφ
      exact hpair q hq
  | algebraMap r =>
      intro x y
      simp
  | add φ ψ hφ hψ ihφ ihψ =>
      intro x y
      simp only [LinearMap.add_apply, map_add]
      rw [ihφ, ihψ]
  | mul φ ψ hφ hψ ihφ ihψ =>
      intro x y
      have hφψ : φ * ψ = ψ * φ :=
        heckeSubalgebra_mul_comm hcomm φ hφ ψ hψ
      calc pair ((φ * ψ) x) y = pair (φ (ψ x)) y := rfl
        _ = pair (ψ x) (φ y) := ihφ _ _
        _ = pair x (ψ (φ y)) := ihψ _ _
        _ = pair x ((ψ * φ) y) := rfl
        _ = pair x ((φ * ψ) y) := by rw [hφψ]

/-- **Idempotent approximation in a commutative ring** (the classical
Newton iteration `y ↦ 3y² − 2y³`, run to nilpotent precision): any
element whose idempotency defect `y² − y` is nilpotent differs from an
honest idempotent by a multiple of the defect. Each iteration step
squares the defect (`y'² − y' = (y² − y)²·(4y² − 4y − 3)`), so
induction on the nilpotency exponent terminates. Pure commutative
algebra; the annihilator-idempotent engine below applies it to the
almost-idempotent produced by the Cayley–Hamilton determinant trick
inside a finite-dimensional commutative operator algebra. -/
theorem exists_isIdempotentElem_sub_mem_span_of_isNilpotent
    {R : Type*} [CommRing R] {y : R} (h : IsNilpotent (y * y - y)) :
    ∃ e : R, e * e = e ∧ e - y ∈ Ideal.span {y * y - y} := by
  obtain ⟨n, hn⟩ := h
  induction n generalizing y with
  | zero =>
    have h1 : (1 : R) = 0 := by simpa using hn
    have hall : ∀ x : R, x = 0 := fun x => by
      rw [← mul_one x, h1, mul_zero]
    refine ⟨y, ?_, ?_⟩
    · rw [hall (y * y), hall y]
    · rw [sub_self]; exact Ideal.zero_mem _
  | succ n ih =>
    rcases n with _ | n
    · have h0 : y * y - y = 0 := by simpa using hn
      exact ⟨y, sub_eq_zero.mp h0,
        by rw [sub_self]; exact Ideal.zero_mem _⟩
    · set y' := 3 * y ^ 2 - 2 * y ^ 3 with hy'
      have hb : y' * y' - y' =
          (y * y - y) ^ 2 * (4 * y ^ 2 - 4 * y - 3) := by
        rw [hy']; ring
      have hpow : (y' * y' - y') ^ (n + 1) = 0 := by
        rw [hb, mul_pow, ← pow_mul]
        have h2 : 2 * (n + 1) = (n + 1 + 1) + n := by ring
        rw [h2, pow_add, hn, zero_mul, zero_mul]
      obtain ⟨e, hee, hspan⟩ := ih hpow
      refine ⟨e, hee, ?_⟩
      have h1 : e - y' ∈ Ideal.span {y * y - y} := by
        refine Ideal.span_singleton_le_span_singleton.mpr ?_ hspan
        exact ⟨(y * y - y) * (4 * y ^ 2 - 4 * y - 3), by rw [hb]; ring⟩
      have h2 : y' - y ∈ Ideal.span {y * y - y} :=
        Ideal.mem_span_singleton'.mpr ⟨1 - 2 * y, by rw [hy']; ring⟩
      have h3 : e - y = (e - y') + (y' - y) := by ring
      rw [h3]
      exact Ideal.add_mem _ h1 h2

/-- **The annihilator idempotent of a vector in a finite-dimensional
commutative Hecke subalgebra** — the pure-algebra engine behind the
étale newform idempotent of the modular-Jacobian package: for any
vector `v`, the Hecke subalgebra of a pairwise-commuting operator
family on a finite-dimensional space contains an idempotent `e`
FIXING `v` such that every member of the subalgebra annihilating `v`
becomes NILPOTENT after multiplication by `e`. Classically `e` is the
unit of the local factor of the Artinian algebra
`A = heckeSubalgebra t` supporting the character `a·v = χ(a)·v`; the
proof is quotient-free: the powers of the annihilator ideal
`m = Ann_A(v)` stabilize (their `F`-dimensions are an antitone
sequence of naturals), the Cayley–Hamilton determinant trick
(`Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul`
applied to `m·m^k = m^k`) produces an almost-idempotent `y ≡ 1 mod m`
with `y·m^k = 0`, and the Newton iteration
(`exists_isIdempotentElem_sub_mem_span_of_isNilpotent`) corrects it
to an honest idempotent within `span {y² − y} ⊆ m`, preserving both
the fixing of `v` and the nilpotency of `m·e` (for `a ∈ m`, `(a·y)^k`
ends in `y·a^k = 0`). -/
theorem exists_idempotent_heckeSubalgebra_fixing
    [Module.Finite F V₀] {t : ℕ → Module.End F V₀}
    (hcomm : ∀ m n : ℕ, t m * t n = t n * t m) (v : V₀) :
    ∃ e ∈ heckeSubalgebra t, e * e = e ∧ e v = v ∧
      ∀ a ∈ heckeSubalgebra t, a v = 0 → IsNilpotent (a * e) := by
  classical
  letI : CommRing ↥(heckeSubalgebra t) :=
    { (inferInstance : Ring ↥(heckeSubalgebra t)) with
      mul_comm := fun a b =>
        Subtype.ext (heckeSubalgebra_mul_comm hcomm a.1 a.2 b.1 b.2) }
  haveI : IsNoetherian ↥(heckeSubalgebra t) ↥(heckeSubalgebra t) :=
    isNoetherian_of_tower F inferInstance
  -- the annihilator ideal of `v` inside the Hecke subalgebra
  let m : Ideal ↥(heckeSubalgebra t) :=
    { carrier := {a : ↥(heckeSubalgebra t) |
        (a : Module.End F V₀) v = 0}
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq] at ha hb ⊢
        rw [AddMemClass.coe_add, LinearMap.add_apply, ha, hb, add_zero]
      zero_mem' := by
        simp only [Set.mem_setOf_eq, ZeroMemClass.coe_zero,
          LinearMap.zero_apply]
      smul_mem' := fun c a ha => by
        simp only [Set.mem_setOf_eq] at ha ⊢
        rw [smul_eq_mul, MulMemClass.coe_mul, Module.End.mul_apply, ha,
          map_zero] }
  -- the powers of `m` are decreasing …
  have hpowle : ∀ n : ℕ,
      (m ^ (n + 1) : Ideal ↥(heckeSubalgebra t)) ≤ m ^ n := fun n => by
    rw [pow_succ']
    exact Ideal.mul_le_left
  -- … so their `F`-dimensions stabilize
  have hex : ∃ n : ℕ,
      Module.finrank F
          ((m ^ (n + 1) : Ideal ↥(heckeSubalgebra t)).restrictScalars F) =
        Module.finrank F
          ((m ^ n : Ideal ↥(heckeSubalgebra t)).restrictScalars F) := by
    by_contra hne
    push Not at hne
    have hlt : ∀ n : ℕ,
        Module.finrank F
            ((m ^ (n + 1) :
              Ideal ↥(heckeSubalgebra t)).restrictScalars F) <
          Module.finrank F
            ((m ^ n : Ideal ↥(heckeSubalgebra t)).restrictScalars F) :=
      fun n => lt_of_le_of_ne
        (Submodule.finrank_mono fun x hx => hpowle n hx) (hne n)
    have hsum : ∀ n : ℕ,
        Module.finrank F
            ((m ^ n : Ideal ↥(heckeSubalgebra t)).restrictScalars F) +
              n ≤
          Module.finrank F
            ((m ^ 0 : Ideal ↥(heckeSubalgebra t)).restrictScalars F) := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        have := hlt n
        omega
    have := hsum
      (Module.finrank F
        ((m ^ 0 : Ideal ↥(heckeSubalgebra t)).restrictScalars F) + 1)
    omega
  obtain ⟨k₀, hk₀⟩ := hex
  have hstep : (m ^ (k₀ + 1) : Ideal ↥(heckeSubalgebra t)) = m ^ k₀ := by
    have h1 : (m ^ (k₀ + 1) :
        Ideal ↥(heckeSubalgebra t)).restrictScalars F =
        (m ^ k₀ : Ideal ↥(heckeSubalgebra t)).restrictScalars F :=
      Submodule.eq_of_le_of_finrank_eq (fun x hx => hpowle k₀ hx) hk₀
    exact Submodule.restrictScalars_injective F _ _ h1
  have hk : (m ^ (k₀ + 1 + 1) : Ideal ↥(heckeSubalgebra t)) =
      m ^ (k₀ + 1) := by
    calc (m ^ (k₀ + 1 + 1) : Ideal ↥(heckeSubalgebra t))
        = m ^ (k₀ + 1) * m := pow_succ m (k₀ + 1)
      _ = m ^ k₀ * m := by rw [hstep]
      _ = m ^ (k₀ + 1) := (pow_succ m k₀).symm
  -- Cayley–Hamilton determinant trick on `N := m ^ (k₀ + 1)`
  obtain ⟨y, hy1, hy0⟩ :=
    Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul m
      (m ^ (k₀ + 1) : Ideal ↥(heckeSubalgebra t))
      (IsNoetherian.noetherian _)
      (by rw [Ideal.smul_eq_mul, ← pow_succ']; exact hk.ge)
  -- the idempotency defect of `y` is nilpotent
  have hdef : ((y * y - y : ↥(heckeSubalgebra t)) ^ (k₀ + 1)) = 0 := by
    have h1 : (y - 1) ^ (k₀ + 1) ∈
        (m ^ (k₀ + 1) : Ideal ↥(heckeSubalgebra t)) :=
      Ideal.pow_mem_pow hy1 _
    have h2 : y * (y - 1) ^ (k₀ + 1) = 0 := by
      have h3 := hy0 _ h1
      rwa [smul_eq_mul] at h3
    have hb : (y * y - y : ↥(heckeSubalgebra t)) = y * (y - 1) := by
      ring
    rw [hb, mul_pow, pow_succ, mul_assoc, h2, mul_zero]
  obtain ⟨e, hee, hspan⟩ :=
    exists_isIdempotentElem_sub_mem_span_of_isNilpotent ⟨k₀ + 1, hdef⟩
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hspan
  -- `y` fixes `v`, hence so do the defect-corrections
  have hyv : ((y : ↥(heckeSubalgebra t)) : Module.End F V₀) v = v := by
    have h1 : ((y - 1 : ↥(heckeSubalgebra t)) : Module.End F V₀) v =
        0 := hy1
    rw [AddSubgroupClass.coe_sub, LinearMap.sub_apply,
      OneMemClass.coe_one, Module.End.one_apply, sub_eq_zero] at h1
    exact h1
  have hzv : ((y * y - y : ↥(heckeSubalgebra t)) : Module.End F V₀) v =
      0 := by
    rw [AddSubgroupClass.coe_sub, LinearMap.sub_apply,
      MulMemClass.coe_mul, Module.End.mul_apply, hyv, hyv, sub_self]
  have hev : ((e : ↥(heckeSubalgebra t)) : Module.End F V₀) v = v := by
    have h1 : ((e - y : ↥(heckeSubalgebra t)) : Module.End F V₀) v =
        0 := by
      rw [← hc, MulMemClass.coe_mul, Module.End.mul_apply, hzv,
        map_zero]
    rw [AddSubgroupClass.coe_sub, LinearMap.sub_apply, sub_eq_zero]
      at h1
    rw [h1, hyv]
  refine ⟨(e : Module.End F V₀), e.2, ?_, hev, ?_⟩
  · have h1 := congrArg (Subtype.val
      (p := fun x => x ∈ heckeSubalgebra t)) hee
    simpa using h1
  · intro a haA hav
    have ham : (⟨a, haA⟩ : ↥(heckeSubalgebra t)) ∈ m := hav
    set a' : ↥(heckeSubalgebra t) := ⟨a, haA⟩ with ha'
    have h1 : IsNilpotent (a' * y) := by
      refine ⟨k₀ + 1, ?_⟩
      have h2 : y * a' ^ (k₀ + 1) = 0 := by
        have h3 := hy0 _ (Ideal.pow_mem_pow ham (k₀ + 1))
        rwa [smul_eq_mul] at h3
      calc (a' * y) ^ (k₀ + 1)
          = y ^ k₀ * (y * a' ^ (k₀ + 1)) := by ring
        _ = 0 := by rw [h2, mul_zero]
    have h2 : IsNilpotent (a' * (e - y)) := by
      refine ⟨k₀ + 1, ?_⟩
      have hb2 : a' * (e - y) = (a' * c) * (y * y - y) := by
        rw [← hc]; ring
      rw [hb2, mul_pow, hdef, mul_zero]
    have h3 : IsNilpotent (a' * e) := by
      have h4 : a' * e = a' * y + a' * (e - y) := by ring
      rw [h4]
      exact (Commute.all _ _).isNilpotent_add h1 h2
    obtain ⟨n, hn⟩ := h3
    refine ⟨n, ?_⟩
    have h5 := congrArg (Subtype.val
      (p := fun x => x ∈ heckeSubalgebra t)) hn
    simpa using h5

/-- **From an eigenvector of the Hecke ALGEBRA to an eigenvector of the
MODULE** (PROVEN — the occurrence half of the module/algebra spectral
transfer of the 2026-07-25 fourth decomposition): if the operator
family is pairwise commuting, the module is spanned over its Hecke
subalgebra by two elements `b₁, b₂`, and the Hecke subalgebra itself
contains a NONZERO element `a` on which every prime-indexed operator
acts by the scalar system `lam` (left multiplication), then the module
carries a nonzero joint eigenvector for `lam`.

Proof: were both `a b₁` and `a b₂` zero, then for every `x = c b₁ + d b₂`
with `c, d` in the subalgebra, commutativity gives
`a (c b₁) = (a·c) b₁ = (c·a) b₁ = c (a b₁) = 0` and likewise for the
second coordinate, so `a = 0` — contradiction. Hence one of them is
nonzero, and `t q (a bᵢ) = (t q · a) bᵢ = (lam q • a) bᵢ = lam q • (a bᵢ)`
exhibits it as a joint eigenvector. -/
theorem exists_ne_zero_mem_heckeEigenspace_of_free
    {t : ℕ → Module.End F V₀}
    (hcomm : ∀ m n : ℕ, t m * t n = t n * t m) {b₁ b₂ : V₀}
    (hspan : ∀ x : V₀, ∃ a ∈ heckeSubalgebra t, ∃ b ∈ heckeSubalgebra t,
      x = a b₁ + b b₂)
    {lam : ℕ → F} {a : Module.End F V₀} (haA : a ∈ heckeSubalgebra t)
    (hane : a ≠ 0) (hae : ∀ q : ℕ, q.Prime → t q * a = lam q • a) :
    ∃ v ∈ heckeEigenspace t lam, v ≠ 0 := by
  have hkey : a b₁ ≠ 0 ∨ a b₂ ≠ 0 := by
    by_contra hcon
    push Not at hcon
    obtain ⟨h1, h2⟩ := hcon
    refine hane (LinearMap.ext fun x => ?_)
    obtain ⟨c, hc, d, hd, rfl⟩ := hspan x
    have hac : a * c = c * a :=
      heckeSubalgebra_mul_comm hcomm a haA c hc
    have had : a * d = d * a :=
      heckeSubalgebra_mul_comm hcomm a haA d hd
    have e1 : a (c b₁) = 0 := by
      rw [← Module.End.mul_apply, hac, Module.End.mul_apply, h1, map_zero]
    have e2 : a (d b₂) = 0 := by
      rw [← Module.End.mul_apply, had, Module.End.mul_apply, h2, map_zero]
    rw [map_add, e1, e2, add_zero, LinearMap.zero_apply]
  have hev : ∀ w : V₀, (∀ q : ℕ, q.Prime → t q (a w) = lam q • a w) := by
    intro w q hq
    calc t q (a w) = (t q * a) w := (Module.End.mul_apply _ _ _).symm
      _ = (lam q • a) w := by rw [hae q hq]
      _ = lam q • a w := rfl
  rcases hkey with h | h
  · exact ⟨a b₁, mem_heckeEigenspace_iff.mpr (hev b₁), h⟩
  · exact ⟨a b₂, mem_heckeEigenspace_iff.mpr (hev b₂), h⟩

/-- **From reducedness of the Hecke ALGEBRA at a character to
semisimplicity on the MODULE** (PROVEN — the multiplicity-one half of
the module/algebra spectral transfer of the 2026-07-25 fourth
decomposition): if the module is FREE of rank two over its Hecke
subalgebra on `b₁, b₂` and, inside that subalgebra, every element
killed by a power of each `t q − lam q` is already killed by
`t q − lam q`, then every joint GENERALIZED eigenvector of the family
in the module is an honest joint eigenvector.

Proof: write `x = c b₁ + d b₂` with `c, d` in the subalgebra. For a
prime `q` and `u := (t q − lam q)ⁿ` killing `x`, the coordinates of
`u x` are `u·c` and `u·d`, which lie in the subalgebra, so uniqueness
of the coordinates forces `u·c = u·d = 0`. Hence `c` and `d` satisfy
the hypothesis of the reducedness clause, giving
`(t q − lam q)·c = (t q − lam q)·d = 0`, whence
`(t q − lam q) x = 0`. -/
theorem mem_heckeEigenspace_of_free {t : ℕ → Module.End F V₀}
    {b₁ b₂ : V₀}
    (hspan : ∀ x : V₀, ∃ a ∈ heckeSubalgebra t, ∃ b ∈ heckeSubalgebra t,
      x = a b₁ + b b₂)
    (hindep : ∀ a ∈ heckeSubalgebra t, ∀ b ∈ heckeSubalgebra t,
      a b₁ + b b₂ = 0 → a = 0 ∧ b = 0)
    {lam : ℕ → F}
    (hred : ∀ a ∈ heckeSubalgebra t,
      (∀ q : ℕ, q.Prime → ∃ n : ℕ,
        (t q - lam q • (1 : Module.End F V₀)) ^ n * a = 0) →
      ∀ q : ℕ, q.Prime → (t q - lam q • (1 : Module.End F V₀)) * a = 0)
    {x : V₀}
    (hx : ∀ q : ℕ, q.Prime → ∃ n : ℕ,
      ((t q - lam q • (1 : Module.End F V₀)) ^ n) x = 0) :
    x ∈ heckeEigenspace t lam := by
  obtain ⟨c, hc, d, hd, rfl⟩ := hspan x
  have hpowmem : ∀ (q : ℕ), q.Prime → ∀ n : ℕ,
      (t q - lam q • (1 : Module.End F V₀)) ^ n ∈ heckeSubalgebra t := by
    intro q hq n
    exact pow_mem (sub_mem (hecke_mem_heckeSubalgebra hq)
      (Subalgebra.smul_mem _ (one_mem _) _)) n
  have hcoord : ∀ (q : ℕ), q.Prime → ∃ n : ℕ,
      (t q - lam q • (1 : Module.End F V₀)) ^ n * c = 0 ∧
        (t q - lam q • (1 : Module.End F V₀)) ^ n * d = 0 := by
    intro q hq
    obtain ⟨n, hn⟩ := hx q hq
    refine ⟨n, ?_⟩
    have h0 : ((t q - lam q • (1 : Module.End F V₀)) ^ n * c) b₁ +
        ((t q - lam q • (1 : Module.End F V₀)) ^ n * d) b₂ = 0 := by
      rw [Module.End.mul_apply, Module.End.mul_apply, ← map_add]
      exact hn
    exact hindep _ (mul_mem (hpowmem q hq n) hc) _
      (mul_mem (hpowmem q hq n) hd) h0
  have hc0 : ∀ q : ℕ, q.Prime →
      (t q - lam q • (1 : Module.End F V₀)) * c = 0 :=
    hred c hc fun q hq => by
      obtain ⟨n, h1, -⟩ := hcoord q hq
      exact ⟨n, h1⟩
  have hd0 : ∀ q : ℕ, q.Prime →
      (t q - lam q • (1 : Module.End F V₀)) * d = 0 :=
    hred d hd fun q hq => by
      obtain ⟨n, -, h2⟩ := hcoord q hq
      exact ⟨n, h2⟩
  refine mem_heckeEigenspace_iff.mpr fun q hq => ?_
  have hzero : (t q - lam q • (1 : Module.End F V₀)) (c b₁ + d b₂) = 0 := by
    rw [map_add, ← Module.End.mul_apply, ← Module.End.mul_apply,
      hc0 q hq, hd0 q hq, LinearMap.zero_apply, LinearMap.zero_apply,
      add_zero]
  have hsub : t q (c b₁ + d b₂) - lam q • (c b₁ + d b₂) = 0 := by
    rw [LinearMap.sub_apply, LinearMap.smul_apply,
      Module.End.one_apply] at hzero
    exact hzero
  exact sub_eq_zero.mp hsub

end HeckeSubalgebra

/-- **The Eichler–Shimura package of a weight-2 newform** `g` at the
`p`-adic embedding `κ` — the modular-Jacobian carrier. The intended
inhabitant (Diamond–Shurman ch. 8–9) is the rational `p`-adic Tate
module `Vp = V_p(J₀(M)) ⊗ ℚ̄_p` of the modular Jacobian
`J₀(M) = Jac X₀(M)`, with its continuous Galois action `τJ`, its
Hecke operators `hecke` (the correspondences `T_m`, resp. `U_q` at
`q ∣ M`), and the exceptional set `S = {v : v ∣ Mp}`. Each field is a
classically-true cited assertion about this inhabitant — the precise
citations are in the docstring of the inhabitation leaf
`nonempty_eichlerShimuraPackage`, the only sorried node of the cut. -/
structure EichlerShimuraPackage (M : ℕ) (g : CuspForm (Gamma0GL M) 2)
    (κ : heckeField M g →+* AlgebraicClosure ℚ_[p]) where
  /-- The Galois module: intended `V_p(J₀(M)) ⊗ ℚ̄_p`. -/
  Vp : Type
  [addCommGroup : AddCommGroup Vp]
  [module : Module (AlgebraicClosure ℚ_[p]) Vp]
  [moduleFinite : Module.Finite (AlgebraicClosure ℚ_[p]) Vp]
  /-- The continuous Galois action on the Tate module. -/
  τJ : GaloisRep ℚ (AlgebraicClosure ℚ_[p]) Vp
  /-- The Hecke operators, base-changed to `ℚ̄_p`. -/
  hecke : ℕ → Module.End (AlgebraicClosure ℚ_[p]) Vp
  /-- The exceptional set (intended: the places over `Mp`). -/
  S : Finset (HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
  /-- Hecke correspondences are defined over `ℚ`, so they commute
  with the whole Galois action. -/
  hecke_comm : ∀ (m : ℕ) (γ : Field.absoluteGaloisGroup ℚ),
    hecke m * τJ γ = τJ γ * hecke m
  /-- The Eichler–Shimura congruence relation at good primes:
  `Frob_q² − T_q·Frob_q + q = 0` on the Tate module. -/
  congruence : ∀ (q : ℕ) (hq : q.Prime),
    hq.toHeightOneSpectrumRingOfIntegersRat ∉ S →
    τJ (globalFrob hq.toHeightOneSpectrumRingOfIntegersRat) ^ 2
      - hecke q *
        τJ (globalFrob hq.toHeightOneSpectrumRingOfIntegersRat)
      + (q : AlgebraicClosure ℚ_[p]) • 1 = 0
  /-- Multiplicity one: the joint `κ(a(g))`-eigenspace of the Hecke
  operators is 2-dimensional. -/
  rank_eigenspace :
    Module.rank (AlgebraicClosure ℚ_[p])
      (heckeEigenspace hecke (fun m => κ (heckeCoeff M g m))) = 2
  /-- The Weil-pairing determinant: the Galois determinant on the
  eigenspace is cyclotomic, with value `q` at the `q`-Frobenius. -/
  det_frob : ∀ (q : ℕ) (hq : q.Prime),
    hq.toHeightOneSpectrumRingOfIntegersRat ∉ S →
    ∀ (hst : ∀ x ∈ heckeEigenspace hecke
        (fun m => κ (heckeCoeff M g m)),
      τJ (globalFrob hq.toHeightOneSpectrumRingOfIntegersRat) x ∈
        heckeEigenspace hecke (fun m => κ (heckeCoeff M g m))),
    LinearMap.det
        ((τJ (globalFrob
          hq.toHeightOneSpectrumRingOfIntegersRat)).restrict hst) =
      (q : AlgebraicClosure ℚ_[p])
  /-- Ribet irreducibility (Ribet 1977, Springer LNM 601, Thm. (2.3)):
  the Galois action admits no proper nonzero stable subspace inside
  the `κ`-eigenspace — the eigenspace representation is irreducible. -/
  irred_eigenspace : ∀ U : Submodule (AlgebraicClosure ℚ_[p]) Vp,
    U ≤ heckeEigenspace hecke (fun m => κ (heckeCoeff M g m)) →
    (∀ γ : Field.absoluteGaloisGroup ℚ, ∀ x ∈ U, τJ γ x ∈ U) →
    U = ⊥ ∨ U = heckeEigenspace hecke (fun m => κ (heckeCoeff M g m))

attribute [instance] EichlerShimuraPackage.addCommGroup
  EichlerShimuraPackage.module EichlerShimuraPackage.moduleFinite

/-- **The modular-Jacobian package at level `M`** — the `g`-INDEPENDENT
carrier one level below `EichlerShimuraPackage` (2026-07-24
decomposition). The intended inhabitant is again the rational `p`-adic
Tate module `Vp = V_p(J₀(M)) ⊗ ℚ̄_p` of `J₀(M) = Jac X₀(M)` with its
Galois action, Hecke operators and exceptional set — but where the
Eichler–Shimura package asserts the two `(g, κ)`-DEPENDENT spectral
facts (2-dimensionality of the joint eigenspace, determinant `q` of
Frobenius on it) as primitive fields, this package replaces them by
sharper `g`-independent module theory from which they are PROVEN:

* `hecke_mul_comm` — the Hecke algebra is commutative;
* `basis₁`, `basis₂`, `span_free`, `indep_free` — `Vp` is FREE OF
  RANK 2 over the base-changed Hecke algebra
  `𝕋 ⊗ ℚ̄_p = heckeSubalgebra hecke` (spelled without a module
  structure over the subalgebra: a two-element basis with existence
  and uniqueness of coordinates);
* `pair`, `pair_self`, `pair_nondeg`, `pair_hecke`, `pair_frob` — the
  Atkin–Lehner-twisted Weil pairing: an alternating nondegenerate
  bilinear form for which the Hecke operators are self-adjoint and
  Galois Frobenii off `S` scale by `q`;
* `eigen_idempotent` — for every level-`M` newform `g` and embedding
  `κ`, the `κ(a(g))`-eigensystem splits off as a nonzero idempotent of
  the Hecke subalgebra (the étale newform component of `𝕋 ⊗ ℚ̄_p`).
  This is quantified over `(g, κ)` INSIDE the structure — it is a
  fact about the one intended inhabitant, not about arbitrary
  carriers, so it must not be a standalone lemma quantifying over
  abstract packages (for those it would be false, e.g. `hecke = 0`).

From these, `nonempty_eichlerShimuraPackage` below derives the
eigenspace facts: the joint eigenspace equals `e·Vp`, which by
freeness is the 2-dimensional span of `e basis₁, e basis₂`, and the
twisted Weil pairing restricts to a symplectic form on it, forcing
`det Frob_q = q`. Since the 2026-07-24 third decomposition the
inhabitation of THIS carrier is itself a PROVEN assembly over
`ModularHomologyPackage` below; the citations for each field are in
the docstring of the inhabitation leaf
`nonempty_modularHeckeComparisonPackage`, the sorried GEOMETRIC node of
this cut since the 2026-07-25 fifth decomposition. -/
structure ModularJacobianPackage (M : ℕ) where
  /-- The Galois module: intended `V_p(J₀(M)) ⊗ ℚ̄_p`. -/
  Vp : Type
  [addCommGroup : AddCommGroup Vp]
  [module : Module (AlgebraicClosure ℚ_[p]) Vp]
  [moduleFinite : Module.Finite (AlgebraicClosure ℚ_[p]) Vp]
  /-- The continuous Galois action on the Tate module. -/
  τJ : GaloisRep ℚ (AlgebraicClosure ℚ_[p]) Vp
  /-- The Hecke operators, base-changed to `ℚ̄_p`. -/
  hecke : ℕ → Module.End (AlgebraicClosure ℚ_[p]) Vp
  /-- The exceptional set (intended: the places over `Mp`). -/
  S : Finset (HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
  /-- Hecke correspondences are defined over `ℚ`, so they commute
  with the whole Galois action. -/
  hecke_comm : ∀ (m : ℕ) (γ : Field.absoluteGaloisGroup ℚ),
    hecke m * τJ γ = τJ γ * hecke m
  /-- The Hecke operators commute with each other. -/
  hecke_mul_comm : ∀ m n : ℕ, hecke m * hecke n = hecke n * hecke m
  /-- The Eichler–Shimura congruence relation at good primes:
  `Frob_q² − T_q·Frob_q + q = 0` on the Tate module. -/
  congruence : ∀ (q : ℕ) (hq : q.Prime),
    hq.toHeightOneSpectrumRingOfIntegersRat ∉ S →
    τJ (globalFrob hq.toHeightOneSpectrumRingOfIntegersRat) ^ 2
      - hecke q *
        τJ (globalFrob hq.toHeightOneSpectrumRingOfIntegersRat)
      + (q : AlgebraicClosure ℚ_[p]) • 1 = 0
  /-- First member of a Hecke-algebra basis of the Tate module. -/
  basis₁ : Vp
  /-- Second member of a Hecke-algebra basis of the Tate module. -/
  basis₂ : Vp
  /-- Freeness, existence half: every vector has Hecke-algebra
  coordinates in the basis. -/
  span_free : ∀ x : Vp, ∃ a ∈ heckeSubalgebra hecke,
    ∃ b ∈ heckeSubalgebra hecke, x = a basis₁ + b basis₂
  /-- Freeness, uniqueness half: the coordinates are unique (stated
  at zero). -/
  indep_free : ∀ a ∈ heckeSubalgebra hecke, ∀ b ∈ heckeSubalgebra hecke,
    a basis₁ + b basis₂ = 0 → a = 0 ∧ b = 0
  /-- The Atkin–Lehner-twisted Weil pairing on the Tate module. -/
  pair : Vp →ₗ[AlgebraicClosure ℚ_[p]]
    Vp →ₗ[AlgebraicClosure ℚ_[p]] AlgebraicClosure ℚ_[p]
  /-- The pairing is alternating. -/
  pair_self : ∀ x : Vp, pair x x = 0
  /-- The pairing is nondegenerate. -/
  pair_nondeg : ∀ x : Vp, (∀ y : Vp, pair x y = 0) → x = 0
  /-- The Hecke operators are self-adjoint for the twisted pairing. -/
  pair_hecke : ∀ (q : ℕ), q.Prime → ∀ x y : Vp,
    pair (hecke q x) y = pair x (hecke q y)
  /-- Galois Frobenii off `S` scale the pairing by the cyclotomic
  multiplier `q`. -/
  pair_frob : ∀ (q : ℕ) (hq : q.Prime),
    hq.toHeightOneSpectrumRingOfIntegersRat ∉ S →
    ∀ x y : Vp,
      pair (τJ (globalFrob hq.toHeightOneSpectrumRingOfIntegersRat) x)
          (τJ (globalFrob hq.toHeightOneSpectrumRingOfIntegersRat) y) =
        (q : AlgebraicClosure ℚ_[p]) * pair x y
  /-- The étale newform idempotent: for every level-`M` newform and
  `p`-adic embedding of its Hecke field, the eigensystem splits off
  as a nonzero idempotent of the Hecke subalgebra. -/
  eigen_idempotent : ∀ (g : CuspForm (Gamma0GL M) 2),
    IsWeightTwoNewform M g →
    ∀ (κ : heckeField M g →+* AlgebraicClosure ℚ_[p]),
      ∃ e ∈ heckeSubalgebra hecke, e * e = e ∧ e ≠ 0 ∧
        ∀ (q : ℕ), q.Prime → hecke q * e = κ (heckeCoeff M g q) • e
  /-- Ribet irreducibility (Ribet 1977, Springer LNM 601, Thm. (2.3)):
  for every level-`M` newform and `p`-adic embedding of its Hecke
  field, the Galois action admits no proper nonzero stable subspace
  inside the `κ`-eigenspace. Like `eigen_idempotent` this is
  quantified over `(g, κ)` INSIDE the structure — it is a fact about
  the one intended inhabitant (through the Weil bound
  `|a_q| ≤ 2√q` of the genuine newform), not about arbitrary abstract
  carriers, so it must not be a standalone lemma quantifying over
  packages. -/
  irred_eigenspace : ∀ (g : CuspForm (Gamma0GL M) 2),
    IsWeightTwoNewform M g →
    ∀ (κ : heckeField M g →+* AlgebraicClosure ℚ_[p]),
    ∀ U : Submodule (AlgebraicClosure ℚ_[p]) Vp,
      U ≤ heckeEigenspace hecke (fun m => κ (heckeCoeff M g m)) →
      (∀ γ : Field.absoluteGaloisGroup ℚ, ∀ x ∈ U, τJ γ x ∈ U) →
      U = ⊥ ∨ U = heckeEigenspace hecke (fun m => κ (heckeCoeff M g m))

