  have hBmemGL : ∀ j : ℕ, mapGL ℝ (B j) ∈ Gamma0GL (M / q) := by
    intro j
    exact mem_Gamma0GL_iff.mpr
      ⟨B j, Gamma0_mem_iff_intDvd.mpr (by rw [hM₀, hB10]), rfl⟩
