    (hcomm : ∀ σ ∈ I, ∀ τ ∈ I, (σ * τ * σ⁻¹ * τ⁻¹) r = r)
    (hram : ∀ ξ : AlgebraicClosure F, IsPrimitiveRoot ξ q → ∃ σ ∈ I, σ ξ ≠ ξ) :
