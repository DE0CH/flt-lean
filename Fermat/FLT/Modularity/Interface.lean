        kk, (ε₂ : Matrix (Fin 2) (Fin 2) ℤ) 1 1] = 1 := by
      rw [Matrix.det_fin_two_of]; linear_combination hdet2
    set ρ'' : SL(2, ℤ) := ⟨!![(ε₂ : Matrix (Fin 2) (Fin 2) ℤ) 0 0,
