        (((↑) : (AlgebraicClosure ℚ)ˣ → AlgebraicClosure ℚ) ''
          (rootsOfUnity p (AlgebraicClosure ℚ) :
            Set (AlgebraicClosure ℚ)ˣ))) :=
      IntermediateField.finiteDimensional_adjoin fun x _ =>
        (Algebra.IsAlgebraic.isAlgebraic (R := ℚ) x).isIntegral
