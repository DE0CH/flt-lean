        rw [heckeTMat_inv, SL2_mul_apply_zero_one]
        simp [hW, heckeTMat]
      rw [hval] at hd
      refine hqv ?_
      have h7 : (q : ℤ) ∣ u * q * (-((j : ℕ) : ℤ)) := ⟨u * (-((j : ℕ) : ℤ)), by ring⟩
      have h8 := dvd_sub hd h7
      have h9 : u * q * (-((j : ℕ) : ℤ)) + v - u * q * (-((j : ℕ) : ℤ)) = v := by ring
      rwa [h9] at h8
    · have hmul : r (some k) * (r (some j))⁻¹
