    (Units.map (algebraMap ℤ_[p] k).toMonoidHom).comp
      ((cyclotomicCharacter (AlgebraicClosure ℚ) p).comp
        (MulSemiringAction.toRingAut (Field.absoluteGaloisGroup ℚ)
          (AlgebraicClosure ℚ))) with hωdef
