  have hχcomm : ∀ σ τ : Field.absoluteGaloisGroup F, χ (σ * τ * σ⁻¹ * τ⁻¹) = 1 := by
    intro σ τ
    simp only [map_mul, map_inv]
    rw [mul_comm (χ σ) (χ τ)]
