/-- The **complex Hecke algebra** `𝕋_ℂ` acting on `S₂(Γ₀(M))`: the `ℂ`-subalgebra
of `End_ℂ S₂(Γ₀(M))` generated by the `T_q` at all primes `q`.  It is the `ℂ`-span
of `𝕋_ℚ = modularHeckeAlgebraQ M` (`heckeAlgC_le_span_modularHeckeAlgebraQ`), so
nothing is lost by working with it instead. -/
noncomputable def heckeAlgC (M : ℕ) :
    Subalgebra ℂ (Module.End ℂ (CuspForm (Gamma0GL M) 2)) :=
  Algebra.adjoin ℂ
    {φ : Module.End ℂ (CuspForm (Gamma0GL M) 2) |
      ∃ q : ℕ, q.Prime ∧ φ = heckeOp M q}

theorem heckeOp_mem_heckeAlgC {M q : ℕ} (hq : q.Prime) :
    heckeOp M q ∈ heckeAlgC M :=
  Algebra.subset_adjoin ⟨q, hq, rfl⟩

/-- **`𝕋_ℂ` IS THE `ℂ`-SPAN OF `𝕋_ℚ`** (PROVEN): the `ℂ`-span of a `ℚ`-subalgebra
is a `ℂ`-subalgebra, so it contains the `ℂ`-adjoin of the same generators.  This
is what lets every construction below be performed in the (much more convenient)
`ℂ`-algebra and then read back into the target's `ℂ`-span of a `𝕋_ℚ`-orbit. -/
theorem heckeAlgC_le_span_modularHeckeAlgebraQ (M : ℕ) :
    ∀ T ∈ heckeAlgC M, T ∈ Submodule.span ℂ
      ((modularHeckeAlgebraQ M : Set (Module.End ℂ (CuspForm (Gamma0GL M) 2)))) := by
  classical
  set A : Set (Module.End ℂ (CuspForm (Gamma0GL M) 2)) :=
    (modularHeckeAlgebraQ M : Set (Module.End ℂ (CuspForm (Gamma0GL M) 2)))
  have hmulclosed : ∀ x ∈ Submodule.span ℂ A, ∀ y ∈ Submodule.span ℂ A,
      x * y ∈ Submodule.span ℂ A := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem a ha =>
        intro y hy
        induction hy using Submodule.span_induction with
        | mem b hb => exact Submodule.subset_span (mul_mem ha hb)
        | zero => simp
        | add u v _ _ hu hv => rw [mul_add]; exact add_mem hu hv
        | smul c u _ hu => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ hu
    | zero => intro y _; simp
    | add u v _ _ hu hv => intro y hy; rw [add_mul]; exact add_mem (hu y hy) (hv y hy)
    | smul c u _ hu => intro y hy; rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ (hu y hy)
  intro T hT
  have hT' : T ∈ Algebra.adjoin ℂ
      {φ : Module.End ℂ (CuspForm (Gamma0GL M) 2) |
        ∃ q : ℕ, q.Prime ∧ φ = heckeOp M q} := hT
  clear hT
  induction hT' using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨q, hq, rfl⟩ := hx
      exact Submodule.subset_span (heckeOp_mem_modularHeckeAlgebraQ hq)
  | algebraMap r =>
      have h1 : (1 : Module.End ℂ (CuspForm (Gamma0GL M) 2)) ∈ A := one_mem _
      have : algebraMap ℂ (Module.End ℂ (CuspForm (Gamma0GL M) 2)) r
          = r • (1 : Module.End ℂ (CuspForm (Gamma0GL M) 2)) := by
        simp [Algebra.algebraMap_eq_smul_one]
      rw [this]
      exact Submodule.smul_mem _ _ (Submodule.subset_span h1)
  | add x y _ _ hx hy => exact add_mem hx hy
  | mul x y _ _ hx hy => exact hmulclosed x hx y hy

/-- The `ℂ`-span of the `𝕋_ℚ`-orbit of a cusp form — the submodule the target
`exists_heckeCyclicVector` asks to be all of `S₂(Γ₀(M))`. -/
noncomputable def heckeOrbitSpan (M : ℕ) (f₀ : CuspForm (Gamma0GL M) 2) :
    Submodule ℂ (CuspForm (Gamma0GL M) 2) :=
  Submodule.span ℂ
    {g : CuspForm (Gamma0GL M) 2 |
      ∃ T ∈ modularHeckeAlgebraQ M,
        g = (T : Module.End ℂ (CuspForm (Gamma0GL M) 2)) f₀}

theorem self_mem_heckeOrbitSpan {M : ℕ} (f₀ : CuspForm (Gamma0GL M) 2) :
    f₀ ∈ heckeOrbitSpan M f₀ :=
  Submodule.subset_span ⟨1, one_mem _, by simp⟩

/-- The orbit span is `𝕋_ℚ`-STABLE — the whole point of taking the span of an
orbit rather than of a finite set of translates. -/
theorem heckeOrbitSpan_stable {M : ℕ} (f₀ : CuspForm (Gamma0GL M) 2)
    {T : Module.End ℂ (CuspForm (Gamma0GL M) 2)} (hT : T ∈ modularHeckeAlgebraQ M)
    {v : CuspForm (Gamma0GL M) 2} (hv : v ∈ heckeOrbitSpan M f₀) :
    T v ∈ heckeOrbitSpan M f₀ := by
  induction hv using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨S, hS, rfl⟩ := hx
      exact Submodule.subset_span ⟨T * S, mul_mem hT hS, rfl⟩
  | zero => simp
  | add u v _ _ hu hv => rw [map_add]; exact add_mem hu hv
  | smul c u _ hu => rw [map_smul]; exact Submodule.smul_mem _ _ hu

/-- The orbit span absorbs the whole COMPLEX algebra, not just `𝕋_ℚ`. -/
theorem apply_mem_heckeOrbitSpan {M : ℕ} (f₀ : CuspForm (Gamma0GL M) 2)
    {T : Module.End ℂ (CuspForm (Gamma0GL M) 2)} (hT : T ∈ heckeAlgC M) :
    T f₀ ∈ heckeOrbitSpan M f₀ := by
  have hspan := heckeAlgC_le_span_modularHeckeAlgebraQ M T hT
  clear hT
  induction hspan using Submodule.span_induction with
  | mem S hS => exact Submodule.subset_span ⟨S, hS, rfl⟩
  | zero => simp
  | add u v _ _ hu hv => simpa using add_mem hu hv
  | smul c u _ hu => simpa using Submodule.smul_mem _ c hu

/-- A vector in the orbit span of `f₀` has its own orbit span inside that of
`f₀` — transitivity of "is generated by". -/
theorem heckeOrbitSpan_mono {M : ℕ} {f₀ u : CuspForm (Gamma0GL M) 2}
    (hu : u ∈ heckeOrbitSpan M f₀) :
    heckeOrbitSpan M u ≤ heckeOrbitSpan M f₀ := by
  refine Submodule.span_le.mpr ?_
  rintro g ⟨T, hT, rfl⟩
  exact heckeOrbitSpan_stable f₀ hT hu

/-- The joint maximal generalized eigenspace of the GOOD Hecke operators at the
character `ψ`.  By `heckeOp_apply_of_mem_heckeGoodEigenspace` (Petersson
self-adjointness) the "generalized" is vacuous: the good operators act by honest
scalars on it. -/
noncomputable def heckeGoodEigenspace (M : ℕ)
    (ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ) :
    Submodule ℂ (CuspForm (Gamma0GL M) 2) :=
  ⨅ q : {q : ℕ // q.Prime ∧ ¬ q ∣ M},
    (heckeOp M q.1).maxGenEigenspace (ψ q)

/-- **THE GOOD EIGENSPACES FILL `S₂(Γ₀(M))`** (PROVEN): simultaneous
triangularizability of the commuting family `{T_q : q ∤ M}` over the
algebraically closed field `ℂ`, i.e. `eq_iSup_inf_iInf_maxGenEigenspace_of_mapsTo`
above, applied to `U = ⊤`. -/
theorem iSup_heckeGoodEigenspace_eq_top {M : ℕ} (hM : 0 < M) :
    ⨆ ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ, heckeGoodEigenspace M ψ = ⊤ := by
  haveI : FiniteDimensional ℂ (CuspForm (Gamma0GL M) 2) :=
    cuspForm_finiteDimensional M hM
  have h := eq_iSup_inf_iInf_maxGenEigenspace_of_mapsTo
    (K := ℂ) (V := CuspForm (Gamma0GL M) 2)
    (T := fun q : {q : ℕ // q.Prime ∧ ¬ q ∣ M} => heckeOp M q.1)
    (fun i j => heckeOp_mul_comm hM i.2.1 j.2.1) ⊤
    (fun _ _ _ => Submodule.mem_top)
  simp only [top_inf_eq] at h
  exact h.symm

/-- **THE GOOD EIGENSPACES ARE `𝕋_ℂ`-STABLE** (PROVEN): every Hecke operator —
including the BAD ones, which is the point — commutes with the good ones
(`heckeOp_mul_comm`), hence preserves their generalized eigenspaces. -/
theorem heckeAlgC_mapsTo_heckeGoodEigenspace {M : ℕ} (hM : 0 < M)
    (ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ)
    {T : Module.End ℂ (CuspForm (Gamma0GL M) 2)} (hT : T ∈ heckeAlgC M)
    {v : CuspForm (Gamma0GL M) 2} (hv : v ∈ heckeGoodEigenspace M ψ) :
    T v ∈ heckeGoodEigenspace M ψ := by
  have key : ∀ S ∈ heckeAlgC M, ∀ w ∈ heckeGoodEigenspace M ψ,
      S w ∈ heckeGoodEigenspace M ψ := by
    intro S hS
    have hS' : S ∈ Algebra.adjoin ℂ
        {φ : Module.End ℂ (CuspForm (Gamma0GL M) 2) |
          ∃ q : ℕ, q.Prime ∧ φ = heckeOp M q} := hS
    clear hS
    induction hS' using Algebra.adjoin_induction with
    | mem x hx =>
        obtain ⟨q, hq, rfl⟩ := hx
        intro w hw
        rw [heckeGoodEigenspace, Submodule.mem_iInf] at hw ⊢
        intro r
        exact Module.End.mapsTo_maxGenEigenspace_of_comm
          (heckeOp_mul_comm hM r.2.1 hq) (ψ r) (hw r)
    | algebraMap r =>
        intro w hw
        have : algebraMap ℂ (Module.End ℂ (CuspForm (Gamma0GL M) 2)) r w = r • w := by
          simp [Algebra.algebraMap_eq_smul_one]
        rw [this]
        exact Submodule.smul_mem _ _ hw
    | add x y _ _ hx hy =>
        intro w hw
        simpa using add_mem (hx w hw) (hy w hw)
    | mul x y _ _ hx hy =>
        intro w hw
        exact hx _ (hy w hw)
  exact key T hT v hv

/-- **THE GOOD OPERATORS ACT BY HONEST SCALARS** on a good eigenspace (PROVEN
over `heckeOp_eq_smul_of_generalizedEigen_of_not_dvd_level`, i.e. over the
Petersson product): semisimplicity at the primes away from the level. -/
theorem heckeOp_apply_of_mem_heckeGoodEigenspace {M : ℕ} (hM : 0 < M)
    {ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ} {v : CuspForm (Gamma0GL M) 2}
    (hv : v ∈ heckeGoodEigenspace M ψ) (q : {q : ℕ // q.Prime ∧ ¬ q ∣ M}) :
    heckeOp M q.1 v = ψ q • v := by
  rw [heckeGoodEigenspace, Submodule.mem_iInf] at hv
  obtain ⟨k, hk⟩ := (Module.End.mem_maxGenEigenspace _ _ _).mp (hv q)
  exact heckeOp_eq_smul_of_generalizedEigen_of_not_dvd_level hM q.2.1 q.2.2 (ψ q) hk

/-- A good prime at which two distinct good eigensystems differ. -/
noncomputable def sepPrime {M : ℕ} (ψ ψ' : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ)
    (h : ψ ≠ ψ') : {q : ℕ // q.Prime ∧ ¬ q ∣ M} :=
  (Function.ne_iff.mp h).choose

theorem sepPrime_spec {M : ℕ} (ψ ψ' : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ) (h : ψ ≠ ψ') :
    ψ (sepPrime ψ ψ' h) ≠ ψ' (sepPrime ψ ψ' h) :=
  (Function.ne_iff.mp h).choose_spec

open scoped Classical in
/-- The **Lagrange factor** `(T_q − ψ'(q))/(ψ(q) − ψ'(q))` at a good prime `q`
separating `ψ` from `ψ'`: it is the identity on `E ψ` and kills `E ψ'`. -/
noncomputable def sepFactor (M : ℕ) (ψ ψ' : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ) :
    Module.End ℂ (CuspForm (Gamma0GL M) 2) :=
  if h : ψ ≠ ψ' then
    (ψ (sepPrime ψ ψ' h) - ψ' (sepPrime ψ ψ' h))⁻¹ •
      (heckeOp M (sepPrime ψ ψ' h).1 -
        ψ' (sepPrime ψ ψ' h) • (1 : Module.End ℂ (CuspForm (Gamma0GL M) 2)))
  else 1

theorem sepFactor_mem_heckeAlgC (M : ℕ) (ψ ψ' : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ) :
    sepFactor M ψ ψ' ∈ heckeAlgC M := by
  rw [sepFactor]
  split
  · exact Subalgebra.smul_mem _
      (sub_mem (heckeOp_mem_heckeAlgC (sepPrime ψ ψ' ‹_›).2.1)
        (Subalgebra.smul_mem _ (one_mem _) _)) _
  · exact one_mem _

theorem sepFactor_apply_self {M : ℕ} (hM : 0 < M)
    {ψ ψ' : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ} (hne : ψ ≠ ψ')
    {v : CuspForm (Gamma0GL M) 2} (hv : v ∈ heckeGoodEigenspace M ψ) :
    sepFactor M ψ ψ' v = v := by
  have hq := sepPrime_spec ψ ψ' hne
  have hT := heckeOp_apply_of_mem_heckeGoodEigenspace hM hv (sepPrime ψ ψ' hne)
  rw [sepFactor, dif_pos hne]
  simp only [LinearMap.smul_apply, LinearMap.sub_apply, Module.End.one_apply, hT]
  rw [← sub_smul, smul_smul, inv_mul_cancel₀ (sub_ne_zero.mpr hq), one_smul]

theorem sepFactor_apply_other {M : ℕ} (hM : 0 < M)
    {ψ ψ' : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ} (hne : ψ ≠ ψ')
    {w : CuspForm (Gamma0GL M) 2} (hw : w ∈ heckeGoodEigenspace M ψ') :
    sepFactor M ψ ψ' w = 0 := by
  have hT := heckeOp_apply_of_mem_heckeGoodEigenspace hM hw (sepPrime ψ ψ' hne)
  rw [sepFactor, dif_pos hne]
  simp only [LinearMap.smul_apply, LinearMap.sub_apply, Module.End.one_apply, hT,
    sub_self, smul_zero]

/-- The product of the Lagrange factors along a LIST of competing eigensystems.
A list rather than a `Finset` product because `End_ℂ S₂(Γ₀(M))` is not a
commutative monoid: the two lemmas below are proved by walking the list from the
right, where a factor either fixes the vector or annihilates it once and for
all, and no rearrangement is ever needed. -/
noncomputable def sepOp (M : ℕ) (ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ)
    (l : List ({q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ)) :
    Module.End ℂ (CuspForm (Gamma0GL M) 2) :=
  (l.map (sepFactor M ψ)).prod

theorem sepOp_cons (M : ℕ) (ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ)
    (a : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ)
    (l : List ({q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ)) :
    sepOp M ψ (a :: l) = sepFactor M ψ a * sepOp M ψ l := by
  rw [sepOp, sepOp, List.map_cons, List.prod_cons]

theorem sepOp_mem_heckeAlgC (M : ℕ) (ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ)
    (l : List ({q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ)) :
    sepOp M ψ l ∈ heckeAlgC M := by
  induction l with
  | nil => simp [sepOp]
  | cons a t ih =>
      rw [sepOp_cons]
      exact mul_mem (sepFactor_mem_heckeAlgC M ψ a) ih

/-- `sepOp` is the IDENTITY on its own eigenspace. -/
theorem sepOp_apply_self {M : ℕ} (hM : 0 < M)
    {ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ}
    (l : List ({q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ)) (hl : ∀ x ∈ l, ψ ≠ x)
    {v : CuspForm (Gamma0GL M) 2} (hv : v ∈ heckeGoodEigenspace M ψ) :
    sepOp M ψ l v = v := by
  induction l with
  | nil => simp [sepOp]
  | cons a t ih =>
      rw [sepOp_cons, Module.End.mul_apply,
        ih (fun x hx => hl x (List.mem_cons_of_mem _ hx))]
      exact sepFactor_apply_self hM (hl a List.mem_cons_self) hv

/-- `sepOp` KILLS every eigenspace named in its list.  The stability of the
eigenspaces under `𝕋_ℂ` is what makes the induction go through without any
commutation: the tail of the product keeps the vector inside `E c` until the
factor at `c` itself is reached. -/
theorem sepOp_apply_other {M : ℕ} (hM : 0 < M)
    {ψ c : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ}
    (l : List ({q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ)) (hl : ∀ x ∈ l, ψ ≠ x)
    (hc : c ∈ l) {w : CuspForm (Gamma0GL M) 2} (hw : w ∈ heckeGoodEigenspace M c) :
    sepOp M ψ l w = 0 := by
  classical
  induction l with
  | nil => exact absurd hc (List.not_mem_nil)
  | cons a t ih =>
      rw [sepOp_cons, Module.End.mul_apply]
      by_cases hct : c ∈ t
      · rw [ih (fun x hx => hl x (List.mem_cons_of_mem _ hx)) hct]
        exact map_zero _
      · have hca : c = a := by
          rcases List.mem_cons.mp hc with h | h
          · exact h
          · exact absurd h hct
        subst hca
        exact sepFactor_apply_other hM (hl c List.mem_cons_self)
          (heckeAlgC_mapsTo_heckeGoodEigenspace hM c (sepOp_mem_heckeAlgC M ψ t) hw)

/-- **`U_q ∘ V_{qd} = V_d` AT A BAD PRIME** (PROVEN): a one-line `q`-expansion
computation.  At `q ∣ M` the Hecke formula is `a_m(U_q f) = a_{qm}(f)`
(`qCoeff_heckeOp`), and `a_{qm}(V_{qd} u)` is `a_{qm/(qd)}(u) = a_{m/d}(u)` when
`qd ∣ qm ↔ d ∣ m` and `0` otherwise — which is `a_m(V_d u)`.

This is the engine of the oldform block: it says `U_q` moves one step DOWN the
chain `V_{q^r} f, V_{q^{r-1}} f, …, V_1 f = f`.

RENAMED AT INTEGRATION (2026-07-27, was `heckeOp_degeneracyOp_of_dvd`): two
branches landed different theorems under that one name on the same day, and
the other one — `U_p ∘ V_d = V_d ∘ U_p` for `p ∤ d`, at line 35527 — got there
first and has its own consumers.  `_mul_left` names the shape that
distinguishes this one: the degeneracy index is `q * d`, not `d`. -/
theorem heckeOp_degeneracyOp_mul_left {N M d q : ℕ} (hM : 0 < M) (hd : 0 < d)
    (hq : q.Prime) (hqM : q ∣ M) (hdvd : q * d * N ∣ M)
    (u : CuspForm (Gamma0GL N) 2) :
    heckeOp M q (degeneracyOp N M (q * d) u) = degeneracyOp N M d u := by
  have hqd : 0 < q * d := Nat.mul_pos hq.pos hd
  have hdvd' : d * N ∣ M := dvd_trans (by
    exact ⟨q, by ring⟩) hdvd
  refine cuspForm_eq_of_forall_qCoeff_eq fun m => ?_
  rw [qCoeff_heckeOp hM hq _ m, if_pos hqM, add_zero,
    qCoeff_degeneracyOp hqd hdvd u (q * m), qCoeff_degeneracyOp hd hdvd' u m]
  by_cases hdm : d ∣ m
  · rw [if_pos (mul_dvd_mul_left q hdm), if_pos hdm, Nat.mul_div_mul_left _ _ hq.pos]
  · rw [if_neg hdm, if_neg]
    intro h
    exact hdm ((Nat.mul_dvd_mul_iff_left hq.pos).mp h)

/-- **DESCENT ALONG THE DIVISORS** (PROVEN): for `N ∣ M` and any `f` at level
`N`, every degeneracy translate `V_d f` with `d ∣ M/N` lies in the Hecke orbit
span of the DEEPEST one, `V_{M/N} f`.

This is the "block is cyclic with generator `f((M/N)z)`" half of the classical
argument, and it is entirely elementary: strong induction on the cofactor
`(M/N)/d`, stepping down by one prime at a time through
`heckeOp_degeneracyOp_mul_left`.  Note it needs no hypothesis on `f` whatever —
newness, normalization and the eigensystem are all irrelevant here, which is
exactly why they are isolated in the single remaining leaf. -/
theorem degeneracyOp_mem_heckeOrbitSpan {N M : ℕ} (hN : 0 < N) (hM : 0 < M)
    (hNM : N ∣ M) (f : CuspForm (Gamma0GL N) 2) :
    ∀ k : ℕ, ∀ d : ℕ, d * k = M / N →
      degeneracyOp N M d f ∈ heckeOrbitSpan M (degeneracyOp N M (M / N) f) := by
  have hMN : 0 < M / N := Nat.div_pos (Nat.le_of_dvd hM hNM) hN
  have hMNM : (M / N) * N = M := Nat.div_mul_cancel hNM
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    intro d hdk
    have hk0 : k ≠ 0 := by rintro rfl; rw [Nat.mul_zero] at hdk; omega
    rcases eq_or_ne k 1 with rfl | hk1
    · rw [Nat.mul_one] at hdk
      rw [hdk]
      exact self_mem_heckeOrbitSpan _
    obtain ⟨q, hq, hqk⟩ := Nat.exists_prime_and_dvd hk1
    obtain ⟨k', rfl⟩ := hqk
    have hk'0 : k' ≠ 0 := by rintro rfl; simp at hk0
    have hlt : k' < q * k' := by
      have := hq.one_lt
      calc k' = 1 * k' := (one_mul k').symm
        _ < q * k' := (Nat.mul_lt_mul_right (Nat.pos_of_ne_zero hk'0)).mpr this
    have hdq : (d * q) * k' = M / N := by rw [← hdk]; ring
    have hmem := ih k' hlt (d * q) hdq
    have hd0 : 0 < d := by
      rcases Nat.eq_zero_or_pos d with rfl | h
      · rw [Nat.zero_mul] at hdk; omega
      · exact h
    have hdvdMN : d * q ∣ M / N := ⟨k', hdq.symm⟩
    have hqdN : q * d * N ∣ M := by
      rw [← hMNM]
      exact Nat.mul_dvd_mul_right (by rw [mul_comm q d]; exact hdvdMN) N
    have hqM : q ∣ M :=
      dvd_trans (dvd_trans (dvd_mul_left q d) hdvdMN) (Nat.div_dvd_of_dvd hNM)
    have hstep : heckeOp M q (degeneracyOp N M (d * q) f) = degeneracyOp N M d f := by
      rw [mul_comm d q]
      exact heckeOp_degeneracyOp_mul_left hM hd0 hq hqM hqdN f
    rw [← hstep]
    exact heckeOrbitSpan_stable _ (heckeOp_mem_modularHeckeAlgebraQ hq) hmem

/-! ### The SIXTEENTH decomposition: Atkin–Lehner blocks, cut along STRONG
MULTIPLICITY ONE

(2026-07-27.)  Everything from here to `exists_degeneracyBlock_heckeGoodEigenspace`
below reduces "a nonzero good eigenspace is the oldform block of a single form" to
ONE classical statement, `eq_of_isWeightTwoNewform_qCoeff_eq_of_not_dvd`: two
newforms of levels dividing `M` whose coefficients agree at every prime `q ∤ M`
are equal.

THE ROUTE, and why it needs exactly that one input.  Write
`E_M ψ = heckeGoodEigenspace M ψ`.

1. `E_M ψ` is stable under EVERY Hecke operator (`heckeOp_mul_comm`, bad primes
   included), so if it is nonzero it contains a joint eigenvector of the FULL
   Hecke family (`exists_ne_zero_mem_forall_prime_heckeOp_eq_smul`); that vector
   has `a₁ ≠ 0` (`eq_zero_of_forall_heckeOp_eq_smul_of_qCoeff_one_eq_zero`), so it
   normalizes to an eigenform of level `M` realizing `ψ`, and
   `exists_weightTwoNewform_of_weightTwoEigenform` puts a NEWFORM `f` of a divisor
   level `N ∣ M` behind it.  That is
   `exists_isWeightTwoNewform_of_heckeGoodEigenspace_ne_bot`, and it needs no
   Atkin–Lehner input at all.
2. Every translate `V_d f` with `d·N ∣ M` lies back in `E_M ψ`
   (`degeneracyOp_mem_heckeGoodEigenspace`, off `heckeOp_degeneracyOp`).
3. For `u ∈ E_M ψ`, subtracting `a₁(u)·V_1 f` gives a vector of `E_M ψ` with
   `a₁ = 0`; by `qCoeff_eq_qCoeff_one_mul_of_heckeOp_eigen_of_coprime` ALL of its
   coefficients at indices coprime to `M` vanish, so the Main Lemma
   `mem_oldSubspace_of_qCoeff_coprime_eq_zero` puts it in the OLD subspace
   `Σ_{p ∣ M} V_p S₂(Γ₀(M/p))`.
4. The old subspace is a SUM of `T_q`-stable pieces, so the good eigenspace meets
   it componentwise (`mem_iSup_inf_iInf_maxGenEigenspace`, the linear-algebra
   companion of `exists_ne_zero_mem_inf_iInf_maxGenEigenspace` above).  Injectivity
   of `V_p` and its commutation with the good `T_q` push each component down to a
   good eigenvector at level `M/p` (`mem_maxGenEigenspace_of_degeneracyOp_mem`),
   where the induction on the level applies and `V_p ∘ V_e = V_{pe}`
   (`degeneracyOp_degeneracyOp`) brings the answer back up.
5. The ONE gap is that step 4 produces, at level `M/p`, a newform `f'` of its own,
   and the block is a single form's block only if `f' = f`.  Both are newforms of
   levels dividing `M` with the same coefficients at every `q ∤ M`, so this is
   exactly Strong Multiplicity One — and it is exactly the input Diamond–Shurman
   themselves import from outside when proving Theorem 5.8.3 ("By a result known
   as Strong Multiplicity One, these conditions make all of the `fᵢ` equal").

Note the index-set subtlety that makes the induction work at all: at level `M/p`
the good primes are those `∤ M/p`, a LARGER set than those `∤ M`, and the extra
prime can only be `p` itself (a prime `q ≠ p` dividing `M` still divides `M/p`).
So one further splitting by the `T_p`-eigenvalue at level `M/p` — one application
of `eq_iSup_inf_iInf_maxGenEigenspace_of_mapsTo` with a one-element family — turns
the level-`M` character `ψ` into a genuine level-`M/p` character `ψ'`. -/

/-- **SPECTRAL SPLITTING OF A SUM, INSIDE ONE JOINT EIGENSPACE** (PROVEN, pure
linear algebra over an algebraically closed field).  If a commuting family `T i`
preserves each `U k`, then a vector of `⨆ k, U k` lying in the joint generalized
eigenspace at `χ` already lies in `⨆ k, (U k ⊓ E χ)`.

This is the quantitative form of `exists_ne_zero_mem_inf_iInf_maxGenEigenspace`
above: that lemma produces ONE nonzero vector in ONE summand, which is enough for
a descent but not for a SPANNING statement, and the spanning statement is what the
oldform-block argument needs.  Same proof, stopped one step earlier. -/
theorem mem_iSup_inf_iInf_maxGenEigenspace
    {K V ι κ : Type*} [Field K] [IsAlgClosed K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V]
    (U : κ → Submodule K V) (T : ι → Module.End K V)
    (hcomm : ∀ i j, Commute (T i) (T j))
    (hstab : ∀ i k, Set.MapsTo (T i) (U k) (U k))
    (χ : ι → K) {w : V} (hwU : w ∈ ⨆ k, U k)
    (hwχ : w ∈ ⨅ i, (T i).maxGenEigenspace (χ i)) :
    w ∈ ⨆ k, (U k ⊓ ⨅ i, (T i).maxGenEigenspace (χ i)) := by
  classical
  set E : (ι → K) → Submodule K V :=
    fun ψ => ⨅ i, (T i).maxGenEigenspace (ψ i) with hEdef
  have hmaps : ∀ i j φ,
      Set.MapsTo (T i) ((T j).maxGenEigenspace φ) ((T j).maxGenEigenspace φ) :=
    fun i j φ => (T j).mapsTo_maxGenEigenspace_of_comm (hcomm i j).eq.symm φ
  have hindep : iSupIndep E :=
    Module.End.independent_iInf_maxGenEigenspace_of_forall_mapsTo T hmaps
  have hUdecomp : ∀ k, U k = ⨆ ψ : ι → K, U k ⊓ E ψ := fun k =>
    eq_iSup_inf_iInf_maxGenEigenspace_of_mapsTo T hcomm (U k) (fun i => hstab i k)
  set F : (ι → K) → Submodule K V := fun ψ => ⨆ k, U k ⊓ E ψ with hFdef
  have hFle : ∀ ψ, F ψ ≤ E ψ := fun ψ => iSup_le fun _ => inf_le_right
  have hwF : w ∈ ⨆ ψ : ι → K, F ψ := by
    have h1 : (⨆ k, U k) = ⨆ k, ⨆ ψ : ι → K, U k ⊓ E ψ := iSup_congr hUdecomp
    have h2 : (⨆ ψ : ι → K, F ψ) = ⨆ k, ⨆ ψ : ι → K, U k ⊓ E ψ := iSup_comm
    rw [h2, ← h1]
    exact hwU
  rw [iSup_split_single F χ] at hwF
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hwF
  have hbE : b ∈ E χ := by
    rw [eq_sub_of_add_eq' hab]
    exact Submodule.sub_mem _ hwχ (hFle χ ha)
  have hbrest : b ∈ ⨆ (ψ : ι → K) (_ : ψ ≠ χ), E ψ :=
    (iSup₂_mono fun ψ _ => hFle ψ) hb
  have hb0 : b = 0 := by
    have hbot := (hindep χ).le_bot ⟨hbE, hbrest⟩
    simpa using hbot
  have haw : a = w := by rw [← hab, hb0, add_zero]
  exact haw ▸ ha

/-- **`V_d ∘ V_e = V_{d·e}`** (PROVEN): a pure `q`-expansion computation off
`qCoeff_degeneracyOp` at the two levels.  It is what lets the descent through one
prime `p` of `M` be reassembled into a single block at level `M`. -/
theorem degeneracyOp_degeneracyOp {N L M e d : ℕ} (he : 0 < e) (hd : 0 < d)
    (heN : e * N ∣ L) (hdL : d * L ∣ M) (f : CuspForm (Gamma0GL N) 2) :
    degeneracyOp L M d (degeneracyOp N L e f) = degeneracyOp N M (d * e) f := by
  have hde : 0 < d * e := Nat.mul_pos hd he
  have hdeN : d * e * N ∣ M := by
    have h1 : d * (e * N) ∣ d * L := Nat.mul_dvd_mul_left d heN
    exact dvd_trans (by rw [mul_assoc]; exact h1) hdL
  refine cuspForm_eq_of_forall_qCoeff_eq fun m => ?_
  rw [qCoeff_degeneracyOp hd hdL _ m, qCoeff_degeneracyOp hde hdeN f m]
  by_cases hdm : d ∣ m
  · obtain ⟨t, rfl⟩ := hdm
    rw [if_pos ⟨t, rfl⟩, qCoeff_degeneracyOp he heN f (d * t / d),
      Nat.mul_div_cancel_left t hd]
    by_cases het : e ∣ t
    · obtain ⟨s, rfl⟩ := het
      have hdvd2 : d * e ∣ d * (e * s) := ⟨s, by ring⟩
      rw [if_pos (dvd_mul_right e s), if_pos hdvd2, Nat.mul_div_cancel_left s he,
        show d * (e * s) = d * e * s by ring, Nat.mul_div_cancel_left s hde]
    · rw [if_neg het, if_neg]
      intro h
      obtain ⟨s, hs⟩ := h
      exact het ⟨s, by
        have : d * t = d * (e * s) := by rw [hs]; ring
        exact Nat.eq_of_mul_eq_mul_left hd this⟩
  · rw [if_neg hdm, if_neg]
    intro h
    exact hdm (dvd_trans (Dvd.intro e rfl) h)

/-- **POWERS OF `T_q − c` COMMUTE WITH `V_d` AT A GOOD PRIME** (PROVEN):
induction on the exponent off `heckeOp_degeneracyOp`.  This is what turns a
GENERALIZED eigenvector statement upstairs into one downstairs. -/
theorem pow_sub_smul_apply_degeneracyOp {N M d q : ℕ} (hN : 0 < N) (hM : 0 < M) (hd : 0 < d)
    (hdvd : d * N ∣ M) (hq : q.Prime) (hqM : ¬ q ∣ M) (c : ℂ) (k : ℕ) :
    ∀ w : CuspForm (Gamma0GL N) 2,
      ((heckeOp M q - c • (1 : Module.End ℂ (CuspForm (Gamma0GL M) 2))) ^ k)
          (degeneracyOp N M d w)
        = degeneracyOp N M d
            (((heckeOp N q - c • (1 : Module.End ℂ (CuspForm (Gamma0GL N) 2))) ^ k) w) := by
  have hstep : ∀ x : CuspForm (Gamma0GL N) 2,
      (heckeOp M q - c • (1 : Module.End ℂ (CuspForm (Gamma0GL M) 2)))
          (degeneracyOp N M d x)
        = degeneracyOp N M d
            ((heckeOp N q - c • (1 : Module.End ℂ (CuspForm (Gamma0GL N) 2))) x) := by
    intro x
    simp only [LinearMap.sub_apply, LinearMap.smul_apply, Module.End.one_apply, map_sub,
      map_smul, heckeOp_degeneracyOp hN hM hd hdvd hq hqM x]
  induction k with
  | zero => intro w; simp
  | succ k ih =>
      intro w
      calc ((heckeOp M q - c • (1 : Module.End ℂ (CuspForm (Gamma0GL M) 2))) ^ (k + 1))
            (degeneracyOp N M d w)
          = ((heckeOp M q - c • (1 : Module.End ℂ (CuspForm (Gamma0GL M) 2))) ^ k)
              ((heckeOp M q - c • (1 : Module.End ℂ (CuspForm (Gamma0GL M) 2)))
                (degeneracyOp N M d w)) := by
            rw [pow_succ, Module.End.mul_apply]
        _ = ((heckeOp M q - c • (1 : Module.End ℂ (CuspForm (Gamma0GL M) 2))) ^ k)
              (degeneracyOp N M d
                ((heckeOp N q - c • (1 : Module.End ℂ (CuspForm (Gamma0GL N) 2))) w)) := by
            rw [hstep]
        _ = degeneracyOp N M d
              (((heckeOp N q - c • (1 : Module.End ℂ (CuspForm (Gamma0GL N) 2))) ^ k)
                ((heckeOp N q - c • (1 : Module.End ℂ (CuspForm (Gamma0GL N) 2))) w)) := ih _
        _ = degeneracyOp N M d
              (((heckeOp N q - c • (1 : Module.End ℂ (CuspForm (Gamma0GL N) 2))) ^ (k + 1)) w) := by
            rw [pow_succ, Module.End.mul_apply]

/-- **DESCENT OF A GENERALIZED EIGENVECTOR THROUGH `V_d`** (PROVEN): if `V_d w`
is a generalized `c`-eigenvector of a good `T_q`, so is `w`, by
`pow_sub_smul_apply_degeneracyOp` and the INJECTIVITY of `V_d`. -/
theorem mem_maxGenEigenspace_of_degeneracyOp_mem {N M d q : ℕ} (hN : 0 < N) (hM : 0 < M)
    (hd : 0 < d) (hdvd : d * N ∣ M) (hq : q.Prime) (hqM : ¬ q ∣ M) (c : ℂ)
    {w : CuspForm (Gamma0GL N) 2}
    (hmem : degeneracyOp N M d w ∈ (heckeOp M q).maxGenEigenspace c) :
    w ∈ (heckeOp N q).maxGenEigenspace c := by
  obtain ⟨k, hk⟩ := (Module.End.mem_maxGenEigenspace _ _ _).mp hmem
  refine (Module.End.mem_maxGenEigenspace _ _ _).mpr ⟨k, ?_⟩
  refine degeneracyOp_injective hd hdvd ?_
  rw [map_zero, ← pow_sub_smul_apply_degeneracyOp hN hM hd hdvd hq hqM c k w]
  exact hk

/-- **EVERY TRANSLATE OF AN EIGENFORM STAYS IN THE BLOCK** (PROVEN): `T_q` commutes
with `V_d` at a good `q` and `f` is an honest `T_q`-eigenvector at `ψ q`, so
`V_d f` is an honest — hence a fortiori generalized — `ψ q`-eigenvector.  This is
the elementary half of the target. -/
theorem degeneracyOp_mem_heckeGoodEigenspace {M N d : ℕ} (hM : 0 < M) (hN : 0 < N)
    (hd : 0 < d) (hdvd : d * N ∣ M)
    {ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ} {f : CuspForm (Gamma0GL N) 2}
    (hf : IsWeightTwoEigenform N f)
    (hfψ : ∀ q : {q : ℕ // q.Prime ∧ ¬ q ∣ M}, qCoeff N f q.1 = ψ q) :
    degeneracyOp N M d f ∈ heckeGoodEigenspace M ψ := by
  rw [heckeGoodEigenspace, Submodule.mem_iInf]
  intro q
  have hstep : heckeOp M q.1 (degeneracyOp N M d f) = ψ q • degeneracyOp N M d f := by
    rw [heckeOp_degeneracyOp hN hM hd hdvd q.2.1 q.2.2 f,
      heckeOp_apply_eq_smul_of_isWeightTwoEigenform hN hf q.2.1, map_smul, hfψ q]
  refine (Module.End.mem_maxGenEigenspace _ _ _).mpr ⟨1, ?_⟩
  simp only [pow_one, LinearMap.sub_apply, LinearMap.smul_apply, Module.End.one_apply, hstep,
    sub_self]

/-- **A NONZERO GOOD EIGENSPACE CARRIES A NORMALIZED EIGENFORM OF ITS OWN LEVEL**
(PROVEN, no Atkin–Lehner input): the block is stable under the WHOLE Hecke family
because the operators commute, so it contains a joint eigenvector of all of them
(`exists_ne_zero_mem_forall_prime_heckeOp_eq_smul`); that vector has `a₁ ≠ 0`
(`eq_zero_of_forall_heckeOp_eq_smul_of_qCoeff_one_eq_zero`), and normalizing gives
an eigenform (`isWeightTwoEigenform_of_forall_heckeOp_eq_smul`) whose good-prime
coefficients are the block's own character `ψ`. -/
theorem exists_isWeightTwoEigenform_of_heckeGoodEigenspace_ne_bot {M : ℕ} (hM : 0 < M)
    {ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ} (hne : heckeGoodEigenspace M ψ ≠ ⊥) :
    ∃ g : CuspForm (Gamma0GL M) 2, IsWeightTwoEigenform M g ∧
      ∀ q : {q : ℕ // q.Prime ∧ ¬ q ∣ M}, qCoeff M g q.1 = ψ q := by
  classical
  have hstab : ∀ q : ℕ, q.Prime → ∀ x ∈ heckeGoodEigenspace M ψ,
      heckeOp M q x ∈ heckeGoodEigenspace M ψ := by
    intro q hq x hx
    rw [heckeGoodEigenspace, Submodule.mem_iInf] at hx ⊢
    intro r
    exact Module.End.mapsTo_maxGenEigenspace_of_comm (heckeOp_mul_comm hM r.2.1 hq) (ψ r) (hx r)
  obtain ⟨w, hwE, hw0, lam, hlam⟩ :=
    exists_ne_zero_mem_forall_prime_heckeOp_eq_smul hM hne hstab
  have hone : qCoeff M w 1 ≠ 0 := fun h0 =>
    hw0 (eq_zero_of_forall_heckeOp_eq_smul_of_qCoeff_one_eq_zero hM hlam h0)
  have hg1 : qCoeff M ((qCoeff M w 1)⁻¹ • w) 1 = 1 := by
    rw [qCoeff_smul, inv_mul_cancel₀ hone]
  have hgl : ∀ q : ℕ, q.Prime →
      heckeOp M q ((qCoeff M w 1)⁻¹ • w) = lam q • ((qCoeff M w 1)⁻¹ • w) := by
    intro q hq
    rw [map_smul, hlam q hq, smul_comm]
  have hgE : IsWeightTwoEigenform M ((qCoeff M w 1)⁻¹ • w) :=
    isWeightTwoEigenform_of_forall_heckeOp_eq_smul hM hgl hg1
  refine ⟨(qCoeff M w 1)⁻¹ • w, hgE, fun q => ?_⟩
  have h1 : heckeOp M q.1 w = ψ q • w := heckeOp_apply_of_mem_heckeGoodEigenspace hM hwE q
  have h2 : lam q.1 = ψ q := by
    have h := hlam q.1 q.2.1
    rw [h1] at h
    have h3 : (ψ q - lam q.1) • w = 0 := by rw [sub_smul, ← h, sub_self]
    rcases smul_eq_zero.mp h3 with h4 | h4
    · exact (sub_eq_zero.mp h4).symm
    · exact absurd h4 hw0
  have h4 : heckeOp M q.1 ((qCoeff M w 1)⁻¹ • w) =
      qCoeff M ((qCoeff M w 1)⁻¹ • w) q.1 • ((qCoeff M w 1)⁻¹ • w) :=
    heckeOp_apply_eq_smul_of_isWeightTwoEigenform hM hgE q.2.1
  have hg0 : ((qCoeff M w 1)⁻¹ • w) ≠ 0 := ne_zero_of_isWeightTwoEigenform hgE
  have h5 : (qCoeff M ((qCoeff M w 1)⁻¹ • w) q.1 - lam q.1) • ((qCoeff M w 1)⁻¹ • w) = 0 := by
    rw [sub_smul, ← h4, hgl q.1 q.2.1, sub_self]
  rcases smul_eq_zero.mp h5 with h | h
  · rw [sub_eq_zero.mp h, h2]
  · exact absurd h hg0

/-- **A NONZERO GOOD EIGENSPACE CARRIES A NEWFORM OF A DIVISOR LEVEL** (PROVEN):
the eigenform of the previous lemma, pushed down to its minimal level by
`exists_weightTwoNewform_of_weightTwoEigenform`.  Agreement survives the descent
because that lemma delivers it at every `q ∤ M`, which is the whole index set of
`ψ`. -/
theorem exists_isWeightTwoNewform_of_heckeGoodEigenspace_ne_bot {M : ℕ} (hM : 0 < M)
    {ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ} (hne : heckeGoodEigenspace M ψ ≠ ⊥) :
    ∃ N : ℕ, 0 < N ∧ N ∣ M ∧ ∃ f : CuspForm (Gamma0GL N) 2, IsWeightTwoNewform N f ∧
      ∀ q : {q : ℕ // q.Prime ∧ ¬ q ∣ M}, qCoeff N f q.1 = ψ q := by
  obtain ⟨g, hg, hgψ⟩ := exists_isWeightTwoEigenform_of_heckeGoodEigenspace_ne_bot hM hne
  obtain ⟨N, hNM, hN, f, hf, hagree⟩ := exists_weightTwoNewform_of_weightTwoEigenform hM hg
  exact ⟨N, hN, hNM, f, hf, fun q => (hagree q.1 q.2.1 q.2.2).trans (hgψ q)⟩

/-- **A GOOD EIGENVECTOR WITH `a₁ = 0` HAS NO COEFFICIENTS AWAY FROM THE LEVEL**
(PROVEN): `qCoeff_eq_qCoeff_one_mul_of_heckeOp_eigen_of_coprime` against the
eigenform supplied by the block itself.  This is the hypothesis of the Main Lemma
`mem_oldSubspace_of_qCoeff_coprime_eq_zero`, and it is how the induction below
enters the old subspace. -/
theorem qCoeff_eq_zero_of_mem_heckeGoodEigenspace_of_qCoeff_one_eq_zero {M : ℕ} (hM : 0 < M)
    {ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ} {u : CuspForm (Gamma0GL M) 2}
    (hu : u ∈ heckeGoodEigenspace M ψ) (hu1 : qCoeff M u 1 = 0)
    {g : CuspForm (Gamma0GL M) 2} (hg : IsWeightTwoEigenform M g)
    (hgψ : ∀ q : {q : ℕ // q.Prime ∧ ¬ q ∣ M}, qCoeff M g q.1 = ψ q)
    (n : ℕ) (hn : Nat.Coprime n M) : qCoeff M u n = 0 := by
  have hv : ∀ q : ℕ, q.Prime → ¬ q ∣ M → heckeOp M q u = qCoeff M g q • u := by
    intro q hq hqM
    rw [hgψ ⟨q, hq, hqM⟩]
    exact heckeOp_apply_of_mem_heckeGoodEigenspace hM hu ⟨q, hq, hqM⟩
  have h := qCoeff_eq_qCoeff_one_mul_of_heckeOp_eigen_of_coprime hM hg hv n hn
  rw [hu1, zero_mul] at h
  exact h

/-- **STRONG MULTIPLICITY ONE ACROSS LEVELS** (sorry leaf, the SIXTEENTH
decomposition, 2026-07-27; Atkin–Lehner 1970 Theorem 5, Miyake Theorem 4.6.19,
Casselman): two NEWFORMS `f`, `f'`, of levels `N`, `N'` both dividing `M`, whose
`q`-expansion coefficients agree at every prime `q ∤ M`, have the same level and
the same coefficients — hence are the same form.

THIS IS THE ONLY REMAINING CONTENT of the Atkin–Lehner block theorem in this
file, and it is exactly the outside input Diamond–Shurman themselves import.  In
their proof of Theorem 5.8.3 (the basis `{f(nτ) : f new of level M, nM ∣ N}` of
`S_k(Γ₁(N))`) they reduce a hypothetical linear relation to "distinct forms `fᵢ`
of levels `Mᵢ ∣ N` with all `a_p(fᵢ)` equal for `p ∤ N`" and then write: *"By a
result known as Strong Multiplicity One, these conditions make all of the `fᵢ`
equal"* (GTM 228, p. 198).  The statement below is that sentence.

WHY THE ATKIN–LEHNER FORM IS NOT ENOUGH, and this is the load-bearing point for
whoever attacks it.  Atkin–Lehner 1970 Theorem 5 assumes agreement at every
`q ∤ N·N'`; here the hypothesis is agreement only at `q ∤ M`.  Since `N ∣ M` and
`N' ∣ M`, `{q : q ∤ M} ⊆ {q : q ∤ N·N'}`, so the hypothesis here is STRICTLY
WEAKER: nothing is known at a prime `q ∣ M` with `q ∤ N·N'`, and at such a `q`
the coefficient `a_q` is an unconstrained good eigenvalue at BOTH levels.  So the
theorem needed is the "almost all primes" form of strong multiplicity one, not
the Atkin–Lehner form.  Two routes are classical:

* Rankin–Selberg: `L(f × conj f', s)` has a pole at `s = 1` iff `f = f'`, and the
  Euler factors outside a finite set determine the pole.  Needs the Rankin–Selberg
  integral, which this pin does not have.
* Representation theory (Casselman): the automorphic representations attached to
  `f` and `f'` are isomorphic at almost every place, hence isomorphic.  Needs the
  adelic dictionary.

A third, cheaper possibility WORTH CHECKING FIRST is whether the CONSUMER can be
re-cut so that only the Atkin–Lehner form is needed: the induction below compares
`f` (level `N ∣ M`) with a newform `f'` produced at level `M/p`, and it is the
LEVEL-`M` character that limits the agreement set.  An induction carrying
agreement at `q ∤ N·N'` instead would close the leaf against the weaker classical
theorem — but that theorem is not in this tree either, so the saving is only in
difficulty, not in work already done.

FAITHFULNESS.  Both `hNM` and `hN'M` are load-bearing: without them `N` and `N'`
share no prime constraint with `M`, `hagree` can be vacuous (take `M` divisible by
every prime below any bound), and the conclusion is then plainly false.  `hM` rules
out `M = 0`, where `¬ q ∣ 0` is never satisfied and `hagree` is vacuous.  The
statement is NOT vacuous: `N = N'`, `f = f'` satisfies every hypothesis. -/
theorem eq_of_isWeightTwoNewform_qCoeff_eq_of_not_dvd {M : ℕ} (hM : 0 < M)
    {N : ℕ} (hNM : N ∣ M) {f : CuspForm (Gamma0GL N) 2} (hf : IsWeightTwoNewform N f)
    {N' : ℕ} (hN'M : N' ∣ M) {f' : CuspForm (Gamma0GL N') 2} (hf' : IsWeightTwoNewform N' f')
    (hagree : ∀ q : ℕ, q.Prime → ¬ q ∣ M → qCoeff N f q = qCoeff N' f' q) :
    N = N' ∧ ∀ n : ℕ, qCoeff N f n = qCoeff N' f' n :=
  sorry

/-- **THE BLOCK CONTAINMENT** (PROVEN over the single leaf
`eq_of_isWeightTwoNewform_qCoeff_eq_of_not_dvd`): for a NEWFORM `f` of level
`N ∣ M` realizing the good eigensystem `ψ`, the whole block `E_M ψ` is spanned by
the degeneracy translates `V_d f`, `d·N ∣ M`.

Strong induction on `M`, exactly the five steps of the section header: subtract
`a₁(u)·V_1 f` to kill the first coefficient, use the Main Lemma to land in the old
subspace, split the old subspace spectrally, descend each `range V_p` component to
level `M/p` through the injectivity of `V_p`, split once more by the `T_p`-eigenvalue
there (which is what upgrades the level-`M` character `ψ` to a level-`M/p` one), and
apply the induction hypothesis — with the leaf identifying the newform found at
level `M/p` with `f`.

Note the statement quantifies over `f` UNIVERSALLY rather than producing it.  That
is deliberate and it is what makes the induction go through: the recursive call at
level `M/p` must be made with the SAME `f`, and supplying it is precisely where the
leaf is consumed. -/
theorem heckeGoodEigenspace_le_span_degeneracyOp :
    ∀ M : ℕ, 0 < M → ∀ (ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ) (N : ℕ), 0 < N → N ∣ M →
      ∀ f : CuspForm (Gamma0GL N) 2, IsWeightTwoNewform N f →
        (∀ q : {q : ℕ // q.Prime ∧ ¬ q ∣ M}, qCoeff N f q.1 = ψ q) →
        heckeGoodEigenspace M ψ ≤
          Submodule.span ℂ
            {u : CuspForm (Gamma0GL M) 2 | ∃ d : ℕ, d * N ∣ M ∧ u = degeneracyOp N M d f} := by
  intro M
  induction M using Nat.strong_induction_on with
  | _ M ih =>
  intro hM ψ N hN hNM f hf hfψ
  classical
  haveI : FiniteDimensional ℂ (CuspForm (Gamma0GL M) 2) := cuspForm_finiteDimensional M hM
  intro u hu
  have h1dvd : 1 * N ∣ M := by simpa using hNM
  have h1B : degeneracyOp N M 1 f ∈ Submodule.span ℂ
      {u : CuspForm (Gamma0GL M) 2 | ∃ d : ℕ, d * N ∣ M ∧ u = degeneracyOp N M d f} :=
    Submodule.subset_span ⟨1, h1dvd, rfl⟩
  have h1E : degeneracyOp N M 1 f ∈ heckeGoodEigenspace M ψ :=
    degeneracyOp_mem_heckeGoodEigenspace hM hN one_pos h1dvd hf.toIsWeightTwoEigenform hfψ
  have h1coeff : qCoeff M (degeneracyOp N M 1 f) 1 = 1 := by
    rw [qCoeff_degeneracyOp_one hNM f 1, hf.qCoeff_one]
  have hu₁E : u - qCoeff M u 1 • degeneracyOp N M 1 f ∈ heckeGoodEigenspace M ψ :=
    sub_mem hu (Submodule.smul_mem _ _ h1E)
  have hu₁E' : u - qCoeff M u 1 • degeneracyOp N M 1 f ∈
      ⨅ q : {q : ℕ // q.Prime ∧ ¬ q ∣ M}, (heckeOp M q.1).maxGenEigenspace (ψ q) := hu₁E
  have hu₁1 : qCoeff M (u - qCoeff M u 1 • degeneracyOp N M 1 f) 1 = 0 := by
    rw [qCoeff_sub, qCoeff_smul, h1coeff, mul_one, sub_self]
  have hEne : heckeGoodEigenspace M ψ ≠ ⊥ := by
    intro h
    rw [h, Submodule.mem_bot] at h1E
    rw [h1E, qCoeff_zero_cuspForm] at h1coeff
    exact zero_ne_one h1coeff
  obtain ⟨g, hgE, hgψ⟩ := exists_isWeightTwoEigenform_of_heckeGoodEigenspace_ne_bot hM hEne
  have hcop : ∀ n : ℕ, Nat.Coprime n M →
      qCoeff M (u - qCoeff M u 1 • degeneracyOp N M 1 f) n = 0 := fun n hn =>
    qCoeff_eq_zero_of_mem_heckeGoodEigenspace_of_qCoeff_one_eq_zero hM hu₁E hu₁1 hgE hgψ n hn
  have hold := mem_oldSubspace_of_qCoeff_coprime_eq_zero hM hcop
  have holdU : u - qCoeff M u 1 • degeneracyOp N M 1 f ∈
      ⨆ p : {p : ℕ // p ∈ M.primeFactors},
        LinearMap.range (degeneracyOp (M / p.1) M p.1) :=
    (iSup₂_le fun p hp => le_iSup
      (fun p : {p : ℕ // p ∈ M.primeFactors} =>
        LinearMap.range (degeneracyOp (M / p.1) M p.1)) ⟨p, hp⟩) hold
  have hstabU : ∀ (i : {q : ℕ // q.Prime ∧ ¬ q ∣ M}) (k : {p : ℕ // p ∈ M.primeFactors}),
      Set.MapsTo (heckeOp M i.1)
        (LinearMap.range (degeneracyOp (M / k.1) M k.1))
        (LinearMap.range (degeneracyOp (M / k.1) M k.1)) := by
    rintro i k x ⟨w, rfl⟩
    have hpp : k.1.Prime := Nat.prime_of_mem_primeFactors k.2
    have hpd : k.1 ∣ M := Nat.dvd_of_mem_primeFactors k.2
    have hpos : 0 < M / k.1 := Nat.div_pos (Nat.le_of_dvd hM hpd) hpp.pos
    have hdvd : k.1 * (M / k.1) ∣ M := by rw [Nat.mul_div_cancel' hpd]
    exact ⟨heckeOp (M / k.1) i.1 w,
      (heckeOp_degeneracyOp hpos hM hpp.pos hdvd i.2.1 i.2.2 w).symm⟩
  have hsplit := mem_iSup_inf_iInf_maxGenEigenspace
    (fun p : {p : ℕ // p ∈ M.primeFactors} =>
      LinearMap.range (degeneracyOp (M / p.1) M p.1))
    (fun q : {q : ℕ // q.Prime ∧ ¬ q ∣ M} => heckeOp M q.1)
    (fun i j => heckeOp_mul_comm hM i.2.1 j.2.1) hstabU ψ holdU hu₁E'
  have hUle : ∀ k : {p : ℕ // p ∈ M.primeFactors},
      (LinearMap.range (degeneracyOp (M / k.1) M k.1) ⊓
        ⨅ q : {q : ℕ // q.Prime ∧ ¬ q ∣ M}, (heckeOp M q.1).maxGenEigenspace (ψ q)) ≤
        Submodule.span ℂ
          {u : CuspForm (Gamma0GL M) 2 | ∃ d : ℕ, d * N ∣ M ∧ u = degeneracyOp N M d f} := by
    intro k x hx
    obtain ⟨hxR, hxE⟩ := Submodule.mem_inf.mp hx
    obtain ⟨w, rfl⟩ := hxR
    have hpp : k.1.Prime := Nat.prime_of_mem_primeFactors k.2
    have hpd : k.1 ∣ M := Nat.dvd_of_mem_primeFactors k.2
    have hL : 0 < M / k.1 := Nat.div_pos (Nat.le_of_dvd hM hpd) hpp.pos
    have hpL : k.1 * (M / k.1) ∣ M := by rw [Nat.mul_div_cancel' hpd]
    have hLlt : M / k.1 < M := Nat.div_lt_self hM hpp.one_lt
    haveI : FiniteDimensional ℂ (CuspForm (Gamma0GL (M / k.1)) 2) :=
      cuspForm_finiteDimensional _ hL
    set Eg : Submodule ℂ (CuspForm (Gamma0GL (M / k.1)) 2) :=
      ⨅ q : {q : ℕ // q.Prime ∧ ¬ q ∣ M},
        (heckeOp (M / k.1) q.1).maxGenEigenspace (ψ q) with hEgdef
    have hwEg : w ∈ Eg := by
      rw [hEgdef, Submodule.mem_iInf]
      intro q
      exact mem_maxGenEigenspace_of_degeneracyOp_mem hL hM hpp.pos hpL q.2.1 q.2.2 (ψ q)
        (Submodule.mem_iInf _ |>.mp hxE q)
    have hkey : Eg ≤
        Submodule.span ℂ {v : CuspForm (Gamma0GL (M / k.1)) 2 |
          ∃ e : ℕ, e * N ∣ M / k.1 ∧ v = degeneracyOp N (M / k.1) e f} := by
      have hstabEg : ∀ _ : Unit, Set.MapsTo (heckeOp (M / k.1) k.1) Eg Eg := by
        intro _ x hx
        rw [SetLike.mem_coe, hEgdef, Submodule.mem_iInf] at hx ⊢
        intro r
        exact Module.End.mapsTo_maxGenEigenspace_of_comm
          (heckeOp_mul_comm hL r.2.1 hpp) (ψ r) (hx r)
      refine le_trans (le_of_eq (eq_iSup_inf_iInf_maxGenEigenspace_of_mapsTo
        (fun _ : Unit => heckeOp (M / k.1) k.1) (fun _ _ => Commute.refl _) Eg hstabEg)) ?_
      refine iSup_le fun lam => ?_
      by_cases hbot : (Eg ⊓
          ⨅ _ : Unit, (heckeOp (M / k.1) k.1).maxGenEigenspace (lam ())) = ⊥
      · rw [hbot]; exact bot_le
      set ψ' : {q : ℕ // q.Prime ∧ ¬ q ∣ M / k.1} → ℂ :=
        fun q => if h : q.1 ∣ M then lam () else ψ ⟨q.1, q.2.1, h⟩ with hψ'
      have hsub : (Eg ⊓
            ⨅ _ : Unit, (heckeOp (M / k.1) k.1).maxGenEigenspace (lam ())) ≤
          heckeGoodEigenspace (M / k.1) ψ' := by
        intro x hx
        obtain ⟨hx1, hx2⟩ := Submodule.mem_inf.mp hx
        rw [hEgdef, Submodule.mem_iInf] at hx1
        rw [Submodule.mem_iInf] at hx2
        rw [heckeGoodEigenspace, Submodule.mem_iInf]
        intro r
        by_cases hrM : r.1 ∣ M
        · have hrp : r.1 = k.1 := by
            by_contra hne
            refine r.2.2 ?_
            have hcop : Nat.Coprime r.1 k.1 := (Nat.coprime_primes r.2.1 hpp).mpr hne
            have h1 : r.1 ∣ k.1 * (M / k.1) := by rw [Nat.mul_div_cancel' hpd]; exact hrM
            exact hcop.dvd_of_dvd_mul_left h1
          have hval : ψ' r = lam () := dif_pos hrM
          rw [hval, hrp]
          exact hx2 ()
        · have hval : ψ' r = ψ ⟨r.1, r.2.1, hrM⟩ := dif_neg hrM
          rw [hval]
          exact hx1 ⟨r.1, r.2.1, hrM⟩
      have hEne' : heckeGoodEigenspace (M / k.1) ψ' ≠ ⊥ := by
        intro h
        exact hbot (le_bot_iff.mp (h ▸ hsub))
      obtain ⟨N', hN', hN'L, f', hf', hf'ψ⟩ :=
        exists_isWeightTwoNewform_of_heckeGoodEigenspace_ne_bot hL hEne'
      have hagree : ∀ q : ℕ, q.Prime → ¬ q ∣ M → qCoeff N f q = qCoeff N' f' q := by
        intro q hq hqM
        have hqL : ¬ q ∣ M / k.1 := fun h => hqM (h.trans (Nat.div_dvd_of_dvd hpd))
        have h2 := hf'ψ ⟨q, hq, hqL⟩
        have hval : ψ' ⟨q, hq, hqL⟩ = ψ ⟨q, hq, hqM⟩ := dif_neg hqM
        rw [hval] at h2
        rw [hfψ ⟨q, hq, hqM⟩, h2]
      obtain ⟨hNN, hcoef⟩ := eq_of_isWeightTwoNewform_qCoeff_eq_of_not_dvd hM hNM hf
        (hN'L.trans (Nat.div_dvd_of_dvd hpd)) hf' hagree
      subst hNN
      have hff : f = f' := cuspForm_eq_of_forall_qCoeff_eq hcoef
      subst hff
      exact le_trans hsub (ih (M / k.1) hLlt hL ψ' N hN hN'L f hf' hf'ψ)
    have hmapB : Submodule.map (degeneracyOp (M / k.1) M k.1)
        (Submodule.span ℂ {v : CuspForm (Gamma0GL (M / k.1)) 2 |
          ∃ e : ℕ, e * N ∣ M / k.1 ∧ v = degeneracyOp N (M / k.1) e f}) ≤
        Submodule.span ℂ
          {u : CuspForm (Gamma0GL M) 2 | ∃ d : ℕ, d * N ∣ M ∧ u = degeneracyOp N M d f} := by
      rw [Submodule.map_span]
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨y, ⟨e, he, rfl⟩, rfl⟩
      rcases Nat.eq_zero_or_pos e with rfl | he0
      · rw [Nat.zero_mul, Nat.zero_dvd] at he
        exact absurd he hL.ne'
      · rw [degeneracyOp_degeneracyOp he0 hpp.pos he hpL f]
        refine Submodule.subset_span ⟨k.1 * e, ?_, rfl⟩
        refine dvd_trans ?_ hpL
        rw [mul_assoc]
        exact Nat.mul_dvd_mul_left _ he
    exact hmapB ⟨w, hkey hwEg, rfl⟩
  have hu₁B : u - qCoeff M u 1 • degeneracyOp N M 1 f ∈ Submodule.span ℂ
      {u : CuspForm (Gamma0GL M) 2 | ∃ d : ℕ, d * N ∣ M ∧ u = degeneracyOp N M d f} :=
    (iSup_le hUle) hsplit
  have huEq : u = (u - qCoeff M u 1 • degeneracyOp N M 1 f)
      + qCoeff M u 1 • degeneracyOp N M 1 f := by abel
  rw [huEq]
  exact add_mem hu₁B (Submodule.smul_mem _ _ h1B)

/-- **A NONZERO GOOD EIGENSPACE IS AN OLDFORM BLOCK** (PROVEN 2026-07-27 over the
single leaf `eq_of_isWeightTwoNewform_qCoeff_eq_of_not_dvd`, i.e. over STRONG
MULTIPLICITY ONE; the FIFTEENTH decomposition's remaining node): a joint eigenspace
`E ψ` of the GOOD Hecke operators which contains a nonzero vector is spanned by the
degeneracy translates `V_d f = f(dz)`, `d ∣ M/N`, of a SINGLE form `f` at a divisor
level `N ∣ M`, and the deepest translate `V_{M/N} f` lies in `E ψ`.

This is Atkin–Lehner theory (Atkin–Lehner 1970; Diamond–Shurman Theorems 5.7.1,
5.8.1–3; Miyake §4.6) in the precise form the cyclicity argument consumes.  The
`f` produced is the NEWFORM of level `N` whose away-from-`M` eigensystem is `ψ`
(`exists_isWeightTwoNewform_of_heckeGoodEigenspace_ne_bot` — this half needs NO
Atkin–Lehner input); `V_{M/N} f ∈ E ψ` is `degeneracyOp_mem_heckeGoodEigenspace`;
and the CONTAINMENT is `heckeGoodEigenspace_le_span_degeneracyOp`, the induction on
the level, whose one external input is strong multiplicity one.  The section header
above documents the five steps and the index-set subtlety that makes the induction
close.

FAITHFULNESS.  The `v ≠ 0` hypothesis is not decoration: at `E ψ = ⊥` the
statement is discharged by `N = M`, `f = 0` and carries nothing, and the consumer
`exists_heckeCyclicVector_jointEigenspace` handles that case itself so that this
node is never invoked vacuously.  The conclusion quantifies over ALL of `E ψ`, so
no choice of `f` discharges it for free. -/
theorem exists_degeneracyBlock_heckeGoodEigenspace {M : ℕ} (hM : 0 < M)
    (ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ) {v : CuspForm (Gamma0GL M) 2}
    (hv : v ∈ heckeGoodEigenspace M ψ) (hv0 : v ≠ 0) :
    ∃ N : ℕ, 0 < N ∧ N ∣ M ∧ ∃ f : CuspForm (Gamma0GL N) 2,
      degeneracyOp N M (M / N) f ∈ heckeGoodEigenspace M ψ ∧
      heckeGoodEigenspace M ψ ≤
        Submodule.span ℂ
          {u : CuspForm (Gamma0GL M) 2 |
            ∃ d : ℕ, d ∣ M / N ∧ u = degeneracyOp N M d f} := by
  have hEne : heckeGoodEigenspace M ψ ≠ ⊥ := (Submodule.ne_bot_iff _).mpr ⟨v, hv, hv0⟩
  obtain ⟨N, hN, hNM, f, hf, hfψ⟩ :=
    exists_isWeightTwoNewform_of_heckeGoodEigenspace_ne_bot hM hEne
  have hd : 0 < M / N := Nat.div_pos (Nat.le_of_dvd hM hNM) hN
  have hdvd : (M / N) * N ∣ M := by rw [Nat.div_mul_cancel hNM]
  refine ⟨N, hN, hNM, f,
    degeneracyOp_mem_heckeGoodEigenspace hM hN hd hdvd hf.toIsWeightTwoEigenform hfψ, ?_⟩
  refine le_trans (heckeGoodEigenspace_le_span_degeneracyOp M hM ψ N hN hNM f hf hfψ) ?_
  refine Submodule.span_mono ?_
  rintro x ⟨d, hdd, rfl⟩
  exact ⟨d, (Nat.dvd_div_iff_mul_dvd hNM).mpr (by rwa [mul_comm] at hdd), rfl⟩

/-- **EACH GOOD EIGENSPACE IS CYCLIC OVER `𝕋`** (PROVEN over the single leaf
`exists_degeneracyBlock_heckeGoodEigenspace`): the block is generated by the
deepest degeneracy translate, by the elementary descent
`degeneracyOp_mem_heckeOrbitSpan`.  The zero block is discharged here with the
generator `0`. -/
theorem exists_heckeCyclicVector_jointEigenspace {M : ℕ} (hM : 0 < M)
    (ψ : {q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ) :
    ∃ g ∈ heckeGoodEigenspace M ψ,
      heckeGoodEigenspace M ψ ≤ heckeOrbitSpan M g := by
  classical
  by_cases hbot : heckeGoodEigenspace M ψ = ⊥
  · exact ⟨0, hbot ▸ Submodule.zero_mem _, by rw [hbot]; exact bot_le⟩
  obtain ⟨v, hv, hv0⟩ := (Submodule.ne_bot_iff _).mp hbot
  obtain ⟨N, hN, hNM, f, hmem, hle⟩ :=
    exists_degeneracyBlock_heckeGoodEigenspace hM ψ hv hv0
  refine ⟨degeneracyOp N M (M / N) f, hmem, le_trans hle ?_⟩
  refine Submodule.span_le.mpr ?_
  rintro u ⟨d, hd, rfl⟩
  obtain ⟨k, hk⟩ := hd
  exact degeneracyOp_mem_heckeOrbitSpan hN hM hNM f k d hk.symm

/-- **`S₂(Γ₀(M))` HAS A HECKE-CYCLIC VECTOR** (PROVEN 2026-07-27, the FIFTEENTH
decomposition, over the single leaf `exists_degeneracyBlock_heckeGoodEigenspace`
— formerly the sorry leaf of the fourteenth): some cusp form `f₀` has the
property that the `ℂ`-span of its `𝕋_ℚ`-orbit is all of `S₂(Γ₀(M))`.

THIS IS THE WHOLE ARITHMETIC CONTENT of the Frobenius/Gorenstein cluster,
and it contains NO Galois theory, NO modular curve, NO tensor product and
no `ℚ̄_p`. Everything above it in that cluster — the Frobenius form over
`ℂ`, the Frobenius form over `ℚ`, the Frobenius form over `ℚ̄_p`, and the
four pairing fields of `ModularTateGaloisData` — is now glue over this one
statement about cusp forms.

WHAT IT SAYS CLASSICALLY. Since `ℂ ⊗_ℚ 𝕋_ℚ` acts through `ℂ`-linear
combinations of elements of `𝕋_ℚ` (`heckeRealC`), the conclusion is
precisely that `S₂(Γ₀(M))` is a CYCLIC module over `𝕋_ℂ`; with
`dim_ℂ 𝕋_ℂ = dim_ℂ S₂` (the perfect `q`-expansion pairing, Diamond–Shurman
§5.5) that is

  **`S₂(Γ₀(M))` is FREE OF RANK ONE over `𝕋`**

— the Gorenstein/multiplicity-one property of the Hecke algebra (Mazur,
*Modular curves and the Eisenstein ideal*, ch. II §15; Ribet, *Invent.
Math.* 100 (1990), §2). It is **item 7** of the seven-theory list in
`ModularTateGaloisData`, and it is now separated from items 4 and 6 (the
geometry of `X₀(M)`) by the twelfth and thirteenth decompositions and
from all base-field bookkeeping by the fourteenth.

THE ROUTE — FOLLOWED, 2026-07-27; what follows is now a description of the
proof above rather than of a plan, and its one unrealized step is exactly
`exists_degeneracyBlock_heckeGoodEigenspace`.  The separation of the blocks
("the blocks are separated by the `T_n` with `(n,M) = 1`") is `sepFactor` /
`sepOp`; the block cyclicity computation ("the iterates of `U_q` on `f(q^r z)`
run through a basis") is `heckeOp_degeneracyOp_mul_left` and
`degeneracyOp_mem_heckeOrbitSpan`; "a sum of the block generators is a cyclic
vector" is the assembly below.  What is NOT proven here is that the blocks are
what Atkin–Lehner says they are, which is the leaf.  By Atkin–Lehner,
`S₂(Γ₀(M))` decomposes into oldform blocks, one per newform `f` of level
`N ∣ M`, the block spanned by the `f(dz)`, `d ∣ M/N`. On such a block the
image of `𝕋` is generated by the `U_q` for `q ∣ M/N`, and the block is
CYCLIC over that image with generator `f((M/N)z)`: for a single prime
power `M = Nq^r` this is the computation `U_q · f(q^j z) = f(q^{j−1} z)`
(together with `U_q f = a_q f − q f(qz)`), whose iterates on `f(q^r z)`
run through a basis. The blocks are separated by the `T_n` with
`(n, M) = 1` (strong multiplicity one), so a sum of the block generators
is a cyclic vector for the whole space. The file already carries the
oldform/degeneracy apparatus this needs — `degeneracyOp`,
`qCoeff_degeneracyOp`, `qCoeff_eq_zero_of_mem_oldSubspace`,
`qCoeff_heckeOp` — and the eigenform separation lemmas
(`qCoeff_eq_qCoeff_one_mul_of_heckeOp_eigen` and its coprime variant).

NON-VACUITY, and it is genuine. `M = 1` is the one degenerate case and it
is honest rather than vacuous: `S₂(Γ₀(1)) = 0`, so `f₀ = 0` discharges it.
As soon as `dim_ℂ S₂ ≥ 2` the statement has real content — an arbitrary
`f₀` does NOT work, since a Hecke EIGENFORM spans only its own line under
`𝕋`, so a cyclic vector must meet every block. And it is exactly the
input that FAILS for the mod-`p` Hecke algebra in the cases where
multiplicity one is known to fail, which is why no soft argument can
replace it.

NOT REFUTABLE BY A JUNK WITNESS. The conclusion quantifies over ALL `f`,
so no choice of `f₀` discharges it for free; and the span is taken over
`ℂ` of the orbit under the RATIONAL algebra, which is the correct object
— taking the span over `ℚ` would be false for dimension reasons alone. -/
theorem exists_heckeCyclicVector {M : ℕ} (hM : 0 < M) :
    ∃ f₀ : CuspForm (Gamma0GL M) 2,
      ∀ f : CuspForm (Gamma0GL M) 2,
        f ∈ Submodule.span ℂ
          {g : CuspForm (Gamma0GL M) 2 |
            ∃ T ∈ modularHeckeAlgebraQ M,
              g = (T : Module.End ℂ (CuspForm (Gamma0GL M) 2)) f₀} := by
  classical
  haveI : FiniteDimensional ℂ (CuspForm (Gamma0GL M) 2) :=
    cuspForm_finiteDimensional M hM
  -- one generator per good eigensystem
  choose g hg hgle using fun ψ => exists_heckeCyclicVector_jointEigenspace hM ψ
  have htop := iSup_heckeGoodEigenspace_eq_top hM
  -- finitely many eigensystems already fill the (finite-dimensional) space
  obtain ⟨B, hB⟩ :=
    IsNoetherian.noetherian (R := ℂ) (M := CuspForm (Gamma0GL M) 2) ⊤
  have hmemB : ∀ t : CuspForm (Gamma0GL M) 2,
      ∃ s : Finset ({q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ),
        t ∈ ⨆ ψ ∈ s, heckeGoodEigenspace M ψ := fun t =>
    Submodule.mem_iSup_iff_exists_finset.mp (by rw [htop]; trivial)
  choose sf hsf using hmemB
  set s : Finset ({q : ℕ // q.Prime ∧ ¬ q ∣ M} → ℂ) := B.biUnion sf
  have hstop : (⨆ ψ ∈ s, heckeGoodEigenspace M ψ) = ⊤ := by
    refine le_antisymm le_top ?_
    rw [← hB]
    refine Submodule.span_le.mpr ?_
    intro t ht
    have hsub : sf t ⊆ s :=
      Finset.subset_biUnion_of_mem sf (Finset.mem_coe.mp ht)
    have hmono : (⨆ ψ ∈ sf t, heckeGoodEigenspace M ψ)
        ≤ ⨆ ψ ∈ s, heckeGoodEigenspace M ψ :=
      iSup_le fun ψ => iSup_le fun hψ => le_iSup_of_le ψ (le_iSup_of_le (hsub hψ) le_rfl)
    exact hmono (hsf t)
  -- the cyclic vector is the SUM of the block generators
  refine ⟨∑ ψ ∈ s, g ψ, fun f => ?_⟩
  set f₀ : CuspForm (Gamma0GL M) 2 := ∑ ψ ∈ s, g ψ with hf₀
  have hgmem : ∀ ψ ∈ s, g ψ ∈ heckeOrbitSpan M f₀ := by
    intro ψ hψ
    -- Lagrange interpolation in the good Hecke operators recovers `g ψ` from `f₀`
    set l := s.toList.erase ψ with hl
    have hlne : ∀ x ∈ l, ψ ≠ x := by
      intro x hx
      have hx' := (List.Nodup.mem_erase_iff s.nodup_toList).mp hx
      exact fun h => hx'.1 h.symm
    have h0 : ∀ b ∈ s, b ≠ ψ → sepOp M ψ l (g b) = 0 := by
      intro b hb hbne
      refine sepOp_apply_other hM l hlne ?_ (hg b)
      rw [hl, List.Nodup.mem_erase_iff s.nodup_toList]
      exact ⟨hbne, Finset.mem_toList.mpr hb⟩
    have h1 : ψ ∉ s → sepOp M ψ l (g ψ) = 0 := fun h => absurd hψ h
    have hLf : sepOp M ψ l f₀ = g ψ := by
      rw [hf₀, map_sum, Finset.sum_eq_single ψ h0 h1]
      exact sepOp_apply_self hM l hlne (hg ψ)
    rw [← hLf]
    exact apply_mem_heckeOrbitSpan f₀ (sepOp_mem_heckeAlgC M ψ l)
  have hle : (⊤ : Submodule ℂ (CuspForm (Gamma0GL M) 2)) ≤ heckeOrbitSpan M f₀ := by
    rw [← hstop]
    exact iSup_le fun ψ => iSup_le fun hψ =>
      le_trans (hgle ψ) (heckeOrbitSpan_mono (hgmem ψ hψ))
  exact hle Submodule.mem_top

/-- Cyclicity restated through the realization (PROVEN): the set of
values `heckeRealC M a f₀` is a `ℂ`-submodule containing the `𝕋_ℚ`-orbit
of `f₀`, hence contains its span. -/
theorem exists_heckeRealC_apply {M : ℕ} (hM : 0 < M) :
    ∃ f₀ : CuspForm (Gamma0GL M) 2,
      ∀ f : CuspForm (Gamma0GL M) 2,
        ∃ a : ℂ ⊗[ℚ] ↥(modularHeckeAlgebraQ M), heckeRealC M a f₀ = f := by
  obtain ⟨f₀, hf₀⟩ := exists_heckeCyclicVector hM
  refine ⟨f₀, fun f => ?_⟩
  set N : Submodule ℂ (CuspForm (Gamma0GL M) 2) :=
    { carrier := {g | ∃ a : ℂ ⊗[ℚ] ↥(modularHeckeAlgebraQ M), heckeRealC M a f₀ = g}
      zero_mem' := ⟨0, by simp⟩
      add_mem' := by
        rintro x y ⟨a, rfl⟩ ⟨b, rfl⟩
        exact ⟨a + b, by simp⟩
      smul_mem' := by
        rintro c x ⟨a, rfl⟩
        exact ⟨c • a, by simp⟩ } with hN
  have hle : Submodule.span ℂ
      {g : CuspForm (Gamma0GL M) 2 |
        ∃ T ∈ modularHeckeAlgebraQ M,
          g = (T : Module.End ℂ (CuspForm (Gamma0GL M) 2)) f₀} ≤ N := by
    refine Submodule.span_le.mpr ?_
    rintro g ⟨T, hT, rfl⟩
    exact ⟨(1 : ℂ) ⊗ₜ[ℚ] ⟨T, hT⟩, by rw [heckeRealC_one_tmul]⟩
  exact hle (hf₀ f)

/-- **`ℂ ⊗_ℚ 𝕋_ℚ` IS A FROBENIUS `ℂ`-ALGEBRA** (PROVEN, the FOURTEENTH
decomposition, 2026-07-27), as glue over `exists_heckeCyclicVector`.

The form is `θ (a) = a₁ (a · f₀)` — the first `q`-expansion coefficient of
the image of a cyclic vector, i.e. the `q`-EXPANSION PAIRING evaluated at
`f₀`. Nondegeneracy is the two classical facts of this file combined with
cyclicity:

* every coefficient functional `a_m` is `a₁ ∘ S` for a single
  `S ∈ 𝕋_ℤ ⊆ 𝕋_ℚ` (`exists_mem_heckeSubring_qCoeff`,
  `heckeSubring_le_modularHeckeAlgebraQ`), so `θ (a · b) = 0` for all `b`
  forces every coefficient of `a · (b · f₀)` to vanish — here
  commutativity of `ℂ ⊗_ℚ 𝕋_ℚ` is what moves `S` past `a`;
* a cusp form with all `q`-coefficients zero is zero
  (`cuspForm_eq_of_forall_qCoeff_eq`), so `a` kills `𝕋_ℚ · f₀`, hence by
  cyclicity all of `S₂`, hence `a = 0` by `heckeRealC_injective`.

So the Frobenius property over `ℂ` is cyclicity plus the `q`-expansion
principle, with no further arithmetic input. -/
theorem exists_frobeniusForm_modularHeckeAlgebraC {M : ℕ} (hM : 0 < M) :
    ∃ Θ : ℂ ⊗[ℚ] ↥(modularHeckeAlgebraQ M) →ₗ[ℂ] ℂ,
      ∀ a : ℂ ⊗[ℚ] ↥(modularHeckeAlgebraQ M),
        (∀ b : ℂ ⊗[ℚ] ↥(modularHeckeAlgebraQ M), Θ (a * b) = 0) → a = 0 := by
  classical
  obtain ⟨f₀, hf₀⟩ := exists_heckeRealC_apply hM
  refine ⟨(qCoeffL M 1).comp
    (((LinearMap.applyₗ (R := ℂ) f₀)).comp (heckeRealC M).toLinearMap), ?_⟩
  intro a ha
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.applyₗ_apply_apply,
    AlgHom.toLinearMap_apply, qCoeffL_apply] at ha
  have hzero : ∀ f : CuspForm (Gamma0GL M) 2, heckeRealC M a f = 0 := by
    intro f
    obtain ⟨c, hc⟩ := hf₀ f
    rw [← hc]
    refine cuspForm_eq_of_forall_qCoeff_eq (g := 0) fun m => ?_
    rw [qCoeff_zero_cuspForm]
    obtain ⟨S, hS, hSe⟩ := exists_mem_heckeSubring_qCoeff hM m
    have hS' : S ∈ modularHeckeAlgebraQ M :=
      heckeSubring_le_modularHeckeAlgebraQ hM S hS
    rw [hSe]
    have hkey : S (heckeRealC M a (heckeRealC M c f₀))
        = heckeRealC M (a * (((1 : ℂ) ⊗ₜ[ℚ] (⟨S, hS'⟩ :
            ↥(modularHeckeAlgebraQ M))) * c)) f₀ := by
      have h1 : heckeRealC M (a * (((1 : ℂ) ⊗ₜ[ℚ] (⟨S, hS'⟩ :
            ↥(modularHeckeAlgebraQ M))) * c))
          = heckeRealC M ((((1 : ℂ) ⊗ₜ[ℚ] (⟨S, hS'⟩ :
            ↥(modularHeckeAlgebraQ M)))) * (a * c)) := by
        congr 1
        letI : CommRing ↥(modularHeckeAlgebraQ M) := modularHeckeAlgebraQCommRing hM
        ring
      rw [h1, map_mul, map_mul, heckeRealC_one_tmul]
      rfl
    rw [hkey]
    exact ha _
  have hend : heckeRealC M a = 0 := LinearMap.ext fun f => by simp [hzero f]
  exact heckeRealC_injective hM (by simpa using hend)

/-- **`𝕋_ℚ` ITSELF IS A FROBENIUS `ℚ`-ALGEBRA** (opened as a sorry leaf
by the THIRTEENTH decomposition, 2026-07-27; **PROVEN the same day by
the FOURTEENTH**, as glue over `exists_frobeniusForm_modularHeckeAlgebraC`
through `exists_frobeniusForm_of_baseChange`): the honest rational Hecke algebra
`modularHeckeAlgebraQ M ⊆ End_ℂ S₂(Γ₀(M))` carries a `ℚ`-linear
functional whose trace form `(a, b) ↦ θ(ab)` is nondegenerate.

THIS IS THE SAME MATHEMATICS AS `exists_frobeniusForm_modularTateFrame`
BELOW, WITH `ℚ̄_p` AND THE TENSOR PRODUCT REMOVED. That leaf is now glue
over this one via `tensorFunctional_frobenius`
(`Modularity/HeckeFrameForm.lean`), which base-changes a Frobenius form
along any field extension: pick a `ℚ`-basis `eᵢ` of `𝕋_ℚ` and the family
`tⱼ` dual to it under the (injective, hence bijective) map
`x ↦ θ(x · −) : 𝕋_ℚ → 𝕋_ℚ^∨`; then the `ℚ̄_p`-coordinates of any
`a ∈ ℚ̄_p ⊗ 𝕋_ℚ` are read off as `θ_{ℚ̄_p}(a · (1 ⊗ tⱼ))`, so a killing
`a` is zero. That argument needs `𝕋_ℚ` finite-dimensional
(`finiteDimensional_modularHeckeAlgebraQ`) and commutative
(`modularHeckeAlgebraQ_mul_comm`), both PROVEN.

WHY STATE IT OVER `ℚ` RATHER THAN OVER `ℚ̄_p`. Three reasons, and the
first is the only one that matters mathematically:

1. It is the CLASSICAL statement. "The Hecke algebra is Gorenstein",
   equivalently "`S₂(Γ₀(M))` is free of rank one over `𝕋`", is a
   statement about the rational algebra (Mazur, *Modular curves and the
   Eisenstein ideal*, ch. II §15; Ribet, *Invent. Math.* 100 (1990),
   §2). It is TRUE over `ℚ`: the `q`-expansion pairing
   `𝕋_ℚ × S₂(Γ₀(M); ℚ) → ℚ`, `(T, f) ↦ a₁(Tf)`, is perfect
   (Diamond–Shurman §5.5), so `𝕋_ℚ^∨ ≅ S₂(Γ₀(M); ℚ)`, and freeness of
   rank one identifies that with `𝕋_ℚ`.
2. It is a genuine STRENGTHENING of the `ℚ̄_p` form (base change goes
   only one way, and the reverse — descent of a Frobenius form along a
   field extension — is a separate Zariski-density argument that is NOT
   formalized here; see the note below). Strengthening is sound because
   the strengthened statement is the true classical one.
3. Every object in it is already in this file's cone as a concrete
   definition, with no `AlgebraicClosure ℚ_[p]` instance paths to fight.

HOW IT IS PROVED — and the previous docstring's own recommendation,
now executed. That docstring recorded the `ℂ` side as the natural route
(`modularHeckeAlgebraQ_linearIndependent_complex` embeds `ℂ ⊗_ℚ 𝕋_ℚ`
faithfully in `End_ℂ S₂(Γ₀(M))`, and Atkin–Lehner theory decomposes
`S₂ ⊗ ℂ` into oldform blocks cyclic over the corresponding factors of
`𝕋`), and named the one missing check that would justify taking it:

  *Frobenius descent.* Fix a `k`-basis of `A₀`; `θ ↦ det (θ(eᵢeⱼ))` is a
  homogeneous polynomial function on `A₀^∨ ≅ k^n`, defined over `k` and
  unchanged by base change. A Frobenius form over `K` is a `K`-point
  where it is nonzero, hence the polynomial is not identically zero,
  hence (as `k = ℚ` is infinite) it has a `k`-point where it is nonzero.

**That check is now FORMALIZED**, as `exists_frobeniusForm_of_baseChange`
in `Modularity/HeckeFrameForm.lean`, for an arbitrary finite-dimensional
algebra over an arbitrary infinite field — no commutativity needed. So
this theorem is glue, and the arithmetic has moved to `ℂ`, where the
newform machinery of this file lives:
`exists_frobeniusForm_modularHeckeAlgebraC` just below, itself glue over
the single analytic leaf `exists_heckeCyclicVector`.

Note that descent is the direction that is NOT formal: `tensorFunctional_frobenius`
pushes a Frobenius form UP a field extension by pure algebra, and it is
what `exists_frobeniusForm_modularTateFrame` below uses to reach `ℚ̄_p`
from here. The two together say the Frobenius property of `𝕋_ℚ` is
insensitive to the base field, which is why it was legitimate to state
the classical `ℚ` form and legitimate to prove it over `ℂ`.

NON-VACUITY is inherited verbatim from the leaf below: `θ = 0` fails at
once, and so does any `θ` vanishing on a nonzero ideal, because what is
demanded is nondegeneracy of the TRACE form and not mere non-vanishing
of `θ`. `M = 1` is the one degenerate case and it is honest rather than
vacuous — `S₂(Γ₀(1)) = 0`, so `𝕋_ℚ = 0` and `θ = 0` discharges it. -/
theorem exists_frobeniusForm_modularHeckeAlgebraQ {M : ℕ} (hM : 0 < M) :
    ∃ θ : ↥(modularHeckeAlgebraQ M) →ₗ[ℚ] ℚ,
      ∀ a : ↥(modularHeckeAlgebraQ M),
        (∀ b : ↥(modularHeckeAlgebraQ M), θ (a * b) = 0) → a = 0 := by
  haveI : FiniteDimensional ℚ ↥(modularHeckeAlgebraQ M) :=
    finiteDimensional_modularHeckeAlgebraQ hM
  obtain ⟨Θ, hΘ⟩ := exists_frobeniusForm_modularHeckeAlgebraC hM
  exact exists_frobeniusForm_of_baseChange (F := ℂ) Θ hΘ

/-- **The rational Hecke algebra is a FROBENIUS algebra** (opened as a
sorry leaf by the TWELFTH decomposition, 2026-07-27; PROVEN the same day
as glue over `exists_frobeniusForm_modularHeckeAlgebraQ` above by the
THIRTEENTH): `𝕋_ℚ ⊗ ℚ̄_p` carries a `ℚ̄_p`-linear functional `θ` whose
trace form `(a, b) ↦ θ(ab)` is nondegenerate.

Everything below describes the MATHEMATICS of this statement and is
unchanged; what changed is only where it is now demanded. The content
has moved one step up, to the same statement about `𝕋_ℚ` over `ℚ`, and
this declaration is base change (`tensorFunctional_frobenius`).

THIS IS THE WHOLE OF THE PAIRING SIDE OF `ModularTateGaloisData`, AND IT
CONTAINS NO GALOIS THEORY AND NO MODULAR CURVE. The four fields `pair`,
`pair_self`, `pair_nondeg`, `pair_hecke` of that structure are, by
`frameSymplectic` and its lemmas in `Modularity/HeckeFrame.lean`, exactly
equivalent to this one functional — see the section note there for the
converse direction (an alternating `A`-self-adjoint form on `A²` is
`θ(x₀y₁ − x₁y₀)` for a unique `θ`, and it is nondegenerate iff `θ` is a
Frobenius form). So the cut below loses nothing: it does not weaken the
geometric leaf, it *relocates* four of its nine fields into a statement
about a finite-dimensional commutative algebra.

CLASSICAL CONTENT, and which of the geometric leaf's seven missing
theories this is. Writing `A := 𝕋_ℚ ⊗ ℚ̄_p`, a Frobenius form exists iff
`A ≅ A^∨` as `A`-modules. The `q`-expansion pairing `𝕋 × S₂ → ℚ`,
`(T, f) ↦ a₁(Tf)`, is perfect (Diamond–Shurman §5.5), so `A^∨ ≅ S₂ ⊗ ℚ̄_p`
and the statement is precisely

  **`S₂(Γ₀(M))` is FREE OF RANK ONE over `𝕋`**

— the Gorenstein/multiplicity-one property of the Hecke algebra (Mazur,
*Modular curves and the Eisenstein ideal*, ch. II §15; Ribet, *Invent.
Math.* 100 (1990), §2). That is **item 7** of the list in
`ModularTateGaloisData` ("freeness of `H₁(X₀(M); ℚ)` of rank two over
`𝕋_ℚ`"): over `ℚ̄_p`, `H₁ ⊗ ℚ̄_p` free of rank two over `A` and `S₂ ⊗ ℚ̄_p`
free of rank one are the same statement, since `H₁ ⊗ ℂ ≅ S₂ ⊕ S̄₂` as
Hecke modules. It is **not** items 4 or 6 — no Hecke correspondence over
`ℚ`, and no Eichler–Shimura isomorphism, is needed to state or to prove
it. Splitting it off is the entire point of this decomposition: items 4
and 6 are the geometry of `X₀(M)`, item 7 is commutative algebra plus
the classical `q`-expansion pairing, and until now the three were fused
in one node.

WHY IT IS TRUE, in a form a successor can follow. `A` is a
finite-dimensional commutative `ℚ̄_p`-algebra
(`finiteDimensional_modularHeckeAlgebraQ`), hence a product of local
artinian factors. By Atkin–Lehner, `S₂(Γ₀(M)) ⊗ ℂ` decomposes into
oldform blocks, one per newform `f` of level `N ∣ M`, spanned by the
`f(dz)`, `d ∣ M/N`. On such a block the image of `𝕋` is generated by the
`U_q`, `q ∣ M/N`, and the block is a CYCLIC module over that image with
generator `f((M/N)z)` — for a single prime power `M = Nq^r` this is the
computation `U_q·f(q^jz) = f(q^{j−1}z)` (and `U_q f = a_qf − qf(qz)`),
whose iterates on `f(q^rz)` are a basis. So each block is free of rank
one over its factor of `𝕋`, and the factors are separated by the `T_n`
with `(n, M) = 1` (strong multiplicity one). Summing over blocks gives
`S₂ ≅ 𝕋` and hence `θ`.

NON-VACUITY. `θ = 0` fails at once, and so does any `θ` vanishing on a
nonzero ideal: the hypothesis is nondegeneracy of the TRACE form, not
mere nonzero-ness of `θ`. If `A` had a non-Gorenstein local factor there
would be no such `θ` at all, so this leaf carries genuine arithmetic —
it is exactly the input that fails for the mod-`p` Hecke algebra in the
cases where multiplicity one is known to fail.

NOT A DUPLICATE OF `exists_heckeSubring_zForm` (far above, and under a
live separate owner as of 2026-07-27). That leaf is about the `ℤ`-module
structure of `heckeSubring N ⊆ End_ℂ(S₂)`, and its consumer is
`integralCuspForms_span_eq_top`; this one is about a `ℚ̄_p`-bilinear form
on the base-changed `modularHeckeAlgebraQ M`. They cite adjacent
classical facts and neither implies the other as stated: an integral
spanning set says nothing about nondegeneracy of a trace form, and a
Frobenius form over `ℚ̄_p` says nothing about a `ℤ`-lattice. **The check
that would refute this separation**: exhibit a term of one from the
other without new input. -/
theorem exists_frobeniusForm_modularTateFrame {M : ℕ} (hM : 0 < M) :
    ∃ θ : (AlgebraicClosure ℚ_[p]) ⊗[ℚ] ↥(modularHeckeAlgebraQ M) →ₗ[AlgebraicClosure ℚ_[p]]
        AlgebraicClosure ℚ_[p],
      ∀ a : (AlgebraicClosure ℚ_[p]) ⊗[ℚ] ↥(modularHeckeAlgebraQ M),
        (∀ b : (AlgebraicClosure ℚ_[p]) ⊗[ℚ] ↥(modularHeckeAlgebraQ M),
          θ (a * b) = 0) → a = 0 := by
  haveI : FiniteDimensional ℚ ↥(modularHeckeAlgebraQ M) :=
    finiteDimensional_modularHeckeAlgebraQ hM
  obtain ⟨θ, hθ⟩ := exists_frobeniusForm_modularHeckeAlgebraQ hM
  refine ⟨tensorFunctional (F := AlgebraicClosure ℚ_[p]) θ, ?_⟩
  exact tensorFunctional_frobenius (F := AlgebraicClosure ℚ_[p])
    (fun a b => Subtype.ext (modularHeckeAlgebraQ_mul_comm hM a.1 a.2 b.1 b.2)) θ hθ

/-- **THE ABSTRACT CARRIER** of the sixteenth cut: a `ℚ̄_p`-vector space
of dimension `2·dim_ℚ 𝕋_ℚ`, with no Hecke-module structure built in.

Choosing a `ℚ̄_p`-basis of `V_p(J₀(M)) ⊗ ℚ̄_p` is free information — it is
a finite-dimensional vector space over a field — so naming this concrete
space costs nothing, while `modularTateSpace M = (𝕋_ℚ ⊗ ℚ̄_p)²` costs
item 7 (freeness of rank two over the Hecke algebra). That is exactly the
content the sixteenth cut moves out of the geometry and into
`exists_frameEquiv_of_symplectic`. -/
abbrev modularTateCarrier (M : ℕ) : Type :=
  Fin (2 * Module.finrank ℚ ↥(modularHeckeAlgebraQ M)) → AlgebraicClosure ℚ_[p]

/-!
### Transporting a Hecke-module datum along a linear equivalence

The four lemmas below are what makes it legitimate for the GEOMETRIC leaf
`nonempty_modularTateCarrierData` to be stated on the object the geometry
actually produces — an abstract finite-dimensional `F`-vector space
carrying an action of `F ⊗ₖ T`, with the module clauses demanded only at
a GENERATING SET of `T` — while its consumer
`exists_galoisRep_modularTateCarrier` works with a coordinatized carrier
and needs the clauses for every element of `F ⊗ₖ T`. Two of them widen a
clause from generators to the whole algebra (`commute_act_of_adjoin`,
`selfAdjoint_act_of_adjoin`); two of them move a clause across a linear
equivalence (`symm_conjAlgEquiv_apply`, `nondegenerate_compl₁₂`).

Nothing here is specific to modular curves: `T` is any `k`-algebra and
the "generating set" is any `Sg` with `Algebra.adjoin k Sg = ⊤`. They are
the general-`act` analogues of `commute_frameMul_of_adjoin` in
`Modularity/HeckeFrameForm.lean`, which is the same induction for the
special case where the module is `(F ⊗ₖ T)²` and the action is
multiplication.
-/

section CarrierTransport

variable {k : Type*} [Field k] {F : Type*} [Field F] [Algebra k F]
variable {T : Type*} [Ring T] [Algebra k T]
variable {V : Type*} [AddCommGroup V] [Module F V]
variable {W : Type*} [AddCommGroup W] [Module F W]

/-- **Commutation with an action propagates from a generating set**
(PROVEN): if `Sg` generates `T` as a `k`-algebra and an endomorphism `g`
of `V` commutes with `act (1 ⊗ s)` for every `s ∈ Sg`, then it commutes
with `act r` for every `r : F ⊗ₖ T`.

`adjoin_includeRight_eq_top` transports the generation statement across
the base change; the `algebraMap` case is centrality of scalars. -/
theorem commute_act_of_adjoin (act : (F ⊗[k] T) →ₐ[F] Module.End F V)
    (g : Module.End F V) (Sg : Set T) (hS : Algebra.adjoin k Sg = ⊤)
    (hgen : ∀ s ∈ Sg, act ((1 : F) ⊗ₜ[k] s) * g = g * act ((1 : F) ⊗ₜ[k] s)) :
    ∀ r : F ⊗[k] T, act r * g = g * act r := by
  intro r
  have hr : r ∈ Algebra.adjoin F
      ((Algebra.TensorProduct.includeRight : T →ₐ[k] F ⊗[k] T) '' Sg) := by
    rw [adjoin_includeRight_eq_top Sg hS]; trivial
  induction hr using Algebra.adjoin_induction with
  | mem u hu =>
      obtain ⟨s, hs, rfl⟩ := hu
      exact hgen s hs
  | algebraMap c =>
      rw [AlgHom.commutes]
      exact Algebra.commutes c g
  | add u v _ _ ihu ihv => rw [map_add, add_mul, mul_add, ihu, ihv]
  | mul u v _ _ ihu ihv => rw [map_mul, mul_assoc, ihv, ← mul_assoc, ihu, mul_assoc]

/-- **Self-adjointness for a bilinear form propagates from a generating
set** (PROVEN): if `Sg` generates `T` and every `act (1 ⊗ s)`, `s ∈ Sg`,
is self-adjoint for `P`, then so is `act r` for every `r : F ⊗ₖ T`.

The `mul` case is where the COMMUTATIVITY hypothesis is used and it
cannot be dropped: composing two self-adjoint operators gives an operator
adjoint to the composite in the OPPOSITE order, so the argument needs
`u * v = v * u` to land back on `act (u * v)`. -/
theorem selfAdjoint_act_of_adjoin (hcomm : ∀ x y : F ⊗[k] T, x * y = y * x)
    (act : (F ⊗[k] T) →ₐ[F] Module.End F V)
    (P : V →ₗ[F] V →ₗ[F] F) (Sg : Set T) (hS : Algebra.adjoin k Sg = ⊤)
    (hgen : ∀ s ∈ Sg, ∀ x y : V,
      P (act ((1 : F) ⊗ₜ[k] s) x) y = P x (act ((1 : F) ⊗ₜ[k] s) y)) :
    ∀ (r : F ⊗[k] T) (x y : V), P (act r x) y = P x (act r y) := by
  intro r
  have hr : r ∈ Algebra.adjoin F
      ((Algebra.TensorProduct.includeRight : T →ₐ[k] F ⊗[k] T) '' Sg) := by
    rw [adjoin_includeRight_eq_top Sg hS]; trivial
  induction hr using Algebra.adjoin_induction with
  | mem u hu =>
      obtain ⟨s, hs, rfl⟩ := hu
      exact hgen s hs
  | algebraMap c =>
      intro x y
      have hc : act (algebraMap F (F ⊗[k] T) c) = algebraMap F (Module.End F V) c :=
        AlgHom.commutes _ c
      rw [hc]
      show P (c • x) y = P x (c • y)
      rw [map_smul, LinearMap.smul_apply, LinearMap.map_smul]
  | add u v _ _ ihu ihv =>
      intro x y
      have h1 : act (u + v) x = act u x + act v x := by rw [map_add]; rfl
      have h2 : act (u + v) y = act u y + act v y := by rw [map_add]; rfl
      rw [h1, h2, map_add, LinearMap.add_apply, map_add, ihu, ihv]
  | mul u v _ _ ihu ihv =>
      intro x y
      have h1 : act (u * v) x = act u (act v x) := by rw [map_mul]; rfl
      have h2 : act (u * v) y = act v (act u y) := by
        rw [hcomm u v, map_mul]; rfl
      rw [h1, h2, ihu, ihv]

/-- **Conjugation, read backwards** (PROVEN): `e.symm` intertwines the
conjugated endomorphism with the original one. This is the identity every
transport step of the seventeenth cut runs on, and it is `rfl` after
`e.symm_apply_apply`. -/
theorem symm_conjAlgEquiv_apply (e : V ≃ₗ[F] W) (g : Module.End F V) (z : W) :
    e.symm (LinearEquiv.conjAlgEquiv F e g z) = g (e.symm z) := by
  show e.symm (e (g (e.symm z))) = g (e.symm z)
  rw [e.symm_apply_apply]

/-- **Nondegeneracy transports along a linear equivalence** (PROVEN): the
form `(x, y) ↦ P (e⁻¹x) (e⁻¹y)` on `W` is nondegenerate as soon as `P` is
nondegenerate on `V`. -/
theorem nondegenerate_compl₁₂ (e : V ≃ₗ[F] W) (P : V →ₗ[F] V →ₗ[F] F)
    (h : ∀ x : V, (∀ y : V, P x y = 0) → x = 0) :
    ∀ x : W, (∀ y : W,
      (P.compl₁₂ (e.symm : W →ₗ[F] V) (e.symm : W →ₗ[F] V)) x y = 0) → x = 0 := by
  intro x hx
  have h0 : e.symm x = 0 := by
    refine h _ fun z => ?_
    have := hx (e z)
    rwa [LinearMap.compl₁₂_apply, LinearEquiv.coe_coe, e.symm_apply_apply] at this
  have := congrArg e h0
  rwa [e.apply_symm_apply, map_zero] at this

end CarrierTransport

/-- **THE GEOMETRIC DATUM OF THE SEVENTEENTH CUT** (2026-07-28): the
Eichler–Shimura package of level `M`, stated on the object the geometry
actually produces rather than on a coordinatized copy of it.

Relative to `exists_galoisRep_modularTateCarrier` below — which is now
PROVEN glue over `nonempty_modularTateCarrierData` — this carrier differs
in exactly three ways, and all three make the GEOMETRIC obligation
smaller, never larger:

* the carrier `Vp` is an ARBITRARY finite-dimensional `ℚ̄_p`-vector space
  of dimension `2·dim_ℚ 𝕋_ℚ` (intended: `V_p(J₀(M)) ⊗ ℚ̄_p`), not the
  coordinate space `Fin (2·dim 𝕋_ℚ) → ℚ̄_p`. A geometer produces the Tate
  module, not a basis of it; picking the basis is
  `LinearEquiv.ofFinrankEq` and is done once, in the glue;
* `hecke_comm` and `pair_hecke` are demanded only at the PRIME
  GENERATORS `T_q` — which is what the correspondences and the Rosati
  involution give — instead of at every element of `ℚ̄_p ⊗ 𝕋_ℚ`. Widening
  them is `commute_act_of_adjoin` and `selfAdjoint_act_of_adjoin` just
  above, an `Algebra.adjoin` induction over
  `adjoin_modularTateGen_eq_top`;
* the shape now matches `ModularJacobianPackage` above field for field,
  which is the form every other package in this file is written in.

WHAT IT STILL CARRIES, unchanged by the cut: items **4** and **6** of the
list in `ModularTateGaloisData` — Hecke correspondences with `ℚ`-models
(Diamond–Shurman §7.9, §8.5) and the Eichler–Shimura congruence relation
(Igusa; D–S 8.6.1, 8.7.2) — together with the Atkin–Lehner-twisted Weil
pairing on `J₀(M)[p^∞]` and its cyclotomic Frobenius multiplier. **Item 7
is NOT here** (the sixteenth cut removed it; it is
`exists_frobeniusForm_modularHeckeAlgebraQ` plus
`exists_freeElement_of_frobenius`), and neither is any statement about a
basis.

NON-VACUITY, inherited verbatim from the leaf below and re-checked here.
`act_injective` forbids `act = 0`; `τJ = 1` fails `congruence`
(`1 − T_q + q = 0` at every good `q` would force `𝕋_ℚ` to be spanned by
`(1 + q)`, and it fails already at `M = 11`, where `𝕋_ℚ = ℚ` and `a_q` is
unbounded); `pair` is required alternating AND nondegenerate, so `Vp`
really is symplectic; and `finrank_eq` pins the dimension, so the datum
cannot be discharged by a small carrier. -/
structure ModularTateCarrierData (M : ℕ) where
  /-- The Galois module: intended `V_p(J₀(M)) ⊗ ℚ̄_p`. -/
  Vp : Type
  [addCommGroup : AddCommGroup Vp]
  [module : Module (AlgebraicClosure ℚ_[p]) Vp]
  [finiteDimensional : FiniteDimensional (AlgebraicClosure ℚ_[p]) Vp]
  /-- The dimension count: `dim V_p(J₀(M)) = 2·dim J₀(M) = 2·dim_ℚ 𝕋_ℚ`. -/
  finrank_eq : Module.finrank (AlgebraicClosure ℚ_[p]) Vp
    = 2 * Module.finrank ℚ ↥(modularHeckeAlgebraQ M)
  /-- The Hecke action, base-changed to `ℚ̄_p`. -/
  act : ((AlgebraicClosure ℚ_[p]) ⊗[ℚ] ↥(modularHeckeAlgebraQ M)) →ₐ[AlgebraicClosure ℚ_[p]]
    Module.End (AlgebraicClosure ℚ_[p]) Vp
  /-- The Hecke action is FAITHFUL — which is what the geometry gives,
  and is strictly weaker than freeness of rank two. -/
  act_injective : Function.Injective act
  /-- The continuous Galois action on the Tate module. -/
  τJ : GaloisRep ℚ (AlgebraicClosure ℚ_[p]) Vp
  /-- The exceptional set (intended: the places over `Mp`). -/
  S : Finset (HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
  /-- Hecke correspondences are defined over `ℚ`, so `T_q` commutes with
  the whole Galois action. -/
  hecke_comm : ∀ (q : ℕ), q.Prime → ∀ γ : Field.absoluteGaloisGroup ℚ,
    act ((1 : AlgebraicClosure ℚ_[p]) ⊗ₜ[ℚ] modularTateGen M q) * τJ γ =
      τJ γ * act ((1 : AlgebraicClosure ℚ_[p]) ⊗ₜ[ℚ] modularTateGen M q)
  /-- The Eichler–Shimura congruence relation at good primes. -/
  congruence : ∀ (q : ℕ) (hq : q.Prime),
    hq.toHeightOneSpectrumRingOfIntegersRat ∉ S →
    τJ (globalFrob hq.toHeightOneSpectrumRingOfIntegersRat) ^ 2
      - act ((1 : AlgebraicClosure ℚ_[p]) ⊗ₜ[ℚ] modularTateGen M q) *
        τJ (globalFrob hq.toHeightOneSpectrumRingOfIntegersRat)
      + (q : AlgebraicClosure ℚ_[p]) • 1 = 0
  /-- The Atkin–Lehner-twisted Weil pairing. -/
  pair : Vp →ₗ[AlgebraicClosure ℚ_[p]] Vp →ₗ[AlgebraicClosure ℚ_[p]] AlgebraicClosure ℚ_[p]
  /-- The pairing is alternating. -/
  pair_self : ∀ x : Vp, pair x x = 0
  /-- The pairing is nondegenerate. -/
  pair_nondeg : ∀ x : Vp, (∀ y : Vp, pair x y = 0) → x = 0
  /-- The Hecke operators are self-adjoint for the twisted pairing. -/
  pair_hecke : ∀ (q : ℕ), q.Prime → ∀ x y : Vp,
    pair (act ((1 : AlgebraicClosure ℚ_[p]) ⊗ₜ[ℚ] modularTateGen M q) x) y =
      pair x (act ((1 : AlgebraicClosure ℚ_[p]) ⊗ₜ[ℚ] modularTateGen M q) y)
  /-- Galois Frobenii off `S` scale the pairing by `q`. -/
  pair_frob : ∀ (q : ℕ) (hq : q.Prime),
    hq.toHeightOneSpectrumRingOfIntegersRat ∉ S →
    ∀ x y : Vp,
      pair (τJ (globalFrob hq.toHeightOneSpectrumRingOfIntegersRat) x)
          (τJ (globalFrob hq.toHeightOneSpectrumRingOfIntegersRat) y) =
        (q : AlgebraicClosure ℚ_[p]) * pair x y

attribute [instance] ModularTateCarrierData.addCommGroup
  ModularTateCarrierData.module ModularTateCarrierData.finiteDimensional

