    have hJ' : J ∈ (Ideal (𝓞 CF))⁰ := mem_nonZeroDivisors_iff_ne_zero.mpr hJ
    have hIJ' : I * J ∈ (Ideal (𝓞 CF))⁰ := mul_mem hI' hJ'
