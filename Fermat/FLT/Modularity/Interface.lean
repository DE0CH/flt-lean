    have hε₂10 : (ε₂ : Matrix (Fin 2) (Fin 2) ℤ) 1 0 = (q : ℤ) * kk := by
      rw [hε₂, hkk]
      simp [Matrix.SpecialLinearGroup.coe_mul, hW, hρmat, Matrix.mul_apply,
