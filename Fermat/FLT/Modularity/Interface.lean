    {kk' : Type u} [Field kk'] [Finite kk'] [Algebra ℤ_[p] kk'] [CharP kk' p]
    (χ : Field.absoluteGaloisGroup ℚ →* kk')
    (hχcyc : ∀ g : Field.absoluteGaloisGroup ℚ, χ g =
      algebraMap ℤ_[p] kk'
        (cyclotomicCharacter (AlgebraicClosure ℚ) p g.toRingEquiv))
