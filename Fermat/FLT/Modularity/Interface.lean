      have hjq : ((j : ℕ) : ℤ) < q := by exact_mod_cast j.isLt
      have hkq : ((k : ℕ) : ℤ) < q := by exact_mod_cast k.isLt
      have hj0 : (0 : ℤ) ≤ ((j : ℕ) : ℤ) := Int.natCast_nonneg _
      have hk0 : (0 : ℤ) ≤ ((k : ℕ) : ℤ) := Int.natCast_nonneg _
