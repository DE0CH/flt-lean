      rw [hmul] at h
      have hd := (hGpiff _ (heckeTMat_mem_Gamma0 M _)).mp h
      have hd' : (q : ℤ) ∣ ((k : ℕ) : ℤ) - ((j : ℕ) : ℤ) := by simpa [heckeTMat] using hd
