      (∀ g x, e₁ ((ρ₁.baseChange (AlgebraicClosure ℚ_[p])) g x) =
        (ρO.baseChange (AlgebraicClosure ℚ_[p])) g (e₁ x)) →
      v₁ ≠ 0 →
