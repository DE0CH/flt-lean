      Set (Field.absoluteGaloisGroup ℚ)) := by
    haveI : NeZero p := ⟨hp.out.ne_zero⟩
    haveI : Finite ((rootsOfUnity p (AlgebraicClosure ℚ) :
        Set (AlgebraicClosure ℚ)ˣ)) :=
      inferInstanceAs (Finite (rootsOfUnity p (AlgebraicClosure ℚ)))
