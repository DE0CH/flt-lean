    have h3 : (q : ℤ) ∣ 1 := ⟨t, h2⟩
    have h4 := Int.le_of_dvd one_pos h3
    have h5 : (2 : ℤ) ≤ (q : ℤ) := by exact_mod_cast hq.two_le
