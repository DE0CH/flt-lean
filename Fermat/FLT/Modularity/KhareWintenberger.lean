      funext i
      show φ (a • v i) = a • φ (v i)
      exact map_smul (divisibleTensorEquiv D).symm a (v i)
    have h : e (fun i => φ ((a • v) i)) = m.act a (e fun i => φ (v i)) := by
      rw [hfun]; exact hact a _
    exact h
