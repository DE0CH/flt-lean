theorem exists_bound_forall_irreducibleFibre_of_irreducibleGeometricGenericFibre
    {n m : ℕ} (f : Fin m → MvPolynomial (Fin n) ℤ)
    (hsm : Algebra.FormallySmooth ℚ (IntegralSystemModel f ℚ))
