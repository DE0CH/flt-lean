    | zero => rw [smul_zero, hact0]; exact hzeroι
    | tmul b y => rw [TensorProduct.smul_tmul']; exact hactι a b y
    | add x y hx hy =>
      rw [smul_add, haddι', hx, hy, haddι' x y]
