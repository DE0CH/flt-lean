      AlgebraicGeometry.SmoothOfRelativeDimension (Module.finrank ℚ D) fB ∧
      (∀ v w, e (v + w) = abB.add (e v) (e w)) ∧
      (∀ (a : NumberField.RingOfIntegers D) v, e (a • v) = m.act a (e v)) ∧
