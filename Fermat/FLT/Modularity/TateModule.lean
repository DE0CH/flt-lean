  · intro k σ t t' s s' ht' hs'
    exact Ideal.pow_le_pow_right (hNge k) (hgal (Nn k) σ t t' s s' ht' hs')
  · intro k t t' s s' hts hss
    exact hcont (Nn k) k (hNge k) t t' s s' hts hss
