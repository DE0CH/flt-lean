  obtain ⟨q0, hTWq⟩ := exists_taylorWilesPrimeSet_card_eq p ρbar hTW
  obtain ⟨tw⟩ := exists_taylorWilesTower.{s, t, uK, uW, uR} hpodd hp5 hW hρbar hirr
