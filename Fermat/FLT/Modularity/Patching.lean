    [IsLocalRing R] [Algebra ℤ_[p] R]
    {V : Type a} [AddCommGroup V] [Module R V] [Module.Finite R V]
    [Module.Free R V] (hV : Module.rank R V = 2)
    {ρ : GaloisRep ℚ R V} (πR : R →+* k) (hπcont : Continuous πR)
