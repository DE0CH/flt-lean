      intro σ hσ
      refine hmemJ _ (hcancel _ _ _ hu ?_)
      rw [hrel1 σ, hδone σ hσ]
    · right
      intro σ hσ
      refine hmemJ _ (hcancel _ _ _ hu ?_)
      rw [hrel2 σ, hδone σ hσ]
