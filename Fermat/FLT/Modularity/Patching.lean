lemma charFrob_pushforwardFrame.{u} {B : Type u} [CommRing B]
    [TopologicalSpace B] [IsTopologicalRing B] {A : Type u} [CommRing A]
    [TopologicalSpace A] [IsTopologicalRing A] (ψ : B →+* A)
