          map_one' := by rw [hδ'one, map_one]
          map_mul' := fun g h => by rw [hδ'mul, map_mul] }
      continuous_toFun := (IsModuleTopology.continuous_of_linearMap
        (Algebra.linearMap R (Module.End R R))).comp hδ'cont }, ?_, ?_⟩
