        Submodule (MvPowerSeries (Fin q) ℤ_[p]) L.M))
      ≃ₗ[MvPowerSeries (Fin q) ℤ_[p]]
        (Fin d → MvPowerSeries (Fin q) ℤ_[p] ⧸ taylorWilesAug p q)) :=
    ⟨(Submodule.Quotient.equiv _ _ ecoord hmap).trans g0⟩
