  have hgN : (Field.absoluteGaloisGroup.map (algebraMap ℚ
      (HeightOneSpectrum.adicCompletion ℚ hq.toHeightOneSpectrumRingOfIntegersRat))) σ ∈ N := by
    rw [← hfix, IntermediateField.mem_fixingSubgroup_iff]
