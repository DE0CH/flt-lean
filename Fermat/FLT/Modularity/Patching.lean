    have hrel2 : ∀ g : Field.absoluteGaloisGroup (hq.toHeightOneSpectrumRingOfIntegersRat.adicCompletion ℚ),
        algebraMap R A (δ g) * (Φ u₂).2 = (δA g 1) * (Φ u₂).2 := by
      intro g
