  · refine eq_of_forall_mk_padicTowerIdeal_eq (p := p) fun n => ?_
    have e := RingHom.congr_fun (hψX n).1 r
    simp only [RingHom.comp_apply] at e ⊢
    rw [hΨ n, e]
