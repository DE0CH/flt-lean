      by_contra hc
      rw [not_or] at hc
      have hA : a ∈ IsLocalRing.maximalIdeal A :=
        (IsLocalRing.mem_maximalIdeal _).mpr hc.1
      have hB : b ∈ IsLocalRing.maximalIdeal A :=
        (IsLocalRing.mem_maximalIdeal _).mpr hc.2
