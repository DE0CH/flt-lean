    intro g
    have h := hd g (e'.symm (1, 0))
    rw [e'.apply_symm_apply] at h
    rw [h]; simp
  have hδ'eq : ∀ g, δ' g = (e' (ρ.toLocal v g (e'.symm (0, 1)))).2 := by
    intro g
    have h := hd g (e'.symm (0, 1))
    rw [e'.apply_symm_apply] at h
