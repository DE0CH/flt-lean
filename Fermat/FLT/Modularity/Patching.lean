        algebraMap R (Module.End R R) (δ' g) ((e' y).2))
    simp [Module.algebraMap_end_apply, smul_eq_mul]
  · intro σ hσ
    show algebraMap R (Module.End R R) (δ' σ) = 1
    rw [hI σ hσ, map_one]


