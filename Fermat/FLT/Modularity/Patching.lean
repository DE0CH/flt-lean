    simpa using this
  have hδF : δ F = b := by
    have h1 := hdiag F (e.symm (0, 1))
    have h2 := he (e.symm (0, 1))
    rw [e.apply_symm_apply] at h1 h2
    have := congrArg Prod.snd (h1.symm.trans h2)
    simpa using this
  have hud : IsUnit (χ F - δ F) := by rw [hχF, hδF]; exact hu
