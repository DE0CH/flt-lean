    rw [hyGen (ε₀ z)]
    constructor
    · intro h
      obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp h
      refine AddSubgroup.mem_zmultiples_iff.mpr ⟨k, ?_⟩
      apply ε₀.injective
      rw [map_zsmul, AddEquiv.apply_symm_apply]
      exact hk
    · intro h
      obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp h
      exact AddSubgroup.mem_zmultiples_iff.mpr
        ⟨k, by rw [← hk, map_zsmul, AddEquiv.apply_symm_apply]⟩
  rw [hL, hL2, ← hker', hchar φ' z, ← hφφ' z, hint z]
  constructor
  · intro h
    show ε ((φ : AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) z)
      + ε ((φ : AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) z) = ε z
    rw [← map_add, h]
  · intro h
    apply ε.injective
    rw [map_add]
    exact h

