  have hnot2 : ¬ ((2 : ℤ) ∣ X ∧ (2 : ℤ) ∣ Y) := by
    rintro ⟨⟨k, hk⟩, ⟨l, hl⟩⟩; omega
  have hdiff : Y - X = B := by omega
  have hcopXY : IsCoprime X Y := by
