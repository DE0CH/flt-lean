      (2 * ψ - 1 : WeierstrassCurve.End (E⁄(AlgebraicClosure ℚ)).toAffine) 1 w
    have hB : (2 * ψ - 1 : WeierstrassCurve.End (E⁄(AlgebraicClosure ℚ)).toAffine) + 1
