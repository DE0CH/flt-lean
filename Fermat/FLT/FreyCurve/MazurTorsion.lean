theorem exists_denomNormalForm_thirtySevenB (x y : ℚ)
    (h : y * (y + 20 * x + 296) = x ^ 3) :
    ∃ p q r : ℤ, 0 < r ∧ IsCoprime p r ∧ IsCoprime q r ∧
      x = (p : ℚ) / (r : ℚ) ^ 2 ∧ q * (q + 20 * p * r + 296 * r ^ 3) = p ^ 3 := by
  set P : ℤ := x.num with hP
  set C : ℤ := y.num with hC
  set Q : ℤ := (x.den : ℤ) with hQdef
  set D : ℤ := (y.den : ℤ) with hDdef
  have hQ0 : (0 : ℤ) < Q := by rw [hQdef]; exact_mod_cast x.pos
  have hD0 : (0 : ℤ) < D := by rw [hDdef]; exact_mod_cast y.pos
  have hQQ : ((x.den : ℚ)) ≠ 0 := Nat.cast_ne_zero.mpr x.den_nz
  have hDQ : ((y.den : ℚ)) ≠ 0 := Nat.cast_ne_zero.mpr y.den_nz
  have hxq : (P : ℚ) = x * (x.den : ℚ) := (div_eq_iff hQQ).mp (Rat.num_div_den x)
  have hyd : (C : ℚ) = y * (y.den : ℚ) := (div_eq_iff hDQ).mp (Rat.num_div_den y)
  have hPQ : IsCoprime P Q := by
    rw [hP, hQdef, Int.isCoprime_iff_gcd_eq_one]
    simpa [Int.gcd] using x.reduced
  have hCD : IsCoprime C D := by
    rw [hC, hDdef, Int.isCoprime_iff_gcd_eq_one]
    simpa [Int.gcd] using y.reduced
  -- the equation, cleared of denominators
