  obtain ⟨A, B, s₁, s₂, s₃, hΔ, hj, hs1ne, hE1, hE2, hE3, hΔ', hjq⟩ :=
    E.exists_x0Seven_veluShortQuotient P hP hstable hCfin t w hE' ht hw
  obtain ⟨hQne, h1, h2⟩ :=
    MazurLevelSeven.kernelInvariants_of_relations A B s₁ s₂ hs1ne hΔ hE1 hE2
