    (_hgeom : ∀ x : RelPoint d.f (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))),
      x.1 ≫ v = x.1 → RelPoint.LiesIn d.cyc.ι x) :
    IsFinite (equalizer.ι v (𝟙 d.E) ≫ d.f) :=
