theorem WeierstrassCurve.classPoly676_of_endSq_neg169
    (E : WeierstrassCurve ℚ) [E.IsElliptic]
    (ψ : WeierstrassCurve.End (E⁄(AlgebraicClosure ℚ)).toAffine)
