      ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩ <;> subst h <;> exact ⟨by norm_num, by norm_num⟩
  obtain ⟨hpp, hp11⟩ := hpair
  haveI : Fact p.Prime := ⟨hpp⟩
  have hp0 : p ≠ 0 := hpp.ne_zero
