    exists_endMinpoly_of_stable_cyclic_isolatedJ E hp (ε₀.symm y) hord hstab
  -- **3.** the two roots differ by `x ↦ 1 − x`, so they have the SAME `ker (2· − 1)`
  have hcomm := WeierstrassCurve.End.mul_comm_charZero φ φ'
