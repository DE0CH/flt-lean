        (⟨S' ^ 4 - 2 * S' ^ 2 * e' ^ 2 - 63 * e' ^ 4, by rw [ht']; ring⟩ : S' ^ 2 ∣ t' ^ 2)
      have hc2' : c' ^ 2 = S' ^ 4 - 2 * S' ^ 2 * e' ^ 2 - 63 * e' ^ 4 := by
        refine mul_left_cancel₀ (pow_ne_zero 2 hS0') ?_
        have h2 : (S' * c') ^ 2 = (1 : ℤ) * S' ^ 2
            * (((1 : ℤ) * S' ^ 2 - 9 * e' ^ 2) * ((1 : ℤ) * S' ^ 2 + 7 * e' ^ 2)) := by
          rw [← ht', hc']
