/-! #### `ψ = √−N` as a MORPHISM, and the self-`N`-isogeny of a CM datum

`IsCMByRamifiedMaximalOrder` (declared far above) carries `φ` as a
base-NATURAL operation on relative points rather than as a morphism of
schemes — its `phi_pre` field is exactly that naturality, and its own
docstring says the field exists so that `φ` "is an endomorphism of the
scheme and not merely of one fibre".  This sub-block cashes that in: by
Yoneda, `ψ = 2φ − 1` is precomposition with a morphism `E ⟶ E`, and the
construction is the one `AbelianSchemeStruct.mulByNat` already uses —
apply the operation to the TAUTOLOGICAL relative point `RelPoint.self`
and read off the underlying morphism, then recover the general case with
`RelPoint.pre_self`.  No fibre products and no chosen pullbacks.

**Note this does NOT go through a Weierstrass model, which is why it is
elementary here while `exists_end_of_isCMByRamifiedMaximalOrder` below —
the same translation into `WeierstrassCurve.End` — is still a leaf.** -/

namespace IsCMByRamifiedMaximalOrder

variable {N : ℕ} {T : Scheme.{0}} {d : Gamma0Datum N T}

/-- `ψ = 2φ − 1`, the square root of `−N`, on relative points.  Written in the
`AddCommGroup` notation of `d.ab.addCommGroup g` so that the instance path in
the unfolding is the one a proof gets from `letI` — the two are defeq but not
syntactically equal, and `rw` cannot see through the difference. -/
noncomputable def psiPt (h : IsCMByRamifiedMaximalOrder N d) {T' : Scheme.{0}} {g : T' ⟶ T}
    (x : RelPoint d.f g) : RelPoint d.f g :=
  letI := d.ab.addCommGroup g
  h.phi x + h.phi x - x

theorem psiPt_def (h : IsCMByRamifiedMaximalOrder N d) {T' : Scheme.{0}} {g : T' ⟶ T}
    (x : RelPoint d.f g) :
    letI := d.ab.addCommGroup g
    h.psiPt x = h.phi x + h.phi x - x := rfl

/-- `φ` on the relative points over one base point, as an `AddMonoidHom` — this
is only a repackaging of `phi_add`, and it exists so that `map_neg` is
available. -/
noncomputable def phiHom (h : IsCMByRamifiedMaximalOrder N d) {T' : Scheme.{0}} (g : T' ⟶ T) :
    letI := d.ab.addCommGroup g
    RelPoint d.f g →+ RelPoint d.f g :=
  letI := d.ab.addCommGroup g
  AddMonoidHom.mk' (fun x => h.phi x) (fun x y => h.phi_add x y)

theorem phiHom_apply (h : IsCMByRamifiedMaximalOrder N d) {T' : Scheme.{0}} (g : T' ⟶ T)
    (x : RelPoint d.f g) :
    letI := d.ab.addCommGroup g
    h.phiHom g x = h.phi x := rfl

/-- `ψ` is additive. -/
theorem psiPt_add (h : IsCMByRamifiedMaximalOrder N d) {T' : Scheme.{0}} {g : T' ⟶ T}
    (x y : RelPoint d.f g) :
    letI := d.ab.addCommGroup g
    h.psiPt (x + y) = h.psiPt x + h.psiPt y := by
  letI := d.ab.addCommGroup g
  have hadd : ∀ a b : RelPoint d.f g, h.phi (a + b) = h.phi a + h.phi b :=
    fun a b => h.phi_add a b
  show h.phi (x + y) + h.phi (x + y) - (x + y)
      = (h.phi x + h.phi x - x) + (h.phi y + h.phi y - y)
  rw [hadd]
  abel

/-- `ψ` on the relative points over one base point, as an `AddMonoidHom`. -/
noncomputable def psiHom (h : IsCMByRamifiedMaximalOrder N d) {T' : Scheme.{0}} (g : T' ⟶ T) :
    letI := d.ab.addCommGroup g
    RelPoint d.f g →+ RelPoint d.f g :=
  letI := d.ab.addCommGroup g
  AddMonoidHom.mk' (fun x => h.psiPt x) (fun x y => h.psiPt_add x y)

theorem psiHom_apply (h : IsCMByRamifiedMaximalOrder N d) {T' : Scheme.{0}} (g : T' ⟶ T)
    (x : RelPoint d.f g) :
    letI := d.ab.addCommGroup g
    h.psiHom g x = h.psiPt x := rfl

/-- `ψ` is natural in the base point — this is `phi_pre` together with the
naturality of the group law (`pre_add`, `pre_neg`). -/
theorem psiPt_pre (h : IsCMByRamifiedMaximalOrder N d) {T'' T' : Scheme.{0}} (k : T'' ⟶ T')
    {g : T' ⟶ T} {g' : T'' ⟶ T} (hg : k ≫ g = g') (x : RelPoint d.f g) :
    h.psiPt (RelPoint.pre k hg x) = RelPoint.pre k hg (h.psiPt x) := by
  letI := d.ab.addCommGroup g
  letI := d.ab.addCommGroup g'
  have e1 : ∀ a b : RelPoint d.f g, a - b = d.ab.add a (d.ab.neg b) :=
    fun a b => sub_eq_add_neg a b
  have e2 : ∀ a b : RelPoint d.f g', a - b = d.ab.add a (d.ab.neg b) :=
    fun a b => sub_eq_add_neg a b
  have e3 : ∀ a b : RelPoint d.f g, a + b = d.ab.add a b := fun _ _ => rfl
  have e4 : ∀ a b : RelPoint d.f g', a + b = d.ab.add a b := fun _ _ => rfl
  show h.phi (RelPoint.pre k hg x) + h.phi (RelPoint.pre k hg x) - RelPoint.pre k hg x
      = RelPoint.pre k hg (h.phi x + h.phi x - x)
  rw [e1, e2, e3, e4, h.phi_pre k hg, d.ab.pre_add k hg, d.ab.pre_neg k hg,
    d.ab.pre_add k hg]

/-- **`ψ`, as a MORPHISM `E ⟶ E`** — the Yoneda realization of the natural
operation `psiPt`, exactly as `AbelianSchemeStruct.mulByNat` realizes `n • ·`. -/
noncomputable def psiMor (h : IsCMByRamifiedMaximalOrder N d) : d.E ⟶ d.E :=
  (h.psiPt (RelPoint.self d.f)).1

theorem psiMor_comp (h : IsCMByRamifiedMaximalOrder N d) : h.psiMor ≫ d.f = d.f :=
  (h.psiPt (RelPoint.self d.f)).2

theorem psiPt_val (h : IsCMByRamifiedMaximalOrder N d) {T' : Scheme.{0}} {g : T' ⟶ T}
    (x : RelPoint d.f g) : (h.psiPt x).1 = x.1 ≫ h.psiMor := by
  conv_lhs => rw [← RelPoint.pre_self x]
  rw [h.psiPt_pre x.1 x.2 (RelPoint.self d.f)]
  rfl

/-- **Postcomposition with `psiMor` computes `ψ` on every relative point** —
this is what makes `psiMor` deserve the name. -/
theorem post_psiMor (h : IsCMByRamifiedMaximalOrder N d) {T' : Scheme.{0}} {g : T' ⟶ T}
    (x : RelPoint d.f g) :
    RelPoint.post h.psiMor h.psiMor_comp x = h.psiPt x :=
  Subtype.ext (h.psiPt_val x).symm

/-- **`ψ̄ = −ψ`, the DUAL isogeny, as a morphism `E ⟶ E`.**  It is `−ψ` and not
`ψ` because `ψ² = [−N]`, so `ψ · (−ψ) = [N]`; taking `ψ` for both `map` and
`dual` would give `dual_map = [−N]` and is exactly the sign error to avoid. -/
noncomputable def psiNegMor (h : IsCMByRamifiedMaximalOrder N d) : d.E ⟶ d.E :=
  (d.ab.neg (h.psiPt (RelPoint.self d.f))).1

theorem psiNegMor_comp (h : IsCMByRamifiedMaximalOrder N d) : h.psiNegMor ≫ d.f = d.f :=
  (d.ab.neg (h.psiPt (RelPoint.self d.f))).2

theorem psiNegPt_val (h : IsCMByRamifiedMaximalOrder N d) {T' : Scheme.{0}} {g : T' ⟶ T}
    (x : RelPoint d.f g) : (d.ab.neg (h.psiPt x)).1 = x.1 ≫ h.psiNegMor := by
  conv_lhs => rw [← RelPoint.pre_self x]
  rw [h.psiPt_pre x.1 x.2 (RelPoint.self d.f), ← d.ab.pre_neg x.1 x.2]
  rfl

theorem post_psiNegMor (h : IsCMByRamifiedMaximalOrder N d) {T' : Scheme.{0}} {g : T' ⟶ T}
    (x : RelPoint d.f g) :
    RelPoint.post h.psiNegMor h.psiNegMor_comp x = d.ab.neg (h.psiPt x) :=
  Subtype.ext (h.psiNegPt_val x).symm

/-- The pure abelian-group identity behind `ψ² = [−N]`: with `a = φx`,
`b = k·x` and `φ²x = a − b`, expanding `ψ(ψ x)` leaves `x − 4b`.  Split out
because `abel` is the whole proof and it should not be re-run inside the
scheme-theoretic argument. -/
theorem psiSq_group_identity {G : Type*} [AddCommGroup G] (a b x : G) :
    (a - b + (a - b) - a) + (a - b + (a - b) - a) - (a + a - x)
      = x - (b + b + (b + b)) := by
  abel

/-- **`ψ² = [−N]`**, from `phi_sq` alone.

`phi_sq` says `φ² + k = φ` with `k = (N+1)/4`, so `ψ² = 4φ² − 4φ + 1 = −4k + 1`,
and `hN : N % 4 = 3` is exactly what makes `4k = N + 1` — i.e. what makes the
ℕ-division in `phi_sq` EXACT.  Without it the identity is false: at `N % 4 ≠ 3`
the order `ℤ[φ]` of `phi_sq` has discriminant `1 − 4k ≠ −N`. -/
theorem psiPt_psiPt (h : IsCMByRamifiedMaximalOrder N d) (hN : N % 4 = 3)
    {T' : Scheme.{0}} {g : T' ⟶ T} (x : RelPoint d.f g) :
    letI := d.ab.addCommGroup g
    h.psiPt (h.psiPt x) = -((N : ℕ) • x) := by
  letI := d.ab.addCommGroup g
  have hadd : ∀ u v : RelPoint d.f g, h.phi (u + v) = h.phi u + h.phi v :=
    fun u v => h.phi_add u v
  -- `φ² = φ − k`, where `k = (N+1)/4`
  have hsq : h.phi (h.phi x) = h.phi x - ((N + 1) / 4 : ℕ) • x :=
    eq_sub_of_add_eq (h.phi_sq x)
  -- `4k = N + 1`, spelled as a fourfold sum so that only `add_nsmul` is needed
  have h4b : ((N + 1) / 4 : ℕ) • x + ((N + 1) / 4 : ℕ) • x
      + (((N + 1) / 4 : ℕ) • x + ((N + 1) / 4 : ℕ) • x) = (N : ℕ) • x + x := by
    have hsum : ((N + 1) / 4 + (N + 1) / 4 + ((N + 1) / 4 + (N + 1) / 4) : ℕ) = N + 1 := by
      omega
    have hx : ((N + 1) / 4 + (N + 1) / 4 + ((N + 1) / 4 + (N + 1) / 4) : ℕ) • x
        = (N : ℕ) • x + x := by
      rw [hsum, add_nsmul]
      congr 1
      simp
    simp only [add_nsmul] at hx
    exact hx
  have hphineg : ∀ a : RelPoint d.f g, h.phi (-a) = -(h.phi a) :=
    fun a => (h.phiHom g).map_neg a
  -- `φ(ψ x) = φ²x + φ²x − φx`
  have hp : h.phi (h.psiPt x) = h.phi (h.phi x) + h.phi (h.phi x) - h.phi x := by
    rw [h.psiPt_def x, sub_eq_add_neg, hadd, hadd, hphineg]
    abel
  calc h.psiPt (h.psiPt x)
      = h.phi (h.psiPt x) + h.phi (h.psiPt x) - h.psiPt x := h.psiPt_def _
    _ = (h.phi (h.phi x) + h.phi (h.phi x) - h.phi x)
          + (h.phi (h.phi x) + h.phi (h.phi x) - h.phi x)
          - (h.phi x + h.phi x - x) := by rw [hp, h.psiPt_def x]
    _ = -((N : ℕ) • x) := by
        rw [hsq, psiSq_group_identity, h4b]
        abel

end IsCMByRamifiedMaximalOrder

/-- **A CM `Γ₀(N)`-datum for the ramified maximal order of discriminant `−N` is
`N`-ISOGENOUS TO ITSELF** (PROVEN 2026-07-30) — `ψ = √−N` is the isogeny and
`ψ̄ = −ψ` is its dual.

This is the formal content of the sentence every docstring in this block quotes
as "visible without any descent": `𝔭 = (√−N)` satisfies `𝔭² = (N)` and is
PRINCIPAL, so `E/C ≅ E` and `φ(E[N]) = φ(E[𝔭²]) = E[𝔭] = C`.  In
`IsNIsogenyPair`'s vocabulary all four clauses are read off `IsCMByRamifiedMaximalOrder`:

* `ker_map`, `ker_dual` — `liesIn_iff` says the level structure IS `ker ψ`,
  verbatim, and `ker(−ψ) = ker ψ`;
* `dual_map`, `map_dual` — `psiPt_psiPt`, i.e. `ψ² = [−N]`, so `−ψ · ψ = [N]`.

`hN : N % 4 = 3` is LOAD-BEARING and does exactly one job: it makes the
ℕ-division `(N+1)/4` in `phi_sq` exact, so that `ℤ[φ]` really has discriminant
`−N`.  It holds at `43, 67, 163`, which is where every consumer lives.

**LEVEL-GENERIC**: nothing here knows the class number, the `j`-invariants, or
Mazur.  It is the CONVERSE of `exists_atkinLehnerEnd_of_stable_cyclic_mazurLevel`
below, which goes from Atkin–Lehner fixedness to an endomorphism with
`ψ² = [−N]`; together the two say that at these levels *fixed by `w_N`* and *CM
by `𝒪_{−N}`* are interderivable, which is the fact that makes the re-cut above
sound and also the fact that makes the chain in item (2) of the block docstring
redundant. -/
theorem nonempty_isNIsogenyPair_self_of_isCMByRamifiedMaximalOrder (N : ℕ) (hN : N % 4 = 3)
    {T : Scheme.{0}} {d : Gamma0Datum N T} (h : IsCMByRamifiedMaximalOrder N d) :
    Nonempty (IsNIsogenyPair N d d) := by
  refine ⟨{ map := h.psiMor, comm := h.psiMor_comp,
            dual := h.psiNegMor, dual_comm := h.psiNegMor_comp,
            ker_map := ?_, ker_dual := ?_, dual_map := ?_, map_dual := ?_ }⟩
  · -- `ker ψ = C`: this is `liesIn_iff` and nothing else
    intro T' g x
    letI := d.ab.addCommGroup g
    rw [h.post_psiMor x, h.psiPt_def x]
    have hz : (h.phi x + h.phi x - x = d.ab.zero g) ↔ (h.phi x + h.phi x - x = 0) := Iff.rfl
    rw [hz, sub_eq_zero]
    exact (h.liesIn_iff x).symm
  · -- `ker ψ̄ = ker (−ψ) = ker ψ = C`
    intro T' g y
    letI := d.ab.addCommGroup g
    rw [h.post_psiNegMor y]
    have hn : (d.ab.neg (h.psiPt y) = d.ab.zero g) ↔ (-(h.psiPt y) = 0) := Iff.rfl
    rw [hn, neg_eq_zero, h.psiPt_def y, sub_eq_zero]
    exact (h.liesIn_iff y).symm
  · -- `ψ̄ ∘ ψ = −ψ² = [N]`
    intro T' g x
    letI := d.ab.addCommGroup g
    rw [h.post_psiMor x, h.post_psiNegMor (h.psiPt x)]
    show -(h.psiPt (h.psiPt x)) = (N : ℕ) • x
    rw [h.psiPt_psiPt hN x, neg_neg]
  · -- `ψ ∘ ψ̄ = −ψ² = [N]`
    intro T' g y
    letI := d.ab.addCommGroup g
    rw [h.post_psiNegMor y]
    show RelPoint.post h.psiMor h.psiMor_comp (-(h.psiPt y)) = (N : ℕ) • y
    rw [h.post_psiMor (-(h.psiPt y)), ← h.psiHom_apply g (-(h.psiPt y)), map_neg,
      h.psiHom_apply, h.psiPt_psiPt hN y, neg_neg]

/-- **If the `ℚ̄`-moduli point of a rational point `y` of `Y_0(N)` is
`N`-ISOGENOUS TO ITSELF, then `y` is FIXED by the Atkin–Lehner involution**
(PROVEN 2026-07-30) — LEVEL-GENERIC, and this is the declaration that shows the
Jacobian half of the old cut was never needed.

The whole proof is `IsAtkinLehner`'s own pin read at `T = Spec ℚ̄`.  That pin is
quantified over EVERY test object, not over `ℚ`-points, so a `ℚ̄`-datum is a
legal input; `hd` puts it at (the base change of) `y`; a self-`N`-isogeny makes
the pin's two sides the same point; `RelPoint.post_pre` slides the two
postcompositions past the base change; and `Spec ℚ̄ ⟶ Spec ℚ` is an EPIMORPHISM
(`epi_specMap_of_fieldHom` — `Spec` of a map of FIELDS), which cancels it back
down to `ℚ`.  That last step is `Y(ℚ) ↪ Y(ℚ̄)` and is the same one
`card_y0Le_classNumberOne` runs.

**Why the hypothesis has to be about a `ℚ̄`-datum and CANNOT be about a
`ℚ`-datum.**  `IsCMByRamifiedMaximalOrder N d` for `d : Gamma0Datum N SpecQ` is
UNSATISFIABLE, so the `ℚ`-form of the sibling leaf below would be FALSE, not
merely unprovable.  By the Yoneda construction above, such a `φ` would BE a
group-scheme endomorphism of `E` over `ℚ`, and `ψ = 2φ − 1` would satisfy
`ψ² = [−N]` in `End_ℚ(E) = ℤ` — impossible, since `−N` is not a square.  CM is
never defined over `ℚ`; it needs `ℚ(√−N)`.  This is why every CM statement in
this block quantifies over `Spec ℚ̄`, and it is worth stating because the
`ℚ`-form is the more natural-looking cut and it is a false one. -/
theorem atkinLehnerFixed_of_isNIsogenyPair_self_geom {N : ℕ}
    {X Y : Scheme.{0}} {strX : X ⟶ SpecQ} {strY : Y ⟶ SpecQ} {jY : Y ⟶ X}
    (hX : IsX0Compactification N strX strY jY)
    (w : X ⟶ X) (hw : w ≫ strX = strX) (hal : IsAtkinLehner N hX w hw)
    (y : RelPoint strY (𝟙 SpecQ))
    (d : Gamma0Datum N (Spec (CommRingCat.of (AlgebraicClosure ℚ))))
    (hd : hX.coarse.classify (specAlgClos ℚ ≫ 𝟙 SpecQ) d
      = RelPoint.pre (specAlgClos ℚ) rfl y)
    (pair : IsNIsogenyPair N d d) :
    RelPoint.post w hw (RelPoint.post jY hX.comm y) = RelPoint.post jY hX.comm y := by
  haveI : Epi (specAlgClos ℚ) := by
    show Epi (Spec.map (CommRingCat.ofHom (algebraMap ℚ (AlgebraicClosure ℚ))))
    exact epi_specMap_of_fieldHom _
  have key := hal (specAlgClos ℚ ≫ 𝟙 SpecQ) d d pair
  rw [hd, RelPoint.post_pre, RelPoint.post_pre] at key
  exact Subtype.ext ((cancel_epi (specAlgClos ℚ)).mp (congrArg Subtype.val key))

/-! #### The residue of the moduli↔Weierstrass bridge, CUT (2026-07-30)

The bridge leaf below was closed on 2026-07-28 down to a single trailing `sorry`
carrying step **5** — "transport `φ` across `hmodel` to a NATURAL endomorphism of
`d`'s functor of points".  This subsection cuts that residue.  Three of the four
things the old docstring listed as remaining are **not open at all**, and the
corrections are recorded in that docstring below; what is really left is split
here into two leaves plus three PROVEN pieces of formalism.

**The two proven reductions, and they are the point of the cut.**  A candidate
`Ψ : d.E ⟶ d.E` over the base gives `phi := RelPoint.post Ψ`, and then

* `phi_pre` is FREE — it is `RelPoint.post_pre`, i.e. associativity of
  composition;
* `phi_sq` at EVERY test scheme follows from `phi_sq` at the single
  TAUTOLOGICAL point `RelPoint.self d.f`.  That is `relPoint_post_sq_of_self`
  below, and it is Yoneda for `RelPoint` (`RelPoint.pre_self`) plus
  `pre_add`/`pre_nsmul`.  So the minimal polynomial costs ONE equation, not a
  family of them;
* the subfunctor `ker (2Ψ − 1)` is the **FIXED LOCUS of one morphism**: writing
  `w := post Ψ (self) + post Ψ (self) : RelPoint d.f d.f`, a relative point `x`
  satisfies `phi x + phi x = x` **iff** `x.1 ≫ w.1 = x.1`.  That is
  `relPoint_post_add_post_eq_iff` below.  This is what makes `liesIn_iff`
  statable without any functor-of-points apparatus, and it is why LEAF 2 can be
  phrased as a comparison of two CLOSED SUBSCHEMES.

**LEAF 1 — `exists_relSchemeEnd_of_endMinpoly_of_weierstrassModel`** — is the
geometry: the point-level `φ` becomes an actual scheme endomorphism.

**LEAF 2 — `liesIn_iff_of_geomFibre_of_fixedLocus`** — is the descent from
`ℚ̄`-points to arbitrary test schemes, and it is LEVEL-GENERIC with no
Weierstrass model in it at all.  The two sibling leaves
`WeierstrassCurve.nonempty_isNIsogenyPair_of_gamma0Model` and
`WeierstrassCurve.exists_isogenyIsom_of_gamma0Model_isBaseChangeOf` need the same
descent; they should cite it rather than rebuild it.

**WHY LEAF 1 KEEPS `hp`, against the old docstring's objection.**  The docstring
below declined to split the residue at exactly this seam, and its reason is
correct as far as it goes: `e` is *quantified over* rather than pinned to
`hmodel`'s open immersion, so `e` may be replaced by `e ∘ α` for an additive
Galois-equivariant automorphism `α` of `E(ℚ̄)` that is nowhere near algebraic.
The conclusion of LEAF 1, however, **does not mention `e`** — it asks only for a
scheme endomorphism of `d.E` cutting out `d.cyc` — so the ambiguity cannot make
the leaf false by moving the conclusion.  What it does is weaken the hypotheses:
all a bogus `e` still forces is that `d₀.cyc`'s geometric fibre is *some*
Galois-stable subgroup of order `p`.  `hp` is therefore LOAD-BEARING in LEAF 1,
and this is where: `φ` carries `IsIsogeny`, so `End(E⁄ℚ̄) ⊇ ℤ[(1+√−p)/2]` and `E`
has CM by the maximal order of discriminant `−p` (maximal because `E` is defined
over `ℚ`, which forces `h(−p) = 1`); the two roots of `X² − X + (p+1)/4` in that
order are conjugate and have the SAME kernel `E[𝔭]`; and at `p = 43, 67, 163`
the Galois-stable subgroup of order `p` on such a curve is UNIQE, namely `E[𝔭]`.
That last step is Mazur-level input rather than formalism — it is the same fact
that makes `Y_0(p)(ℚ)` a single CM point at these levels — and it is what a
prover of LEAF 1 must supply.  **Dropping `hp` would make LEAF 1 FALSE**: `E/ℚ`
with CM by the maximal order of discriminant `−p` also exists at
`p = 3, 7, 11, 19` (the other class-number-one values with `p ≡ 3 mod 4`), and
there the hypotheses no longer pin `d₀.cyc` to `E[𝔭]`, while the conclusion
still demands a `Ψ` whose kernel is `d₀.cyc`.

The cheaper licensing check the old docstring proposed instead — pinning `e` to
`ι` on points — remains the better fix and remains unwritten; it belongs in
`X0.lean`.  With it, `hp` could be dropped from LEAF 1 and the split would carry
no arithmetic at all. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry _root_.Fermat in
/-- **The minimal-polynomial identity at the TAUTOLOGICAL point implies it at
every test scheme** (PROVEN 2026-07-30) — Yoneda for `RelPoint`, and nothing
else.

`RelPoint.pre_self` says every relative point is `RelPoint.self d.f` pulled back
along itself.  `RelPoint.post` commutes with `RelPoint.pre` (associativity), and
`pre` is additive (`pre_add`) and commutes with `n • ·` (`pre_nsmul`); so both
sides of the identity are `RelPoint.pre x.1 x.2` of their values at the
tautological point, and one equation there gives the whole family.

This is what reduces the `phi_sq` field of `IsCMByRamifiedMaximalOrder` — a
statement quantified over all test schemes and all base points — to a single
equation in `RelPoint d.f d.f`. -/
theorem relPoint_post_sq_of_self (p : ℕ) {N : ℕ} {T : Scheme.{0}} (d : Gamma0Datum N T)
    (Ψ : d.E ⟶ d.E) (hΨ : Ψ ≫ d.f = d.f)
    (hself : letI := d.ab.addCommGroup d.f
      d.ab.add (RelPoint.post Ψ hΨ (RelPoint.post Ψ hΨ (RelPoint.self d.f)))
          (((p + 1) / 4 : ℕ) • RelPoint.self d.f)
        = RelPoint.post Ψ hΨ (RelPoint.self d.f))
    {T' : Scheme.{0}} {g : T' ⟶ T} (x : RelPoint d.f g) :
    letI := d.ab.addCommGroup g
    d.ab.add (RelPoint.post Ψ hΨ (RelPoint.post Ψ hΨ x)) (((p + 1) / 4 : ℕ) • x)
      = RelPoint.post Ψ hΨ x := by
  letI := d.ab.addCommGroup g
  letI := d.ab.addCommGroup d.f
  have hx : RelPoint.pre x.1 x.2 (RelPoint.self d.f) = x := RelPoint.pre_self x
  have hA : RelPoint.pre x.1 x.2 (RelPoint.post Ψ hΨ (RelPoint.self d.f))
      = RelPoint.post Ψ hΨ x :=
    (RelPoint.post_pre Ψ hΨ x.1 x.2 (RelPoint.self d.f)).symm.trans
      (congrArg (RelPoint.post Ψ hΨ) hx)
  have hB : RelPoint.pre x.1 x.2
        (RelPoint.post Ψ hΨ (RelPoint.post Ψ hΨ (RelPoint.self d.f)))
      = RelPoint.post Ψ hΨ (RelPoint.post Ψ hΨ x) :=
    (RelPoint.post_pre Ψ hΨ x.1 x.2 (RelPoint.post Ψ hΨ (RelPoint.self d.f))).symm.trans
      (congrArg (RelPoint.post Ψ hΨ) hA)
  have hC : RelPoint.pre x.1 x.2 (((p + 1) / 4 : ℕ) • RelPoint.self d.f)
      = ((p + 1) / 4 : ℕ) • x :=
    (d.ab.pre_nsmul x.1 x.2 ((p + 1) / 4) (RelPoint.self d.f)).trans
      (congrArg (fun z => ((p + 1) / 4 : ℕ) • z) hx)
  have key : RelPoint.pre x.1 x.2
        (d.ab.add (RelPoint.post Ψ hΨ (RelPoint.post Ψ hΨ (RelPoint.self d.f)))
          (((p + 1) / 4 : ℕ) • RelPoint.self d.f))
      = d.ab.add (RelPoint.post Ψ hΨ (RelPoint.post Ψ hΨ x)) (((p + 1) / 4 : ℕ) • x) :=
    (d.ab.pre_add x.1 x.2 _ _).trans (by rw [hB, hC])
  exact key.symm.trans ((congrArg (RelPoint.pre x.1 x.2) hself).trans hA)

open _root_.CategoryTheory _root_.AlgebraicGeometry _root_.Fermat in
/-- **`ker (2Ψ − 1)` is the FIXED LOCUS of a single morphism `d.E ⟶ d.E`**
(PROVEN 2026-07-30).

Write `w := RelPoint.post Ψ (RelPoint.self d.f) + RelPoint.post Ψ (RelPoint.self
d.f)`, an element of `RelPoint d.f d.f`, i.e. a morphism `w.1 : d.E ⟶ d.E` over
the base.  By Yoneda (`RelPoint.pre_self`) plus `post_pre` and `pre_add`, for
every relative point `x`

  `post Ψ x + post Ψ x = RelPoint.pre x.1 x.2 w`,

and `x` itself is `RelPoint.pre x.1 x.2 (RelPoint.self d.f)`; the two agree
exactly when their underlying morphisms do, which is `x.1 ≫ w.1 = x.1`.

**Why this matters for the cut.**  The `liesIn_iff` field of
`IsCMByRamifiedMaximalOrder` compares the level structure with a subfunctor
defined by a group-law equation, and `AbelianSchemeStruct.add` is primitively a
functor-of-points datum, so that subfunctor is not visibly representable.  This
lemma says it IS — it is the equaliser of `w.1` and `𝟙`, hence a closed
subscheme of `d.E` (which is separated, being proper over an affine base).  That
turns `liesIn_iff` into an equality of two closed subschemes, which is what
`liesIn_iff_of_geomFibre_of_fixedLocus` below exploits. -/
theorem relPoint_post_add_post_eq_iff {N : ℕ} {T : Scheme.{0}} (d : Gamma0Datum N T)
    (Ψ : d.E ⟶ d.E) (hΨ : Ψ ≫ d.f = d.f)
    {T' : Scheme.{0}} {g : T' ⟶ T} (x : RelPoint d.f g) :
    d.ab.add (RelPoint.post Ψ hΨ x) (RelPoint.post Ψ hΨ x) = x ↔
      x.1 ≫ (d.ab.add (RelPoint.post Ψ hΨ (RelPoint.self d.f))
        (RelPoint.post Ψ hΨ (RelPoint.self d.f))).1 = x.1 := by
  have hx : RelPoint.pre x.1 x.2 (RelPoint.self d.f) = x := RelPoint.pre_self x
  have hA : RelPoint.pre x.1 x.2 (RelPoint.post Ψ hΨ (RelPoint.self d.f))
      = RelPoint.post Ψ hΨ x :=
    (RelPoint.post_pre Ψ hΨ x.1 x.2 (RelPoint.self d.f)).symm.trans
      (congrArg (RelPoint.post Ψ hΨ) hx)
  have hL : RelPoint.pre x.1 x.2
        (d.ab.add (RelPoint.post Ψ hΨ (RelPoint.self d.f))
          (RelPoint.post Ψ hΨ (RelPoint.self d.f)))
      = d.ab.add (RelPoint.post Ψ hΨ x) (RelPoint.post Ψ hΨ x) :=
    (d.ab.pre_add x.1 x.2 _ _).trans (by rw [hA])
  rw [← hL, ← hx]
  constructor
  · intro h; exact congrArg Subtype.val h
  · intro h; exact Subtype.ext h

open _root_.CategoryTheory _root_.AlgebraicGeometry _root_.Fermat in
/-- **`RelPoint.post` of the morphism `w := 2Ψ` IS `x ↦ Ψ x + Ψ x`** (PROVEN
2026-07-30) — the same Yoneda computation as `relPoint_post_add_post_eq_iff`
above, read as an identity of maps rather than as a criterion.

`RelPoint.post w.1 w.2 x` and `RelPoint.pre x.1 x.2 w` are both
`⟨x.1 ≫ w.1, _⟩`, hence definitionally equal, and `pre_add` plus `post_pre`
evaluate the second. -/
theorem relPoint_post_twoPost {N : ℕ} {T : Scheme.{0}} (d : Gamma0Datum N T)
    (Ψ : d.E ⟶ d.E) (hΨ : Ψ ≫ d.f = d.f)
    {T' : Scheme.{0}} {g : T' ⟶ T} (x : RelPoint d.f g) :
    RelPoint.post (d.ab.add (RelPoint.post Ψ hΨ (RelPoint.self d.f))
          (RelPoint.post Ψ hΨ (RelPoint.self d.f))).1
        (d.ab.add (RelPoint.post Ψ hΨ (RelPoint.self d.f))
          (RelPoint.post Ψ hΨ (RelPoint.self d.f))).2 x
      = d.ab.add (RelPoint.post Ψ hΨ x) (RelPoint.post Ψ hΨ x) := by
  have hx : RelPoint.pre x.1 x.2 (RelPoint.self d.f) = x := RelPoint.pre_self x
  have hA : RelPoint.pre x.1 x.2 (RelPoint.post Ψ hΨ (RelPoint.self d.f))
      = RelPoint.post Ψ hΨ x :=
    (RelPoint.post_pre Ψ hΨ x.1 x.2 (RelPoint.self d.f)).symm.trans
      (congrArg (RelPoint.post Ψ hΨ) hx)
  exact (d.ab.pre_add x.1 x.2 _ _).trans (by rw [hA])

open _root_.CategoryTheory _root_.AlgebraicGeometry _root_.Fermat in
/-- **`2Ψ` IS A HOMOMORPHISM when `Ψ` is** (PROVEN 2026-07-30), stated as the
`IsAdditiveOn` of the morphism `w := (Ψ + Ψ)(self)` that
`relPoint_post_add_post_eq_iff` above exhibits as the one cutting out the level
structure.

**Why this exists, and it is the whole point of proving it now.**  The open leaf
`exists_factor_of_comp_eq_of_geomFixed` below is stated for an ARBITRARY `v`,
and its reducedness step then needs the decomposition of an endomorphism of an
elliptic curve as a translation composed with an isogeny — a theory this tree
does not have.  For a HOMOMORPHISM `v` the same step is Cartier's theorem
instead, which is **already proven and sorry-free here**
(`CartierTheorem.isReduced_of_charZero`; see `isReduced_cyc_of_algClosBase`).
A prover who takes that trade must add an additivity hypothesis to that leaf and
discharge it at the call site — and this lemma IS that discharge, so the trade
now costs nothing.  It is deliberately proven ahead of the leaf that would use
it rather than left as a remark, because a remark would have to be re-derived.

The argument is `relPoint_post_twoPost` three times and `add_add_add_comm`:
`(Ψx + Ψy) + (Ψx + Ψy) = (Ψx + Ψx) + (Ψy + Ψy)`. -/
theorem isAdditiveOn_twoPost {N : ℕ} {T : Scheme.{0}} (d : Gamma0Datum N T)
    (Ψ : d.E ⟶ d.E) (hΨ : Ψ ≫ d.f = d.f) (hadd : IsAdditiveOn d.ab d.ab Ψ hΨ) :
    IsAdditiveOn d.ab d.ab
      (d.ab.add (RelPoint.post Ψ hΨ (RelPoint.self d.f))
        (RelPoint.post Ψ hΨ (RelPoint.self d.f))).1
      (d.ab.add (RelPoint.post Ψ hΨ (RelPoint.self d.f))
        (RelPoint.post Ψ hΨ (RelPoint.self d.f))).2 := by
  intro T' g x y
  letI := d.ab.addCommGroup g
  rw [relPoint_post_twoPost, relPoint_post_twoPost, relPoint_post_twoPost, hadd]
  exact add_add_add_comm _ _ _ _

open _root_.CategoryTheory _root_.AlgebraicGeometry _root_.Fermat in
/-- **A FINITE REDUCED algebra over an algebraically closed field is a finite
PRODUCT OF COPIES of the field** (PROVEN 2026-07-30).

`Module.Finite K A` makes `A` Artinian (`IsArtinianRing.of_finite`), so the
reduced Artinian decomposition `IsArtinianRing.equivPi`
(`Mathlib/RingTheory/Artinian/Module.lean`) applies and gives
`A ≃ₐ[A] ∀ 𝔪 : MaximalSpectrum A, A ⧸ 𝔪`; each `A ⧸ 𝔪` is a field, finite over
`K`, hence integral over it, hence equal to `K` because `K` is algebraically
closed (`IsAlgClosed.algebraMap_bijective_of_isIntegral`).  Restricting scalars
from `A` to `K` and applying `AlgEquiv.piCongrRight` componentwise assembles the
two into a `K`-algebra equivalence.

Stated as a `def` returning the equivalence rather than as an existence
statement, because the consumer below needs the map itself: it must know that
the `𝔪`-th projection is a `K`-algebra map, which is exactly what makes the
corresponding morphism `Spec K ⟶ Spec A` a SECTION of the structure map. -/
noncomputable def algEquivPiOfIsAlgClosed (K : Type) [Field K] [IsAlgClosed K]
    (A : Type) [CommRing A] [Algebra K A] [Module.Finite K A] [_root_.IsReduced A] :
    A ≃ₐ[K] (MaximalSpectrum A → K) := by
  haveI : IsArtinianRing A := IsArtinianRing.of_finite K A
  refine (IsArtinianRing.equivPi A).restrictScalars K |>.trans (AlgEquiv.piCongrRight ?_)
  intro 𝔪
  haveI : 𝔪.asIdeal.IsMaximal := 𝔪.isMaximal
  haveI : Field (A ⧸ 𝔪.asIdeal) := Ideal.Quotient.field _
  haveI : Module.Finite K (A ⧸ 𝔪.asIdeal) :=
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ K 𝔪.asIdeal).toLinearMap
      Ideal.Quotient.mk_surjective
  haveI : Algebra.IsIntegral K (A ⧸ 𝔪.asIdeal) := Algebra.IsIntegral.of_finite K _
  exact (AlgEquiv.ofBijective (Algebra.ofId K (A ⧸ 𝔪.asIdeal))
    (IsAlgClosed.algebraMap_bijective_of_isIntegral)).symm

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry
  _root_.Fermat in
/-- **A FINITE REDUCED scheme over an algebraically closed field IS A FINITE
DISJOINT UNION OF COPIES OF THE BASE** (PROVEN 2026-07-30).

This is the geometric content that used to sit inside
`eq_of_geomSections_of_isReduced_of_isFinite` below, hoisted out on 2026-07-30
because a SECOND consumer appeared:
`exists_factor_of_geomSections_of_isReduced_of_isFinite` needs the decomposition
itself, not merely the "morphisms out of it are determined" corollary, because it
has to BUILD a morphism out of `C` from its values on sections rather than
compare two given ones.  `eq_of_geomSections_of_isReduced_of_isFinite` is now
four lines over this.

The proof is the one that was written there, unchanged: `π` finite makes `C`
affine (`isAffine_of_isAffineHom`), `ρ := Spec.preimage (C.isoSpec.inv ≫ π)`
puts a `K`-algebra structure on `A := Γ(C, ⊤)` with `Module.Finite K A`
(`IsFinite.SpecMap_iff`), `A` is reduced
(`AlgebraicGeometry.IsReduced.component_reduced`), so
`algEquivPiOfIsAlgClosed` gives `A ≃ₐ[K] (𝔪 → K)` over the FINITE index
`MaximalSpectrum A`, and `sigmaSpec` is then an isomorphism
`∐_𝔪 Spec K ≅ Spec (∏_𝔪 K) ≅ C`.  The `𝔪`-th coprojection is a SECTION of `π`
because the equivalence is a `K`-algebra map — that is the one place
`e.commutes` is used, and it is why the conclusion can carry the section clause.

**Both hypotheses are load-bearing for the same reasons recorded on the
corollary below**: `Spec K[ε]/(ε²)` is finite over `Spec K` and not a disjoint
union of copies of `Spec K`; `Spec ℂ` over `Spec ℝ` is finite and reduced and has
no section at all. -/
theorem exists_sigmaSpec_iso_of_isReduced_of_isFinite {K : Type} [Field K]
    [IsAlgClosed K] {C : Scheme.{0}} (π : C ⟶ Spec (CommRingCat.of K))
    [IsFinite π] [AlgebraicGeometry.IsReduced C] :
    ∃ (ι : Type) (_ : Finite ι) (p : (∐ fun _ : ι => Spec (CommRingCat.of K)) ⟶ C),
      IsIso p ∧
        ∀ i : ι, (Sigma.ι (fun _ : ι => Spec (CommRingCat.of K)) i ≫ p) ≫ π = 𝟙 _ := by
  haveI : IsAffine C := isAffine_of_isAffineHom π
  set ρ : CommRingCat.of K ⟶ Γ(C, ⊤) := Spec.preimage (C.isoSpec.inv ≫ π) with hρdef
  have hmap : Spec.map ρ = C.isoSpec.inv ≫ π := Spec.map_preimage _
  haveI : IsFinite (Spec.map ρ) := by rw [hmap]; infer_instance
  have hfin : ρ.hom.Finite := (IsFinite.SpecMap_iff ρ).mp inferInstance
  letI : Algebra K Γ(C, ⊤) := ρ.hom.toAlgebra
  haveI : Module.Finite K Γ(C, ⊤) := hfin
  haveI : _root_.IsReduced ↑Γ(C, ⊤) := AlgebraicGeometry.IsReduced.component_reduced ⊤
  haveI : IsArtinianRing ↑Γ(C, ⊤) := IsArtinianRing.of_finite K _
  set ι := MaximalSpectrum ↑Γ(C, ⊤) with hι
  haveI : Finite ι := inferInstance
  set e : ↑Γ(C, ⊤) ≃ₐ[K] (ι → K) := algEquivPiOfIsAlgClosed K _ with he
  set g : Spec (CommRingCat.of (ι → K)) ⟶ C :=
    Spec.map (CommRingCat.ofHom e.toRingHom) ≫ C.isoSpec.inv with hg
  haveI : IsIso (CommRingCat.ofHom e.toRingEquiv.toRingHom) :=
    e.toRingEquiv.toCommRingCatIso.isIso_hom
  haveI : IsIso g := by rw [hg]; infer_instance
  -- the `𝔪`-th component of the decomposition is a SECTION of `π`
  have hsec : ∀ i : ι, (Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ι => K) i)) ≫ g)
      ≫ π = 𝟙 _ := by
    intro i
    rw [hg, Category.assoc, Category.assoc, ← hmap, ← Spec.map_comp, ← Spec.map_comp,
      Category.assoc]
    rw [show ρ ≫ CommRingCat.ofHom e.toRingEquiv.toRingHom ≫
        CommRingCat.ofHom (Pi.evalRingHom (fun _ : ι => K) i) = 𝟙 (CommRingCat.of K) from ?_]
    · exact Spec.map_id _
    · ext k
      exact congrArg (fun z : ι → K => z i) (e.commutes k)
  refine ⟨ι, inferInstance, sigmaSpec (fun _ : ι => CommRingCat.of K) ≫ g, inferInstance,
    fun i => ?_⟩
  rw [← Category.assoc, ι_sigmaSpec]
  exact hsec i

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry
  _root_.Fermat in
/-- **A FINITE REDUCED scheme over an algebraically closed field is detected by
its SECTIONS** (PROVEN 2026-07-30): two morphisms out of it that agree on every
section over the base are equal.

Generic scheme theory — no elliptic curve, no level structure, no
`Gamma0Datum`, and **no hypothesis whatever on the target `X`**.  It is what
remains of `iota_comp_eq_of_geomLiesIn` below once the reducedness input is
supplied, and it is stated separately because it is reusable: the same step is
what any "agrees on `K`-points ⟹ agrees" argument over a finite level structure
needs.

**The proof, and why `IsFinite` rather than `LocallyOfFiniteType` is the right
hypothesis.**  All the geometry is now in
`exists_sigmaSpec_iso_of_isReduced_of_isFinite` above (which was extracted from
this proof on 2026-07-30, unchanged, when a second consumer appeared): `C` is a
finite disjoint union of copies of `Spec K` whose coprojections are sections of
`π`.  What is left here is that a morphism out of a coproduct is determined by
its components (`Sigma.hom_ext`).  `IsFinite` rather than
`LocallyOfFiniteType` is what buys the decomposition — finiteness of
`MaximalSpectrum Γ(C, ⊤)` is what makes `AlgebraicGeometry.sigmaSpec` an
isomorphism.

**No separatedness of `X` is needed, and finiteness of `π` is exactly what buys
that.**  The classical form of this statement, for `C` merely reduced and of
finite type, goes through the equaliser of `a` and `b`, which is a closed
subscheme only when `X` is separated, and then through density of the closed
points.  Here there are finitely many points, all closed, `C` is literally a
finite disjoint union of copies of `Spec K`, and no density argument occurs.
(Compare `AlgebraicGeometry.pointsPi_injective`, `Mathlib/AlgebraicGeometry/`
`PointsPi.lean`, which proves the analogous statement for an ARBITRARY index
type and therefore has to assume `QuasiSeparatedSpace X`.)

**`IsReduced C` IS LOAD-BEARING**: `Spec K[ε]/(ε²)` is finite over `Spec K` and
has exactly one section, and the two `K`-algebra maps `K[t] → K[ε]`, `t ↦ 0` and
`t ↦ ε`, agree after composing with it while differing.

**`IsAlgClosed K` IS LOAD-BEARING**: over `K = ℝ`, `C = Spec ℂ` is finite over
`Spec ℝ` and reduced and has NO section at all, so the hypothesis is vacuous
while the conclusion fails for any `X` admitting two distinct maps out of
`Spec ℂ` — for instance `X = Spec ℂ` with `𝟙` and `Spec` of complex
conjugation. -/
theorem eq_of_geomSections_of_isReduced_of_isFinite {K : Type} [Field K] [IsAlgClosed K]
    {C X : Scheme.{0}} (π : C ⟶ Spec (CommRingCat.of K))
    [IsFinite π] [AlgebraicGeometry.IsReduced C] (a b : C ⟶ X)
    (h : ∀ w : Spec (CommRingCat.of K) ⟶ C, w ≫ π = 𝟙 _ → w ≫ a = w ≫ b) :
    a = b := by
  obtain ⟨ι, hιfin, p, hp, hsec⟩ := exists_sigmaSpec_iso_of_isReduced_of_isFinite π
  haveI := hιfin
  haveI := hp
  rw [← cancel_epi p]
  refine Sigma.hom_ext _ _ fun i => ?_
  simp only [← Category.assoc]
  exact h _ (hsec i)

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry
  _root_.Fermat in
/-- **A MORPHISM OUT OF A FINITE REDUCED SCHEME over an algebraically closed
field FACTORS through any subscheme its `K`-POINTS factor through** (PROVEN
2026-07-30) — the *constructive* companion of
`eq_of_geomSections_of_isReduced_of_isFinite` above, and the engine that turns a
containment of `K`-points into a containment of subschemes.

Generic scheme theory: no elliptic curve, no level structure, no `Gamma0Datum`,
**no hypothesis whatever on the target `X`, and — worth stating because it is
what makes the lemma cheap — none on `j` either.**  `j` is an arbitrary morphism,
not a closed immersion and not even a monomorphism; the factorisation produced is
then not unique, and the statement is existential to match.  (When `j` IS a mono
it is unique, which is how the consumer uses it, but that is the consumer's
business.)

**The proof.**  `exists_sigmaSpec_iso_of_isReduced_of_isFinite` writes `C` as
`∐_{i ∈ ι} Spec K` with `ι` finite and each coprojection `w i` a section of `π`.
The hypothesis applied to `w i` chooses `z i : Spec K ⟶ Z` with
`z i ≫ j = w i ≫ a`; `Sigma.desc z` assembles them, `Sigma.hom_ext` checks
`Sigma.desc z ≫ j = p ≫ a` componentwise, and transporting along the
isomorphism `p` gives the wanted `b := p⁻¹ ≫ Sigma.desc z`.  `Classical.choice`
enters only through `choose`, and only because `j` is not assumed mono.

**`IsReduced C` IS LOAD-BEARING**, with the same witness as the corollary above
and a sharper failure: `C = Spec K[ε]/(ε²)` is finite over `Spec K`, its unique
`K`-point is the origin, so with `X = 𝔸¹ = Spec K[t]`, `a` the closed immersion
of `C` and `Z = X = {0}` the origin, every `K`-point of `C` factors through the
origin while `C` itself does not.

**`IsAlgClosed K` IS LOAD-BEARING**: over `K = ℝ`, `C = Spec ℂ` is finite and
reduced over `Spec ℝ` and has NO section, so the hypothesis is vacuous, while
taking `X = Spec ℂ`, `a = 𝟙` and `Z` the initial scheme makes the conclusion
false. -/
theorem exists_factor_of_geomSections_of_isReduced_of_isFinite {K : Type} [Field K]
    [IsAlgClosed K] {C X Z : Scheme.{0}} (π : C ⟶ Spec (CommRingCat.of K))
    [IsFinite π] [AlgebraicGeometry.IsReduced C] (a : C ⟶ X) (j : Z ⟶ X)
    (h : ∀ w : Spec (CommRingCat.of K) ⟶ C, w ≫ π = 𝟙 _ →
      ∃ z : Spec (CommRingCat.of K) ⟶ Z, z ≫ j = w ≫ a) :
    ∃ b : C ⟶ Z, b ≫ j = a := by
  classical
  obtain ⟨ι, hιfin, p, hp, hsec⟩ := exists_sigmaSpec_iso_of_isReduced_of_isFinite π
  haveI := hιfin
  haveI := hp
  choose z hz using fun i : ι => h _ (hsec i)
  have key : Sigma.desc z ≫ j = p ≫ a := by
    refine Sigma.hom_ext _ _ fun i => ?_
    simp only [← Category.assoc, Sigma.ι_desc]
    exact hz i
  refine ⟨(asIso p).inv ≫ Sigma.desc z, ?_⟩
  rw [Category.assoc, key, asIso_inv, IsIso.inv_hom_id_assoc]

open _root_.CategoryTheory _root_.AlgebraicGeometry _root_.Fermat in
/-- **The level structure of a `Γ₀(N)`-datum over `Spec ℚ̄` is REDUCED**
(PROVEN 2026-07-30, and it is a one-line consequence of released material —
`grep` for a reducedness statement about `d.cyc.C` returns nothing, which is
how it was nearly rebuilt).

`CyclicSubgroupOfOrder.isReduced_geomFibre_of_specQBase` (`X0.lean`, PROVEN and
sorry-free) says every GEOMETRIC FIBRE of `C` is reduced, and over the base
`Spec ℚ̄` the fibre at the identity geometric point IS `C`: the pullback of
`d.cyc.ι ≫ d.f` along `𝟙` has `pullback.fst` an isomorphism
(`Limits.pullback_fst_iso_of_right_iso`), and `IsReduced` transports along it.

**This is where Cartier's theorem enters, and it is ALREADY PROVEN IN THIS
TREE** — `CartierTheorem.isReduced_of_charZero`
(`Fermat/FLT/GroupScheme/Cartier.lean`, sorry-free: a commutative Hopf algebra
finite-dimensional over a field of characteristic zero is reduced), reached
through `CyclicSubgroupOfOrder.exists_hopfAlgebra_geomFibre`, which converts
`zero_liesIn`/`add_liesIn`/`neg_liesIn` into the Hopf structure by Yoneda.  It
is nameable here because `X0.lean:453` carries
`public import Fermat.FLT.GroupScheme.Cartier` and this file `public import`s
`X0`.  **The docstring this cut replaced priced that reducedness as an
unformalised citation to Waterhouse Thm. 11.4; it is not, it is a lemma one
`exact` away.** -/
theorem isReduced_cyc_of_algClosBase {N : ℕ}
    (d : Gamma0Datum N (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) :
    AlgebraicGeometry.IsReduced d.cyc.C := by
  haveI : AlgebraicGeometry.IsReduced
      (Limits.pullback (d.cyc.ι ≫ d.f) (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))) :=
    d.cyc.isReduced_geomFibre_of_specQBase (specAlgClos ℚ) (AlgebraicClosure ℚ) (𝟙 _)
  exact AlgebraicGeometry.isReduced_of_isOpenImmersion
    (asIso (Limits.pullback.fst (d.cyc.ι ≫ d.f)
      (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))))).inv

open _root_.CategoryTheory _root_.AlgebraicGeometry _root_.Fermat in
/-- **LEAF 2a (cut 2026-07-30, PROVEN the same day): `C ⊆ Fix(v)` — the level
structure is fixed by `v` as a MORPHISM, given that its `ℚ̄`-points are.**

This is the whole `⟶` direction of `liesIn_iff_of_geomFibre_of_fixedLocus`
below, at every test scheme at once, compressed into one equation of morphisms
`d.cyc.C ⟶ d.E`; see that theorem's docstring, observation 1, for why the
compression is exact.

**What it needs, and it is the EASY half of the reducedness discussion.**  `C`
is finite (`d.cyc.isFinite`) and flat (`d.cyc.flat`) over `Spec ℚ̄` and
represents a subgroup functor (`zero_liesIn`, `add_liesIn`, `neg_liesIn`, with
representability from `d.cyc.isClosedImmersion`), so it is a finite flat group
scheme over a field of characteristic `0`, hence étale by Cartier's theorem
(Waterhouse, *Introduction to Affine Group Schemes*, Thm. 11.4), hence REDUCED —
and a reduced scheme of finite type over an algebraically closed field is the
scheme-theoretic union of its `ℚ̄`-points, so two morphisms out of it that agree
on every `ℚ̄`-point are equal.  Applied to `ι ≫ v` and `ι`, that is exactly the
conclusion.  **No property of `v` beyond `hv` is used**: the `τ_Q ∘ ψ`
decomposition and the reducedness of `Fix(v)`, which are the parts with content,
belong entirely to `exists_factor_of_comp_eq_of_geomFixed` below.

**Why `hgeom` is stated on `RelPoint d.f (𝟙 _)` and that is the right set.**  A
`ℚ̄`-point of `C` is a `w : Spec ℚ̄ ⟶ d.cyc.C` with `w ≫ (d.cyc.ι ≫ d.f) = 𝟙`,
i.e. a SECTION of `C` over the base; `x := ⟨w ≫ d.cyc.ι, _⟩` is then a relative
point over `𝟙` satisfying `RelPoint.LiesIn d.cyc.ι x`, so `hgeom` applies to it.
Because `ℚ̄` is algebraically closed and `C` is of finite type over it, every
closed point of `C` arises this way, which is what makes "agree on `ℚ̄`-points"
enough.

**CHARACTERISTIC `0` IS LOAD-BEARING**: over `𝔽_ℓ` the finite flat group scheme
`μ_ℓ` is NOT reduced, its only `ℚ̄`-point is the identity, and a `v` fixing just
the identity section would satisfy `hgeom` while `ι ≫ v ≠ ι`.  That is why the
base is spelled `Spec ℚ̄` rather than an arbitrary algebraically closed field.

**`_hv` is carried but NOT CONSUMED**, and the underscore records that: this
half needs nothing about `v` at all, whereas the other half is FALSE without
it.  It is kept in the signature so the two halves have matching hypothesis
lists at the call site in `liesIn_iff_of_geomFibre_of_fixedLocus`. -/
theorem iota_comp_eq_of_geomLiesIn {N : ℕ}
    (d : Gamma0Datum N (Spec (CommRingCat.of (AlgebraicClosure ℚ))))
    (v : d.E ⟶ d.E) (_hv : v ≫ d.f = d.f)
    (hgeom : ∀ x : RelPoint d.f (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))),
      RelPoint.LiesIn d.cyc.ι x → x.1 ≫ v = x.1) :
    d.cyc.ι ≫ v = d.cyc.ι := by
  haveI := d.cyc.isFinite
  haveI := isReduced_cyc_of_algClosBase d
  refine eq_of_geomSections_of_isReduced_of_isFinite (K := AlgebraicClosure ℚ)
    (d.cyc.ι ≫ d.f) (d.cyc.ι ≫ v) d.cyc.ι fun w hw => ?_
  have hx : (w ≫ d.cyc.ι) ≫ d.f = 𝟙 _ := by rw [Category.assoc]; exact hw
  have := hgeom ⟨w ≫ d.cyc.ι, hx⟩ ⟨w, rfl⟩
  simpa [Category.assoc] using this

/-!
