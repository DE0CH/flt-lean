        + algebraMap ℚ (AlgebraicClosure ℚ) B) := by
    have hℓsq : (((twoTorsionModel A B)⁄(AlgebraicClosure ℚ)).toAffine.slope X₁ X₁ Y₁ Y₁
          * (2 * Y₁)) ^ 2
