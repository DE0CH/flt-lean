    rw [hB, WeierstrassCurve.End.coe_add_apply, hone w] at hA
    constructor
    · intro hw
      have hw' : ((2 * ψ - 1 : WeierstrassCurve.End (E⁄(AlgebraicClosure ℚ)).toAffine) :
          AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) w = 0 := hw
      rw [hw', zero_add] at hA
      exact hA
    · intro hw
      rw [hw] at hA
      show ((2 * ψ - 1 : WeierstrassCurve.End (E⁄(AlgebraicClosure ℚ)).toAffine) :
        AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) w = 0
      have hcan : ((2 * ψ - 1 : WeierstrassCurve.End (E⁄(AlgebraicClosure ℚ)).toAffine) :
