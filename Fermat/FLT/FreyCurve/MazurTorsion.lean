              AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) :
            (E⁄(AlgebraicClosure ℚ)).Point →+ (E⁄(AlgebraicClosure ℚ)).Point)
        ↔ (ψ : AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) w
            + (ψ : AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) w = w := by
