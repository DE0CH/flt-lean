/-- **A CYCLIC IMAGE MAKES THE RELATIVE INDEX AN ORDER** (PROVEN 2026-07-30):
if the image of a subgroup `A` under a monoid-valued representation `ρ` is
generated by `ρ σ` for a single `σ ∈ A`, and `J = A ⊓ ker ρ`, then the relative
index `[A : J]` is exactly `orderOf (ρ σ)`.

Pure group theory, and stated over an arbitrary MONOID target because that is
what `Module.End` is: `ρ|_A` is corestricted to the UNITS by
`MonoidHom.toHomUnits` (so that `Subgroup.index_ker`, which wants a group,
applies), the kernel of that corestriction is `J.subgroupOf A` because a unit is
`1` exactly when its value is, its range is `Subgroup.zpowers` of the generator
by `hcyc`, and `Nat.card_zpowers` finishes.

EXTRACTED 2026-07-30 from the body of `relIndex_dvd_of_det_eq_one_five`
immediately below, which had it inline and now consumes it, because
`A₀-3a-i-c` `not_five_dvd_relIndex_of_padicValRat_j_nonneg` needs the SAME
computation against a different relation on the generator (`(ρ σ)¹² = 1`, from
Serre–Tate, rather than the Cayley–Hamilton trichotomy).  Neither statement
mentions `5`, `det`, or an elliptic curve; keeping one copy is what stops the two
consumers drifting apart. -/
theorem relIndex_eq_orderOf_of_cyclic_image {M : Type*} [Monoid M]
    {G : Type*} [Group G] (ρ : G →* M)
    {A J : Subgroup G} (hJ : J = A ⊓ ρ.ker)
    {σ : G} (hσA : σ ∈ A)
    (hcyc : ∀ τ ∈ A, ∃ k : ℕ, ρ τ = ρ σ ^ k) :
    J.relIndex A = orderOf (ρ σ) := by
  classical
  set φ : A →* Mˣ := ρ.toHomUnits.comp A.subtype with hφ
  have hφval : ∀ τ : A, ((φ τ : Mˣ) : M) = ρ τ := by intro τ; rfl
  set s : A := ⟨σ, hσA⟩ with hs
  have hkereq : φ.ker = J.subgroupOf A := by
    ext τ
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, hJ, Subgroup.mem_inf]
    constructor
    · intro h
      refine ⟨τ.2, MonoidHom.mem_ker.mpr ?_⟩
      have := congrArg (fun u : Mˣ => (u : M)) h
      rw [hφval] at this
      simpa using this
    · intro h
      have h1 : ρ (τ : G) = 1 := MonoidHom.mem_ker.mp h.2
      refine Units.ext ?_
      rw [hφval]
      simpa using h1
  have hrange : φ.range = Subgroup.zpowers (φ s) := by
    refine le_antisymm ?_ ?_
    · rintro x ⟨τ, rfl⟩
      obtain ⟨k, hk⟩ := hcyc (τ : G) τ.2
      refine Subgroup.mem_zpowers_iff.mpr ⟨(k : ℤ), Units.ext ?_⟩
      rw [zpow_natCast, Units.val_pow_eq_pow_val, hφval, hφval, hk]
    · rw [Subgroup.zpowers_le]
      exact ⟨s, rfl⟩
  rw [Subgroup.relIndex, ← hkereq, Subgroup.index_ker, hrange, Nat.card_zpowers,
    ← orderOf_units, hφval s]

