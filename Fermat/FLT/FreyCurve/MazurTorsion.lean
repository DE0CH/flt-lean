      + 162434321923500244963691319577164899941782327177547776 *
          (x.num : ℚ) ^ 4 * (x.den : ℚ) ^ 2
      - 1250093798808181921331239024003439064057314451090248756625408 *
          (x.num : ℚ) ^ 3 * (x.den : ℚ) ^ 3
