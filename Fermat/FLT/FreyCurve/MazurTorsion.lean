        have h3 : w - ((φ : AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) w
            + (φ : AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) w) = 0 := by
          have h4 : (w - (φ : AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) w)
