reducedness half directly and both by the finiteness leaf. -/
theorem isFinite_isReduced_fixedLocus_of_geomFixed {N : ℕ}
    (d : Gamma0Datum N (Spec (CommRingCat.of (AlgebraicClosure ℚ))))
    (v : d.E ⟶ d.E) (hv : v ≫ d.f = d.f)
    (hadd : IsAdditiveOn d.ab d.ab v hv)
    (hgeom : ∀ x : RelPoint d.f (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))),
      x.1 ≫ v = x.1 → RelPoint.LiesIn d.cyc.ι x) :
    IsFinite (equalizer.ι v (𝟙 d.E) ≫ d.f) ∧
      AlgebraicGeometry.IsReduced (equalizer v (𝟙 d.E)) := by
  haveI := isFinite_fixedLocus_of_geomFixed d v hv hadd hgeom
  exact ⟨this, isReduced_fixedLocus_of_isAdditiveOn d v hv hadd⟩

