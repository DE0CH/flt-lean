theorem WeierstrassCurve.isIsogeny_equivVariableChange {F : Type*} [Field F] [DecidableEq F]
    (W : WeierstrassCurve F) [W.IsElliptic] (C : WeierstrassCurve.VariableChange F) :
    WeierstrassCurve.IsIsogeny
      (WeierstrassCurve.Affine.Point.equivVariableChange W C).toAddMonoidHom where
  isRationalMap := by
    refine ⟨Polynomial.C ((C.u : F) ^ 2) * Polynomial.X + Polynomial.C C.r, 1,
      Polynomial.C ((C.u : F) ^ 3),
      Polynomial.C ((C.u : F) ^ 2 * C.s) * Polynomial.X + Polynomial.C C.t, 1,
      one_ne_zero, one_ne_zero, ?_⟩
    rintro (_ | ⟨x, y, h⟩) hP
    · exact absurd rfl hP
    · rw [AddEquiv.coe_toAddMonoidHom, WeierstrassCurve.Affine.Point.equivVariableChange_some]
      simp [veluPointX, veluPointY]
      ring
  surjective _ := (WeierstrassCurve.Affine.Point.equivVariableChange W C).surjective
  finite_ker _ := by
    have h : (AddMonoidHom.ker
        (WeierstrassCurve.Affine.Point.equivVariableChange W C).toAddMonoidHom :
          Set (C • W).toAffine.Point) = {0} := by
      ext P
      simp [AddMonoidHom.mem_ker]
    rw [h]
    exact Set.finite_singleton _

/-- **The transport of `equivVariableChange` along an equality of curves is still an
isogeny** (PROVEN 2026-07-31).  `subst` reduces `equivOfEq` to the identity; the
`AddMonoidHom`s are then equal on the nose, so `isIsogeny_equivVariableChange`
applies.  This is the form the assembly below consumes, because
`exists_variableChange_of_isWeierstrassModel` returns `W' = C • W` rather than a
map out of `W'`. -/
theorem WeierstrassCurve.isIsogeny_equivOfEq_trans {F : Type*} [Field F] [DecidableEq F]
    {V W : WeierstrassCurve F} [W.IsElliptic] (C : WeierstrassCurve.VariableChange F)
    (h : V = C • W) :
    WeierstrassCurve.IsIsogeny ((WeierstrassCurve.Affine.Point.equivOfEq h).trans
      (WeierstrassCurve.Affine.Point.equivVariableChange W C)).toAddMonoidHom := by
  subst h
  have he : ((WeierstrassCurve.Affine.Point.equivOfEq (rfl : C • W = C • W)).trans
      (WeierstrassCurve.Affine.Point.equivVariableChange W C)).toAddMonoidHom
      = (WeierstrassCurve.Affine.Point.equivVariableChange W C).toAddMonoidHom := by
    ext P; rfl
  rw [he]
  exact WeierstrassCurve.isIsogeny_equivVariableChange W C

