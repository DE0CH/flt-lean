      have b7 : 7 ∉ N.primeFactors := fun h =>
        hcon 6 7 42 (by decide) (by norm_num) h6 (hd 7 h) h42
      have hsub23 : N.primeFactors ⊆ ({2, 3} : Finset ℕ) := by
        intro r hr
        have h := hsub r hr
