        ∀ (P : RelPoint strX (𝟙 SpecQ)) (p : ℚ × ℚ), f P = some p →
          p.2 ^ 2 = p.1 ^ 3 + 4 * p.1 := by
  obtain ⟨f, hf⟩ := exists_weierstrassModel_x0ThirtyTwo hX
  exact ⟨fun P => planeCoords (f P), planeCoords_injective.comp hf,
