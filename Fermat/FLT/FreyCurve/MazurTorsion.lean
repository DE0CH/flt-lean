      ((1 : WeierstrassCurve.End (E⁄(AlgebraicClosure ℚ)).toAffine) :
        AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) w = w := fun _ => rfl
  -- `w ∈ ker (2ψ − 1)` is `ψ w + ψ w = w`, for any `ψ`
