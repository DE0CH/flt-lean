    have hQ' : ((Q : ℤ) : ℚ) = (x.den : ℚ) := by rw [hQdef]; push_cast; ring
    have hD' : ((D : ℤ) : ℚ) = (y.den : ℚ) := by rw [hDdef]; push_cast; ring
    have hcast : (C : ℚ) ^ 2 * (Q : ℚ) ^ 3 + 20 * (P : ℚ) * (C : ℚ) * (Q : ℚ) ^ 2 * (D : ℚ)
        + 296 * (C : ℚ) * (Q : ℚ) ^ 3 * (D : ℚ) = (P : ℚ) ^ 3 * (D : ℚ) ^ 2 := by
      rw [hQ', hD', hxq, hyd]
