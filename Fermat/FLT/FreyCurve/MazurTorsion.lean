        + (-c ^ 5 - 10 * c ^ 4 - 19 * c ^ 3) * b ^ 3 + (9 * c ^ 5 + 15 * c ^ 4) * b ^ 2
        + (-4 * c ^ 6 - 6 * c ^ 5) * b + (c ^ 9 + c ^ 8 + c ^ 7 + c ^ 6)) := by
  have h := eval_preΨ'_even (WeierstrassCurve.tateNormalForm b c) 0 3
  norm_num [eval_preΨ₄, eval_five, eval_six, eval_seven, eval_eight] at h
