  obtain ⟨g₇, hg₇, hstable₇⟩ :=
    E.exists_stable_zmultiples_of_dvd g (N := 21) (d := 7) (by norm_num) (by norm_num)
      hg hstable
  obtain ⟨t₃, ht₃⟩ := E.exists_x0Three_hauptmodul g₃ hg₃ hstable₃
  obtain ⟨t₇, ht₇⟩ := E.exists_x0Seven_hauptmodul g₇ hg₇ hstable₇
