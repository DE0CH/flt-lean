  have hφφ' : ∀ w : (E⁄(AlgebraicClosure ℚ)).Point,
      ((φ : AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) w
          + (φ : AddMonoid.End (E⁄(AlgebraicClosure ℚ)).toAffine.Point) w = w)
