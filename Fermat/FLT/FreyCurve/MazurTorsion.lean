        exacts [Or.inl rfl, Or.inr rfl, absurd hr b5, absurd hr b7]
      have ha1 : 1 ≤ N.factorization 2 := hposfac 2 b2
      have hb1 : 1 ≤ N.factorization 3 := hposfac 3 b3
