theorem nonempty_relPoint_of_isX0Compactification_finiteField {N ℓ m : ℕ}
    {a₁ a₂ a₃ a₄ a₆ : ℤ} (h : (N, ℓ, a₁, a₂, a₃, a₄, a₆, m) ∈ modelTable)
