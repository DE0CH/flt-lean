    intro p
    obtain ⟨a, ha, b, hb, hab⟩ := Finset.one_lt_card.mp hcard
    rcases eq_or_ne a p with rfl | h
    · exact ⟨b, hb, Ne.symm hab⟩
    · exact ⟨a, ha, h⟩
  -- every prime factor lies in `{2, 3, 5, 7}`
