  have hsqne : (u : Ω) ^ 2 ≠ 1 := by
    intro hcon
    have hum2 : (u : Ω) = -2 := by linear_combination hu - hcon
    have h30 : (3 : Ω) = 0 := by linear_combination hcon - ((u : Ω) - 2) * hum2
    exact absurd h30 (by norm_num)
