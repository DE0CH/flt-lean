    apply mul_left_cancel₀ (pow_ne_zero 4 hune)
    have expand : u ^ 4 * (12 * a ^ 2 + 10 * a * (φ s₁) ^ 2 - 6 * a * (φ s₂) - (φ s₁) ^ 4
