  obtain ⟨u₁, u₂, hu₁0, hnb, hres⟩ := E.exists_x0Seven_chainParameters g hg hstable
  exact MazurLevelFortyNine.x0FortyNine_point_of_residual u₁ u₂ hu₁0 hnb hres

