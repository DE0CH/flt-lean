/-- **A scheme endomorphism with the right minimal polynomial and the right
kernel IS a CM structure** (PROVEN 2026-07-30 over
`liesIn_iff_of_geomFibre_of_fixedLocus`, `relPoint_post_sq_of_self` and
`relPoint_post_add_post_eq_iff`) — the formal half of the bridge's residue,
with no geometry in it.

`phi := RelPoint.post Ψ`, and then every field of
`IsCMByRamifiedMaximalOrder` is discharged mechanically: `phi_add` is `hadd`
verbatim, `phi_pre` is associativity (`RelPoint.post_pre`), `phi_sq` is the
tautological equation propagated by `relPoint_post_sq_of_self`, and
`liesIn_iff` is the fixed-locus reformulation composed with the descent from
`ℚ̄`-points.

Note what the hypotheses ask for and what they do NOT: `hself` is ONE equation
in `RelPoint d.f d.f`, and `hgeom` is only about `ℚ̄`-points.  Both weakenings
are what the three lemmas above buy. -/
theorem nonempty_isCMByRamifiedMaximalOrder_of_relSchemeEnd (p : ℕ)
    {d : Gamma0Datum p (Spec (CommRingCat.of (AlgebraicClosure ℚ)))}
    (Ψ : d.E ⟶ d.E) (hΨ : Ψ ≫ d.f = d.f)
    (hadd : IsAdditiveOn d.ab d.ab Ψ hΨ)
    (hself : letI := d.ab.addCommGroup d.f
      d.ab.add (RelPoint.post Ψ hΨ (RelPoint.post Ψ hΨ (RelPoint.self d.f)))
          (((p + 1) / 4 : ℕ) • RelPoint.self d.f)
        = RelPoint.post Ψ hΨ (RelPoint.self d.f))
    (hgeom : ∀ x : RelPoint d.f (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))),
      RelPoint.LiesIn d.cyc.ι x ↔
        x.1 ≫ (d.ab.add (RelPoint.post Ψ hΨ (RelPoint.self d.f))
          (RelPoint.post Ψ hΨ (RelPoint.self d.f))).1 = x.1) :
    Nonempty (IsCMByRamifiedMaximalOrder p d) :=
  ⟨{ phi := fun x => RelPoint.post Ψ hΨ x
     phi_add := fun x y => hadd x y
     phi_pre := fun {_ _} h {_ _} hg x => RelPoint.post_pre Ψ hΨ h hg x
     phi_sq := fun x => relPoint_post_sq_of_self p d Ψ hΨ hself x
     liesIn_iff := fun x =>
       (liesIn_iff_of_geomFibre_of_fixedLocus d _
           (d.ab.add (RelPoint.post Ψ hΨ (RelPoint.self d.f))
             (RelPoint.post Ψ hΨ (RelPoint.self d.f))).2
           (isAdditiveOn_twoPost d Ψ hΨ hadd) hgeom x).trans
         (relPoint_post_add_post_eq_iff d Ψ hΨ x).symm }⟩

