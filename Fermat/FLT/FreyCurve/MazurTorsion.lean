  obtain ⟨t, w, hell', φ, ht', hw', hgal, hker, hcoord⟩ :=
    WeierstrassCurve.exists_velu_quotient_isogeny_model E
      (AddSubgroup.zmultiples P) hCfin hCodd hstable
