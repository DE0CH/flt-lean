`ℤ_(q)` — equivalently, a level `N` and a prime `q ∤ N` at which `w_N` is
not defined on the smooth model.

**REFERENCES.**  Deligne–Rapoport, *Les schémas de modules de courbes
elliptiques* (Antwerp II, 1973), IV–VI; Atkin–Lehner, *Hecke operators on
`Γ₀(m)`*, Math. Ann. 185 (1970), §2. -/
theorem exists_extend_atkinLehnerModel_of_jNeronDatum (hq : q.Prime) (hqN : q ≠ N)
    (al : AtkinLehnerMorphism N) (wYQ : Y ⟶ Y) (hwYQ : wYQ ≫ strY = strY)
    (hpin : ∀ {T : Scheme.{0}} (g : T ⟶ SpecQ) (dd : Gamma0Datum N T),
      RelPoint.post wYQ hwYQ (hc.classify g dd) = hc.classify g (al.dual g dd))
    (_hinvQ : wYQ ≫ wYQ = 𝟙 Y) :
    ∃ (w : XZ ⟶ XZ) (wY : YZ ⟶ YZ) (hw : w ≫ xstr = xstr) (hwY : wY ≫ ystr = ystr),
      wY ≫ jZ = jZ ≫ w ∧ wY ≫ wY = 𝟙 YZ ∧
      ∀ {T : Scheme.{0}} (g : T ⟶ SpecQ) (g₀ : T ⟶ SpecLoc R)
        (h : g ≫ SpecLoc.generic R = g₀) (y : RelPoint strY g),
        d.genY g g₀ h (RelPoint.post wYQ hwYQ y) = RelPoint.post wY hwY (d.genY g g₀ h y) := by
  obtain ⟨alZ, wY, hwY, hinv, hpinZ⟩ :=
    exists_atkinLehnerModelOpen_of_jNeronDatum d hq hqN
  obtain ⟨w, hw, hcomm⟩ :=
    exists_extend_atkinLehnerCusps_of_jNeronDatum d hq hqN alZ wY hwY hpinZ
  -- the tautological point of `Y`, and the generic identification read at it
  obtain ⟨y₀, hy₀⟩ : ∃ y₀ : RelPoint strY strY, y₀ = ⟨𝟙 Y, Category.id_comp _⟩ :=
    ⟨_, rfl⟩
  have hy₀' : y₀.1 = 𝟙 Y := by rw [hy₀]
  -- `w_𝒴` acts on the generic fibre as a morphism `v : Y ⟶ Y` over `ℚ`
  obtain ⟨v, hvstr, hv⟩ : ∃ (v : Y ⟶ Y) (hvs : v ≫ strY = strY),
      d.genY strY (strY ≫ SpecLoc.generic R) rfl (RelPoint.post v hvs y₀)
        = RelPoint.post wY hwY (d.genY strY (strY ≫ SpecLoc.generic R) rfl y₀) := by
    refine ⟨((d.genY strY (strY ≫ SpecLoc.generic R) rfl).symm (RelPoint.post wY hwY
        (d.genY strY (strY ≫ SpecLoc.generic R) rfl y₀))).1,
      ((d.genY strY (strY ≫ SpecLoc.generic R) rfl).symm (RelPoint.post wY hwY
        (d.genY strY (strY ≫ SpecLoc.generic R) rfl y₀))).2, ?_⟩
    rw [show RelPoint.post _ _ y₀
        = (d.genY strY (strY ≫ SpecLoc.generic R) rfl).symm (RelPoint.post wY hwY
            (d.genY strY (strY ≫ SpecLoc.generic R) rfl y₀))
      from Subtype.ext (by
        show y₀.1 ≫ _ = _
        rw [hy₀']
        exact Category.id_comp _)]
    exact (d.genY strY (strY ≫ SpecLoc.generic R) rfl).apply_symm_apply _
  -- hence on every relative point, by naturality of the identification
  have hgenv : ∀ {T : Scheme.{0}} (g : T ⟶ SpecQ) (g₀ : T ⟶ SpecLoc R)
      (h : g ≫ SpecLoc.generic R = g₀) (y : RelPoint strY g),
      d.genY g g₀ h (RelPoint.post v hvstr y)
        = RelPoint.post wY hwY (d.genY g g₀ h y) := by
    intro T g g₀ h y
    have hy : RelPoint.pre y.1 y.2 y₀ = y :=
      Subtype.ext (by
        show y.1 ≫ y₀.1 = _
        rw [hy₀']
        exact Category.comp_id _)
    have hpv : RelPoint.pre y.1 y.2 (RelPoint.post v hvstr y₀)
        = RelPoint.post v hvstr y :=
      Subtype.ext (by
        show y.1 ≫ y₀.1 ≫ v = y.1 ≫ v
        rw [hy₀', Category.id_comp])
    have hcomp : y.1 ≫ (strY ≫ SpecLoc.generic R) = g₀ := by
      rw [← Category.assoc, y.2, h]
    calc d.genY g g₀ h (RelPoint.post v hvstr y)
        = d.genY g g₀ h (RelPoint.pre y.1 y.2 (RelPoint.post v hvstr y₀)) := by rw [hpv]
      _ = RelPoint.pre y.1 hcomp
            (d.genY strY (strY ≫ SpecLoc.generic R) rfl (RelPoint.post v hvstr y₀)) :=
          d.genY_nat y.1 y.2 rfl h _
      _ = RelPoint.pre y.1 hcomp
            (RelPoint.post wY hwY (d.genY strY (strY ≫ SpecLoc.generic R) rfl y₀)) := by
          rw [hv]
      _ = RelPoint.post wY hwY
            (RelPoint.pre y.1 hcomp (d.genY strY (strY ≫ SpecLoc.generic R) rfl y₀)) :=
          Subtype.ext (Category.assoc _ _ _).symm
      _ = RelPoint.post wY hwY (d.genY g g₀ h (RelPoint.pre y.1 y.2 y₀)) := by
          rw [d.genY_nat y.1 y.2 rfl h y₀]
      _ = RelPoint.post wY hwY (d.genY g g₀ h y) := by rw [hy]
  -- `v` realises the moduli action `al.dual` on `Y_0(N)_ℚ`, hence `v = w_{Y,ℚ}`
  have hcnat : ∀ {T' T : Scheme.{0}} (h : T' ⟶ T) {g : T ⟶ SpecQ} {g' : T' ⟶ SpecQ}
      (hg : h ≫ g = g') {dd' : Gamma0Datum N T'} {dd : Gamma0Datum N T},
      IsBaseChangeOf h dd' dd →
      hc.classify g' (al.dual g' dd')
        = RelPoint.pre h hg (hc.classify g (al.dual g dd)) := by
    intro T' T h g g' hg dd' dd bc
    exact hc.classify_natural h hg (al.dual_baseChange h hg bc)
  obtain ⟨_u0, -, huniqQ⟩ :=
    hc.universal strY (fun {_T} g dd => hc.classify g (al.dual g dd)) hcnat
  have hvpin : ∀ {T : Scheme.{0}} (g : T ⟶ SpecQ) (dd : Gamma0Datum N T),
      (hc.classify g (al.dual g dd)).1 = (hc.classify g dd).1 ≫ v := by
    intro T g dd
    have key : d.genY g (g ≫ SpecLoc.generic R) rfl (hc.classify g (al.dual g dd))
        = d.genY g (g ≫ SpecLoc.generic R) rfl
            (RelPoint.post v hvstr (hc.classify g dd)) := by
      rw [d.genY_classify g (g ≫ SpecLoc.generic R) rfl (al.dual g dd),
        hgenv g (g ≫ SpecLoc.generic R) rfl (hc.classify g dd),
        d.genY_classify g (g ≫ SpecLoc.generic R) rfl dd,
        hpinZ (g ≫ SpecLoc.generic R) dd]
      exact (d.model.coarse.classify_natural (𝟙 T) (Category.id_comp _)
          (nonempty_isBaseChangeOf_of_isNIsogenyPair (al.pair g dd)
            (alZ.pair (g ≫ SpecLoc.generic R) dd)).some).trans
        (Subtype.ext (Category.id_comp _))
    exact congrArg Subtype.val ((d.genY g (g ≫ SpecLoc.generic R) rfl).injective key)
  have hv_eq : v = wYQ :=
    (huniqQ v ⟨hvstr, fun g dd => hvpin g dd⟩).trans
      (huniqQ wYQ ⟨hwYQ, fun g dd => congrArg Subtype.val (hpin g dd).symm⟩).symm
  refine ⟨w, wY, hw, hwY, hcomm, hinv, ?_⟩
  intro T g g₀ h y
  have hy : RelPoint.post wYQ hwYQ y = RelPoint.post v hvstr y :=
    Subtype.ext (by
      show y.1 ≫ wYQ = y.1 ≫ v
      rw [hv_eq])
  rw [hy]
  exact hgenv g g₀ h y

