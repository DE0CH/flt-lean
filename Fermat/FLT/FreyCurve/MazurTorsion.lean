      ((twoTorsionModel A B)⁄(AlgebraicClosure ℚ)).toAffine.negY X Y = -Y := by
    intro X Y
    simp [Affine.negY, twoTorsionModel, WeierstrassCurve.baseChange, WeierstrassCurve.map]
