    (hψker : ∀ Pt : (E'⁄(AlgebraicClosure ℚ)).Point,
      ψ Pt = 0 ↔ Pt ∈ AddSubgroup.zmultiples (φ h))
    (hφiso : WeierstrassCurve.IsIsogeny φ) (hψiso : WeierstrassCurve.IsIsogeny ψ) :
