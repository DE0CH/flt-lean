      WeierstrassCurve.End (E⁄(AlgebraicClosure ℚ)).toAffine) := eq_sub_of_add_eq hsq
  have e2 : φ' * φ' = φ' - (((p + 1) / 4 : ℕ) :
      WeierstrassCurve.End (E⁄(AlgebraicClosure ℚ)).toAffine) := eq_sub_of_add_eq hsq'
  have hz : (φ - φ') * (φ + φ' - 1) = 0 := by
    have expand : (φ - φ') * (φ + φ' - 1)
