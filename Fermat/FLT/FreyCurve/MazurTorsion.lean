  by_cases b2 : 2 ∈ N.primeFactors
  · by_cases b3 : 3 ∈ N.primeFactors
    · -- prime factors `{2, 3}`
      have h2 : (2:ℕ) ∣ N := hd 2 b2
      have h3 : (3:ℕ) ∣ N := hd 3 b3
