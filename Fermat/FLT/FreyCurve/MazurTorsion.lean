  -- and the density theorem promotes involutivity from `𝒴` to `𝒳`
  have hinv : w ≫ w = 𝟙 XZ := by
    refine eq_of_comp_open_x0JNeronModel d.model ?_
    rw [← Category.assoc, ← hcomm, Category.assoc, ← hcomm, ← Category.assoc, hinvY,
      Category.id_comp, Category.comp_id]
  -- STEP 4: Atkin–Lehner §2 supplies the moved cusp.  `hqN` is strengthened here
