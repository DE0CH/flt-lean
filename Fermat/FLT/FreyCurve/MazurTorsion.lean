    (hφker : ∀ Pt : (E⁄(AlgebraicClosure ℚ)).Point,
      φ Pt = 0 ↔ Pt ∈ AddSubgroup.zmultiples ((3 : ℕ) • h))
    (hψker : ∀ Pt : (E'⁄(AlgebraicClosure ℚ)).Point,
