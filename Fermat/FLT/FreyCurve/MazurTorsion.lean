      exact hφh₂ne (by rw [← hpQ]; exact addOrderOf_dvd_iff_nsmul_eq_zero.mp hd)
    obtain ⟨k, hk2, hkeq⟩ := (Nat.dvd_prime_pow hpp).mp hdvd
