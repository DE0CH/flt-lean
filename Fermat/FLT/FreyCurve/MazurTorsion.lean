mechanical fix: the coarse-moduli universal property quantifies over
`T ⟶ SpecLoc R` alone, and the two hypotheses this theorem feeds can only
be satisfied on the GENERIC fibre.

**That is the mathematics, not an accident of the formalisation**, and it
is the whole of the 2026-07-30 re-cut.  `w_N` on the integral model is not
obtained by applying the moduli involution over `ℤ_(q)`; it is obtained by
constructing it on the ℚ-fibre and EXTENDING it across the special fibre.
So the `universal` step now runs on the GENERIC coarse space and the
extension leaf takes the generic `w_{Y,ℚ}` as its input, returning `w_𝒴`,
`w` and the compatibility that pins them.  **The statement of this node did
not change**, and neither did the mathematics either leaf below is asked
for; what changed is the fibre on which the pin is expressed.  Two things
worth recording about the repair:

* the two hypotheses fed below both had `_hpin` binders carrying a spare
  `gQ : T ⟶ SpecQ`, added at the merge as a stopgap.  Those binders were
  UNSATISFIABLE in combination with their `g : T ⟶ SpecLoc R`, not merely
  awkward, and they are gone;
* `wY ≫ wY = 𝟙 𝒴` is now a CONCLUSION of the extension leaf rather than
  something this node derives, because the involutivity of the integral
  `w_𝒴` cannot be obtained from `w_{Y,ℚ} ≫ w_{Y,ℚ} = 𝟙 Y` by any density
  argument available here: `eq_of_comp_open_x0JNeronModel` compares
  endomorphisms of `𝒳` against their restriction to `𝒴`, and there is no
  twin comparing endomorphisms of `𝒴` against their generic fibre.  It is
  free for Deligne–Rapoport's construction, which is where the leaf lives. -/
theorem exists_atkinLehnerModelAut_of_jNeronDatum (N q : ℕ)
    (hN : N.Prime) (hq : q.Prime) (hqN : q ≠ N)
    {R : Subring ℚ} {toF : R →+* ZMod q}
    {Y X Y' X' YZ XZ : Scheme.{0}} {strY : Y ⟶ SpecQ} {strX : X ⟶ SpecQ}
    {strY' : Y' ⟶ SpecF q} {strX' : X' ⟶ SpecF q} {jY' : Y' ⟶ X'}
    {hc : IsCoarseModuliY0 N strY}
    {hX : IsCompactificationY0 strY strX}
    {hX' : IsX0Compactification N strX' strY' jY'}
    {hj : IsJMapOn N hc}
    {ystr : YZ ⟶ SpecLoc R} {xstr : XZ ⟶ SpecLoc R} {jZ : YZ ⟶ XZ}
    (d : IsX0JNeronDatum N q R toF hX hX' hj (ystr := ystr) (xstr := xstr) jZ) :
    ∃ (w : XZ ⟶ XZ) (wY : YZ ⟶ YZ) (hw : w ≫ xstr = xstr) (hwY : wY ≫ ystr = ystr),
      wY ≫ jZ = jZ ≫ w ∧ w ≫ w = 𝟙 XZ ∧
      ∃ x' : RelPoint strX' (𝟙 (SpecF q)), hX'.IsCusp x' ∧ neronSpAut d w hw x' ≠ x' := by
  obtain ⟨al⟩ := nonempty_atkinLehnerMorphism N
  -- STEP 2, on the GENERIC coarse space: the moduli action descends to a unique
  -- endomorphism of `Y_0(N)_ℚ`.  Over `Spec ℤ_(q)` this call cannot be written at
  -- all — `al.dual` needs the `ℚ`-structure of its test scheme — which is the
  -- release-17 regression recorded in the docstring.
  obtain ⟨wYQ, ⟨hwYQ, hfac⟩, -⟩ :=
    hc.universal strY (fun {_} g dd => hc.classify g (al.dual g dd))
      (by
        intro T' T h g g' hg dd' dd hbc
        exact hc.classify_natural h hg (al.dual_baseChange h hg hbc))
  have hpin : ∀ {T : Scheme.{0}} (g : T ⟶ SpecQ) (dd : Gamma0Datum N T),
      RelPoint.post wYQ hwYQ (hc.classify g dd) = hc.classify g (al.dual g dd) := by
    intro T g dd
    exact Subtype.ext (hfac g dd).symm
  -- `(E/C)/(E[N]/C) ≅ E`, read on moduli points
  have hdd : ∀ {T : Scheme.{0}} (g : T ⟶ SpecQ) (dd : Gamma0Datum N T),
      hc.classify g (al.dual g (al.dual g dd)) = hc.classify g dd := by
    intro T g dd
    rw [hc.classify_natural (𝟙 T) (Category.id_comp g) (al.dual_dual g dd)]
    exact Subtype.ext (Category.id_comp _)
  -- so `wYQ ≫ wYQ` and `𝟙 Y` factor the SAME natural transformation, hence agree
  have hinvQ : wYQ ≫ wYQ = 𝟙 Y := by
    refine (hc.universal strY (fun {_} g dd => hc.classify g dd)
      (by
        intro T' T h g g' hg dd' dd hbc
        exact hc.classify_natural h hg hbc)).unique
      (y₁ := wYQ ≫ wYQ) (y₂ := 𝟙 Y) ⟨by rw [Category.assoc, hwYQ, hwYQ], fun {_} g dd => ?_⟩
      ⟨Category.id_comp strY, fun {_} g dd => (Category.comp_id _).symm⟩
    rw [← Category.assoc, ← hfac, ← hfac, hdd]
  -- STEP 3: Deligne–Rapoport carry `w_{Y,ℚ}` onto the model
  obtain ⟨w, wY, hw, hwY, hcomm, hinvY, hgen⟩ :=
