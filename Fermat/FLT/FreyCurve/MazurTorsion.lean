`4 · 1369` with `exists_dvd_and_dvd_of_dvd_mul` and reads each prime part off
`Nat.dvd_prime_pow`. -/
theorem thirtySevenB_dvd_5476_cases {e : ℤ} (he : 0 < e) (h : e ∣ 5476) :
    e = 1 ∨ e = 2 ∨ e = 4 ∨ e = 37 ∨ e = 74 ∨ e = 148 ∨ e = 1369 ∨ e = 2738 ∨
      e = 5476 := by
  have hnat : e.natAbs ∣ 5476 := by
    have := Int.natAbs_dvd_natAbs.2 h
    simpa using this
  obtain ⟨d₁, d₂, h₁, h₂, hk⟩ :
      ∃ d₁ d₂, d₁ ∣ 4 ∧ d₂ ∣ 1369 ∧ e.natAbs = d₁ * d₂ :=
    exists_dvd_and_dvd_of_dvd_mul (by simpa using hnat)
  have hp : Nat.Prime 37 := by norm_num
  rw [show (4 : ℕ) = 2 ^ 2 by norm_num] at h₁
  rw [show (1369 : ℕ) = 37 ^ 2 by norm_num] at h₂
  obtain ⟨i, hi, rfl⟩ := (Nat.dvd_prime_pow (by norm_num)).1 h₁
  obtain ⟨j, hj, rfl⟩ := (Nat.dvd_prime_pow hp).1 h₂
  have hee : e = (e.natAbs : ℤ) := (Int.natAbs_of_nonneg he.le).symm
  rw [hk] at hee
  interval_cases i <;> interval_cases j <;> norm_num at hee ⊢ <;> omega

/-- **The nine cubic residues mod `63`** (2026-07-30, flt-lean-151).

`63 = 9 · 7` is the smallest modulus that separates all nine `2^a·37^b` classes
below: the cubes mod `63` are `{0, 1, 8, 27, 28, 35, 36, 55, 62}`, and
seventy-two of the eighty-one products `d·d'` miss that set. -/
theorem thirtySevenB_cube_emod_63 (c : ℤ) :
    c ^ 3 % 63 = 0 ∨ c ^ 3 % 63 = 1 ∨ c ^ 3 % 63 = 8 ∨ c ^ 3 % 63 = 27 ∨
      c ^ 3 % 63 = 28 ∨ c ^ 3 % 63 = 35 ∨ c ^ 3 % 63 = 36 ∨ c ^ 3 % 63 = 55 ∨
      c ^ 3 % 63 = 62 := by
  have hmm : c ≡ c % 63 [ZMOD 63] := by unfold Int.ModEq; omega
  have key : c ^ 3 % 63 = (c % 63) ^ 3 % 63 := hmm.pow 3
  rw [key]
  have h1 : 0 ≤ c % 63 := Int.emod_nonneg _ (by norm_num)
  have h2 : c % 63 < 63 := Int.emod_lt_of_pos _ (by norm_num)
  set s := c % 63 with hs
  clear_value s
  interval_cases s <;> norm_num

/-- **A cube divided by a cube is a cube**: `k · t³ = p³` with `t ≠ 0` forces
`k` to be a cube (2026-07-30, flt-lean-151).

`Int.pow_dvd_pow_iff` gives `t ∣ p`, and cancelling `t³` identifies `k` with the
cube of the quotient.  This is what turns `hprod` into `p = c·m·n` below. -/
theorem exists_cube_of_mul_pow_three {k t p : ℤ} (ht : t ≠ 0) (h : k * t ^ 3 = p ^ 3) :
    ∃ c : ℤ, k = c ^ 3 := by
  have hdvd : t ^ 3 ∣ p ^ 3 := ⟨k, by rw [← h]; ring⟩
  obtain ⟨c, hc⟩ := (Int.pow_dvd_pow_iff (n := 3) (by norm_num)).1 hdvd
  refine ⟨c, ?_⟩
  have h3 : t ^ 3 ≠ 0 := pow_ne_zero _ ht
  have : k * t ^ 3 = c ^ 3 * t ^ 3 := by rw [h, hc]; ring
  exact mul_right_cancel₀ h3 this

