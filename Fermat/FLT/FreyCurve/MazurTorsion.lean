  have hXpos : 0 < X := by omega
  have hYpos : 0 < Y := by omega
  have hn4 : (2 * ((e.natAbs : ℤ))) ^ 4 = 16 * e ^ 4 := by
    have h := natAbs_pow_four_eq e
    calc (2 * ((e.natAbs : ℤ))) ^ 4 = 16 * ((e.natAbs : ℤ)) ^ 4 := by ring
