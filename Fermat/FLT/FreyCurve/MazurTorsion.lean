    (E : WeierstrassCurve ℚ) [E.IsElliptic] {p : ℕ}
    (hp : p ∈ ({37, 43, 67, 163} : Finset ℕ))
    (Q : (E⁄ℚ).Point) : addOrderOf Q ≠ p := by
