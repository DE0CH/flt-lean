theorem exists_inj_point_x0Model_of_relPointEquiv (N : ℕ) (_hN : N ∈ levels)
    {X Y : Scheme.{0}} {strX : X ⟶ SpecQ} {strY : Y ⟶ SpecQ} {jY : Y ⟶ X}
