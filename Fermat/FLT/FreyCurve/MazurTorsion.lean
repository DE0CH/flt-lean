  rcases h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact key 2 (by decide) (by decide) rfl (card_y0Le_thirtySeven hX.coarse)
