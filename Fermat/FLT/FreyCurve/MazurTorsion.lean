  set E := d.spX (specFDStr q) (specFDStr q ≫ SpecLoc.special toF) rfl with hE
  have hnat : ∀ v : RelPoint strX' (specFDStr q),
      d.spX (𝟙 (SpecF q)) (SpecLoc.special toF) (Category.id_comp _)
