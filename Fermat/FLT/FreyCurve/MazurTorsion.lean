    exact hℓprime.one_lt.ne' hx₀.symm
  have hx₀torsion : (ℓ : ℤ) • (x₀ : (E⁄(AlgebraicClosure ℚ)).Point) = 0 := by
    have h1 : (ℓ : ℕ) • x₀ = 0 := by rw [← hx₀]; exact addOrderOf_nsmul_eq_zero x₀
