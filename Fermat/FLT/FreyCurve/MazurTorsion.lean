* hence `C = ordCompl[37] (ordCompl[2] A)` has ALL exponents divisible by `3` and
  is a cube by `exists_cube_of_forall_three_dvd_factorization` above;
* `A = 2^a·37^b·C` by `ordProj_mul_ordCompl_eq_self` twice, and splitting
  `a = 3⌊a/3⌋ + a % 3` moves the cube parts of the `2`- and `37`-powers inside,
  leaving `d = 2^{a % 3}·37^{b % 3} ∣ 2²·37²`;
* the SIGN is free because `3` is odd: `α = −A` is handled by negating `m`.

The degenerate `β = 0` case is included and needs no separate treatment — every
prime then divides `β`, so `hsupp` says `α`'s support is already inside `{2, 37}`
and `C = 1`. -/
theorem exists_cubeClass_of_supp_dvd_296 {α β c : ℤ} (hα : α ≠ 0) (h : α * β = c ^ 3)
    (hsupp : ∀ ℓ : ℤ, Prime ℓ → ℓ ∣ α → ℓ ∣ β → ℓ ∣ 296) :
    ∃ d m : ℤ, 0 < d ∧ d ∣ 5476 ∧ α = d * m ^ 3 := by
  set A : ℕ := α.natAbs with hAdef
  have hA : A ≠ 0 := Int.natAbs_ne_zero.mpr hα
  -- **the key claim**: away from `2` and `37` the exponents of `α` are multiples of `3`
  have key : ∀ p : ℕ, p.Prime → p ≠ 2 → p ≠ 37 → 3 ∣ A.factorization p := by
    intro p hp hp2 hp37
    by_cases hpα : (p : ℤ) ∣ α
    · have hpβ : ¬ (p : ℤ) ∣ β := by
        intro hpβ
        have h296 : (p : ℤ) ∣ 296 := hsupp p (Nat.prime_iff_prime_int.mp hp) hpα hpβ
        have hn : p ∣ 296 := by
          have hnn : ((p : ℤ)).natAbs ∣ ((296 : ℤ)).natAbs := Int.natAbs_dvd_natAbs.mpr h296
          simpa using hnn
        rcases (Nat.Prime.dvd_mul hp).mp
            (by rw [show (296 : ℕ) = 2 ^ 3 * 37 by norm_num] at hn; exact hn) with h1 | h1
        · exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp (hp.dvd_of_dvd_pow h1))
        · exact hp37 ((Nat.prime_dvd_prime_iff_eq hp (by norm_num)).mp h1)
      have hβ : β ≠ 0 := fun hc => hpβ (hc ▸ dvd_zero _)
      have hβn : β.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hβ
      have hnat : A * β.natAbs = c.natAbs ^ 3 := by
        have hcg := congrArg Int.natAbs h
        simpa [Int.natAbs_mul, Int.natAbs_pow, hAdef] using hcg
      have hz : β.natAbs.factorization p = 0 := by
        refine Nat.factorization_eq_zero_of_not_dvd ?_
        intro hc
        exact hpβ (Int.natAbs_dvd_natAbs.mp (by simpa using hc))
      have hfac := congrArg (fun f : ℕ →₀ ℕ => f p) (congrArg Nat.factorization hnat)
      simp only [Nat.factorization_mul hA hβn, Nat.factorization_pow, Finsupp.add_apply,
        Finsupp.smul_apply, smul_eq_mul, hz, add_zero] at hfac
      exact ⟨c.natAbs.factorization p, hfac⟩
    · refine ⟨0, ?_⟩
      rw [Nat.factorization_eq_zero_of_not_dvd, mul_zero]
      intro hc
      exact hpα (Int.natAbs_dvd_natAbs.mp (by simpa using hc))
  set a : ℕ := A.factorization 2 with hadef
  set b : ℕ := A.factorization 37 with hbdef
  set C : ℕ := ordCompl[37] (ordCompl[2] A) with hCdef
  have hC0 : C ≠ 0 := by
    have h1 : ordCompl[2] A ≠ 0 := (Nat.ordCompl_pos 2 hA).ne'
    exact (Nat.ordCompl_pos 37 h1).ne'
  have hCfac : C.factorization = ((A.factorization.erase 2).erase 37) := by
    rw [hCdef, Nat.factorization_ordCompl, Nat.factorization_ordCompl]
  have hCcube : ∀ p, 3 ∣ C.factorization p := by
    intro p
    rw [hCfac]
    by_cases h37 : p = 37
    · simp [h37]
    by_cases h2 : p = 2
    · simp [h2, Finsupp.erase_same]
    rw [Finsupp.erase_ne h37, Finsupp.erase_ne h2]
    by_cases hp : p.Prime
    · exact key p hp h2 h37
    · simp [Nat.factorization_eq_zero_of_not_prime _ hp]
  obtain ⟨m₀, hm₀⟩ := exists_cube_of_forall_three_dvd_factorization hC0 hCcube
  -- **the decomposition of `A`**
  have hsplit : A = 2 ^ a * (37 ^ b * C) := by
    have e1 : ordProj[2] A * ordCompl[2] A = A := Nat.ordProj_mul_ordCompl_eq_self A 2
    have e2 : ordProj[37] (ordCompl[2] A) * C = ordCompl[2] A :=
      Nat.ordProj_mul_ordCompl_eq_self (ordCompl[2] A) 37
    have e3 : (ordCompl[2] A).factorization 37 = b := by
      rw [Nat.factorization_ordCompl, Finsupp.erase_ne (by norm_num : (37 : ℕ) ≠ 2), hbdef]
    rw [← e1, ← e2, e3, hadef]
  -- **regroup into `d * cube`**
  have h2pow : (2 : ℕ) ^ a = 2 ^ (a % 3) * (2 ^ (a / 3)) ^ 3 := by
    rw [← pow_mul, ← pow_add]
    congr 1
    omega
  have h37pow : (37 : ℕ) ^ b = 37 ^ (b % 3) * (37 ^ (b / 3)) ^ 3 := by
    rw [← pow_mul, ← pow_add]
    congr 1
    omega
  have hAeq : A = 2 ^ (a % 3) * 37 ^ (b % 3) * (2 ^ (a / 3) * 37 ^ (b / 3) * m₀) ^ 3 := by
    rw [hsplit, hm₀, h2pow, h37pow]
    ring
  have hi : a % 3 ≤ 2 := by omega
  have hj : b % 3 ≤ 2 := by omega
  have hd5476 : ((2 : ℤ) ^ (a % 3) * 37 ^ (b % 3)) ∣ 5476 := by
    rw [show (5476 : ℤ) = 2 ^ 2 * 37 ^ 2 by norm_num]
    exact mul_dvd_mul (pow_dvd_pow 2 hi) (pow_dvd_pow 37 hj)
  have hdpos : (0 : ℤ) < 2 ^ (a % 3) * 37 ^ (b % 3) := by positivity
  have hAZ : (A : ℤ)
      = 2 ^ (a % 3) * 37 ^ (b % 3) * ((2 ^ (a / 3) * 37 ^ (b / 3) * m₀ : ℕ) : ℤ) ^ 3 := by
    exact_mod_cast congrArg (fun n : ℕ => (n : ℤ)) hAeq
  rcases Int.natAbs_eq α with hs | hs
  · exact ⟨2 ^ (a % 3) * 37 ^ (b % 3), ((2 ^ (a / 3) * 37 ^ (b / 3) * m₀ : ℕ) : ℤ),
      hdpos, hd5476, by rw [hs]; exact hAZ⟩
  · refine ⟨2 ^ (a % 3) * 37 ^ (b % 3), -((2 ^ (a / 3) * 37 ^ (b / 3) * m₀ : ℕ) : ℤ),
      hdpos, hd5476, ?_⟩
    rw [hs, hAZ]
    ring

/-- **The positive divisors of `5476 = 2²·37²`, enumerated** (2026-07-30,
flt-lean-151; a step of `eq_zero_of_thirtySevenB_cubeClass` below).

