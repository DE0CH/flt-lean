pure duplication.  A successor who ever makes that import public should delete
these and cite `EllipticScheme.lean`. -/
theorem dense_compl_singleton_of_isOpen {X : Type*} [TopologicalSpace X]
    [ConnectedSpace X] {z : X} (hopen : IsOpen ({z}ᶜ : Set X))
    (hne : ({z}ᶜ : Set X).Nonempty) : Dense ({z}ᶜ : Set X) := by
  by_contra hd
  have hcl : IsClosed ({z}ᶜ : Set X) := by
    rw [← closure_eq_iff_isClosed]
    refine Set.Subset.antisymm (fun x hx => ?_) subset_closure
    rcases eq_or_ne x z with rfl | hxz
    · refine absurd (dense_iff_closure_eq.mpr (Set.eq_univ_of_forall fun y => ?_)) hd
      rcases eq_or_ne y x with rfl | hy
      · exact hx
      · exact subset_closure hy
    · exact hxz
  rcases isClopen_iff.mp ⟨hcl, hopen⟩ with h | h
  · exact hne.ne_empty h
  · have hz : z ∈ ({z}ᶜ : Set X) := Set.eq_univ_iff_forall.mp h z
    simp at hz

/-- **The range of a `K`-point of a scheme is a single point** (PROVEN), for any
field `K`: `Spec K` is a one-point space.  The `ℚ`-only
`Fermat.range_hom_specRat_eq_singleton` is not nameable here — see the
NAMEABILITY note above. -/
theorem range_hom_specField_eq_singleton {K : Type} [Field K] {X : Scheme.{0}}
    (s : Spec (CommRingCat.of K) ⟶ X) : ∃ z : X, Set.range s.base = {z} := by
  refine ⟨s.base (IsLocalRing.closedPoint K), ?_⟩
  ext y
  simp only [Set.mem_range, Set.mem_singleton_iff]
  constructor
  · rintro ⟨w, rfl⟩
    exact congrArg _ (Subsingleton.elim w _)
  · rintro rfl
    exact ⟨_, rfl⟩

/-- **A chart whose range is the complement of a `K`-point of a connected scheme
is dominant** (PROVEN, from the two lemmas above). -/
theorem isDominant_of_range_eq_compl_specField {K : Type} [Field K] {X C : Scheme.{0}}
    [ConnectedSpace X] [Nonempty C] (j : C ⟶ X) [IsOpenImmersion j]
    (s : Spec (CommRingCat.of K) ⟶ X)
    (hj : Set.range j.base = (Set.range s.base)ᶜ) : IsDominant j := by
  obtain ⟨z, hz⟩ := range_hom_specField_eq_singleton s
  rw [hz] at hj
  have hopen : IsOpen (Set.range j.base) := by
    rw [← Scheme.Hom.coe_opensRange]; exact j.opensRange.2
  have hne : (Set.range j.base).Nonempty := Set.range_nonempty _
  rw [hj] at hopen hne
  refine ⟨?_⟩
  show Dense (Set.range j.base)
  rw [hj]
  exact dense_compl_singleton_of_isOpen hopen hne

/-- **Two morphisms over a base that are mutually inverse on a dense open are
mutually inverse** (PROVEN) — the UNIQUENESS half of the gluing argument, and it
is formal.  Both `IsReduced` and both `IsSeparated` hypotheses are load-bearing;
no properness is used. -/
theorem isIso_of_isDominant_of_inverse {S P B C : Scheme.{0}}
    {p : P ⟶ S} {f : B ⟶ S} [IsSeparated p] [IsSeparated f]
    [IsReduced P] [IsReduced B]
    {ι₀ : C ⟶ P} {ι : C ⟶ B} [IsDominant ι₀] [IsDominant ι]
    (u : P ⟶ B) (v : B ⟶ P) (hu : u ≫ f = p) (hv : v ≫ p = f)
    (hu' : ι₀ ≫ u = ι) (hv' : ι ≫ v = ι₀) : IsIso u := by
  have h1 : u ≫ v = 𝟙 P :=
    ext_of_isDominant_of_isSeparated p (by rw [Category.assoc, hv, hu, Category.id_comp]) ι₀
      (by rw [← Category.assoc, hu', hv', Category.comp_id])
  have h2 : v ≫ u = 𝟙 B :=
    ext_of_isDominant_of_isSeparated f (by rw [Category.assoc, hu, hv, Category.id_comp]) ι
      (by rw [← Category.assoc, hv', hu', Category.comp_id])
  exact ⟨v, h1, h2⟩

/-- **Over an ALGEBRAICALLY CLOSED field two sections with the same image agree**
(PROVEN, from mathlib's `AlgebraicGeometry.ext_of_apply_closedPoint_eq`).

This is what replaces the `ℚ`-only `Fermat.hom_specRat_eq_of_range_eq`, and it
is where the base being `ℚ̄` is USED rather than merely tolerated: a `K`-point of
a locally-of-finite-type `K`-scheme is pinned by its image point exactly because
`K` is algebraically closed (the residue field of a closed point is then `K`
itself). -/
theorem section_eq_of_range_eq_algClos {K : Type} [Field K] [IsAlgClosed K]
    {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of K)) [LocallyOfFiniteType f]
    {s t : Spec (CommRingCat.of K) ⟶ A} (hs : s ≫ f = 𝟙 _) (ht : t ≫ f = 𝟙 _)
    (h : Set.range s.base = Set.range t.base) : s = t := by
  obtain ⟨z, hz⟩ := range_hom_specField_eq_singleton s
  obtain ⟨w, hw⟩ := range_hom_specField_eq_singleton t
  refine AlgebraicGeometry.ext_of_apply_closedPoint_eq f hs ht ?_
  have hset : ({z} : Set A) = {w} := by rw [← hz, ← hw, h]
  have hzw : z = w := by simpa using hset
  have h1 : s.base (IsLocalRing.closedPoint K) = z := by
    have hm : s.base (IsLocalRing.closedPoint K) ∈ Set.range s.base := ⟨_, rfl⟩
    rwa [hz, Set.mem_singleton_iff] at hm
  have h2 : t.base (IsLocalRing.closedPoint K) = w := by
    have hm : t.base (IsLocalRing.closedPoint K) ∈ Set.range t.base := ⟨_, rfl⟩
    rwa [hw, Set.mem_singleton_iff] at hm
  rw [h1, h2, hzw]

/-! #### THE CHANGE-OF-VARIABLES ISOMORPHISM OF COORDINATE RINGS — no leaf

(2026-07-30, flt-lean-33.)  This was cut as the single algebra leaf of
`nonempty_isEllipticIsoOf_of_variableChange_isWeierstrassModel` earlier the same
day and is CLOSED here; nothing in this subsection is open.

**What it says.**  A change of variables `V = ⟨u, r, s, t⟩` substitutes
`X ↦ u²X + r`, `Y ↦ u³Y + su²X + t`, and mathlib's `variableChange_a₁ … a₆` are
exactly the coefficients making

  `Φ_V(W.polynomial) = u⁶ · (V • W).polynomial`   in `R[X][Y]`

hold identically.  Since `u` is a UNIT, `Φ_V` carries `(W.polynomial)` onto
`((V • W).polynomial)`, so it descends to the `AdjoinRoot` quotients; `Φ_{V⁻¹}`
is its two-sided inverse, whence an `AlgEquiv`.

**NO GEOMETRY, NO BASE, NO LEVEL, NO `ℚ̄`.**  `R` is an arbitrary commutative
ring and `W` an arbitrary Weierstrass curve, not required elliptic.  Absent from
mathlib, from this project and from `~/cs/FLT` (checked 2026-07-30): mathlib has
the same substitution on POINTS (`Affine.Point.equivVariableChange`) but not its
ring-level shadow, so this is genuinely new material and is stated in full
generality so that it can be upstreamed.

**`u : Rˣ` IS LOAD-BEARING** and the statement is FALSE for a non-invertible
scaling: `X ↦ a²X`, `Y ↦ a³Y` with `a` a non-unit is an injection of coordinate
rings that is not surjective, and the two curves need not be isomorphic at all.
`VariableChange` carries `u` as a `Rˣ`, so the hypothesis is in the datum, and it
is consumed exactly at `variableChangeHom_comp_inv` through `V.u.mul_inv`.

**How the unit inverses are handled**, since this is the only technical point.
`variableChange_aᵢ` writes the new coefficients with `↑V.u⁻¹` powers, and `ring`
cannot know `u · u⁻¹ = 1`.  Rather than fight that inside the bivariate ring, the
five scalar identities `u⁶ · aᵢ' = u^{6−i} · (…)` are proven FIRST in `R`, each by
one `linear_combination … * V.u.mul_inv` with the geometric-series cofactor
`1 + uv + ⋯ + (uv)^{k−1}`; they are then lifted along `C ∘ C` and fed to a single
`linear_combination` in `R[X][Y]`.  Same device at the composition lemma. -/

/-- **The inner substitution `X ↦ u²X + r`**, as a ring hom `R[X] →+* R[X][Y]`
(PROVEN — a definition). -/
noncomputable def variableChangeSubX {R : Type} [CommRing R]
    (V : _root_.WeierstrassCurve.VariableChange R) :
    Polynomial R →+* Polynomial (Polynomial R) :=
  Polynomial.eval₂RingHom (Polynomial.C.comp Polynomial.C)
    (Polynomial.C (Polynomial.C ((V.u : R) ^ 2) * Polynomial.X + Polynomial.C V.r))

/-- **The image of the outer variable, `Y ↦ u³Y + u²sX + t`** (PROVEN — a
definition). -/
noncomputable def variableChangeSubY {R : Type} [CommRing R]
    (V : _root_.WeierstrassCurve.VariableChange R) : Polynomial (Polynomial R) :=
  Polynomial.C (Polynomial.C ((V.u : R) ^ 3)) * Polynomial.X
    + Polynomial.C (Polynomial.C ((V.u : R) ^ 2 * V.s) * Polynomial.X + Polynomial.C V.t)

/-- **THE SUBSTITUTION IDENTITY** (PROVEN 2026-07-30): the change of variables
carries `W`'s Weierstrass polynomial to `u⁶` times that of `V • W`.

This is the whole mathematical content of the subsection; everything after it is
bookkeeping. -/
theorem eval₂_variableChangeSub_polynomial {R : Type} [CommRing R]
    (W : _root_.WeierstrassCurve R) (V : _root_.WeierstrassCurve.VariableChange R) :
    Polynomial.eval₂ (variableChangeSubX V) (variableChangeSubY V) W.toAffine.polynomial
      = Polynomial.C (Polynomial.C ((V.u : R) ^ 6)) * (V • W).toAffine.polynomial := by
  have e1 : ((V.u : R)) ^ 6 * (V • W).a₁ = (V.u : R) ^ 5 * (W.a₁ + 2 * V.s) := by
    rw [_root_.WeierstrassCurve.variableChange_a₁]
    linear_combination ((V.u : R) ^ 5 * (W.a₁ + 2 * V.s)) * V.u.mul_inv
  have e2 : ((V.u : R)) ^ 6 * (V • W).a₂
      = (V.u : R) ^ 4 * (W.a₂ - V.s * W.a₁ + 3 * V.r - V.s ^ 2) := by
    rw [_root_.WeierstrassCurve.variableChange_a₂]
    linear_combination ((V.u : R) ^ 4 * (W.a₂ - V.s * W.a₁ + 3 * V.r - V.s ^ 2)
      * ((V.u : R) * ((V.u⁻¹ : Rˣ) : R) + 1)) * V.u.mul_inv
  have e3 : ((V.u : R)) ^ 6 * (V • W).a₃
      = (V.u : R) ^ 3 * (W.a₃ + V.r * W.a₁ + 2 * V.t) := by
    rw [_root_.WeierstrassCurve.variableChange_a₃]
    linear_combination ((V.u : R) ^ 3 * (W.a₃ + V.r * W.a₁ + 2 * V.t)
      * (((V.u : R) * ((V.u⁻¹ : Rˣ) : R)) ^ 2 + (V.u : R) * ((V.u⁻¹ : Rˣ) : R) + 1))
      * V.u.mul_inv
  have e4 : ((V.u : R)) ^ 6 * (V • W).a₄
      = (V.u : R) ^ 2 * (W.a₄ - V.s * W.a₃ + 2 * V.r * W.a₂
        - (V.t + V.r * V.s) * W.a₁ + 3 * V.r ^ 2 - 2 * V.s * V.t) := by
    rw [_root_.WeierstrassCurve.variableChange_a₄]
    linear_combination ((V.u : R) ^ 2 * (W.a₄ - V.s * W.a₃ + 2 * V.r * W.a₂
        - (V.t + V.r * V.s) * W.a₁ + 3 * V.r ^ 2 - 2 * V.s * V.t)
      * (((V.u : R) * ((V.u⁻¹ : Rˣ) : R)) ^ 3 + ((V.u : R) * ((V.u⁻¹ : Rˣ) : R)) ^ 2
        + (V.u : R) * ((V.u⁻¹ : Rˣ) : R) + 1)) * V.u.mul_inv
  have e6 : ((V.u : R)) ^ 6 * (V • W).a₆
      = W.a₆ + V.r * W.a₄ + V.r ^ 2 * W.a₂ + V.r ^ 3 - V.t * W.a₃ - V.t ^ 2
        - V.r * V.t * W.a₁ := by
    rw [_root_.WeierstrassCurve.variableChange_a₆]
    linear_combination ((W.a₆ + V.r * W.a₄ + V.r ^ 2 * W.a₂ + V.r ^ 3 - V.t * W.a₃ - V.t ^ 2
        - V.r * V.t * W.a₁)
      * (((V.u : R) * ((V.u⁻¹ : Rˣ) : R)) ^ 5 + ((V.u : R) * ((V.u⁻¹ : Rˣ) : R)) ^ 4
        + ((V.u : R) * ((V.u⁻¹ : Rˣ) : R)) ^ 3 + ((V.u : R) * ((V.u⁻¹ : Rˣ) : R)) ^ 2
        + (V.u : R) * ((V.u⁻¹ : Rˣ) : R) + 1)) * V.u.mul_inv
  have E1 := congrArg
    (fun z : R => (Polynomial.C (Polynomial.C z) : Polynomial (Polynomial R))) e1
  have E2 := congrArg
    (fun z : R => (Polynomial.C (Polynomial.C z) : Polynomial (Polynomial R))) e2
  have E3 := congrArg
    (fun z : R => (Polynomial.C (Polynomial.C z) : Polynomial (Polynomial R))) e3
  have E4 := congrArg
    (fun z : R => (Polynomial.C (Polynomial.C z) : Polynomial (Polynomial R))) e4
  have E6 := congrArg
    (fun z : R => (Polynomial.C (Polynomial.C z) : Polynomial (Polynomial R))) e6
  simp only [map_mul, map_add, map_sub, map_pow, map_ofNat] at E1 E2 E3 E4 E6
  simp only [_root_.WeierstrassCurve.Affine.polynomial, variableChangeSubX, variableChangeSubY]
  simp only [Polynomial.eval₂_add, Polynomial.eval₂_sub, Polynomial.eval₂_mul,
    Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C,
    Polynomial.coe_eval₂RingHom, RingHom.coe_comp, Function.comp_apply,
    map_add, map_mul, map_pow]
  linear_combination
    (-(Polynomial.C (Polynomial.X : Polynomial R) * (Polynomial.X : Polynomial (Polynomial R))))
      * E1
    - (Polynomial.X : Polynomial (Polynomial R)) * E3
    + (Polynomial.C (Polynomial.X : Polynomial R)) ^ 2 * E2
    + (Polynomial.C (Polynomial.X : Polynomial R)) * E4 + E6

/-- **The induced ring map on affine coordinate rings** (PROVEN — a definition
plus its well-definedness, which is the substitution identity read modulo
`(V • W).polynomial`). -/
noncomputable def coordinateRingMap {R : Type} [CommRing R] (W : _root_.WeierstrassCurve R)
    (V : _root_.WeierstrassCurve.VariableChange R) :
    W.toAffine.CoordinateRing →+* (V • W).toAffine.CoordinateRing :=
  AdjoinRoot.lift
    ((AdjoinRoot.mk (V • W).toAffine.polynomial).comp (variableChangeSubX V))
    (AdjoinRoot.mk (V • W).toAffine.polynomial (variableChangeSubY V))
    (by
      rw [← Polynomial.hom_eval₂, eval₂_variableChangeSub_polynomial, map_mul,
        AdjoinRoot.mk_self, mul_zero])

/-- **The substitution as a ring endomorphism of `R[X][Y]`** (PROVEN — a
definition).  Stated separately from `coordinateRingMap` because the INVERSION
argument lives at this level, where there are no dependent types: `Φ_{V⁻¹} ∘ Φ_V`
is an identity of endomorphisms of one fixed ring, whereas
`coordinateRingMap (V • W) V⁻¹` would land in `(V⁻¹ • (V • W)).CoordinateRing`
and need a transport along `inv_smul_smul`. -/
noncomputable def variableChangeHom {R : Type} [CommRing R]
    (V : _root_.WeierstrassCurve.VariableChange R) :
    Polynomial (Polynomial R) →+* Polynomial (Polynomial R) :=
  Polynomial.eval₂RingHom (variableChangeSubX V) (variableChangeSubY V)

@[simp] theorem variableChangeHom_C {R : Type} [CommRing R]
    (V : _root_.WeierstrassCurve.VariableChange R) (q : Polynomial R) :
    variableChangeHom V (Polynomial.C q) = variableChangeSubX V q := by
  simp [variableChangeHom]

@[simp] theorem variableChangeHom_X {R : Type} [CommRing R]
    (V : _root_.WeierstrassCurve.VariableChange R) :
    variableChangeHom V (Polynomial.X : Polynomial (Polynomial R))
      = variableChangeSubY V := by
  simp [variableChangeHom]

@[simp] theorem variableChangeSubX_C {R : Type} [CommRing R]
    (V : _root_.WeierstrassCurve.VariableChange R) (a : R) :
    variableChangeSubX V (Polynomial.C a) = Polynomial.C (Polynomial.C a) := by
  simp [variableChangeSubX]

@[simp] theorem variableChangeSubX_X {R : Type} [CommRing R]
    (V : _root_.WeierstrassCurve.VariableChange R) :
    variableChangeSubX V (Polynomial.X : Polynomial R)
      = Polynomial.C (Polynomial.C ((V.u : R) ^ 2) * Polynomial.X + Polynomial.C V.r) := by
  simp [variableChangeSubX]

/-- **THE SUBSTITUTIONS OF `V` AND `V⁻¹` ARE MUTUALLY INVERSE** (PROVEN
2026-07-30), as endomorphisms of `R[X][Y]`.

Two ring homs out of `R[X][Y]` agree once they agree on `C (C a)`, on `C X` and
at `Y`, which is `Polynomial.ringHom_ext` applied twice; the three computations
are then the identities `u²·u⁻² = 1`, and `(rs − t) − sr + t = 0`. -/
theorem variableChangeHom_comp_inv {R : Type} [CommRing R]
    (V : _root_.WeierstrassCurve.VariableChange R) :
    (variableChangeHom V⁻¹).comp (variableChangeHom V)
      = RingHom.id (Polynomial (Polynomial R)) := by
  have hu : (V.u : R) * ((V.u⁻¹ : Rˣ) : R) = 1 := V.u.mul_inv
  have hU : (Polynomial.C ((V.u : R)) * Polynomial.C (((V.u⁻¹ : Rˣ) : R)) : Polynomial R)
      = 1 := by rw [← map_mul, hu, map_one]
  have hUU : (Polynomial.C (Polynomial.C ((V.u : R)))
      * Polynomial.C (Polynomial.C (((V.u⁻¹ : Rˣ) : R)))
      : Polynomial (Polynomial R)) = 1 := by rw [← map_mul, ← map_mul, hu, map_one, map_one]
  refine Polynomial.ringHom_ext ?_ ?_
  · intro q
    have key : ((variableChangeHom V⁻¹).comp (variableChangeHom V)).comp
          (Polynomial.C : Polynomial R →+* Polynomial (Polynomial R))
        = (Polynomial.C : Polynomial R →+* Polynomial (Polynomial R)) := by
      refine Polynomial.ringHom_ext ?_ ?_
      · intro a
        simp
      · simp only [RingHom.comp_apply, variableChangeHom_C, variableChangeSubX_X,
          variableChangeHom_C, _root_.WeierstrassCurve.VariableChange.inv_def]
        simp only [variableChangeSubX, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_add,
          Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X, RingHom.coe_comp,
          Function.comp_apply]
        have hinner : (Polynomial.C ((V.u : R) ^ 2)
              * (Polynomial.C (((V.u⁻¹ : Rˣ) : R) ^ 2) * Polynomial.X
                + Polynomial.C (-V.r * ((V.u⁻¹ : Rˣ) : R) ^ 2))
              + Polynomial.C V.r : Polynomial R) = Polynomial.X := by
          simp only [map_pow, map_mul, map_neg]
          linear_combination ((Polynomial.C ((V.u : R)) * Polynomial.C (((V.u⁻¹ : Rˣ) : R)) + 1)
            * (Polynomial.X - Polynomial.C V.r)) * hU
        rw [← map_mul, ← map_add, hinner]
    exact RingHom.congr_fun key q
  · simp only [RingHom.comp_apply, variableChangeHom_X, RingHom.id_apply]
    simp only [variableChangeSubY, _root_.WeierstrassCurve.VariableChange.inv_def]
    simp only [map_add, map_mul, variableChangeHom_C, variableChangeHom_X,
      variableChangeSubX_C, variableChangeSubY, variableChangeSubX,
      Polynomial.coe_eval₂RingHom, Polynomial.eval₂_add, Polynomial.eval₂_mul,
      Polynomial.eval₂_C, Polynomial.eval₂_X, RingHom.coe_comp, Function.comp_apply,
      map_pow, map_neg, map_sub, Polynomial.C_pow, Polynomial.C_neg, Polynomial.C_sub,
      Polynomial.C_mul, Polynomial.C_add]
    linear_combination
      ((Polynomial.X : Polynomial (Polynomial R))
          * ((Polynomial.C (Polynomial.C ((V.u : R)))
              * Polynomial.C (Polynomial.C (((V.u⁻¹ : Rˣ) : R)))) ^ 2
            + Polynomial.C (Polynomial.C ((V.u : R)))
              * Polynomial.C (Polynomial.C (((V.u⁻¹ : Rˣ) : R))) + 1)
        - Polynomial.C (Polynomial.C V.s) * Polynomial.C (Polynomial.X : Polynomial R)
            * (Polynomial.C (Polynomial.C ((V.u : R)))
              * Polynomial.C (Polynomial.C (((V.u⁻¹ : Rˣ) : R)))) ^ 2
        + (Polynomial.C (Polynomial.C V.r) * Polynomial.C (Polynomial.C V.s)
            - Polynomial.C (Polynomial.C V.t))
            * ((Polynomial.C (Polynomial.C ((V.u : R)))
                * Polynomial.C (Polynomial.C (((V.u⁻¹ : Rˣ) : R)))) ^ 2
              + Polynomial.C (Polynomial.C ((V.u : R)))
                * Polynomial.C (Polynomial.C (((V.u⁻¹ : Rˣ) : R))) + 1)
        - Polynomial.C (Polynomial.C V.s) * Polynomial.C (Polynomial.C V.r)
            * (Polynomial.C (Polynomial.C ((V.u : R)))
              * Polynomial.C (Polynomial.C (((V.u⁻¹ : Rˣ) : R))) + 1)) * hUU

/-- **The inverse substitution's induced ring map** (PROVEN — a definition).
Its well-definedness is the substitution identity for `V⁻¹` applied to `V • W`,
where `inv_smul_smul` turns `V⁻¹ • (V • W)` back into `W`. -/
noncomputable def coordinateRingMapInv {R : Type} [CommRing R] (W : _root_.WeierstrassCurve R)
    (V : _root_.WeierstrassCurve.VariableChange R) :
    (V • W).toAffine.CoordinateRing →+* W.toAffine.CoordinateRing :=
  AdjoinRoot.lift
    ((AdjoinRoot.mk W.toAffine.polynomial).comp (variableChangeSubX V⁻¹))
    (AdjoinRoot.mk W.toAffine.polynomial (variableChangeSubY V⁻¹))
    (by
      rw [← Polynomial.hom_eval₂, eval₂_variableChangeSub_polynomial, inv_smul_smul,
        map_mul, AdjoinRoot.mk_self, mul_zero])

theorem coordinateRingMap_mk {R : Type} [CommRing R] (W : _root_.WeierstrassCurve R)
    (V : _root_.WeierstrassCurve.VariableChange R) (p : Polynomial (Polynomial R)) :
    coordinateRingMap W V (AdjoinRoot.mk W.toAffine.polynomial p)
      = AdjoinRoot.mk (V • W).toAffine.polynomial (variableChangeHom V p) := by
  rw [coordinateRingMap, AdjoinRoot.lift_mk, ← Polynomial.hom_eval₂]
  rfl

theorem coordinateRingMapInv_mk {R : Type} [CommRing R] (W : _root_.WeierstrassCurve R)
    (V : _root_.WeierstrassCurve.VariableChange R) (p : Polynomial (Polynomial R)) :
    coordinateRingMapInv W V (AdjoinRoot.mk (V • W).toAffine.polynomial p)
      = AdjoinRoot.mk W.toAffine.polynomial (variableChangeHom V⁻¹ p) := by
  rw [coordinateRingMapInv, AdjoinRoot.lift_mk, ← Polynomial.hom_eval₂]
  rfl

/-- **The change-of-variables map on coordinate rings is BIJECTIVE** (PROVEN
2026-07-30), from `variableChangeHom_comp_inv` and surjectivity of
`AdjoinRoot.mk`. -/
theorem bijective_coordinateRingMap {R : Type} [CommRing R] (W : _root_.WeierstrassCurve R)
    (V : _root_.WeierstrassCurve.VariableChange R) :
    Function.Bijective (coordinateRingMap W V) := by
  have hVV : (variableChangeHom V).comp (variableChangeHom V⁻¹)
      = RingHom.id (Polynomial (Polynomial R)) := by
    have h := variableChangeHom_comp_inv V⁻¹
    rwa [inv_inv] at h
  constructor
  · intro x y hxy
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective x
    obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective y
    have h := congrArg (coordinateRingMapInv W V) hxy
    rw [coordinateRingMap_mk, coordinateRingMap_mk, coordinateRingMapInv_mk,
      coordinateRingMapInv_mk] at h
    have hp := RingHom.congr_fun (variableChangeHom_comp_inv V) p
    have hq := RingHom.congr_fun (variableChangeHom_comp_inv V) q
    simp only [RingHom.comp_apply, RingHom.id_apply] at hp hq
    rwa [hp, hq] at h
  · intro z
    obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective z
    refine ⟨AdjoinRoot.mk W.toAffine.polynomial (variableChangeHom V⁻¹ q), ?_⟩
    rw [coordinateRingMap_mk]
    congr 1
    exact RingHom.congr_fun hVV q

/-- **The change-of-variables map is an `R`-algebra map** (PROVEN): it sends
`C (C a)` to itself, and `algebraMap R (AdjoinRoot W.polynomial)` is
`mk ∘ C ∘ C` through the `R ⟶ R[X] ⟶ R[W]` tower. -/
theorem coordinateRingMap_commutes {R : Type} [CommRing R] (W : _root_.WeierstrassCurve R)
    (V : _root_.WeierstrassCurve.VariableChange R) (a : R) :
    coordinateRingMap W V (algebraMap R W.toAffine.CoordinateRing a)
      = algebraMap R (V • W).toAffine.CoordinateRing a := by
  rw [IsScalarTower.algebraMap_apply R (Polynomial R) W.toAffine.CoordinateRing,
    IsScalarTower.algebraMap_apply R (Polynomial R) (V • W).toAffine.CoordinateRing,
    AdjoinRoot.algebraMap_eq, AdjoinRoot.algebraMap_eq, coordinateRingMap, AdjoinRoot.lift_of]
  show (AdjoinRoot.mk (V • W).toAffine.polynomial)
      (variableChangeSubX V (algebraMap R (Polynomial R) a))
    = (AdjoinRoot.mk (V • W).toAffine.polynomial)
      (Polynomial.C (algebraMap R (Polynomial R) a))
  congr 1
  rw [variableChangeSubX, Polynomial.coe_eval₂RingHom, Polynomial.algebraMap_eq,
    Polynomial.eval₂_C]
  rfl

/-- **A CHANGE OF VARIABLES INDUCES AN ISOMORPHISM OF AFFINE COORDINATE RINGS**
(introduced 2026-07-30, flt-lean-33, as the ONLY residue of
`nonempty_isEllipticIsoOf_of_variableChange_isWeierstrassModel`; **PROVEN the
same day over the subsection above — it is no longer a leaf, and it added
none**).

`coordinateRingMap` is bijective and commutes with `algebraMap R`, so it IS an
`R`-algebra isomorphism.  The `Nonempty` wrapper is kept rather than exposing the
map itself because the consumer only ever needs existence, and because the
concrete map is available by name for anyone who needs it.

NOT VACUOUS: `V = 1` gives the identity, and the conclusion is an `AlgEquiv`, not
a bare ring map, so it cannot be discharged by a degenerate quotient. -/
theorem nonempty_algEquiv_coordinateRing_of_variableChange {R : Type} [CommRing R]
    (W : _root_.WeierstrassCurve R) (C : _root_.WeierstrassCurve.VariableChange R) :
    Nonempty (W.toAffine.CoordinateRing ≃ₐ[R] (C • W).toAffine.CoordinateRing) :=
  ⟨{ RingEquiv.ofBijective (coordinateRingMap W C) (bijective_coordinateRingMap W C) with
     commutes' := coordinateRingMap_commutes W C }⟩

/-- **The affine Weierstrass curves of `R`-algebra-isomorphic coordinate rings
are isomorphic over the base** (PROVEN — `Spec` of the algebra isomorphism).

Stated separately from the leaf above so that the leaf contains no schemes at
all: this is the only place `Spec` meets the change of variables. -/
theorem exists_isIso_weierstrassAffine_of_algEquiv {R : Type} [CommRing R]
    (W₁ W₂ : _root_.WeierstrassCurve R)
    (e : W₁.toAffine.CoordinateRing ≃ₐ[R] W₂.toAffine.CoordinateRing) :
    ∃ χ : weierstrassAffine W₁ ⟶ weierstrassAffine W₂,
      IsIso χ ∧ χ ≫ weierstrassAffineStr W₂ = weierstrassAffineStr W₁ := by
  show ∃ χ : Spec (CommRingCat.of W₁.toAffine.CoordinateRing) ⟶
        Spec (CommRingCat.of W₂.toAffine.CoordinateRing),
      IsIso χ ∧ χ ≫ Spec.map (CommRingCat.ofHom (algebraMap R W₂.toAffine.CoordinateRing))
        = Spec.map (CommRingCat.ofHom (algebraMap R W₁.toAffine.CoordinateRing))
  have h1 : CommRingCat.ofHom e.toRingEquiv.toRingHom ≫
      CommRingCat.ofHom e.symm.toRingEquiv.toRingHom
      = 𝟙 (CommRingCat.of W₁.toAffine.CoordinateRing) :=
    CommRingCat.hom_ext (RingHom.ext fun x => e.symm_apply_apply x)
  have h2 : CommRingCat.ofHom e.symm.toRingEquiv.toRingHom ≫
      CommRingCat.ofHom e.toRingEquiv.toRingHom
      = 𝟙 (CommRingCat.of W₂.toAffine.CoordinateRing) :=
    CommRingCat.hom_ext (RingHom.ext fun x => e.apply_symm_apply x)
  have h3 : CommRingCat.ofHom (algebraMap R W₂.toAffine.CoordinateRing) ≫
      CommRingCat.ofHom e.symm.toRingEquiv.toRingHom
      = CommRingCat.ofHom (algebraMap R W₁.toAffine.CoordinateRing) :=
    CommRingCat.hom_ext (RingHom.ext fun r => e.symm.commutes r)
  refine ⟨Spec.map (CommRingCat.ofHom e.symm.toRingEquiv.toRingHom),
    ⟨Spec.map (CommRingCat.ofHom e.toRingEquiv.toRingHom), ?_, ?_⟩, ?_⟩
  · rw [← Spec.map_comp, h1, Spec.map_id]
  · rw [← Spec.map_comp, h2, Spec.map_id]
  · rw [← Spec.map_comp, h3]

theorem nonempty_isEllipticIsoOf_of_variableChange_isWeierstrassModel {N : ℕ}
    {d₁ d₂ : Gamma0Datum N (Spec (CommRingCat.of (AlgebraicClosure ℚ)))}
    {W₁ W₂ : _root_.WeierstrassCurve (AlgebraicClosure ℚ)}
    (hW₁ : IsWeierstrassModel d₁.ab W₁) (hW₂ : IsWeierstrassModel d₂.ab W₂)
    (C : _root_.WeierstrassCurve.VariableChange (AlgebraicClosure ℚ)) (hC : C • W₁ = W₂) :
    Nonempty (IsEllipticIsoOf d₁ d₂) := by
  classical
  obtain ⟨ι₁, ho₁, hs₁, hr₁⟩ := hW₁
  obtain ⟨ι₂, ho₂, hs₂, hr₂⟩ := hW₂
  haveI := ho₁; haveI := ho₂
  haveI := d₁.ab.proper; haveI := d₂.ab.proper
  haveI := d₁.ab.smooth; haveI := d₂.ab.smooth
  haveI := d₁.ab.connected; haveI := d₂.ab.connected
  haveI := d₁.relativeDimensionOne; haveI := d₂.relativeDimensionOne
  haveI : IsReduced d₁.E := AlgebraicGeometry.isReduced_of_smooth_over_field d₁.f
  haveI : IsReduced d₂.E := AlgebraicGeometry.isReduced_of_smooth_over_field d₂.f
  haveI : ConnectedSpace d₁.E := GeometricallyConnected.connectedSpace_of_subsingleton (f := d₁.f)
  haveI : ConnectedSpace d₂.E := GeometricallyConnected.connectedSpace_of_subsingleton (f := d₂.f)
  haveI : Nonempty (weierstrassAffine W₁) := by
    show Nonempty (Spec (CommRingCat.of W₁.toAffine.CoordinateRing))
    infer_instance
  haveI : Nonempty (weierstrassAffine W₂) := by
    show Nonempty (Spec (CommRingCat.of W₂.toAffine.CoordinateRing))
    infer_instance
  -- **THE CHART ISOMORPHISM**, from the change of variables: this is the leaf.
  obtain ⟨e⟩ := nonempty_algEquiv_coordinateRing_of_variableChange W₁ C
  rw [hC] at e
  obtain ⟨χ, hχiso, hχstr⟩ := exists_isIso_weierstrassAffine_of_algEquiv W₁ W₂ e
  haveI := hχiso
  have hχsurj : Function.Surjective (χ.base : weierstrassAffine W₁ → weierstrassAffine W₂) :=
    (Scheme.homeoOfIso (asIso χ)).surjective
  -- both charts are dominant: their ranges are complements of single points
  haveI hd₁ : IsDominant ι₁ := isDominant_of_range_eq_compl_specField ι₁ _ hr₁
  haveI hd₂ : IsDominant ι₂ := isDominant_of_range_eq_compl_specField ι₂ _ hr₂
  haveI hdχ : IsDominant (χ ≫ ι₂) := by
    refine ⟨?_⟩
    show Dense (Set.range (χ ≫ ι₂).base)
    have hrng : Set.range ((χ ≫ ι₂).base) = Set.range ι₂.base := by
      simp only [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp]
      rw [hχsurj.range_eq, Set.image_univ]
    rw [hrng]
    exact hd₂.1
  -- the removed loci are single points, hence finite
  have hfin₁ : (Set.range ι₁.base)ᶜ.Finite := by
    obtain ⟨z, hz⟩ := range_hom_specField_eq_singleton
      (d₁.ab.zero (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).1
    rw [hr₁, compl_compl, hz]; exact Set.finite_singleton z
  have hfin₂ : (Set.range ι₂.base)ᶜ.Finite := by
    obtain ⟨z, hz⟩ := range_hom_specField_eq_singleton
      (d₂.ab.zero (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).1
    rw [hr₂, compl_compl, hz]; exact Set.finite_singleton z
  -- **THE TWO EXTENSIONS**, by the valuative criterion for a smooth proper curve
  have hφ₁ : (χ ≫ ι₂) ≫ d₂.f = weierstrassAffineStr W₁ := by
    rw [Category.assoc, hs₂, hχstr]
  obtain ⟨u, ⟨hu, huι⟩, -⟩ :=
    AlgebraicGeometry.exists_unique_extension_of_isSmoothProperCurve
      (strX := d₁.f) (j := ι₁) (strZ := d₂.f) d₁.ab.connected hfin₁ hs₁ (χ ≫ ι₂) hφ₁
  have hφ₂ : (inv χ ≫ ι₁) ≫ d₁.f = weierstrassAffineStr W₂ := by
    rw [Category.assoc, hs₁, ← hχstr, IsIso.inv_hom_id_assoc]
  obtain ⟨v, ⟨hv, hvι⟩, -⟩ :=
    AlgebraicGeometry.exists_unique_extension_of_isSmoothProperCurve
      (strX := d₂.f) (j := ι₂) (strZ := d₁.f) d₂.ab.connected hfin₂ hs₂ (inv χ ≫ ι₁) hφ₂
  have hvι' : (χ ≫ ι₂) ≫ v = ι₁ := by rw [Category.assoc, hvι, IsIso.hom_inv_id_assoc]
  haveI hiso : IsIso u :=
    isIso_of_isDominant_of_inverse (ι₀ := ι₁) (ι := χ ≫ ι₂) u v hu hv huι hvι'
  -- **THE ZERO SECTION IS PRESERVED**: `u` is a homeomorphism carrying the
  -- complement of one removed point onto the complement of the other.
  have hbij : Function.Bijective (u.base : d₁.E → d₂.E) :=
    (Scheme.homeoOfIso (asIso u)).bijective
  have hzrange : Set.range
        (((d₁.ab.zero (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).1 ≫ u).base)
      = Set.range ((d₂.ab.zero (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).1.base) := by
    have h1 : Set.range ((ι₁ ≫ u).base) = Set.range ι₂.base := by
      rw [huι]
      simp only [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp]
      rw [hχsurj.range_eq, Set.image_univ]
    simp only [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp] at h1 ⊢
    rw [hr₁, hr₂, Set.image_compl_eq hbij] at h1
    exact compl_injective h1
  have hzero : (d₁.ab.zero (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).1 ≫ u
      = (d₂.ab.zero (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).1 :=
    section_eq_of_range_eq_algClos d₂.f
      (by rw [Category.assoc, hu]
          exact (d₁.ab.zero (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).2)
      (d₂.ab.zero (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).2 hzrange
  -- **ASSEMBLY**
  have hw : d₁.f ≫ 𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))) = u ≫ d₂.f := by
    rw [Category.comp_id, hu]
  have hpb : IsPullback d₁.f u (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) d₂.f :=
    IsPullback.of_vert_isIso ⟨hw⟩
  have hpz : RelPoint.post u hu
        (d₁.ab.zero (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))))
      = d₂.ab.zero (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) := Subtype.ext hzero
  have hadd : IsAdditiveOn d₁.ab d₂.ab u hu := isAdditiveOn_of_post_zero d₁.ab d₂.ab hu hpz
  refine ⟨{ map := u, isPullback := hpb, map_zero := ?_, map_add := ?_ }⟩
  · intro T' g
    refine Subtype.ext ?_
    show (d₁.ab.zero g).1 ≫ u
        = (d₂.ab.zero (g ≫ 𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).1
    have z₁ : (d₁.ab.zero g).1
        = g ≫ (d₁.ab.zero (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).1 :=
      congrArg Subtype.val (d₁.ab.pre_zero g (Category.comp_id g)).symm
    have z₂ : (d₂.ab.zero (g ≫ 𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).1
        = (g ≫ 𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))
            ≫ (d₂.ab.zero (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).1 :=
      congrArg Subtype.val
        (d₂.ab.pre_zero (g ≫ 𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))
          (Category.comp_id _)).symm
    rw [z₁, z₂, Category.assoc, hzero, Category.comp_id]
  · intro T' g x y
    have hgg : (𝟙 T') ≫ g = g ≫ 𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))) := by
      rw [Category.id_comp, Category.comp_id]
    have halong : ∀ w : RelPoint d₁.f g,
        RelPoint.along u hpb.w w = RelPoint.pre (𝟙 T') hgg (RelPoint.post u hu w) :=
      fun w => Subtype.ext (Category.id_comp _).symm
    rw [halong, halong, halong, hadd x y, d₂.ab.pre_add]

/-- **CLASS NUMBER ONE: two `ℚ̄`-elliptic schemes with CM by the maximal order of
discriminant `−p` are isomorphic** (introduced 2026-07-27 by the cut
of `nonempty_isBaseChangeOf_of_isCMByRamifiedMaximalOrder` as steps 1–2 of that
node's three-step argument, with the LEVEL STRUCTURE REMOVED; **PROVEN
2026-07-28** over the four leaves and one proven lemma of the subsection note
above — it is no longer a leaf).

TRUE.  `phi_sq` says `φᵢ² − φᵢ + (p+1)/4 = 0`, so `ℤ[φᵢ] ⊆ End(Eᵢ)` is the order
of discriminant `1 − (p+1) = −p`; at `p ∈ {43, 67, 163}` — prime, `≡ 3 mod 4`,
squarefree — that discriminant is FUNDAMENTAL, so `ℤ[φᵢ]` is the maximal order
`O_{−p}` and `End(Eᵢ) = O_{−p}` (an order containing a maximal order equals it,
and `End` of an elliptic curve in characteristic `0` is `ℤ` or an order in an
imaginary quadratic field, so it cannot be larger).  Over an algebraically closed
field of characteristic `0` the elliptic curves with `End = O_K` are a principal
homogeneous space under `Cl(O_K)`, and `h(−43) = h(−67) = h(−163) = 1`
(PARI/GP `qfbclassno`, re-verified 2026-07-27), so there is exactly one such
curve up to isomorphism.

**The MAXIMALITY is what makes this true, and the obvious weakening is FALSE.**
With `ψ² = [−p]` in place of `phi_sq` the order is `ℤ[√−p]` of discriminant
`−4p`, and `h(−4·43) = h(−4·67) = h(−4·163) = 3`: three isomorphism classes, so
no such isomorphism need exist.  See the subsection note above
`IsCMByRamifiedMaximalOrder`.

**`hp` is load-bearing twice over** — for `(p+1)/4` (natural division) to be
exact, and for `−p` to be a class-number-one fundamental discriminant.  Neither
survives dropping it.

**WHAT WAS MISSING, AND WHERE IT NOW LIVES** (rewritten 2026-07-28).  The
previous version of this paragraph said: "`End` of an elliptic scheme as a ring,
the fact that it is an order in an imaginary quadratic field, and the
class-group action on the set of CM curves … a successor should expect to build
the class-group action, not to find it."  The first two items were **already in
this file**, ~12000 lines above, as `WeierstrassCurve.End` and
`WeierstrassCurve.End.exists_intBasis` — the note was searching the SCHEME axis
only.  Going through a Weierstrass model instead, the ring is free, the
"order in an imaginary quadratic field" step is `exists_intBasis`, and the
maximality step is PROVEN below as
`closure_singleton_eq_top_of_maximalOrderRel`.  What genuinely remains is the
class-group action, and it is now confined to the single leaf
`jInvariant_eq_of_end_closure_eq_top` — with the class-number-one input in the
weakest form that suffices ("one orbit"), not the Hilbert class polynomial.

The other two leaves this is proven over carry NO complex multiplication at all:
`exists_isWeierstrassModel_algClos` is Riemann–Roch over `ℚ̄` (the exact analogue
of a declaration already PROVEN over `ℚ`), and
`nonempty_isEllipticIsoOf_of_variableChange_isWeierstrassModel` is the
coordinates-to-moduli transport.  See the subsection note above for the route,
for why the CM leaf is stated pairwise, and for the `−p` vs `−4p` trap. -/
theorem nonempty_isEllipticIsoOf_of_isCMByRamifiedMaximalOrder (p : ℕ)
    (hp : p ∈ ({43, 67, 163} : Finset ℕ))
    {d₁ d₂ : Gamma0Datum p (Spec (CommRingCat.of (AlgebraicClosure ℚ)))}
    (h₁ : IsCMByRamifiedMaximalOrder p d₁) (h₂ : IsCMByRamifiedMaximalOrder p d₂) :
    Nonempty (IsEllipticIsoOf d₁ d₂) := by
  classical
  -- **1.** Riemann–Roch: both data have Weierstrass models over `ℚ̄`
  obtain ⟨W₁, hW₁ell, hW₁⟩ := exists_isWeierstrassModel_algClos d₁
  obtain ⟨W₂, hW₂ell, hW₂⟩ := exists_isWeierstrassModel_algClos d₂
  haveI := hW₁ell
  haveI := hW₂ell
  -- **2.** the CM endomorphisms, transported into `WeierstrassCurve.End`
  obtain ⟨φ₁, hφ₁⟩ := exists_end_of_isCMByRamifiedMaximalOrder p h₁ W₁ hW₁
  obtain ⟨φ₂, hφ₂⟩ := exists_end_of_isCMByRamifiedMaximalOrder p h₂ W₂ hW₂
  have hpm : (p : ℤ) = 4 * (((p + 1) / 4 : ℕ) : ℤ) - 1 := by fin_cases hp <;> norm_num
  have hppos : (0 : ℤ) < (p : ℤ) := by fin_cases hp <;> norm_num
  -- **3.** the order is MAXIMAL: `End(Wᵢ) = ℤ[φᵢ]`
  have htop₁ : Subring.closure ({φ₁} : Set (_root_.WeierstrassCurve.End W₁.toAffine)) = ⊤ :=
    closure_singleton_eq_top_of_maximalOrderRel (p : ℤ) (((p + 1) / 4 : ℕ) : ℤ) hpm hppos
      (sq_eq_one_of_sq_mul_eq_neg p hp) φ₁ (by rw [Int.cast_natCast]; exact hφ₁)
  have htop₂ : Subring.closure ({φ₂} : Set (_root_.WeierstrassCurve.End W₂.toAffine)) = ⊤ :=
    closure_singleton_eq_top_of_maximalOrderRel (p : ℤ) (((p + 1) / 4 : ℕ) : ℤ) hpm hppos
      (sq_eq_one_of_sq_mul_eq_neg p hp) φ₂ (by rw [Int.cast_natCast]; exact hφ₂)
  -- **4.** `h(−p) = 1` gives equal `j`, hence a change of variables over the
  -- separably closed `ℚ̄`, hence an isomorphism of the elliptic schemes
  obtain ⟨C, hC⟩ := _root_.WeierstrassCurve.exists_variableChange_of_j_eq W₁ W₂
    (jInvariant_eq_of_end_closure_eq_top p hp W₁ W₂ φ₁ φ₂ hφ₁ hφ₂ htop₁ htop₂)
  exact nonempty_isEllipticIsoOf_of_variableChange_isWeierstrassModel hW₁ hW₂ C hC

/-! #### The conjugation calculus `phi_or_conj_of_isEllipticIsoOf` runs on

(2026-07-28, flt-lean-126.)  Everything below is PROVEN, and it exists so that
`phi_or_conj_of_isEllipticIsoOf` can be reduced to ONE statement about `End(E₂)`
and nothing else.  Two annoyances have to be cleared out of the way first.

* **`RelPoint.along` shifts the base point** from `g` to `g ≫ 𝟙 T`, while
  `IsCMByRamifiedMaximalOrder.phi` and `d₂.ab.add` are indexed by whichever base
  point they are handed.  `relPointRebase` transports a relative point along an
  EQUALITY of base points; since `RelPoint f g` is a subtype of `T' ⟶ E` whose
  index appears only in the propositional component, every structure map commutes
  with it, and each such lemma is `subst` followed by `rfl`.
* **`α` has no written inverse.**  `IsEllipticIsoOf.isPullback` says the square
  over `𝟙 T` is cartesian, which is exactly invertibility, but `RelPoint.along`
  is the map at the SHIFTED base point.  `fwd`/`bwd` are the same two maps at the
  UNSHIFTED one, where they are mutually inverse group isomorphisms natural in the
  test object — i.e. an isomorphism of the functors of points, which is what
  conjugating an endomorphism needs. -/

/-- **Rebasing a relative point along an EQUALITY of base points** (PROVEN).

`RelPoint f g` is `{x : T' ⟶ A // x ≫ f = g}`, so `g` occurs only in the
propositional component: an equality `g = g'` moves a point from one index to the
other without touching the underlying morphism.  Used below only to absorb
`g ≫ 𝟙 T = g`, which is where `RelPoint.along` lands. -/
def relPointRebase {A T : Scheme.{0}} {f : A ⟶ T} {U : Scheme.{0}} {g g' : U ⟶ T}
    (hgg : g = g') (x : RelPoint f g) : RelPoint f g' :=
  ⟨x.1, x.2.trans hgg⟩

/-- **The group law commutes with `relPointRebase`** (PROVEN): `subst`, then `rfl`
by proof irrelevance and structure eta. -/
theorem add_relPointRebase {N : ℕ} {T : Scheme.{0}} (d : Gamma0Datum N T) {U : Scheme.{0}}
    {g g' : U ⟶ T} (hgg : g = g') (x y : RelPoint d.f g) :
    d.ab.add (relPointRebase hgg x) (relPointRebase hgg y)
      = relPointRebase hgg (d.ab.add x y) := by
  subst hgg; rfl

/-- **The CM endomorphism commutes with `relPointRebase`** (PROVEN), by the same
two steps.  Note this is NOT `phi_pre`: no test object moves, only the index. -/
theorem phi_relPointRebase {p : ℕ} {T : Scheme.{0}} {d : Gamma0Datum p T}
    (h : IsCMByRamifiedMaximalOrder p d) {U : Scheme.{0}} {g g' : U ⟶ T} (hgg : g = g')
    (x : RelPoint d.f g) :
    h.phi (relPointRebase hgg x) = relPointRebase hgg (h.phi x) := by
  subst hgg; rfl

namespace IsEllipticIsoOf

variable {N : ℕ} {T : Scheme.{0}} {d₁ d₂ : Gamma0Datum N T}

/-- **`α` on relative points at the UNSHIFTED base point** (PROVEN): the same
underlying morphism `x.1 ≫ α.map` as `RelPoint.along α.map α.isPullback.w x`, read
as a point over `g` rather than over `g ≫ 𝟙 T`. -/
def fwd (α : IsEllipticIsoOf d₁ d₂) {U : Scheme.{0}} {g : U ⟶ T}
    (x : RelPoint d₁.f g) : RelPoint d₂.f g :=
  ⟨x.1 ≫ α.map, by
    rw [Category.assoc, ← α.isPullback.w, ← Category.assoc, x.2, Category.comp_id]⟩

/-- **`RelPoint.along` IS `fwd`, up to the base-point shift** (PROVEN, by `rfl`:
the two underlying morphisms are literally the same composite).  This is the
bridge between the form the statement of the leaf is written in and the form the
conjugation calculus runs in. -/
theorem along_eq_rebase_fwd (α : IsEllipticIsoOf d₁ d₂) {U : Scheme.{0}} {g : U ⟶ T}
    (x : RelPoint d₁.f g) :
    RelPoint.along α.map α.isPullback.w x
      = relPointRebase (Category.comp_id g).symm (α.fwd x) := rfl

/-- **The inverse of `fwd`** (PROVEN), by the universal property of the cartesian
square — `Fermat.IsBaseChangeOf.alongInv` at the unshifted base point, which
cannot be reused because that one asks for the level-structure axiom
`IsEllipticIsoOf` drops. -/
noncomputable def bwd (α : IsEllipticIsoOf d₁ d₂) {U : Scheme.{0}} {g : U ⟶ T}
    (y : RelPoint d₂.f g) : RelPoint d₁.f g :=
  ⟨α.isPullback.lift g y.1 (by rw [Category.comp_id]; exact y.2.symm),
   α.isPullback.lift_fst _ _ _⟩

@[simp] theorem bwd_val_comp (α : IsEllipticIsoOf d₁ d₂) {U : Scheme.{0}} {g : U ⟶ T}
    (y : RelPoint d₂.f g) : (α.bwd y).1 ≫ α.map = y.1 :=
  α.isPullback.lift_snd _ _ _

@[simp] theorem fwd_bwd (α : IsEllipticIsoOf d₁ d₂) {U : Scheme.{0}} {g : U ⟶ T}
    (y : RelPoint d₂.f g) : α.fwd (α.bwd y) = y :=
  Subtype.ext (α.bwd_val_comp y)

@[simp] theorem bwd_fwd (α : IsEllipticIsoOf d₁ d₂) {U : Scheme.{0}} {g : U ⟶ T}
    (x : RelPoint d₁.f g) : α.bwd (α.fwd x) = x :=
  α.along_injective (by rw [α.bwd_val_comp]; rfl)

theorem fwd_inj (α : IsEllipticIsoOf d₁ d₂) {U : Scheme.{0}} {g : U ⟶ T}
    {a b : RelPoint d₁.f g} (h : α.fwd a = α.fwd b) : a = b := by
  rw [← α.bwd_fwd a, ← α.bwd_fwd b, h]

/-- **`fwd` preserves the zero section** (PROVEN), from `map_zero` and
`AbelianSchemeStruct.zero_val_congr` for the base-point shift. -/
theorem fwd_zero (α : IsEllipticIsoOf d₁ d₂) {U : Scheme.{0}} (g : U ⟶ T) :
    α.fwd (d₁.ab.zero g) = d₂.ab.zero g :=
  Subtype.ext ((congrArg Subtype.val (α.map_zero g)).trans
    (AbelianSchemeStruct.zero_val_congr d₂.ab (Category.comp_id g)))

/-- **`fwd` preserves the group law** (PROVEN), from `map_add` and
`AbelianSchemeStruct.add_val_congr` for the base-point shift. -/
theorem fwd_add (α : IsEllipticIsoOf d₁ d₂) {U : Scheme.{0}} {g : U ⟶ T}
    (x y : RelPoint d₁.f g) :
    α.fwd (d₁.ab.add x y) = d₂.ab.add (α.fwd x) (α.fwd y) :=
  Subtype.ext ((congrArg Subtype.val (α.map_add x y)).trans
    (AbelianSchemeStruct.add_val_congr d₂.ab (Category.comp_id g) _ _ _ _ rfl rfl))

/-- **`bwd` preserves the group law** (PROVEN), by applying `fwd` and cancelling. -/
theorem bwd_add (α : IsEllipticIsoOf d₁ d₂) {U : Scheme.{0}} {g : U ⟶ T}
    (x y : RelPoint d₂.f g) :
    α.bwd (d₂.ab.add x y) = d₁.ab.add (α.bwd x) (α.bwd y) :=
  α.fwd_inj (by rw [α.fwd_bwd, α.fwd_add, α.fwd_bwd, α.fwd_bwd])

/-- **`fwd` is natural in the test object** (PROVEN): associativity of
composition, and nothing else. -/
theorem fwd_pre (α : IsEllipticIsoOf d₁ d₂) {U' U : Scheme.{0}} (h : U' ⟶ U) {g : U ⟶ T}
    {g' : U' ⟶ T} (hg : h ≫ g = g') (x : RelPoint d₁.f g) :
    α.fwd (RelPoint.pre h hg x) = RelPoint.pre h hg (α.fwd x) :=
  Subtype.ext (Category.assoc _ _ _)

/-- **`bwd` is natural in the test object** (PROVEN), by `fwd`-injectivity. -/
theorem bwd_pre (α : IsEllipticIsoOf d₁ d₂) {U' U : Scheme.{0}} (h : U' ⟶ U) {g : U ⟶ T}
    {g' : U' ⟶ T} (hg : h ≫ g = g') (y : RelPoint d₂.f g) :
    α.bwd (RelPoint.pre h hg y) = RelPoint.pre h hg (α.bwd y) :=
  α.along_injective (by
    show (α.bwd (RelPoint.pre h hg y)).1 ≫ α.map = (h ≫ (α.bwd y).1) ≫ α.map
    rw [α.bwd_val_comp, Category.assoc, α.bwd_val_comp]
    rfl)

end IsEllipticIsoOf

/-! #### `End(d.E) = ℤ ⊕ ℤ·φ`, in the functor-of-points language

(2026-07-30, flt-lean-170.)  `phi_or_conj_of_isEllipticIsoOf` was decomposed on
2026-07-28 "down to a single sorried `have` — `hend` in the proof below".  That
`have` was an ANONYMOUS inner `sorry`: it carried a full `End`-ring theorem, it
was invisible to every frontier scan this project runs (the
`declaration uses 'sorry'` warning set counts DECLARATIONS, and the warning it
produced was attributed to `phi_or_conj_of_isEllipticIsoOf`, which reads as one
leaf rather than as a leaf plus an unowned sub-leaf), and so it could never be
dispatched at.  It is replaced here by the two NAMED leaves below plus a PROVEN
assembly, `phi_or_conj_of_natEnd`.

**The two leaves are the two halves of one classical statement**: `1, φ` is a
`ℤ`-BASIS of `End(d.E)`.  `intBasis_indep_of_isCMByRamifiedMaximalOrder` is
independence, `mem_intSpan_of_isCMByRamifiedMaximalOrder` is spanning.  They are
the functor-of-points twins of two facts this file already owns on the
`WeierstrassCurve` side — `End.exists_intBasis` (independence, PROVEN) and
`closure_singleton_eq_top_of_maximalOrderRel` (spanning, PROVEN) — so a successor
who builds the TRANSPORT gets both at once and neither is a new theory.  The
transport itself is the general form of `exists_end_of_isCMByRamifiedMaximalOrder`
(a leaf above): that one moves `h.phi` into `WeierstrassCurve.End W` for a
Weierstrass model `W` supplied by `exists_isWeierstrassModel_algClos`; what is
needed here is the same map applied to an ARBITRARY additive natural `u`,
together with its injectivity.

**CORRECTION 2026-07-30 (flt-lean-152): the two halves do NOT have the same
owner, and the sentence that said so cost nothing only because nobody acted on
it.**  The INDEPENDENCE half is now PROVEN with no transport at all — see its
docstring.  Independence is a statement about `ℤ[φ]` acting on points, and the
NORM `a² + ab + b²m` of `a + bφ` is an integer that `phi_sq` alone lets one
apply; positive-definiteness (`4N = (2a + b)² + p b²`) plus "no nonzero integer
kills every relative point" finishes it.  Only the SPANNING half needs to know
what `End(d.E)` IS, and that is where the transport is unavoidable.

**What the split buys, since the leaf count rises from one anonymous to two
named.**  Everything algebraic is now discharged: given the basis, the passage
from `u² − u + m = 0` to `u = φ ∨ u + φ = 1` is the computation in
`phi_or_conj_of_natEnd`, which needs no geometry at all — expand `u = a + bφ`,
use `φ² = φ − m`, and read off `b(2a + b − 1) = 0` and `a² − b²m + m − a = 0`
from independence.  The case `b = 0` dies on `(2a − 1)² = 1 − 4m = −p < 0`; the
case `2a + b = 1` collapses to `p·a(a − 1) = 0`, hence `a ∈ {0, 1}`, hence
`u = φ` or `u = 1 − φ`.  That is the whole of the old `hend` except the basis.

**Why the basis rather than "commutative + no zero divisors".**  The weaker pair
(`u` and `φ` commute; `v ∘ w = 0 ⟹ v = 0 ∨ w = 0`) also suffices — factor
`(u − φ)(u + φ − 1) = 0` — and was the first cut tried here.  The basis form is
preferred because it is a SINGLE classical statement with a single owner, because
it is what the two proven `WeierstrassCurve.End` declarations literally deliver,
and because commutativity alone does not pin `End` and would leave the successor
free to prove something strictly weaker than what the sibling
`jInvariant_eq_of_end_closure_eq_top` needs from the same transport.

**Both leaves are quantified over data satisfying `IsCMByRamifiedMaximalOrder`**,
which is satisfiable at each of `43, 67, 163` (see that structure's docstring for
the `ellisomat` check), so neither is vacuous; and `Gamma0Datum` carries
`relativeDimensionOne`, so `d.E` is a genuine elliptic curve over `ℚ̄` and not a
higher-dimensional abelian scheme — which is exactly what makes the independence
half true rather than an assertion about a trivial group. -/

/-- **No nonzero integer kills every relative point of a `Γ₀(N)`-datum over `ℚ̄`**
(PROVEN 2026-07-30, flt-lean-152).

This is the NOT-VACUOUS clause of the independence leaf below, turned into a
usable statement.  The witness is torsion: pick a prime `ℓ > n` (there are
infinitely many), take the first vector `y` of the level-`ℓ` torsion basis of
`d.E` at the base point supplied by
`Fermat.exists_torsionBasis_geomPoint` (PROVEN, `ModularCurve/X0.lean`), which
is where `d.relativeDimensionOne` is spent — it is what makes the `ℓ`-torsion
`(ℤ/ℓ)²` rather than `(ℤ/ℓ)^{2g}`.  Then `n • y = 0` would give `y` the two
distinct coordinate pairs `(0, 0)` and `(n mod ℓ, 0)` in the `∃!` clause, and
`n < ℓ` makes them distinct.

`ℓ ≥ n + 3` rather than `ℓ > n` only because `exists_torsionBasis_geomPoint`
asks for `3 ≤ ℓ`; primality of `ℓ` is not used at all beyond that. -/
theorem exists_nsmul_relPoint_ne_zero {N : ℕ}
    (d : Gamma0Datum N (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) (n : ℕ) (hn : n ≠ 0) :
    ∃ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (x : RelPoint d.f g),
      letI := d.ab.addCommGroup g
      n • x ≠ 0 := by
  obtain ⟨ℓ, hℓge, hℓp⟩ := Nat.exists_infinite_primes (n + 3)
  have hℓ3 : 3 ≤ ℓ := by omega
  have hnl : n < ℓ := by omega
  obtain ⟨y, z, hyz⟩ := exists_torsionBasis_geomPoint ℓ hℓ3 d.ab d.relativeDimensionOne
    (Spec.map (CommRingCat.ofHom (algebraMap ℚ (AlgebraicClosure ℚ))))
    (AlgebraicClosure ℚ) (𝟙 _)
  refine ⟨_, 𝟙 _, y, ?_⟩
  letI := d.ab.addCommGroup (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))
  intro hny
  obtain ⟨c₀, -, huniq⟩ := (hyz 0).mp (by simp)
  have h1 : ((⟨0, by omega⟩ : Fin ℓ), (⟨0, by omega⟩ : Fin ℓ)) = c₀ := huniq _ (by simp)
  have h2 : ((⟨n, hnl⟩ : Fin ℓ), (⟨0, by omega⟩ : Fin ℓ)) = c₀ := huniq _ (by
    show (0 : RelPoint d.f _) = (n : ℕ) • y + (0 : ℕ) • z
    rw [hny, zero_smul, add_zero])
  have := congrArg (fun c : Fin ℓ × Fin ℓ => (c.1 : ℕ)) (h1.trans h2.symm)
  exact hn (by simpa using this.symm)

/-- **`1` and `φ` are `ℤ`-INDEPENDENT in `End(d.E)`** (**PROVEN 2026-07-30**,
flt-lean-152, over `exists_nsmul_relPoint_ne_zero` above; introduced
2026-07-30 by the naming of `phi_or_conj_of_isEllipticIsoOf`'s anonymous `hend`,
the independence half of "`1, φ` is a `ℤ`-basis of `End(d.E)`").

**The proof taken is NOT the route the paragraphs below describe, and the
difference is worth recording.**  Those paragraphs propose transporting to
`WeierstrassCurve.End` and quoting the independence clause of
`End.exists_intBasis`.  That is unnecessary: independence needs only the NORM
form, and the norm of `a + bφ` is an honest integer that acts on points through
`phi_sq` alone.  Multiplying the hypothesis by the conjugate `(a + b) − bφ`
gives `N • x = 0` for every relative point `x`, with
`4N = (2a + b)² + p·b² > 0` unless `a = b = 0`; and a nonzero integer cannot
kill every relative point, because the `ℓ`-torsion for a large prime `ℓ` is
`(ℤ/ℓ)²`.  So the transport leaf
(`exists_end_of_isCMByRamifiedMaximalOrder`, still open) is NOT a prerequisite
of this half — only of its spanning twin, where it really is unavoidable.

TRUE.  `d.E` is an elliptic curve over `ℚ̄` (`Gamma0Datum.relativeDimensionOne`
together with `d.ab`'s properness, smoothness and geometric connectedness), so
`End(d.E)` is `ℤ` or an order in an imaginary quadratic field (Silverman *AEC*
III.9.4 with Deuring's characteristic-`0` case), and in either case it is
TORSION-FREE as a `ℤ`-module.  `φ` is not an integer: `φ² − φ + m = 0` with
`4m = p + 1` would give `(2c − 1)² = 1 − 4m = −p < 0` for an integer root `c`.
So `End(d.E)` has rank `2` with `ℚ(φ) = ℚ(√−p)`, and `a + bφ = 0` forces
`a = b = 0`.  This is the functor-of-points twin of the independence clause of
`WeierstrassCurve.End.exists_intBasis` (PROVEN above in this file).

**The `∀ U g x` shape is the right one and is not stronger than "the
endomorphism `a + bφ` is zero".**  An endomorphism of the functor of points is
zero exactly when it kills every relative point, which is what is written; no
Yoneda step is hidden in the hypothesis.

**`hp` is retained but only SQUAREFREENESS and `p > 0` are used here** — `p > 0`
is what makes `1 − 4m = −p` negative, hence `φ ∉ ℤ`.  It is kept in the signature
so that this leaf and its spanning twin have the same hypotheses and can be
discharged from one transport; a successor who proves it for all `p ≡ 3 mod 4`
may drop it freely, and nothing downstream would change.

**NOT VACUOUS, and this is the clause that carries the risk.**  Were
`RelPoint d.f g` trivial for every `g`, the hypothesis would hold for every
`a, b` and the leaf would be FALSE.  It is not: `d.ab.zero` and
`d.relativeDimensionOne` make `d.f` a smooth proper genuinely one-dimensional
group scheme, so its `ℚ̄`-points are the points of an elliptic curve.  A
successor must use that; a proof that never touches
`relativeDimensionOne` is proving something false. -/
theorem intBasis_indep_of_isCMByRamifiedMaximalOrder (p : ℕ)
    (_hp : p ∈ ({43, 67, 163} : Finset ℕ))
    {d : Gamma0Datum p (Spec (CommRingCat.of (AlgebraicClosure ℚ)))}
    (h : IsCMByRamifiedMaximalOrder p d) (a b : ℤ)
    (hab : ∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (x : RelPoint d.f g),
      letI := d.ab.addCommGroup g
      a • x + b • h.phi x = 0) :
    a = 0 ∧ b = 0 := by
  by_contra hcon
  have hp3 : p = 43 ∨ p = 67 ∨ p = 163 := by
    simpa [Finset.mem_insert, Finset.mem_singleton] using _hp
  -- `4m = p + 1`, the exactness of the natural division at the three levels
  have h4m : 4 * ((((p + 1) / 4 : ℕ)) : ℤ) = (p : ℤ) + 1 := by
    rcases hp3 with rfl | rfl | rfl <;> norm_num
  have hppos : (0 : ℤ) < (p : ℤ) := by rcases hp3 with rfl | rfl | rfl <;> norm_num
  -- the NORM of `a + bφ` in `ℤ[φ]`, i.e. `(a + bφ)(a + b(1 − φ))`
  set Nz : ℤ := a ^ 2 + a * b + b ^ 2 * ((((p + 1) / 4 : ℕ)) : ℤ) with hNdef
  have h4N : 4 * Nz = (2 * a + b) ^ 2 + (p : ℤ) * b ^ 2 := by
    rw [hNdef]; linear_combination b ^ 2 * h4m
  -- `−p < 0` makes the norm form POSITIVE DEFINITE, which is the only place
  -- `p > 0` is used and the reason `φ ∉ ℤ`
  have hNpos : 0 < Nz := by
    rcases eq_or_ne b 0 with rfl | hb
    · have ha : a ≠ 0 := fun ha => hcon ⟨ha, rfl⟩
      have ha2 : 0 < a ^ 2 := by positivity
      nlinarith
    · have hb2 : 0 < b ^ 2 := by positivity
      nlinarith [sq_nonneg (2 * a + b)]
  -- multiplying the relation by the conjugate `(a + b) − bφ` kills every point
  have key : ∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (x : RelPoint d.f g),
      letI := d.ab.addCommGroup g
      Nz • x = 0 := by
    intro U g x
    letI := d.ab.addCommGroup g
    have h1 : a • x + b • h.phi x = 0 := hab U g x
    have hsq : h.phi (h.phi x) + ((((p + 1) / 4 : ℕ)) : ℤ) • x = h.phi x := by
      rw [natCast_zsmul]; exact h.phi_sq x
    have hsq' : h.phi (h.phi x) = h.phi x - ((((p + 1) / 4 : ℕ)) : ℤ) • x :=
      eq_sub_of_add_eq hsq
    have h2 : a • h.phi x + b • h.phi (h.phi x) = 0 := by
      have hmap := congrArg (AddMonoidHom.mk' (fun y : RelPoint d.f g => h.phi y)
        (fun y z => h.phi_add y z)) h1
      rw [map_add, map_zsmul, map_zsmul, map_zero] at hmap
      exact hmap
    rw [hsq'] at h2
    have h2' : (a + b) • h.phi x - (b * ((((p + 1) / 4 : ℕ)) : ℤ)) • x = 0 := by
      rw [← h2]; module
    have hexp : Nz • x
        = (a + b) • (a • x + b • h.phi x)
          - b • ((a + b) • h.phi x - (b * ((((p + 1) / 4 : ℕ)) : ℤ)) • x) := by
      rw [hNdef]; module
    rw [hexp, h1, h2', smul_zero, smul_zero, sub_zero]
  -- but `d.E` has points of arbitrarily large order, so nothing kills them all
  obtain ⟨U, g, x, hx⟩ := exists_nsmul_relPoint_ne_zero d Nz.toNat (by omega)
  letI := d.ab.addCommGroup g
  refine hx ?_
  have hk := key U g x
  rwa [← natCast_zsmul, Int.toNat_of_nonneg hNpos.le]

/-- **EVERY endomorphism of `d.E` is `a + bφ`** (sorry leaf, introduced
2026-07-30 by the naming of `phi_or_conj_of_isEllipticIsoOf`'s anonymous `hend`;
the spanning half of "`1, φ` is a `ℤ`-basis of `End(d.E)`", and the half that
carries the maximality of the order).

TRUE.  `u` is additive (`hu_add`) and natural in the test object (`hu_pre`), so
by Yoneda it is an endomorphism of the group scheme `d.f`, i.e. an element of
`End(d.E)`.  `φ` satisfies `φ² − φ + m = 0` with `4m = p + 1`, so `ℤ[φ]` is the
order of discriminant `1 − 4m = −p`; at `p ∈ {43, 67, 163}` — prime, hence
squarefree, and `≡ 3 mod 4` — that discriminant is FUNDAMENTAL, so `ℤ[φ]` is the
MAXIMAL order `O_{−p}`.  `End(d.E)` is an order in `ℚ(φ)` containing it, and an
order containing a maximal order equals it, so `End(d.E) = ℤ[φ] = ℤ ⊕ ℤφ`.

This is the functor-of-points twin of
`closure_singleton_eq_top_of_maximalOrderRel` (PROVEN above in this file), whose
proof is exactly this argument carried out in `WeierstrassCurve.End W` over
`End.exists_intBasis` and `sq_eq_one_of_sq_mul_eq_neg`.

**`hp` IS LOAD-BEARING FOR TRUTH and may not be dropped.**  It is used only
through the squarefreeness of `p`, but it is used: at a discriminant `−p` with
`v² ∣ p` for some `v > 1` the ring `ℤ[φ]` has conductor `v` and is NOT maximal,
`End(d.E)` may be strictly larger, and `u` then need not be a `ℤ`-combination of
`1` and `φ`.  This is the same trap `closure_singleton_eq_top_of_maximalOrderRel`
records: at discriminant `−4p` the solution `v = 2` survives and the order
`ℤ[√−p]` has class number three at all three levels.

**`hu_pre` IS LOAD-BEARING and the leaf is FALSE without it.**  Without
naturality `u` is an arbitrary additive endomorphism of the abstract group of
`ℚ̄`-points — a `ℚ`-vector space of infinite dimension once torsion is quotiented
— and those form an enormous ring with nothing to do with `End(d.E)`.  Naturality
is precisely the Yoneda hypothesis that makes `u` a morphism of schemes; it is
the same field `IsCMByRamifiedMaximalOrder.phi_pre` supplies for `φ`, and the
docstring of `exists_end_of_isCMByRamifiedMaximalOrder` records that it is
likewise the only place naturality is used there.

**`hu_add` IS LOAD-BEARING** for the same reason: a natural transformation of the
functor of points that is not additive is a morphism `d.E ⟶ d.E` of schemes, not
of group schemes, and no such morphism need be `a + bφ` (translation by any
`ℚ̄`-point is a counterexample).

NOT VACUOUS: `u = h.phi` satisfies both hypotheses (`phi_add`, `phi_pre`) and is
`a = 0, b = 1`; `u = id` is `a = 1, b = 0`. -/
theorem mem_intSpan_of_isCMByRamifiedMaximalOrder (p : ℕ)
    (_hp : p ∈ ({43, 67, 163} : Finset ℕ))
    {d : Gamma0Datum p (Spec (CommRingCat.of (AlgebraicClosure ℚ)))}
    (h : IsCMByRamifiedMaximalOrder p d)
    (u : ∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))),
      RelPoint d.f g → RelPoint d.f g)
    (_hu_add : ∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (x y : RelPoint d.f g),
      u U g (d.ab.add x y) = d.ab.add (u U g x) (u U g y))
    (_hu_pre : ∀ (U' U : Scheme.{0}) (k : U' ⟶ U)
      (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (g' : U' ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (hg : k ≫ g = g')
      (x : RelPoint d.f g),
      u U' g' (RelPoint.pre k hg x) = RelPoint.pre k hg (u U g x)) :
    ∃ a b : ℤ, ∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (x : RelPoint d.f g),
      letI := d.ab.addCommGroup g
      u U g x = a • x + b • h.phi x :=
  sorry

/-- **`End`-RIGIDITY: a root of `X² − X + (p+1)/4` in `End(d.E)` is `φ` or
`1 − φ`** (PROVEN 2026-07-30 over the two basis leaves above; this is the
statement that `phi_or_conj_of_isEllipticIsoOf` used to carry as its anonymous
sorried `have hend`).

TRUE, and the proof is pure algebra once `1, φ` is known to be a `ℤ`-basis:
writing `u = a + bφ` and using `φ² = φ − m` with `4m = p + 1`,

    u² − u + m = (a² − b²m + m − a) + (2ab + b² − b)·φ ,

so independence gives `b(2a + b − 1) = 0` and `a² − b²m + m − a = 0`.  If `b = 0`
the second reads `(2a − 1)² = 1 − 4m = −p < 0`, impossible; so `2a + b = 1`,
`b = 1 − 2a`, and substituting collapses the second to `p·a(a − 1) = 0`, whence
`a = 0` (so `u = φ`) or `a = 1` (so `u = 1 − φ`, i.e. `u + φ = id`).

**THE DISJUNCTION IS NOT SLACK.**  Both cases occur: `u = φ` and `u = 1 − φ` are
each additive, natural, and roots of the same quadratic, and nothing inside
`O_{−p}` distinguishes `√−p` from `−√−p`.  A single-disjunct version is FALSE.

**`hp` IS LOAD-BEARING TWICE, and both uses are visible in the proof**: `4m = p+1`
needs `p ≡ 3 mod 4` for the natural division to be exact, and `p > 0` is what
kills the `b = 0` branch and what turns `p·a(a − 1) = 0` into `a(a − 1) = 0`.  It
is additionally load-bearing inside `mem_intSpan_of_isCMByRamifiedMaximalOrder`,
through squarefreeness.

NOT VACUOUS: `u = h.phi` satisfies every hypothesis, by `phi_add`, `phi_pre` and
`phi_sq`, and lands in the left disjunct. -/
theorem phi_or_conj_of_natEnd (p : ℕ) (hp : p ∈ ({43, 67, 163} : Finset ℕ))
    {d : Gamma0Datum p (Spec (CommRingCat.of (AlgebraicClosure ℚ)))}
    (h : IsCMByRamifiedMaximalOrder p d)
    (u : ∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))),
      RelPoint d.f g → RelPoint d.f g)
    (hu_add : ∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (x y : RelPoint d.f g),
      u U g (d.ab.add x y) = d.ab.add (u U g x) (u U g y))
    (hu_pre : ∀ (U' U : Scheme.{0}) (k : U' ⟶ U)
      (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (g' : U' ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (hg : k ≫ g = g')
      (x : RelPoint d.f g),
      u U' g' (RelPoint.pre k hg x) = RelPoint.pre k hg (u U g x))
    (hu_sq : ∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (x : RelPoint d.f g),
      letI := d.ab.addCommGroup g
      u U g (u U g x) + ((p + 1) / 4 : ℕ) • x = u U g x) :
    (∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (x : RelPoint d.f g), u U g x = h.phi x) ∨
    (∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (x : RelPoint d.f g), d.ab.add (u U g x) (h.phi x) = x) := by
  obtain ⟨a, b, hab⟩ := mem_intSpan_of_isCMByRamifiedMaximalOrder p hp h u hu_add hu_pre
  set M : ℤ := (((p + 1) / 4 : ℕ) : ℤ) with hM
  have hp4 : 4 * M = (p : ℤ) + 1 := by rw [hM]; fin_cases hp <;> norm_num
  have hppos : (0 : ℤ) < (p : ℤ) := by fin_cases hp <;> norm_num
  -- expand `u² − u + m = 0` on the basis `1, φ`
  have hkey : ∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (x : RelPoint d.f g),
      letI := d.ab.addCommGroup g
      (a * a - b * b * M + M - a) • x + (2 * a * b + b * b - b) • h.phi x = 0 := by
    intro U g x
    letI := d.ab.addCommGroup g
    let Φ : RelPoint d.f g →+ RelPoint d.f g := AddMonoidHom.mk' h.phi h.phi_add
    have hΦ : ∀ y, Φ y = h.phi y := fun _ => rfl
    have hsq : ∀ y : RelPoint d.f g, h.phi (h.phi y) = h.phi y - M • y := by
      intro y
      have hy := h.phi_sq y
      have hnat : (((p + 1) / 4 : ℕ) : ℤ) • y = ((p + 1) / 4 : ℕ) • y := natCast_zsmul _ _
      rw [hM, hnat]
      linear_combination (norm := abel) hy
    have hzs : ∀ (n : ℤ) (y : RelPoint d.f g), h.phi (n • y) = n • h.phi y := by
      intro n y
      have hn := map_zsmul Φ n y
      rw [hΦ, hΦ] at hn
      exact hn
    have hadd : ∀ y z : RelPoint d.f g, h.phi (y + z) = h.phi y + h.phi z := h.phi_add
    have h1 : u U g x = a • x + b • h.phi x := hab U g x
    have h2 : u U g (u U g x) = (a * a - b * b * M) • x + (2 * a * b + b * b) • h.phi x := by
      rw [hab U g (u U g x), h1, hadd, hzs, hzs, hsq]
      module
    have h3 := hu_sq U g x
    have hnat : (((p + 1) / 4 : ℕ) : ℤ) • x = ((p + 1) / 4 : ℕ) • x := natCast_zsmul _ _
    rw [h2, h1] at h3
    rw [← hM] at hnat
    rw [← hnat] at h3
    rw [show (a * a - b * b * M + M - a) • x + (2 * a * b + b * b - b) • h.phi x
        = ((a * a - b * b * M) • x + (2 * a * b + b * b) • h.phi x + M • x)
          - (a • x + b • h.phi x) from by module, h3, sub_self]
  obtain ⟨hA, hB⟩ := intBasis_indep_of_isCMByRamifiedMaximalOrder p hp h _ _ hkey
  have hbcase : b = 0 ∨ 2 * a + b = 1 := by
    have hfac : b * (2 * a + b - 1) = 0 := by linarith [hB]
    rcases mul_eq_zero.1 hfac with hb | hb
    · exact Or.inl hb
    · exact Or.inr (by linarith)
  rcases hbcase with rfl | hlin
  · exact absurd hA (by nlinarith [sq_nonneg (2 * a - 1), hp4, hppos])
  · have hb : b = 1 - 2 * a := by linarith
    subst hb
    have hfac : (p : ℤ) * (a * (a - 1)) = 0 := by nlinarith [hA, hp4]
    have haa : a * (a - 1) = 0 := by
      rcases mul_eq_zero.1 hfac with hz | hz
      · exact absurd hz (by linarith)
      · exact hz
    rcases mul_eq_zero.1 haa with rfl | h1
    · left
      intro U g x
      letI := d.ab.addCommGroup g
      have hx := hab U g x
      rw [hx]
      simp
    · have ha : a = 1 := by linarith
      subst ha
      right
      intro U g x
      letI := d.ab.addCommGroup g
      have hx := hab U g x
      show u U g x + h.phi x = x
      rw [hx]
      norm_num

/-- **AN ENDOMORPHISM OF THE ELLIPTIC SCHEME SATISFYING `X² − X + m = 0` IS `φ`
OR `1 − φ`** (PROVEN 2026-07-29, flt-lean-33, over the two bridge leaves; this is
the statement that was the anonymous `have hend` inside
`phi_or_conj_of_isEllipticIsoOf` below, hoisted to top level and then closed).

TRUE, and — this is the correction the bridge subsection note records — it needs
NO arithmetic input whatever, so it is stated WITHOUT `hp`.  The route is three
steps and each is a named declaration above:

1. `exists_isWeierstrassModel_algClos` gives a Weierstrass model `W` of `d₂`;
2. `exists_end_of_relPointEndo` realises both `u` and `h₂.phi` as elements
   `ψᵤ, ψ_φ` of `WeierstrassCurve.End W`, agreeing with them on `ℚ̄`-points; the
   two hypotheses `hu_sq` and `h₂.phi_sq` become `ψ² + m = ψ` in that ring, by
   the same `map_nsmul`/`map_add` transport as in
   `exists_end_of_isCMByRamifiedMaximalOrder`;
3. `end_eq_or_add_eq_one_of_quadRel` — a monic quadratic has at most two roots in
   a commutative domain — gives `ψᵤ = ψ_φ` or `ψᵤ + ψ_φ = 1`.

That disjunction holds in `End W`, hence at `ℚ̄`-points; `relPointEndo_ext` then
propagates it to every test object, which is the only place naturality of `u` is
used a second time.  In the second branch the family compared with the identity is
`x ↦ u x + φ x`, whose naturality is `d₂.ab.pre_add` together with `hu_pre` and
`phi_pre`.

**WHY THERE IS NO `hp`, against what the consumer's docstring used to claim.**
That note argued that without class number one at a fundamental discriminant
`End(E₂)` could be strictly larger than `ℤ[φ₂]` and so "carry further roots".
The first half is a true statement about the ORDER; the second does not follow.
A monic quadratic has at most two roots in ANY commutative domain, however large,
and `φ₂`, `1 − φ₂` are already two of them.  So the only inputs are
`WeierstrassCurve.End.mul_comm_charZero` and `MazurEndLattice.end_mul_ne_zero`,
neither of which mentions `p`.  The consumer keeps `hp` in its signature as `_hp`
so that nothing downstream changes.

**THE DISJUNCTION IS NOT SLACK.**  Nothing inside `End W` distinguishes `√−p`
from `−√−p`, and the ring argument shows exactly why: both roots of the quadratic
really are attained, and the statement cannot be sharpened without extra data.

NOT VACUOUS: `u = h₂.phi` satisfies all three hypotheses (`phi_add`, `phi_pre`,
`phi_sq`) and lands in the first disjunct, and `IsCMByRamifiedMaximalOrder` is
satisfiable at each of `43, 67, 163` — see its docstring for the `ellisomat`
check. -/
theorem phi_eq_or_add_phi_eq (p : ℕ)
    {d₂ : Gamma0Datum p (Spec (CommRingCat.of (AlgebraicClosure ℚ)))}
    (h₂ : IsCMByRamifiedMaximalOrder p d₂)
    (u : ∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))),
      RelPoint d₂.f g → RelPoint d₂.f g)
    (hu_add : ∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
        (x y : RelPoint d₂.f g),
      u U g (d₂.ab.add x y) = d₂.ab.add (u U g x) (u U g y))
    (hu_pre : ∀ (U' U : Scheme.{0}) (h : U' ⟶ U)
        (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
        (g' : U' ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (hg : h ≫ g = g')
        (x : RelPoint d₂.f g),
      u U' g' (RelPoint.pre h hg x) = RelPoint.pre h hg (u U g x))
    (hu_sq : ∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
        (x : RelPoint d₂.f g),
      letI := d₂.ab.addCommGroup g
      u U g (u U g x) + ((p + 1) / 4 : ℕ) • x = u U g x) :
    (∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (x : RelPoint d₂.f g), u U g x = h₂.phi x) ∨
      (∀ (U : Scheme.{0}) (g : U ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
        (x : RelPoint d₂.f g), d₂.ab.add (u U g x) (h₂.phi x) = x) := by
  classical
  obtain ⟨W, hWell, hW⟩ := exists_isWeierstrassModel_algClos d₂
  haveI := hWell
  letI := d₂.ab.addCommGroup (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))
  obtain ⟨e, he⟩ := exists_end_of_relPointEndo hW
  obtain ⟨ψu, hψu⟩ := he u hu_add hu_pre
  obtain ⟨ψφ, hψφ⟩ := he (fun _ _ x => h₂.phi x) (fun _ _ x y => h₂.phi_add x y)
    (fun _ _ hh _ _ hg x => h₂.phi_pre hh hg x)
  -- both are roots of `X² − X + (p+1)/4` in `End W`
  have hrelu : ψu * ψu
      + (((p + 1) / 4 : ℕ) : _root_.WeierstrassCurve.End W.toAffine) = ψu := by
    refine Subtype.ext (AddMonoidHom.ext fun P => ?_)
    obtain ⟨x, rfl⟩ : ∃ x, e x = P := ⟨e.symm P, e.apply_symm_apply P⟩
    show (ψu : AddMonoid.End W.toAffine.Point) ((ψu : AddMonoid.End W.toAffine.Point) (e x))
        + ((p + 1) / 4 : ℕ) • e x = (ψu : AddMonoid.End W.toAffine.Point) (e x)
    rw [hψu x, hψu (u _ (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) x),
      ← map_nsmul e, ← map_add e]
    exact congrArg e (hu_sq _ (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) x)
  have hrelφ : ψφ * ψφ
      + (((p + 1) / 4 : ℕ) : _root_.WeierstrassCurve.End W.toAffine) = ψφ := by
    refine Subtype.ext (AddMonoidHom.ext fun P => ?_)
    obtain ⟨x, rfl⟩ : ∃ x, e x = P := ⟨e.symm P, e.apply_symm_apply P⟩
    show (ψφ : AddMonoid.End W.toAffine.Point) ((ψφ : AddMonoid.End W.toAffine.Point) (e x))
        + ((p + 1) / 4 : ℕ) • e x = (ψφ : AddMonoid.End W.toAffine.Point) (e x)
    rw [hψφ x, hψφ (h₂.phi x), ← map_nsmul e, ← map_add e]
    exact congrArg e (h₂.phi_sq x)
  -- a monic quadratic has at most two roots in the commutative domain `End W`
  rcases end_eq_or_add_eq_one_of_quadRel (((p + 1) / 4 : ℕ) : ℤ) ψu ψφ
    (by rw [Int.cast_natCast]; exact hrelu) (by rw [Int.cast_natCast]; exact hrelφ) with heq | heq
  · left
    refine relPointEndo_ext u (fun _ _ x => h₂.phi x) hu_pre
      (fun _ _ hh _ _ hg x => h₂.phi_pre hh hg x) (fun x => e.injective ?_)
    rw [← hψu x, ← hψφ x, heq]
  · right
    refine relPointEndo_ext (fun U g x => d₂.ab.add (u U g x) (h₂.phi x)) (fun _ _ x => x)
      (fun U' U hh g g' hg x => ?_) (fun _ _ _ _ _ _ _ => rfl) (fun x => e.injective ?_)
    · rw [d₂.ab.pre_add, hu_pre, h₂.phi_pre]
    · have h1 : (ψu : AddMonoid.End W.toAffine.Point) (e x)
          + (ψφ : AddMonoid.End W.toAffine.Point) (e x) = e x :=
        congrArg (fun k : _root_.WeierstrassCurve.End W.toAffine =>
          (k : AddMonoid.End W.toAffine.Point) (e x)) heq
      show e ((u _ (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) x) + h₂.phi x) = e x
      rw [map_add, ← hψu x, ← hψφ x]
      exact h1

