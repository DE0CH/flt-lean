    (g : (E⁄(AlgebraicClosure ℚ)).toAffine.Point) (hg : addOrderOf g = p)
    (hstab : ∀ σ : Field.absoluteGaloisGroup ℚ, ∀ x ∈ AddSubgroup.zmultiples g,
