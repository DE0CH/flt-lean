      -1159088625 / 2097152} : Finset ℚ) := by
  obtain ⟨g₃, hg₃, hstable₃⟩ :=
    E.exists_stable_zmultiples_of_dvd g (N := 21) (d := 3) (by norm_num) (by norm_num)
