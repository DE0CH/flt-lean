theorem minpoly_eq_of_isCMJInvariant
    (n : ℤ) (hn : 0 < n) (x y : AlgebraicClosure ℚ)
    (hx : IsCMJInvariant n x) (hy : IsCMJInvariant n y) :
    minpoly ℚ y = minpoly ℚ x := by
  obtain ⟨p, hmonic, hirr, hroot⟩ := exists_monic_irreducible_vanishing_isCMJInvariant n hn
  exact (minpoly.eq_of_irreducible_of_monic hirr (hroot y hy) hmonic).symm.trans
    (minpoly.eq_of_irreducible_of_monic hirr (hroot x hx) hmonic)

