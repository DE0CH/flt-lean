  obtain ⟨x₀, hD0, hψ, hSum⟩ :
      ∃ x₀ : ℚ, tateD E x₀ ≠ 0 ∧
        tateN E x₀ ^ 2 = tateM E x₀ * tateD E x₀ ∧
        ∀ (hfin : ((AddSubgroup.zmultiples P :
            AddSubgroup ((E⁄(AlgebraicClosure ℚ)).Point)) :
            Set ((E⁄(AlgebraicClosure ℚ)).Point)).Finite) (t w : ℚ),
          algebraMap ℚ (AlgebraicClosure ℚ) t =
