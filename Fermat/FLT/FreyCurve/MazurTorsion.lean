      veluT (E⁄(AlgebraicClosure ℚ)) hCfin.toFinset)
    (hw : algebraMap ℚ (AlgebraicClosure ℚ) w =
      veluW (E⁄(AlgebraicClosure ℚ)) hCfin.toFinset) :
