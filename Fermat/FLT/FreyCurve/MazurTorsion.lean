  have hc₄' := quot_c₄_mul ht hw hψ
  have hΔ' := quot_Δ_mul ht hw hψ hD0
  have hjΔ : E.j * E.Δ = E.c₄ ^ 3 := MazurLevel9.cFour_cube_eq E
  have hjΔ' : (E.veluModel t w).j * (E.veluModel t w).Δ = (E.veluModel t w).c₄ ^ 3 :=
