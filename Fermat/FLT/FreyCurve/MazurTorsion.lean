theorem exists_relPoint_inj_x0Model_of_abelianSchemeStruct (N : ℕ) (hN : N ∈ levels)
    {X Y : Scheme.{0}} {strX : X ⟶ SpecQ} {strY : Y ⟶ SpecQ} {jY : Y ⟶ X}
    (h : IsX0Compactification N strX strY jY) (ab : AbelianSchemeStruct strX) :
    ∃ f : RelPoint strX (𝟙 SpecQ) → (x0Model N).toAffine.Point, Function.Injective f := by
  -- the scheme side: `X_0(N)(ℚ)` IS the `ℚ`-point set of a Weierstrass curve
  obtain ⟨E, hE, ⟨t⟩⟩ := exists_weierstrassPointEquiv_of_abelianSchemeStruct ab h.smooth
  -- the modular side: that curve is `N a 1`
  obtain ⟨f, hf⟩ := exists_inj_point_x0Model_of_relPointEquiv N hN h E hE t
  exact ⟨f ∘ t, hf.comp t.injective⟩

