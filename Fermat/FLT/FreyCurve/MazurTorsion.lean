    ∃ k : (D⁄(AlgebraicClosure ℚ)).Point,
      addOrderOf k = 8 ∧
      (∀ σ : Field.absoluteGaloisGroup ℚ,
        ∀ z ∈ AddSubgroup.zmultiples k,
