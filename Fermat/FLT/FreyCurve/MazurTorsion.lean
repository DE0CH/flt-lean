        omega
    obtain ⟨d', hd'eq⟩ : ∃ d', d = 2 * d' := ⟨d / 2, by omega⟩
    have hd'pos : (0 : ℤ) < d' := by omega
    have hd'n : ((d'.natAbs : ℤ)) = d' := Int.natAbs_of_nonneg hd'pos.le
