      RelPoint.pre (specFDAug q) (specFDAug_comp_special toF) (E v)
          = RelPoint.pre (SpecLoc.special toF) (Category.comp_id _) (d.intX cusp) →
      RelPoint.pre (specFDAug q) (specFDAug_comp q) v = d.redX cusp := by
    intro v hv
