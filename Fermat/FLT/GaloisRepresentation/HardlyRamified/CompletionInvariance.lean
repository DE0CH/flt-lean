/-- **Density of `φ(𝓞 K)` in `𝒪_M`** (the completion property of the
dense embedding, in purely ideal-theoretic form): every element of
`𝒪_M` is congruent to the image of a global integer modulo every power
of the maximal ideal.  Combines the `ℚ_q`-span representation of `M`,
the density of `ℤ` in `𝒪_q`, and the valuation-ring dichotomy of the
localization `(𝓞 K)_{(Q₀)}` to clear the remaining denominators. -/
theorem exists_sub_mem_pow_maximalIdeal
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField K]
    (M : IntermediateField Kv (AlgebraicClosure Kv))
    [FiniteDimensional Kv M]
    (hMgen : M = IntermediateField.adjoin Kv
      (Set.range fun x : K => AlgebraicClosure.map (algebraMap ℚ Kv)
        (x : AlgebraicClosure ℚ)))
    (φ : RingOfIntegers K →+* IntegralClosure Ov M)
    (hφ : ∀ x : RingOfIntegers K,
      (algebraMap (IntegralClosure Ov M) M (φ x) : AlgebraicClosure Kv) =
      AlgebraicClosure.map (algebraMap ℚ Kv)
        ((algebraMap (RingOfIntegers K) K x : K) : AlgebraicClosure ℚ))
    (y : IntegralClosure Ov M) (j : ℕ) :
    ∃ z : RingOfIntegers K,
      y - φ z ∈ IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ j := by
  classical
  haveI : IsFractionRing (IntegralClosure Ov M) M :=
    IsIntegralClosure.isFractionRing_of_finite_extension Ov Kv M
      (IntegralClosure Ov M)
  -- STEP A: the span representation of `y` inside `M`
  have hy : (algebraMap (IntegralClosure Ov M) M y : M) ∈
      Submodule.span Kv (Set.range fun r : RingOfIntegers K =>
        (algebraMap (IntegralClosure Ov M) M (φ r) : M)) := by
    rw [span_range_algebraMap_comp_eq_top hq K M hMgen φ hφ]
    exact Submodule.mem_top
  obtain ⟨nn, cf, gf, hsum⟩ := Submodule.mem_span_set'.mp hy
  have hgf : ∀ i : Fin nn, ∃ r : RingOfIntegers K,
      (algebraMap (IntegralClosure Ov M) M (φ r) : M) = (gf i : M) := fun i => (gf i).2
  choose rf hrf using hgf
  -- STEP B: a common `q`-power denominator for the coefficients
  have hirr : Irreducible ((q : ℕ) : Ov) := by
    rw [IsDiscreteValuationRing.irreducible_iff_uniformizer]
    exact maximalIdeal_adicCompletionIntegers_eq_span hq
  have hdenom : ∀ i : Fin nn, ∃ (t : ℕ) (o : Ov),
      algebraMap Ov Kv o = ((q : Kv)) ^ t * cf i := by
    intro i
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := Ov) (cf i)
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
    obtain ⟨t, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hirr
    refine ⟨t, ((u⁻¹ : Ovˣ) : Ov) * a, ?_⟩
    have hbK : algebraMap Ov Kv b ≠ 0 := fun h0 =>
      hb0 (IsFractionRing.injective Ov Kv (by rw [h0, map_zero]))
    have hOv : (((u⁻¹ : Ovˣ) : Ov) * a) * b = ((q : ℕ) : Ov) ^ t * a := by
      rw [hu]
      calc (((u⁻¹ : Ovˣ) : Ov) * a) * (((u : Ovˣ) : Ov) * ((q : ℕ) : Ov) ^ t)
          = (((u⁻¹ : Ovˣ) : Ov) * ((u : Ovˣ) : Ov)) * (a * ((q : ℕ) : Ov) ^ t) := by
            ring
        _ = ((q : ℕ) : Ov) ^ t * a := by
            rw [Units.inv_mul, one_mul]
            ring
    have hkey := congrArg (algebraMap Ov Kv) hOv
    rw [← hab, mul_div_assoc']
    rw [eq_div_iff hbK]
    simp only [map_mul, map_pow, map_natCast] at hkey ⊢
    exact hkey
  choose tf oof hoof using hdenom
  set T : ℕ := (Finset.univ : Finset (Fin nn)).sup tf with hTdef
  have hOT : ∀ i : Fin nn, ∃ o : Ov,
      algebraMap Ov Kv o = ((q : Kv)) ^ T * cf i := by
    intro i
    refine ⟨((q : ℕ) : Ov) ^ (T - tf i) * oof i, ?_⟩
    rw [map_mul, map_pow, map_natCast, hoof, ← mul_assoc, ← pow_add]
    congr 2
    have := Finset.le_sup (f := tf) (Finset.mem_univ i)
    omega
  choose oF hoF using hOT
  -- STEP C: integer approximants of the coefficients
  have hzF : ∀ i : Fin nn, ∃ z : ℤ,
      oF i - (z : Ov) ∈ IsLocalRing.maximalIdeal Ov ^ (T + j) := fun i =>
    exists_intCast_sub_mem_pow_maximalIdeal hq (oF i) (T + j)
  choose zF hzF' using hzF
  have hwF : ∀ i : Fin nn, ∃ wi : Ov,
      oF i - (zF i : Ov) = ((q : ℕ) : Ov) ^ (T + j) * wi := by
    intro i
    have h1 := hzF' i
    rw [maximalIdeal_adicCompletionIntegers_eq_span hq, Ideal.span_singleton_pow,
      Ideal.mem_span_singleton] at h1
    obtain ⟨wi, hwi⟩ := h1
    exact ⟨wi, hwi⟩
  choose wF hwF' using hwF
  -- STEP D: the key congruence `q^T · y ≡ φ w  (mod q^(T+j))` in `𝒪_M`
  set w : RingOfIntegers K := ∑ i, (zF i : RingOfIntegers K) * rf i with hwdef
  set b₃ : IntegralClosure Ov M :=
    ∑ i, algebraMap Ov (IntegralClosure Ov M) (wF i) * φ (rf i) with hb₃def
  have hkeyB : ((q : ℕ) : IntegralClosure Ov M) ^ T * y - φ w =
      ((q : ℕ) : IntegralClosure Ov M) ^ (T + j) * b₃ := by
    apply IsFractionRing.injective (IntegralClosure Ov M) M
    rw [map_sub, map_mul, map_pow, map_natCast, map_mul, map_pow, map_natCast]
    -- expand `φ w` and `b₃`
    rw [hwdef, map_sum, map_sum, hb₃def, map_sum]
    simp only [map_mul, map_intCast]
    -- fold everything into a single sum and compare summand by summand
    rw [← hsum, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← hrf i]
    have e1 : ((q : ℕ) : M) ^ T *
        (cf i • (algebraMap (IntegralClosure Ov M) M (φ (rf i)) : M)) =
        (oF i) • (algebraMap (IntegralClosure Ov M) M (φ (rf i)) : M) := by
      rw [Algebra.smul_def, Algebra.smul_def, ← mul_assoc]
      rw [show (((q : ℕ) : M)) = algebraMap Kv M (((q : ℕ) : Kv)) from
        (map_natCast _ _).symm]
      rw [← map_pow, ← map_mul, ← hoF i]
      rw [IsScalarTower.algebraMap_apply Ov Kv M]
    have e2 : (((zF i : ℤ)) : M) *
        (algebraMap (IntegralClosure Ov M) M (φ (rf i)) : M) =
        algebraMap Ov M (((zF i : ℤ) : Ov)) *
          (algebraMap (IntegralClosure Ov M) M (φ (rf i)) : M) := by
      rw [map_intCast]
    have e3 : ((q : ℕ) : M) ^ (T + j) *
        (algebraMap (IntegralClosure Ov M) M
            (algebraMap Ov (IntegralClosure Ov M) (wF i)) *
          (algebraMap (IntegralClosure Ov M) M (φ (rf i)) : M)) =
        algebraMap Ov M (((q : ℕ) : Ov) ^ (T + j) * wF i) *
          (algebraMap (IntegralClosure Ov M) M (φ (rf i)) : M) := by
      rw [← IsScalarTower.algebraMap_apply Ov (IntegralClosure Ov M) M,
        map_mul, map_pow, map_natCast, ← mul_assoc]
    rw [e1, e2, e3, Algebra.smul_def, ← sub_mul, ← map_sub, hwF' i]
  -- STEP E: the localization dichotomy at `Q₀ = φ⁻¹(𝔪_M)`
  haveI hmaxprime : (IsLocalRing.maximalIdeal (IntegralClosure Ov M)).IsPrime :=
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime
  set Q₀ : Ideal (RingOfIntegers K) :=
    Ideal.comap φ (IsLocalRing.maximalIdeal (IntegralClosure Ov M)) with hQ₀def
  haveI hQ₀prime : Q₀.IsPrime := Ideal.IsPrime.comap φ
  have hq0R : ((q : ℕ) : RingOfIntegers K) ∈ Q₀ := by
    rw [hQ₀def, Ideal.mem_comap, map_natCast]
    exact natCast_mem_maximalIdeal hq M
  have hQ₀bot : Q₀ ≠ ⊥ := by
    intro h0
    have h1 : ((q : ℕ) : RingOfIntegers K) = 0 := by
      rw [← Ideal.mem_bot, ← h0]
      exact hq0R
    exact (Nat.cast_ne_zero.mpr hq.ne_zero) h1
  haveI := IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain
    (RingOfIntegers K) hQ₀bot (Localization.AtPrime Q₀)
  -- `q ≠ 0` upstairs
  haveI : CharZero Kv :=
    charZero_of_injective_algebraMap (algebraMap ℚ Kv).injective
  haveI : CharZero M :=
    charZero_of_injective_algebraMap (algebraMap Kv M).injective
  have hqB0 : ((q : ℕ) : IntegralClosure Ov M) ≠ 0 := by
    intro h0
    refine (Nat.cast_ne_zero.mpr hq.ne_zero : ((q : ℕ) : M) ≠ 0) ?_
    rw [← map_natCast (algebraMap (IntegralClosure Ov M) M) q, h0, map_zero]
  -- the contradiction template for the wrong branch of the dichotomy
  have hcontra : ∀ z u : RingOfIntegers K, u ∉ Q₀ → z ∈ Q₀ →
      ¬ (w * z = ((q : ℕ) : RingOfIntegers K) ^ T * u) := by
    intro z u hu hz hzw
    have h1 := congrArg φ hzw
    rw [map_mul, map_mul, map_pow, map_natCast] at h1
    have h2 : φ w = ((q : ℕ) : IntegralClosure Ov M) ^ T * y -
        ((q : ℕ) : IntegralClosure Ov M) ^ (T + j) * b₃ := by
      linear_combination (-1 : IntegralClosure Ov M) * hkeyB
    rw [h2] at h1
    have h3 : ((q : ℕ) : IntegralClosure Ov M) ^ T *
        ((y - ((q : ℕ) : IntegralClosure Ov M) ^ j * b₃) * φ z - φ u) = 0 := by
      linear_combination h1
    have h4 : (y - ((q : ℕ) : IntegralClosure Ov M) ^ j * b₃) * φ z - φ u = 0 := by
      rcases mul_eq_zero.mp h3 with h | h
      · exact absurd h (pow_ne_zero _ hqB0)
      · exact h
    have h5 : φ u = (y - ((q : ℕ) : IntegralClosure Ov M) ^ j * b₃) * φ z := by
      linear_combination -h4
    have h6 : φ u ∈ IsLocalRing.maximalIdeal (IntegralClosure Ov M) := by
      rw [h5]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_comap.mp hz)
    exact hu (Ideal.mem_comap.mpr h6)
  -- the valuation-ring dichotomy in the localization
  obtain ⟨c, hc⟩ := ValuationRing.cond
    (algebraMap (RingOfIntegers K) (Localization.AtPrime Q₀) w)
    (algebraMap (RingOfIntegers K) (Localization.AtPrime Q₀)
      (((q : ℕ) : RingOfIntegers K) ^ T))
  obtain ⟨⟨zc, uc⟩, hzc⟩ := IsLocalization.mk'_surjective Q₀.primeCompl c
  dsimp only at hzc
  have hinj : Function.Injective
      (algebraMap (RingOfIntegers K) (Localization.AtPrime Q₀)) :=
    IsLocalization.injective _ Q₀.primeCompl_le_nonZeroDivisors
  obtain ⟨sden, αnum, hsden, hswα⟩ : ∃ s α : RingOfIntegers K, s ∉ Q₀ ∧
      s * w = ((q : ℕ) : RingOfIntegers K) ^ T * α := by
    rcases hc with hc | hc
    · -- `w · (zc/uc) = q^T`: `w·zc = q^T·uc`
      rw [← hzc, IsLocalization.mul_mk'_eq_mk'_of_mul,
        IsLocalization.mk'_eq_iff_eq_mul] at hc
      rw [← map_mul] at hc
      have h1 : w * zc = ((q : ℕ) : RingOfIntegers K) ^ T * uc := hinj hc
      by_cases hzcQ : zc ∈ Q₀
      · exact absurd h1 (hcontra zc uc uc.2 hzcQ)
      · exact ⟨zc, uc, hzcQ, by linear_combination h1⟩
    · -- `q^T · (zc/uc) = w`: `q^T·zc = w·uc`
      rw [← hzc, IsLocalization.mul_mk'_eq_mk'_of_mul,
        IsLocalization.mk'_eq_iff_eq_mul] at hc
      rw [← map_mul] at hc
      have h1 : ((q : ℕ) : RingOfIntegers K) ^ T * zc = w * uc := hinj hc
      exact ⟨uc, zc, uc.2, by linear_combination -h1⟩
  -- STEP F: the congruence `φ sden · y ≡ φ αnum  (mod 𝔪^j)`
  have hstep : φ sden * y - φ αnum ∈
      IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ j := by
    have h1 := congrArg φ hswα
    rw [map_mul, map_mul, map_pow, map_natCast] at h1
    have h2 : φ w = ((q : ℕ) : IntegralClosure Ov M) ^ T * y -
        ((q : ℕ) : IntegralClosure Ov M) ^ (T + j) * b₃ := by
      linear_combination (-1 : IntegralClosure Ov M) * hkeyB
    rw [h2] at h1
    have h3 : ((q : ℕ) : IntegralClosure Ov M) ^ T *
        (φ sden * y - ((q : ℕ) : IntegralClosure Ov M) ^ j * (φ sden * b₃) -
          φ αnum) = 0 := by
      linear_combination h1
    have h4 : φ sden * y - ((q : ℕ) : IntegralClosure Ov M) ^ j * (φ sden * b₃) -
        φ αnum = 0 := by
      rcases mul_eq_zero.mp h3 with h | h
      · exact absurd h (pow_ne_zero _ hqB0)
      · exact h
    have h5 : φ sden * y - φ αnum =
        ((q : ℕ) : IntegralClosure Ov M) ^ j * (φ sden * b₃) := by
      linear_combination h4
    rw [h5]
    exact Ideal.mul_mem_right _ _
      (Ideal.pow_mem_pow (natCast_mem_maximalIdeal hq M) j)
  -- STEP G: invert `sden` modulo `Q₀^j` and conclude
  haveI hQ₀max : Q₀.IsMaximal := hQ₀prime.isMaximal hQ₀bot
  have hsup : Ideal.span {sden} ⊔ Q₀ = ⊤ := by
    obtain ⟨yinv, i, hiQ, hyi⟩ := hQ₀max.exists_inv hsden
    rw [Ideal.eq_top_iff_one, ← hyi]
    exact Submodule.add_mem _
      (Ideal.mem_sup_left (Ideal.mem_span_singleton'.mpr ⟨yinv, rfl⟩))
      (Ideal.mem_sup_right hiQ)
  have hsupj : Ideal.span {sden} ⊔ Q₀ ^ j = ⊤ :=
    Ideal.isCoprime_iff_sup_eq.mp
      ((Ideal.isCoprime_iff_sup_eq.mpr hsup).pow_right)
  have h8 : (1 : RingOfIntegers K) ∈ Ideal.span {sden} ⊔ Q₀ ^ j := by
    rw [hsupj]
    trivial
  obtain ⟨a1, ha1, b1, hb1, hab1⟩ := Submodule.mem_sup.mp h8
  obtain ⟨sstar, hsstar⟩ := Ideal.mem_span_singleton'.mp ha1
  refine ⟨αnum * sstar, ?_⟩
  have hfinal : y - φ (αnum * sstar) =
      φ sstar * (φ sden * y - φ αnum) + y * φ b1 := by
    have h6 : sden * sstar + b1 = 1 := by
      rw [← hab1, ← hsstar]
      ring
    have h7 := congrArg φ h6
    rw [map_add, map_mul, map_one] at h7
    rw [map_mul]
    linear_combination -y * h7
  rw [hfinal]
  refine Submodule.add_mem _ (Ideal.mul_mem_left _ _ hstep)
    (Ideal.mul_mem_left _ _ ?_)
  have h9 : Ideal.map φ (Q₀ ^ j) ≤
      IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ j := by
    rw [Ideal.map_pow]
    exact Ideal.pow_right_mono Ideal.map_comap_le j
  exact h9 (Ideal.mem_map_of_mem φ hb1)

