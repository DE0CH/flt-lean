/-!
# Completion invariance of the different ideal and the ramification index

Let `K/ℚ` be a Galois number field, `q` a rational prime, `ℚ_q` the
`q`-adic completion (spelled `adicCompletion ℚ v_q` for the height-one
prime `v_q` of `𝓞 ℚ`), and `M` a finite subextension of `ℚ_qᵃˡᵍ/ℚ_q`
GENERATED by the image of `K` under a fixed embedding
`ι : ℚᵃˡᵍ → ℚ_qᵃˡᵍ` (hypothesis `hMgen`).  Given a ring homomorphism
`φ : 𝓞 K →+* 𝒪_M` acting as `ι` on underlying elements (hypothesis
`hφ`), the pullback `Q₀ = φ⁻¹(𝔪_M)` is a prime of `𝓞 K` over `q`, and
`𝒪_M` is the completion of `𝓞 K` at `Q₀`.  This file proves the two
completion-invariance statements consumed by the distinguished-prime
passage of `Fermat.FLT.GaloisRepresentation.HardlyRamified.ModThree`
(Serre, *Corps Locaux* II §3 and III §4 Prop. 10; Neukirch II (9.9),
III (2.2)–(2.9)):

* `ramificationIdx'_comap_maximalIdeal_eq_of_dense`:
  `e(Q₀ ∣ q) = e(𝔪_{𝒪_q} in 𝒪_M)`;
* `maximalIdeal_pow_dvd_local_differentIdeal_of_dense`:
  `Q₀^d ∣ 𝔡_{𝓞K/ℤ} → 𝔪_M^d ∣ 𝔡_{𝒪_M/𝒪_q}` (the divisibility direction
  of the completion invariance of the different).

The shared engine is the DENSITY of `φ(𝓞 K)` in `𝒪_M` for the
`𝔪_M`-adic filtration (`exists_sub_mem_pow_maximalIdeal`), obtained
purely algebraically from `hMgen`: `ℤ` is dense in `𝒪_q` (topological
density of `ℚ` in the completion plus an integer-inversion argument),
`M` is spanned over `ℚ_q` by `ι(𝓞 K)` (clearing denominators in
`hMgen`), and the remaining `Q₀`-denominators are handled by the
valuation-ring dichotomy of the localization `(𝓞 K)_{(Q₀)}`.  On top of
the density sit:

* the uniformizer transport `map φ Q₀ = 𝔪_M` (density at level `2`),
  which yields the ramification-index equality by pushing the global
  factorization `q·𝓞 K = Q₀^e · C` through `φ`;
* the residue-field identification `𝓞K/Q₀ ≅ 𝒪_M/𝔪_M` (density at level
  `1`), which transports the inertia degree;
* the conductor triviality `𝒪_M = 𝒪_q[x]` for `x = φ(θ)` the image of a
  `Q₀`-adically dense global generator `θ` (density at all levels plus
  Nakayama), which computes the local different as
  `𝔡_{𝒪_M/𝒪_q} = (g'(x))` for `g = minpoly x`
  (`conductor_mul_differentIdeal`);
* the root-counting identification of the distinguished local factor:
  `deg g = [M : ℚ_q] = e·f = #D(Q₀)` (the local fundamental identity
  plus Hilbert's `#D = e·f`), which forces the roots of `g` to be
  exactly the `ι`-images of the `D(Q₀)`-conjugates of `θ`, so that the
  cofactor `h = f/g` has unit value `h(x) = ∏_{σ ∉ D} (x − ι(σθ))`
  (master-generator properties `θ ∉ Q₀`, `σθ ∈ Q₀` for `σ ∉ D`).

Everything is stated over a general rational prime `q`; the `ModThree`
consumers instantiate `q = 3`.
-/

@[expose] public section

open NumberField IsDedekindDomain Polynomial

open scoped Pointwise WithZero

namespace GaloisRepresentation.IsHardlyRamified.CompletionInvariance

variable {q : ℕ} (hq : q.Prime)

local notation "Kv" => IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ hq.toHeightOneSpectrumRingOfIntegersRat
local notation "Ov" => IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers ℚ hq.toHeightOneSpectrumRingOfIntegersRat

/-- The valuation (in the completion) of an integer is its global
`v_q`-adic valuation: cast bookkeeping through
`valuedAdicCompletion_eq_valuation`. -/
theorem valued_intCast_eq_valuation (m : ℤ) :
    Valued.v ((m : Kv)) =
      hq.toHeightOneSpectrumRingOfIntegersRat.valuation ℚ
        (algebraMap (NumberField.RingOfIntegers ℚ) ℚ
          ((m : NumberField.RingOfIntegers ℚ))) := by
  have h := IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation'
    (v := hq.toHeightOneSpectrumRingOfIntegersRat) (K := ℚ) ((m : ℚ))
  have h3 := congrFun (IsDedekindDomain.HeightOneSpectrum.algebraMap_adicCompletion
    (S := ℚ) (K := ℚ) (v := hq.toHeightOneSpectrumRingOfIntegersRat)) ((m : ℚ))
  simp only [Function.comp_apply, map_intCast, Algebra.algebraMap_self] at h3
  rw [h3, show (algebraMap (NumberField.RingOfIntegers ℚ) ℚ
    ((m : NumberField.RingOfIntegers ℚ))) = ((m : ℚ)) from map_intCast _ _]
  exact_mod_cast h

/-- The valuation of the rational prime `q` in its own completion is
strictly less than one: `q` lies in the ideal of the place `v_q`. -/
theorem valued_natCast_lt_one :
    Valued.v ((q : Kv)) < (1 : ℤᵐ⁰) := by
  have h : ((q : Kv)) = (((q : ℤ) : Kv)) := by norm_cast
  rw [h, valued_intCast_eq_valuation hq]
  rw [IsDedekindDomain.HeightOneSpectrum.valuation_lt_one_iff_mem]
  rw [hq.mem_toHeightOneSpectrumRingOfIntegersRat_asIdeal]
  rw [map_intCast]
  exact dvd_refl _

/-- Integers have valuation at most one in the completion. -/
theorem valued_intCast_le_one (m : ℤ) :
    Valued.v ((m : Kv)) ≤ (1 : ℤᵐ⁰) := by
  rw [valued_intCast_eq_valuation hq]
  exact IsDedekindDomain.HeightOneSpectrum.valuation_le_one _ _

/-- An integer prime to `q` is a `q`-adic unit. -/
theorem valued_intCast_eq_one {m : ℤ} (hm : ¬ (q : ℤ) ∣ m) :
    Valued.v ((m : Kv)) = (1 : ℤᵐ⁰) := by
  rw [valued_intCast_eq_valuation hq]
  rw [IsDedekindDomain.HeightOneSpectrum.valuation_eq_one_iff_notMem]
  rw [hq.mem_toHeightOneSpectrumRingOfIntegersRat_asIdeal, map_intCast]
  exact hm

/-- **`ℤ` is dense in the completed integer ring `𝒪_q`**: every element
of `𝒪_q` is congruent to a rational integer modulo every power `𝔪_q^j`.
Topological density of `ℚ` in the completion produces a rational
approximant, which has `q`-integral denominator by the ultrametric
inequality; inverting the denominator modulo `q^j` in `ℤ` turns it into
an integer approximant. -/
theorem exists_intCast_sub_mem_pow_maximalIdeal (c : Ov) (j : ℕ) :
    ∃ z : ℤ, c - (z : Ov) ∈ IsLocalRing.maximalIdeal Ov ^ j := by
  classical
  haveI : CharZero Kv := charZero_of_injective_algebraMap (algebraMap ℚ Kv).injective
  have hqK0 : ((q : Kv)) ≠ 0 := Nat.cast_ne_zero.mpr hq.ne_zero
  have hγ0 : (Valued.v : Valuation Kv ℤᵐ⁰).restrict ((q : Kv) ^ j) ≠ 0 := by
    rw [Ne, Valuation.zero_iff]
    exact pow_ne_zero _ hqK0
  -- density of `ℚ` in the completion produces a rational approximant
  have hdense := IsDedekindDomain.HeightOneSpectrum.denseRange_algebraMap
    (K := ℚ) (v := hq.toHeightOneSpectrumRingOfIntegersRat)
  have hball : {y : Kv | Valued.v (y - (c : Kv)) < Valued.v ((q : Kv) ^ j)} ∈
      nhds (c : Kv) := by
    rw [Valued.mem_nhds]
    refine ⟨Units.mk0 _ hγ0, fun y hy => ?_⟩
    rw [Set.mem_setOf_eq, Units.val_mk0] at hy
    exact (Valuation.restrict_lt_iff _).mp hy
  obtain ⟨y, hyball, r, hyr⟩ :=
    (mem_closure_iff_nhds.mp (hdense ((c : Kv)))) _ hball
  rw [Set.mem_setOf_eq] at hyball
  have hyr2 : algebraMap ℚ Kv r = y := by
    rw [← hyr]
    exact RingHom.congr_fun (Subsingleton.elim _ _) r
  have hyball' : Valued.v (algebraMap ℚ Kv r - (c : Kv)) < Valued.v ((q : Kv) ^ j) := by
    rw [hyr2]
    exact hyball
  -- the radius is at most `1`
  have hγle1 : Valued.v ((q : Kv) ^ j) ≤ 1 := by
    rw [map_pow]
    exact pow_le_one₀ zero_le (valued_natCast_lt_one hq).le
  have hcmem : Valued.v ((c : Kv)) ≤ 1 :=
    (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers
      (K := ℚ) (v := hq.toHeightOneSpectrumRingOfIntegersRat)).mp c.2
  -- the rational approximant is a `q`-adic integer
  have hvr : Valued.v (algebraMap ℚ Kv r) ≤ 1 := by
    have h1 : algebraMap ℚ Kv r =
        (algebraMap ℚ Kv r - (c : Kv)) + (c : Kv) := by ring
    rw [h1]
    exact le_trans (Valued.v.map_add _ _)
      (max_le (le_trans hyball'.le hγle1) hcmem)
  set n : ℤ := r.num with hn
  set d : ℤ := (r.den : ℤ) with hd
  have hd0 : (d : ℚ) ≠ 0 := Int.cast_ne_zero.mpr (Int.natCast_ne_zero.mpr r.den_nz)
  have hnd : ((n : ℚ)) = r * (d : ℚ) := by
    have h0 := Rat.num_div_den r
    rw [div_eq_iff (by exact_mod_cast r.den_nz : ((r.den : ℚ)) ≠ 0)] at h0
    rw [hn, hd]
    push_cast
    linarith [h0]
  -- the denominator is prime to `q`
  have hqd : ¬ (q : ℤ) ∣ d := by
    intro hdvd
    have hqn : ¬ (q : ℤ) ∣ n := by
      intro hnd'
      have h2 : (q : ℕ) ∣ r.num.natAbs := by
        rw [← Int.natAbs_natCast q]
        exact Int.natAbs_dvd_natAbs.mpr hnd'
      have h3 : (q : ℕ) ∣ r.den := by
        have h3' := hdvd
        rw [hd] at h3'
        exact_mod_cast h3'
      have h4 := Nat.dvd_gcd h2 h3
      have h5 : Nat.gcd r.num.natAbs r.den = 1 := r.reduced
      rw [h5] at h4
      exact hq.one_lt.ne' (Nat.dvd_one.mp h4)
    have hvn : Valued.v ((n : Kv)) = 1 := valued_intCast_eq_one hq hqn
    -- `v(d) < 1` since `q ∣ d`
    obtain ⟨k, hk⟩ := hdvd
    have hvd : Valued.v ((d : Kv)) < 1 := by
      have h5 : ((d : Kv)) = ((q : Kv)) * ((k : Kv)) := by
        rw [hk]; push_cast; ring
      rw [h5, map_mul]
      calc Valued.v ((q : Kv)) * Valued.v ((k : Kv))
          ≤ Valued.v ((q : Kv)) * 1 :=
            mul_le_mul' le_rfl (valued_intCast_le_one hq k)
        _ = Valued.v ((q : Kv)) := mul_one _
        _ < 1 := valued_natCast_lt_one hq
    -- contradiction: `1 = v(n) = v(r)·v(d) ≤ v(d) < 1`
    have h6 : ((n : Kv)) = algebraMap ℚ Kv r * ((d : Kv)) := by
      have h6' := congrArg (algebraMap ℚ Kv) hnd
      rw [map_mul] at h6'
      rw [show ((n : Kv)) = algebraMap ℚ Kv ((n : ℚ)) from (map_intCast _ _).symm,
        show ((d : Kv)) = algebraMap ℚ Kv ((d : ℚ)) from (map_intCast _ _).symm]
      exact h6'
    have h7 : (1 : ℤᵐ⁰) = Valued.v (algebraMap ℚ Kv r) * Valued.v ((d : Kv)) := by
      rw [← map_mul, ← h6, hvn]
    have h8 : Valued.v (algebraMap ℚ Kv r) * Valued.v ((d : Kv)) ≤
        1 * Valued.v ((d : Kv)) := mul_le_mul' hvr le_rfl
    rw [one_mul] at h8
    exact absurd (h7 ▸ h8) (not_le.mpr hvd)
  -- invert the denominator modulo `q^j`
  have hcop : IsCoprime ((q : ℤ) ^ j) d := by
    refine IsCoprime.pow_left ?_
    rw [Int.isCoprime_iff_gcd_eq_one]
    have hnd' : ¬ (q : ℕ) ∣ d.natAbs := by
      intro h'
      exact hqd (Int.natAbs_dvd.mp (Int.natCast_dvd_natCast.mpr h'))
    have h5 := (Nat.Prime.coprime_iff_not_dvd hq).mpr hnd'
    simpa [Int.gcd, Int.natAbs_natCast] using h5
  obtain ⟨b, a, hab⟩ := hcop.symm
  -- `hab : b * d + a * q ^ j = 1`
  refine ⟨n * b, ?_⟩
  -- the rational identity `r − n·b = n·a·q^j / d`
  have hrz : (r : ℚ) - ((n * b : ℤ) : ℚ) =
      ((n * a : ℤ) : ℚ) * ((q : ℚ)) ^ j / (d : ℚ) := by
    have habℚ : (b : ℚ) * (d : ℚ) + (a : ℚ) * ((q : ℚ)) ^ j = 1 := by
      have h5 := congrArg (fun t : ℤ => (t : ℚ)) hab
      push_cast at h5
      linarith [h5]
    rw [eq_div_iff hd0]
    push_cast
    linear_combination (-1 : ℚ) * hnd - (n : ℚ) * habℚ
  -- the valuation bound on `r − z`
  have hvrz : Valued.v (algebraMap ℚ Kv r - (((n * b : ℤ)) : Kv)) ≤
      Valued.v ((q : Kv) ^ j) := by
    rw [map_pow]
    have h9 : algebraMap ℚ Kv r - (((n * b : ℤ)) : Kv) =
        (((n * a : ℤ)) : Kv) * ((q : Kv)) ^ j / ((d : Kv)) := by
      have h9' := congrArg (algebraMap ℚ Kv) hrz
      rw [map_sub, map_div₀, map_mul, map_pow] at h9'
      rw [show (((n * b : ℤ)) : Kv) = algebraMap ℚ Kv (((n * b : ℤ) : ℚ)) from
          (map_intCast _ _).symm,
        show (((n * a : ℤ)) : Kv) = algebraMap ℚ Kv (((n * a : ℤ) : ℚ)) from
          (map_intCast _ _).symm,
        show ((d : Kv)) = algebraMap ℚ Kv ((d : ℚ)) from (map_intCast _ _).symm,
        show ((q : Kv)) = algebraMap ℚ Kv ((q : ℚ)) from (map_natCast _ _).symm]
      exact h9'
    rw [h9, map_div₀, map_mul, map_pow]
    rw [valued_intCast_eq_one hq hqd, div_one]
    calc Valued.v (((n * a : ℤ) : Kv)) * Valued.v ((q : Kv)) ^ j
        ≤ 1 * Valued.v ((q : Kv)) ^ j :=
          mul_le_mul' (valued_intCast_le_one hq _) le_rfl
      _ = Valued.v ((q : Kv)) ^ j := one_mul _
  -- combine the two approximations
  have htot : Valued.v ((c : Kv) - (((n * b : ℤ)) : Kv)) ≤
      Valued.v ((q : Kv) ^ j) := by
    have h10 : (c : Kv) - (((n * b : ℤ)) : Kv) =
        ((c : Kv) - algebraMap ℚ Kv r) +
          (algebraMap ℚ Kv r - (((n * b : ℤ)) : Kv)) := by ring
    rw [h10]
    refine le_trans (Valued.v.map_add _ _) (max_le ?_ hvrz)
    rw [show (c : Kv) - algebraMap ℚ Kv r = -(algebraMap ℚ Kv r - (c : Kv)) by ring,
      Valuation.map_neg]
    exact hyball'.le
  -- conclude the ideal membership
  rw [maximalIdeal_adicCompletionIntegers_eq_span hq, Ideal.span_singleton_pow,
    Ideal.mem_span_singleton]
  have hq0' : Valued.v ((q : Kv) ^ j) ≠ 0 := by
    rw [Ne, Valuation.zero_iff]
    exact pow_ne_zero _ hqK0
  have hu : Valued.v (((c : Kv) - (((n * b : ℤ)) : Kv)) / ((q : Kv)) ^ j) ≤ 1 := by
    rw [map_div₀]
    rw [div_le_one₀ (lt_of_le_of_ne zero_le (Ne.symm hq0'))]
    exact htot
  refine ⟨⟨((c : Kv) - (((n * b : ℤ)) : Kv)) / ((q : Kv)) ^ j, ?_⟩, ?_⟩
  · exact (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers
      (K := ℚ) (v := hq.toHeightOneSpectrumRingOfIntegersRat)).mpr hu
  · apply Subtype.ext
    push_cast
    field_simp

section Dense

/-- **`M` is spanned over `ℚ_q` by the image of `𝓞 K`** (the
linear-algebra form of the density hypothesis `hMgen`): the `ℚ_q`-span
of `φ(𝓞 K)` inside `M` is everything.  The span is a subalgebra
(`φ(𝓞 K)` is multiplicatively closed and contains `1`), hence — the
generators being integral — an intermediate field, and it contains
every generator `ι(x)` of `hMgen` after clearing the `ℤ`-denominator of
`x ∈ K`. -/
theorem span_range_algebraMap_comp_eq_top
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField K]
    (M : IntermediateField Kv (AlgebraicClosure Kv))
    [FiniteDimensional Kv M]
    (hMgen : M = IntermediateField.adjoin Kv
      (Set.range fun x : K => AlgebraicClosure.map (algebraMap ℚ Kv)
        (x : AlgebraicClosure ℚ)))
    (φ : RingOfIntegers K →+* IntegralClosure Ov M)
    (hφ : ∀ x : RingOfIntegers K,
      (algebraMap (IntegralClosure Ov M) M (φ x) : AlgebraicClosure Kv) =
      AlgebraicClosure.map (algebraMap ℚ Kv)
        ((algebraMap (RingOfIntegers K) K x : K) : AlgebraicClosure ℚ)) :
    Submodule.span Kv
      (Set.range fun r : RingOfIntegers K =>
        (algebraMap (IntegralClosure Ov M) M (φ r) : M)) = ⊤ := by
  classical
  set S : Set M := Set.range (fun r : RingOfIntegers K =>
    (algebraMap (IntegralClosure Ov M) M (φ r) : M))
  -- STEP 1: the ambient adjoin of the `val`-image of `S` is all of `M`
  have hamb : IntermediateField.adjoin Kv ((M.val : M →ₐ[Kv] AlgebraicClosure Kv) '' S) = M := by
    refine le_antisymm ?_ ?_
    · rw [IntermediateField.adjoin_le_iff]
      rintro _ ⟨s, -, rfl⟩
      exact s.2
    · refine le_trans hMgen.le ?_
      rw [IntermediateField.adjoin_le_iff]
      rintro _ ⟨x, rfl⟩
      show AlgebraicClosure.map (algebraMap ℚ Kv) (x : AlgebraicClosure ℚ) ∈
        IntermediateField.adjoin Kv ((M.val : M →ₐ[Kv] AlgebraicClosure Kv) '' S)
      obtain ⟨r, s0, hs0, hx⟩ := IsFractionRing.div_surjective
        (A := RingOfIntegers K) (x : K)
      have hxcl : (x : AlgebraicClosure ℚ) =
          ((algebraMap (RingOfIntegers K) K r : K) : AlgebraicClosure ℚ) /
          ((algebraMap (RingOfIntegers K) K s0 : K) : AlgebraicClosure ℚ) := by
        rw [← hx]
        push_cast
        ring
      rw [hxcl, map_div₀]
      refine div_mem (IntermediateField.subset_adjoin _ _ ?_)
        (IntermediateField.subset_adjoin _ _ ?_)
      · exact ⟨(algebraMap (IntegralClosure Ov M) M (φ r) : M),
          Set.mem_range_self r, hφ r⟩
      · exact ⟨(algebraMap (IntegralClosure Ov M) M (φ s0) : M),
          Set.mem_range_self s0, hφ s0⟩
  -- STEP 2: the intermediate field generated by `S` inside `M` is everything
  have htopIF : IntermediateField.adjoin Kv S = (⊤ : IntermediateField Kv M) := by
    rw [eq_top_iff]
    rintro y -
    have hy : (M.val y) ∈ IntermediateField.adjoin Kv
        ((M.val : M →ₐ[Kv] AlgebraicClosure Kv) '' S) := by
      rw [hamb]
      exact y.2
    rw [← IntermediateField.adjoin_map] at hy
    obtain ⟨y', hy', hyy'⟩ := hy
    have : y' = y := M.val.injective hyy'
    rwa [← this]
  -- STEP 3: pass from the field adjoin to the algebra adjoin, then to the span
  have htopalg : Algebra.adjoin Kv S = ⊤ := by
    have h1 : (IntermediateField.adjoin Kv S).toSubalgebra = Algebra.adjoin Kv S :=
      IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
        (fun s _ => Algebra.IsAlgebraic.isAlgebraic s)
    rw [← h1, htopIF]
    rfl
  -- STEP 4: the generating set is multiplicative, so the span is the adjoin
  have hone : (1 : M) ∈ S := ⟨1, by simp⟩
  have hmul : ∀ a ∈ S, ∀ b ∈ S, a * b ∈ S := by
    rintro _ ⟨r₁, rfl⟩ _ ⟨r₂, rfl⟩
    exact ⟨r₁ * r₂, by simp [map_mul]⟩
  set T : Submonoid M :=
    { carrier := S
      one_mem' := hone
      mul_mem' := fun ha hb => hmul _ ha _ hb } with hTdef
  have hclosure : Submonoid.closure S = T := Submonoid.closure_eq T
  have hspan : Submodule.span Kv S =
      Subalgebra.toSubmodule (Algebra.adjoin Kv S) := by
    rw [Algebra.adjoin_eq_span, hclosure]
    rfl
  rw [hspan, htopalg]
  rfl

/-- The rational prime `q` lies in the maximal ideal of the integral
closure `𝒪_M` (integrality: the pullback of `𝔪_M` to `𝒪_q` is maximal,
hence equal to `𝔪_q ∋ q`). -/
theorem natCast_mem_maximalIdeal
    (M : IntermediateField Kv (AlgebraicClosure Kv))
    [FiniteDimensional Kv M] :
    ((q : ℕ) : IntegralClosure Ov M) ∈
      IsLocalRing.maximalIdeal (IntegralClosure Ov M) := by
  have hqOv : ((q : ℕ) : Ov) ∈ IsLocalRing.maximalIdeal Ov := by
    rw [maximalIdeal_adicCompletionIntegers_eq_span hq]
    exact Ideal.mem_span_singleton_self _
  haveI hcomapmax : (Ideal.comap (algebraMap Ov (IntegralClosure Ov M))
      (IsLocalRing.maximalIdeal (IntegralClosure Ov M))).IsMaximal :=
    Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _
  have h1 : ((q : ℕ) : Ov) ∈ Ideal.comap (algebraMap Ov (IntegralClosure Ov M))
      (IsLocalRing.maximalIdeal (IntegralClosure Ov M)) := by
    rw [IsLocalRing.eq_maximalIdeal hcomapmax]
    exact hqOv
  have h2 := Ideal.mem_comap.mp h1
  rwa [map_natCast] at h2

/-- The image of the distinguished prime generates inside the maximal
ideal: `map φ Q₀ ≤ 𝔪_M`. -/
theorem map_comap_le_maximalIdeal
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField K]
    (M : IntermediateField Kv (AlgebraicClosure Kv))
    [FiniteDimensional Kv M]
    (φ : RingOfIntegers K →+* IntegralClosure Ov M) :
    Ideal.map φ (Ideal.comap φ
        (IsLocalRing.maximalIdeal (IntegralClosure Ov M))) ≤
      IsLocalRing.maximalIdeal (IntegralClosure Ov M) :=
  Ideal.map_comap_le

set_option backward.isDefEq.respectTransparency false in
set_option synthInstance.maxHeartbeats 1000000 in
set_option maxHeartbeats 3000000 in
/-- **Density of `φ(𝓞 K)` in `𝒪_M`** (the completion property of the
dense embedding, in purely ideal-theoretic form): every element of
`𝒪_M` is congruent to the image of a global integer modulo every power
of the maximal ideal.  Combines the `ℚ_q`-span representation of `M`,
the density of `ℤ` in `𝒪_q`, and the valuation-ring dichotomy of the
localization `(𝓞 K)_{(Q₀)}` to clear the remaining denominators. -/
theorem exists_sub_mem_pow_maximalIdeal
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField K]
    (M : IntermediateField Kv (AlgebraicClosure Kv))
    [FiniteDimensional Kv M]
    (hMgen : M = IntermediateField.adjoin Kv
      (Set.range fun x : K => AlgebraicClosure.map (algebraMap ℚ Kv)
        (x : AlgebraicClosure ℚ)))
    (φ : RingOfIntegers K →+* IntegralClosure Ov M)
    (hφ : ∀ x : RingOfIntegers K,
      (algebraMap (IntegralClosure Ov M) M (φ x) : AlgebraicClosure Kv) =
      AlgebraicClosure.map (algebraMap ℚ Kv)
        ((algebraMap (RingOfIntegers K) K x : K) : AlgebraicClosure ℚ))
    (y : IntegralClosure Ov M) (j : ℕ) :
    ∃ z : RingOfIntegers K,
      y - φ z ∈ IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ j := by
  classical
  haveI : IsFractionRing (IntegralClosure Ov M) M :=
    IsIntegralClosure.isFractionRing_of_finite_extension Ov Kv M
      (IntegralClosure Ov M)
  -- STEP A: the span representation of `y` inside `M`
  have hy : (algebraMap (IntegralClosure Ov M) M y : M) ∈
      Submodule.span Kv (Set.range fun r : RingOfIntegers K =>
        (algebraMap (IntegralClosure Ov M) M (φ r) : M)) := by
    rw [span_range_algebraMap_comp_eq_top hq K M hMgen φ hφ]
    exact Submodule.mem_top
  obtain ⟨nn, cf, gf, hsum⟩ := Submodule.mem_span_set'.mp hy
  have hgf : ∀ i : Fin nn, ∃ r : RingOfIntegers K,
      (algebraMap (IntegralClosure Ov M) M (φ r) : M) = (gf i : M) := fun i => (gf i).2
  choose rf hrf using hgf
  -- STEP B: a common `q`-power denominator for the coefficients
  have hirr : Irreducible ((q : ℕ) : Ov) := by
    rw [IsDiscreteValuationRing.irreducible_iff_uniformizer]
    exact maximalIdeal_adicCompletionIntegers_eq_span hq
  have hdenom : ∀ i : Fin nn, ∃ (t : ℕ) (o : Ov),
      algebraMap Ov Kv o = ((q : Kv)) ^ t * cf i := by
    intro i
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := Ov) (cf i)
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
    obtain ⟨t, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hirr
    refine ⟨t, ((u⁻¹ : Ovˣ) : Ov) * a, ?_⟩
    have hbK : algebraMap Ov Kv b ≠ 0 := fun h0 =>
      hb0 (IsFractionRing.injective Ov Kv (by rw [h0, map_zero]))
    have hOv : (((u⁻¹ : Ovˣ) : Ov) * a) * b = ((q : ℕ) : Ov) ^ t * a := by
      rw [hu]
      calc (((u⁻¹ : Ovˣ) : Ov) * a) * (((u : Ovˣ) : Ov) * ((q : ℕ) : Ov) ^ t)
          = (((u⁻¹ : Ovˣ) : Ov) * ((u : Ovˣ) : Ov)) * (a * ((q : ℕ) : Ov) ^ t) := by
            ring
        _ = ((q : ℕ) : Ov) ^ t * a := by
            rw [Units.inv_mul, one_mul]
            ring
    have hkey := congrArg (algebraMap Ov Kv) hOv
    rw [← hab, mul_div_assoc']
    rw [eq_div_iff hbK]
    simp only [map_mul, map_pow, map_natCast] at hkey ⊢
    exact hkey
  choose tf oof hoof using hdenom
  set T : ℕ := (Finset.univ : Finset (Fin nn)).sup tf with hTdef
  have hOT : ∀ i : Fin nn, ∃ o : Ov,
      algebraMap Ov Kv o = ((q : Kv)) ^ T * cf i := by
    intro i
    refine ⟨((q : ℕ) : Ov) ^ (T - tf i) * oof i, ?_⟩
    rw [map_mul, map_pow, map_natCast, hoof, ← mul_assoc, ← pow_add]
    congr 2
    have := Finset.le_sup (f := tf) (Finset.mem_univ i)
    omega
  choose oF hoF using hOT
  -- STEP C: integer approximants of the coefficients
  have hzF : ∀ i : Fin nn, ∃ z : ℤ,
      oF i - (z : Ov) ∈ IsLocalRing.maximalIdeal Ov ^ (T + j) := fun i =>
    exists_intCast_sub_mem_pow_maximalIdeal hq (oF i) (T + j)
  choose zF hzF' using hzF
  have hwF : ∀ i : Fin nn, ∃ wi : Ov,
      oF i - (zF i : Ov) = ((q : ℕ) : Ov) ^ (T + j) * wi := by
    intro i
    have h1 := hzF' i
    rw [maximalIdeal_adicCompletionIntegers_eq_span hq, Ideal.span_singleton_pow,
      Ideal.mem_span_singleton] at h1
    obtain ⟨wi, hwi⟩ := h1
    exact ⟨wi, hwi⟩
  choose wF hwF' using hwF
  -- STEP D: the key congruence `q^T · y ≡ φ w  (mod q^(T+j))` in `𝒪_M`
  set w : RingOfIntegers K := ∑ i, (zF i : RingOfIntegers K) * rf i with hwdef
  set b₃ : IntegralClosure Ov M :=
    ∑ i, algebraMap Ov (IntegralClosure Ov M) (wF i) * φ (rf i) with hb₃def
  have hkeyB : ((q : ℕ) : IntegralClosure Ov M) ^ T * y - φ w =
      ((q : ℕ) : IntegralClosure Ov M) ^ (T + j) * b₃ := by
    apply IsFractionRing.injective (IntegralClosure Ov M) M
    rw [map_sub, map_mul, map_pow, map_natCast, map_mul, map_pow, map_natCast]
    -- expand `φ w` and `b₃`
    rw [hwdef, map_sum, map_sum, hb₃def, map_sum]
    simp only [map_mul, map_intCast]
    -- fold everything into a single sum and compare summand by summand
    rw [← hsum, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← hrf i]
    have e1 : ((q : ℕ) : M) ^ T *
        (cf i • (algebraMap (IntegralClosure Ov M) M (φ (rf i)) : M)) =
        (oF i) • (algebraMap (IntegralClosure Ov M) M (φ (rf i)) : M) := by
      rw [Algebra.smul_def, Algebra.smul_def, ← mul_assoc]
      rw [show (((q : ℕ) : M)) = algebraMap Kv M (((q : ℕ) : Kv)) from
        (map_natCast _ _).symm]
      rw [← map_pow, ← map_mul, ← hoF i]
      rw [IsScalarTower.algebraMap_apply Ov Kv M]
    have e2 : (((zF i : ℤ)) : M) *
        (algebraMap (IntegralClosure Ov M) M (φ (rf i)) : M) =
        algebraMap Ov M (((zF i : ℤ) : Ov)) *
          (algebraMap (IntegralClosure Ov M) M (φ (rf i)) : M) := by
      rw [map_intCast]
    have e3 : ((q : ℕ) : M) ^ (T + j) *
        (algebraMap (IntegralClosure Ov M) M
            (algebraMap Ov (IntegralClosure Ov M) (wF i)) *
          (algebraMap (IntegralClosure Ov M) M (φ (rf i)) : M)) =
        algebraMap Ov M (((q : ℕ) : Ov) ^ (T + j) * wF i) *
          (algebraMap (IntegralClosure Ov M) M (φ (rf i)) : M) := by
      rw [← IsScalarTower.algebraMap_apply Ov (IntegralClosure Ov M) M,
        map_mul, map_pow, map_natCast, ← mul_assoc]
    rw [e1, e2, e3, Algebra.smul_def, ← sub_mul, ← map_sub, hwF' i]
  -- STEP E: the localization dichotomy at `Q₀ = φ⁻¹(𝔪_M)`
  haveI hmaxprime : (IsLocalRing.maximalIdeal (IntegralClosure Ov M)).IsPrime :=
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime
  set Q₀ : Ideal (RingOfIntegers K) :=
    Ideal.comap φ (IsLocalRing.maximalIdeal (IntegralClosure Ov M)) with hQ₀def
  haveI hQ₀prime : Q₀.IsPrime := Ideal.IsPrime.comap φ
  have hq0R : ((q : ℕ) : RingOfIntegers K) ∈ Q₀ := by
    rw [hQ₀def, Ideal.mem_comap, map_natCast]
    exact natCast_mem_maximalIdeal hq M
  have hQ₀bot : Q₀ ≠ ⊥ := by
    intro h0
    have h1 : ((q : ℕ) : RingOfIntegers K) = 0 := by
      rw [← Ideal.mem_bot, ← h0]
      exact hq0R
    exact (Nat.cast_ne_zero.mpr hq.ne_zero) h1
  haveI := IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain
    (RingOfIntegers K) hQ₀bot (Localization.AtPrime Q₀)
  -- `q ≠ 0` upstairs
  haveI : CharZero Kv :=
    charZero_of_injective_algebraMap (algebraMap ℚ Kv).injective
  haveI : CharZero M :=
    charZero_of_injective_algebraMap (algebraMap Kv M).injective
  have hqB0 : ((q : ℕ) : IntegralClosure Ov M) ≠ 0 := by
    intro h0
    refine (Nat.cast_ne_zero.mpr hq.ne_zero : ((q : ℕ) : M) ≠ 0) ?_
    rw [← map_natCast (algebraMap (IntegralClosure Ov M) M) q, h0, map_zero]
  -- the contradiction template for the wrong branch of the dichotomy
  have hcontra : ∀ z u : RingOfIntegers K, u ∉ Q₀ → z ∈ Q₀ →
      ¬ (w * z = ((q : ℕ) : RingOfIntegers K) ^ T * u) := by
    intro z u hu hz hzw
    have h1 := congrArg φ hzw
    rw [map_mul, map_mul, map_pow, map_natCast] at h1
    have h2 : φ w = ((q : ℕ) : IntegralClosure Ov M) ^ T * y -
        ((q : ℕ) : IntegralClosure Ov M) ^ (T + j) * b₃ := by
      linear_combination (-1 : IntegralClosure Ov M) * hkeyB
    rw [h2] at h1
    have h3 : ((q : ℕ) : IntegralClosure Ov M) ^ T *
        ((y - ((q : ℕ) : IntegralClosure Ov M) ^ j * b₃) * φ z - φ u) = 0 := by
      linear_combination h1
    have h4 : (y - ((q : ℕ) : IntegralClosure Ov M) ^ j * b₃) * φ z - φ u = 0 := by
      rcases mul_eq_zero.mp h3 with h | h
      · exact absurd h (pow_ne_zero _ hqB0)
      · exact h
    have h5 : φ u = (y - ((q : ℕ) : IntegralClosure Ov M) ^ j * b₃) * φ z := by
      linear_combination -h4
    have h6 : φ u ∈ IsLocalRing.maximalIdeal (IntegralClosure Ov M) := by
      rw [h5]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_comap.mp hz)
    exact hu (Ideal.mem_comap.mpr h6)
  -- the valuation-ring dichotomy in the localization
  obtain ⟨c, hc⟩ := ValuationRing.cond
    (algebraMap (RingOfIntegers K) (Localization.AtPrime Q₀) w)
    (algebraMap (RingOfIntegers K) (Localization.AtPrime Q₀)
      (((q : ℕ) : RingOfIntegers K) ^ T))
  obtain ⟨⟨zc, uc⟩, hzc⟩ := IsLocalization.mk'_surjective Q₀.primeCompl c
  dsimp only at hzc
  have hinj : Function.Injective
      (algebraMap (RingOfIntegers K) (Localization.AtPrime Q₀)) :=
    IsLocalization.injective _ Q₀.primeCompl_le_nonZeroDivisors
  obtain ⟨sden, αnum, hsden, hswα⟩ : ∃ s α : RingOfIntegers K, s ∉ Q₀ ∧
      s * w = ((q : ℕ) : RingOfIntegers K) ^ T * α := by
    rcases hc with hc | hc
    · -- `w · (zc/uc) = q^T`: `w·zc = q^T·uc`
      rw [← hzc, IsLocalization.mul_mk'_eq_mk'_of_mul,
        IsLocalization.mk'_eq_iff_eq_mul] at hc
      rw [← map_mul] at hc
      have h1 : w * zc = ((q : ℕ) : RingOfIntegers K) ^ T * uc := hinj hc
      by_cases hzcQ : zc ∈ Q₀
      · exact absurd h1 (hcontra zc uc uc.2 hzcQ)
      · exact ⟨zc, uc, hzcQ, by linear_combination h1⟩
    · -- `q^T · (zc/uc) = w`: `q^T·zc = w·uc`
      rw [← hzc, IsLocalization.mul_mk'_eq_mk'_of_mul,
        IsLocalization.mk'_eq_iff_eq_mul] at hc
      rw [← map_mul] at hc
      have h1 : ((q : ℕ) : RingOfIntegers K) ^ T * zc = w * uc := hinj hc
      exact ⟨uc, zc, uc.2, by linear_combination -h1⟩
  -- STEP F: the congruence `φ sden · y ≡ φ αnum  (mod 𝔪^j)`
  have hstep : φ sden * y - φ αnum ∈
      IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ j := by
    have h1 := congrArg φ hswα
    rw [map_mul, map_mul, map_pow, map_natCast] at h1
    have h2 : φ w = ((q : ℕ) : IntegralClosure Ov M) ^ T * y -
        ((q : ℕ) : IntegralClosure Ov M) ^ (T + j) * b₃ := by
      linear_combination (-1 : IntegralClosure Ov M) * hkeyB
    rw [h2] at h1
    have h3 : ((q : ℕ) : IntegralClosure Ov M) ^ T *
        (φ sden * y - ((q : ℕ) : IntegralClosure Ov M) ^ j * (φ sden * b₃) -
          φ αnum) = 0 := by
      linear_combination h1
    have h4 : φ sden * y - ((q : ℕ) : IntegralClosure Ov M) ^ j * (φ sden * b₃) -
        φ αnum = 0 := by
      rcases mul_eq_zero.mp h3 with h | h
      · exact absurd h (pow_ne_zero _ hqB0)
      · exact h
    have h5 : φ sden * y - φ αnum =
        ((q : ℕ) : IntegralClosure Ov M) ^ j * (φ sden * b₃) := by
      linear_combination h4
    rw [h5]
    exact Ideal.mul_mem_right _ _
      (Ideal.pow_mem_pow (natCast_mem_maximalIdeal hq M) j)
  -- STEP G: invert `sden` modulo `Q₀^j` and conclude
  haveI hQ₀max : Q₀.IsMaximal := hQ₀prime.isMaximal hQ₀bot
  have hsup : Ideal.span {sden} ⊔ Q₀ = ⊤ := by
    obtain ⟨yinv, i, hiQ, hyi⟩ := hQ₀max.exists_inv hsden
    rw [Ideal.eq_top_iff_one, ← hyi]
    exact Submodule.add_mem _
      (Ideal.mem_sup_left (Ideal.mem_span_singleton'.mpr ⟨yinv, rfl⟩))
      (Ideal.mem_sup_right hiQ)
  have hsupj : Ideal.span {sden} ⊔ Q₀ ^ j = ⊤ :=
    Ideal.isCoprime_iff_sup_eq.mp
      ((Ideal.isCoprime_iff_sup_eq.mpr hsup).pow_right)
  have h8 : (1 : RingOfIntegers K) ∈ Ideal.span {sden} ⊔ Q₀ ^ j := by
    rw [hsupj]
    trivial
  obtain ⟨a1, ha1, b1, hb1, hab1⟩ := Submodule.mem_sup.mp h8
  obtain ⟨sstar, hsstar⟩ := Ideal.mem_span_singleton'.mp ha1
  refine ⟨αnum * sstar, ?_⟩
  have hfinal : y - φ (αnum * sstar) =
      φ sstar * (φ sden * y - φ αnum) + y * φ b1 := by
    have h6 : sden * sstar + b1 = 1 := by
      rw [← hab1, ← hsstar]
      ring
    have h7 := congrArg φ h6
    rw [map_add, map_mul, map_one] at h7
    rw [map_mul]
    linear_combination -y * h7
  rw [hfinal]
  refine Submodule.add_mem _ (Ideal.mul_mem_left _ _ hstep)
    (Ideal.mul_mem_left _ _ ?_)
  have h9 : Ideal.map φ (Q₀ ^ j) ≤
      IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ j := by
    rw [Ideal.map_pow]
    exact Ideal.pow_right_mono Ideal.map_comap_le j
  exact h9 (Ideal.mem_map_of_mem φ hb1)

set_option backward.isDefEq.respectTransparency false in
set_option synthInstance.maxHeartbeats 1000000 in
set_option maxHeartbeats 1000000 in
/-- **Uniformizer transport**: the maximal ideal of `𝒪_M` is generated
by the image of the distinguished prime `Q₀ = φ⁻¹(𝔪_M)` — i.e. the
extension `𝒪_M / (𝓞 K)_{Q₀}` is unramified in the strong sense
`map φ Q₀ = 𝔪_M` (density at level `2`: a uniformizer of `𝒪_M` is
congruent mod `𝔪_M²` to some `φ(z)`, which is then itself a
uniformizer lying in `φ(Q₀)`). -/
theorem map_comap_maximalIdeal_eq_of_dense
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField K]
    (M : IntermediateField Kv (AlgebraicClosure Kv))
    [FiniteDimensional Kv M]
    (hMgen : M = IntermediateField.adjoin Kv
      (Set.range fun x : K => AlgebraicClosure.map (algebraMap ℚ Kv)
        (x : AlgebraicClosure ℚ)))
    (φ : RingOfIntegers K →+* IntegralClosure Ov M)
    (hφ : ∀ x : RingOfIntegers K,
      (algebraMap (IntegralClosure Ov M) M (φ x) : AlgebraicClosure Kv) =
      AlgebraicClosure.map (algebraMap ℚ Kv)
        ((algebraMap (RingOfIntegers K) K x : K) : AlgebraicClosure ℚ)) :
    Ideal.map φ (Ideal.comap φ
        (IsLocalRing.maximalIdeal (IntegralClosure Ov M))) =
      IsLocalRing.maximalIdeal (IntegralClosure Ov M) := by
  classical
  obtain ⟨π, hπirr⟩ :=
    IsDiscreteValuationRing.exists_irreducible (IntegralClosure Ov M)
  have hπmem : π ∈ IsLocalRing.maximalIdeal (IntegralClosure Ov M) := by
    rw [hπirr.maximalIdeal_eq]
    exact Ideal.mem_span_singleton_self _
  have hπ0 : π ≠ 0 := hπirr.ne_zero
  have hπnotsq : π ∉ IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ 2 := by
    rw [hπirr.maximalIdeal_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    rintro ⟨c, hc⟩
    have h1 : π * (1 - π * c) = 0 := by
      rw [pow_two] at hc
      linear_combination hc
    rcases mul_eq_zero.mp h1 with h | h
    · exact hπ0 h
    · exact hπirr.not_isUnit (IsUnit.of_mul_eq_one c (by linear_combination -h))
  obtain ⟨z, hz⟩ := exists_sub_mem_pow_maximalIdeal hq K M hMgen φ hφ π 2
  have hφz : φ z ∈ IsLocalRing.maximalIdeal (IntegralClosure Ov M) := by
    rw [show φ z = π - (π - φ z) by ring]
    exact Submodule.sub_mem _ hπmem
      (Ideal.pow_le_self two_ne_zero hz)
  have hφznot : φ z ∉ IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ 2 :=
    fun hmem => hπnotsq (by
      rw [show π = (π - φ z) + φ z by ring]
      exact Submodule.add_mem _ hz hmem)
  have hspan : Ideal.span {φ z} = IsLocalRing.maximalIdeal (IntegralClosure Ov M) := by
    have h1 : φ z ∈ Ideal.span {π} := by
      rw [← hπirr.maximalIdeal_eq]
      exact hφz
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h1
    have hcunit : IsUnit c := by
      by_contra hcu
      have hcm : c ∈ IsLocalRing.maximalIdeal (IntegralClosure Ov M) := by
        rw [IsLocalRing.mem_maximalIdeal]
        exact hcu
      refine hφznot ?_
      rw [← hc, pow_two]
      exact Ideal.mul_mem_mul hcm hπmem
    rw [hπirr.maximalIdeal_eq, ← hc]
    exact Ideal.span_singleton_mul_left_unit hcunit π
  refine le_antisymm Ideal.map_comap_le ?_
  refine le_trans (le_of_eq hspan.symm) ?_
  exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr
    (Ideal.mem_map_of_mem φ (Ideal.mem_comap.mpr hφz)))

/-- **Completion invariance of the ramification index** (Serre, *Corps
Locaux* II §3; general-`q` engine behind
`ramificationIdx'_comap_maximalIdeal_eq_local` of `ModThree`): the
ramification index of `Q₀ = φ⁻¹(𝔪_M)` over the rational prime `q`
equals the ramification index of `𝔪_q` in `𝒪_M`.  Push the global
factorization `q·𝓞 K = Q₀^e·C` (`C` coprime to `Q₀`) through `φ`: the
coprime part maps to the unit ideal (an element of `C ∖ Q₀` maps to a
unit of the local ring `𝒪_M`), and `map φ Q₀ = 𝔪_M` by uniformizer
transport, so `q·𝒪_M = 𝔪_M^e` exactly. -/
theorem ramificationIdx'_comap_maximalIdeal_eq_of_dense
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField K]
    (M : IntermediateField Kv (AlgebraicClosure Kv))
    [FiniteDimensional Kv M]
    (hMgen : M = IntermediateField.adjoin Kv
      (Set.range fun x : K => AlgebraicClosure.map (algebraMap ℚ Kv)
        (x : AlgebraicClosure ℚ)))
    (φ : RingOfIntegers K →+* IntegralClosure Ov M)
    (hφ : ∀ x : RingOfIntegers K,
      (algebraMap (IntegralClosure Ov M) M (φ x) : AlgebraicClosure Kv) =
      AlgebraicClosure.map (algebraMap ℚ Kv)
        ((algebraMap (RingOfIntegers K) K x : K) : AlgebraicClosure ℚ)) :
    Ideal.ramificationIdx' (Ideal.span {((q : ℕ) : ℤ)})
      (Ideal.comap φ (IsLocalRing.maximalIdeal (IntegralClosure Ov M))) =
    Ideal.ramificationIdx' (IsLocalRing.maximalIdeal Ov)
      (IsLocalRing.maximalIdeal (IntegralClosure Ov M)) := by
  classical
  haveI hmaxprime : (IsLocalRing.maximalIdeal (IntegralClosure Ov M)).IsPrime :=
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime
  set Q₀ : Ideal (RingOfIntegers K) :=
    Ideal.comap φ (IsLocalRing.maximalIdeal (IntegralClosure Ov M)) with hQ₀def
  haveI hQ₀prime : Q₀.IsPrime := Ideal.IsPrime.comap φ
  have hq0R : ((q : ℕ) : RingOfIntegers K) ∈ Q₀ := by
    rw [hQ₀def, Ideal.mem_comap, map_natCast]
    exact natCast_mem_maximalIdeal hq M
  have hqR0 : ((q : ℕ) : RingOfIntegers K) ≠ 0 := Nat.cast_ne_zero.mpr hq.ne_zero
  have hQ₀bot : Q₀ ≠ ⊥ := by
    intro h0
    refine hqR0 ?_
    rw [← Ideal.mem_bot, ← h0]
    exact hq0R
  haveI hQ₀max : Q₀.IsMaximal := hQ₀prime.isMaximal hQ₀bot
  -- the global factorization `q·𝓞K = Q₀^e·C`
  have hspanbot : Ideal.span {((q : ℕ) : RingOfIntegers K)} ≠ ⊥ := by
    rw [Ne, Ideal.span_singleton_eq_bot]
    exact hqR0
  obtain ⟨C, hCsup, hCeq⟩ := Ideal.eq_prime_pow_mul_coprime hspanbot Q₀
  set e : ℕ := Multiset.count Q₀ (UniqueFactorizationMonoid.normalizedFactors
    (Ideal.span {((q : ℕ) : RingOfIntegers K)}))
  -- `C` is not contained in `Q₀`
  have hCnotle : ¬ C ≤ Q₀ := by
    intro hle
    have h1 : (⊤ : Ideal (RingOfIntegers K)) ≤ Q₀ := by
      rw [← hCsup]
      exact sup_le le_rfl hle
    exact hQ₀prime.ne_top (top_le_iff.mp h1)
  obtain ⟨c₀, hc₀C, hc₀Q⟩ := SetLike.not_le_iff_exists.mp hCnotle
  -- the image of the global factorization: `q·𝒪_M = 𝔪_M^e`
  have hmapC : Ideal.map φ C = ⊤ := by
    by_contra hne
    have h1 : Ideal.map φ C ≤ IsLocalRing.maximalIdeal (IntegralClosure Ov M) :=
      IsLocalRing.le_maximalIdeal hne
    exact hc₀Q (Ideal.mem_comap.mpr (h1 (Ideal.mem_map_of_mem φ hc₀C)))
  have hmapφ : Ideal.span {((q : ℕ) : IntegralClosure Ov M)} =
      IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ e := by
    have h1 : Ideal.map φ (Ideal.span {((q : ℕ) : RingOfIntegers K)}) =
        Ideal.span {((q : ℕ) : IntegralClosure Ov M)} := by
      rw [Ideal.map_span, Set.image_singleton, map_natCast]
    rw [← h1, hCeq, Ideal.map_mul, Ideal.map_pow,
      map_comap_maximalIdeal_eq_of_dense hq K M hMgen φ hφ, hmapC, Ideal.mul_top]
  -- powers of the maximal ideal of a DVR are strictly decreasing
  have hstrict : ∀ n : ℕ, ¬ (IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ n ≤
      IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ (n + 1)) := by
    intro n hle
    obtain ⟨π, hπirr⟩ :=
      IsDiscreteValuationRing.exists_irreducible (IntegralClosure Ov M)
    rw [hπirr.maximalIdeal_eq] at hle
    have h1 : π ^ n ∈ Ideal.span {π} ^ (n + 1) := by
      refine hle ?_
      rw [Ideal.span_singleton_pow]
      exact Ideal.mem_span_singleton_self _
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at h1
    exact absurd ((pow_dvd_pow_iff hπirr.ne_zero hπirr.not_isUnit).mp h1)
      (by omega)
  -- the local index is `e`
  have hloc : Ideal.ramificationIdx' (IsLocalRing.maximalIdeal Ov)
      (IsLocalRing.maximalIdeal (IntegralClosure Ov M)) = e := by
    refine Ideal.ramificationIdx'_spec ?_ ?_
    · rw [maximalIdeal_adicCompletionIntegers_eq_span hq, Ideal.map_span,
        Set.image_singleton, map_natCast, hmapφ]
    · rw [maximalIdeal_adicCompletionIntegers_eq_span hq, Ideal.map_span,
        Set.image_singleton, map_natCast, hmapφ]
      exact hstrict e
  -- the global index is `e`
  have hglob : Ideal.ramificationIdx' (Ideal.span {((q : ℕ) : ℤ)}) Q₀ = e := by
    have hmapZ : Ideal.map (algebraMap ℤ (RingOfIntegers K))
        (Ideal.span {((q : ℕ) : ℤ)}) =
        Ideal.span {((q : ℕ) : RingOfIntegers K)} := by
      rw [Ideal.map_span, Set.image_singleton]
      norm_cast
    refine Ideal.ramificationIdx'_spec ?_ ?_
    · rw [hmapZ, hCeq]
      exact Ideal.mul_le_right
    · rw [hmapZ]
      intro hle
      -- pick `x ∈ Q₀^e ∖ Q₀^(e+1)`; then `c₀·x` violates primality
      have hxex : ¬ (Q₀ ^ e ≤ Q₀ ^ (e + 1)) := by
        intro hle'
        have h3 : Q₀ ^ e = Q₀ ^ (e + 1) :=
          le_antisymm hle' (Ideal.pow_le_pow_right (Nat.le_succ e))
        exact (Ideal.pow_succ_lt_pow hQ₀bot e).ne h3.symm
      obtain ⟨x, hxe, hxe1⟩ := SetLike.not_le_iff_exists.mp hxex
      have h4 : c₀ * x ∈ Ideal.span {((q : ℕ) : RingOfIntegers K)} := by
        rw [hCeq, mul_comm (Q₀ ^ e) C]
        exact Ideal.mul_mem_mul hc₀C hxe
      have h5 := hle h4
      rcases hQ₀prime.mul_mem_pow _ h5 with h | h
      · exact hc₀Q h
      · exact hxe1 h
  rw [hglob, hloc]

/-- **Completion invariance of the inertia degree**: the residue field
of `𝒪_M` is identified with the residue field of `Q₀` by `φ` (injective
because `Q₀ = φ⁻¹(𝔪_M)`, surjective by density at level `1`), and the
bottom residue fields `ℤ/q` and `𝒪_q/𝔪_q` are identified by the density
of `ℤ` in `𝒪_q`; the two inertia degrees agree by comparing
cardinalities `#κ^f`. -/
theorem inertiaDeg'_comap_maximalIdeal_eq_of_dense
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField K]
    (M : IntermediateField Kv (AlgebraicClosure Kv))
    [FiniteDimensional Kv M]
    (hMgen : M = IntermediateField.adjoin Kv
      (Set.range fun x : K => AlgebraicClosure.map (algebraMap ℚ Kv)
        (x : AlgebraicClosure ℚ)))
    (φ : RingOfIntegers K →+* IntegralClosure Ov M)
    (hφ : ∀ x : RingOfIntegers K,
      (algebraMap (IntegralClosure Ov M) M (φ x) : AlgebraicClosure Kv) =
      AlgebraicClosure.map (algebraMap ℚ Kv)
        ((algebraMap (RingOfIntegers K) K x : K) : AlgebraicClosure ℚ)) :
    Ideal.inertiaDeg' (Ideal.span {((q : ℕ) : ℤ)})
      (Ideal.comap φ (IsLocalRing.maximalIdeal (IntegralClosure Ov M))) =
    Ideal.inertiaDeg' (IsLocalRing.maximalIdeal Ov)
      (IsLocalRing.maximalIdeal (IntegralClosure Ov M)) := by
  classical
  haveI hmaxprime : (IsLocalRing.maximalIdeal (IntegralClosure Ov M)).IsPrime :=
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime
  set Q₀ : Ideal (RingOfIntegers K) :=
    Ideal.comap φ (IsLocalRing.maximalIdeal (IntegralClosure Ov M)) with hQ₀def
  haveI hQ₀prime : Q₀.IsPrime := Ideal.IsPrime.comap φ
  have hq0R : ((q : ℕ) : RingOfIntegers K) ∈ Q₀ := by
    rw [hQ₀def, Ideal.mem_comap, map_natCast]
    exact natCast_mem_maximalIdeal hq M
  have hqR0 : ((q : ℕ) : RingOfIntegers K) ≠ 0 := Nat.cast_ne_zero.mpr hq.ne_zero
  have hQ₀bot : Q₀ ≠ ⊥ := by
    intro h0
    refine hqR0 ?_
    rw [← Ideal.mem_bot, ← h0]
    exact hq0R
  -- the bottom prime `span {q} ⊆ ℤ` is maximal
  have hqZ0 : ((q : ℕ) : ℤ) ≠ 0 := Int.natCast_ne_zero.mpr hq.ne_zero
  haveI hprimeZ : (Ideal.span {((q : ℕ) : ℤ)}).IsPrime :=
    (Ideal.span_singleton_prime hqZ0).mpr (Nat.prime_iff_prime_int.mp hq)
  haveI hmaxZ : (Ideal.span {((q : ℕ) : ℤ)}).IsMaximal :=
    hprimeZ.isMaximal (by rw [Ne, Ideal.span_singleton_eq_bot]; exact hqZ0)
  -- `Q₀` lies over `span {q}`
  have hunder : Ideal.comap (algebraMap ℤ (RingOfIntegers K)) Q₀ =
      Ideal.span {((q : ℕ) : ℤ)} := by
    refine (hmaxZ.eq_of_le ?_ ?_).symm
    · intro htop
      refine hQ₀prime.ne_top (Ideal.eq_top_iff_one _ |>.mpr ?_)
      have h1 : (1 : ℤ) ∈ Ideal.comap (algebraMap ℤ (RingOfIntegers K)) Q₀ := by
        rw [htop]
        trivial
      have h2 := Ideal.mem_comap.mp h1
      rwa [map_one] at h2
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
      rw [map_natCast]
      exact hq0R
  haveI hLOgl : Q₀.LiesOver (Ideal.span {((q : ℕ) : ℤ)}) := ⟨hunder.symm⟩
  -- rewrite both inertia degrees as `finrank`s
  rw [Ideal.inertiaDeg'_algebraMap, Ideal.inertiaDeg'_algebraMap]
  -- the residue equivalence upstairs, from density at level `1`
  have hsurjB : Function.Surjective
      ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal (IntegralClosure Ov M))).comp φ) := by
    intro b
    obtain ⟨bb, rfl⟩ := Ideal.Quotient.mk_surjective b
    obtain ⟨z, hz⟩ := exists_sub_mem_pow_maximalIdeal hq K M hMgen φ hφ bb 1
    rw [pow_one] at hz
    refine ⟨z, ?_⟩
    rw [RingHom.comp_apply, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    rw [show φ z - bb = -(bb - φ z) by ring]
    exact Submodule.neg_mem _ hz
  have hkerB : RingHom.ker
      ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal (IntegralClosure Ov M))).comp φ) = Q₀ := by
    rw [← RingHom.comap_ker, Ideal.mk_ker]
  let eB : (RingOfIntegers K ⧸ Q₀) ≃+*
      ((IntegralClosure Ov M) ⧸ IsLocalRing.maximalIdeal (IntegralClosure Ov M)) :=
    (Ideal.quotEquivOfEq hkerB.symm).trans
      (RingHom.quotientKerEquivOfSurjective hsurjB)
  -- the residue equivalence downstairs, from integer density at level `1`
  have hqOv : ((q : ℕ) : Ov) ∈ IsLocalRing.maximalIdeal Ov := by
    rw [maximalIdeal_adicCompletionIntegers_eq_span hq]
    exact Ideal.mem_span_singleton_self _
  have hsurjO : Function.Surjective
      ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal Ov)).comp (Int.castRingHom Ov)) := by
    intro b
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective b
    obtain ⟨z, hz⟩ := exists_intCast_sub_mem_pow_maximalIdeal hq c 1
    rw [pow_one] at hz
    refine ⟨z, ?_⟩
    rw [RingHom.comp_apply, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    rw [show (Int.castRingHom Ov) z - c = -(c - (z : Ov)) by
      rw [eq_intCast]; ring]
    exact Submodule.neg_mem _ hz
  have hkerO : RingHom.ker
      ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal Ov)).comp (Int.castRingHom Ov)) =
      Ideal.span {((q : ℕ) : ℤ)} := by
    rw [← RingHom.comap_ker, Ideal.mk_ker]
    refine (hmaxZ.eq_of_le ?_ ?_).symm
    · intro htop
      refine (IsLocalRing.maximalIdeal.isMaximal Ov).ne_top
        (Ideal.eq_top_iff_one _ |>.mpr ?_)
      have h1 : (1 : ℤ) ∈ Ideal.comap (Int.castRingHom Ov)
          (IsLocalRing.maximalIdeal Ov) := by
        rw [htop]
        trivial
      have h2 := Ideal.mem_comap.mp h1
      rwa [map_one] at h2
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
      rw [map_natCast]
      exact hqOv
  let eO : (ℤ ⧸ Ideal.span {((q : ℕ) : ℤ)}) ≃+* (Ov ⧸ IsLocalRing.maximalIdeal Ov) :=
    (Ideal.quotEquivOfEq hkerO.symm).trans
      (RingHom.quotientKerEquivOfSurjective hsurjO)
  -- finiteness and field structure of the residue rings
  haveI hQ₀max : Q₀.IsMaximal := hQ₀prime.isMaximal hQ₀bot
  letI : Field (ℤ ⧸ Ideal.span {((q : ℕ) : ℤ)}) := Ideal.Quotient.field _
  letI : Field (Ov ⧸ IsLocalRing.maximalIdeal Ov) := Ideal.Quotient.field _
  haveI : NeZero q := ⟨hq.ne_zero⟩
  haveI finZq : Finite (ℤ ⧸ Ideal.span {((q : ℕ) : ℤ)}) :=
    Finite.of_equiv _ (Int.quotientSpanNatEquivZMod q).symm.toEquiv
  haveI finR : Finite (RingOfIntegers K ⧸ Q₀) :=
    Ring.HasFiniteQuotients.finiteQuotient hQ₀bot
  haveI finOv : Finite (Ov ⧸ IsLocalRing.maximalIdeal Ov) :=
    Finite.of_equiv _ eO.toEquiv
  haveI finB : Finite ((IntegralClosure Ov M) ⧸
      IsLocalRing.maximalIdeal (IntegralClosure Ov M)) :=
    Finite.of_equiv _ eB.toEquiv
  haveI := Fintype.ofFinite (ℤ ⧸ Ideal.span {((q : ℕ) : ℤ)})
  haveI := Fintype.ofFinite (RingOfIntegers K ⧸ Q₀)
  haveI := Fintype.ofFinite (Ov ⧸ IsLocalRing.maximalIdeal Ov)
  haveI := Fintype.ofFinite ((IntegralClosure Ov M) ⧸
    IsLocalRing.maximalIdeal (IntegralClosure Ov M))
  -- the two cardinality formulas
  have hcard1 := Module.card_eq_pow_finrank
    (K := ℤ ⧸ Ideal.span {((q : ℕ) : ℤ)}) (V := RingOfIntegers K ⧸ Q₀)
  have hcard2 := Module.card_eq_pow_finrank
    (K := Ov ⧸ IsLocalRing.maximalIdeal Ov)
    (V := (IntegralClosure Ov M) ⧸ IsLocalRing.maximalIdeal (IntegralClosure Ov M))
  have hcardV : Fintype.card (RingOfIntegers K ⧸ Q₀) =
      Fintype.card ((IntegralClosure Ov M) ⧸
        IsLocalRing.maximalIdeal (IntegralClosure Ov M)) :=
    Fintype.card_congr eB.toEquiv
  have hcardk : Fintype.card (ℤ ⧸ Ideal.span {((q : ℕ) : ℤ)}) =
      Fintype.card (Ov ⧸ IsLocalRing.maximalIdeal Ov) :=
    Fintype.card_congr eO.toEquiv
  have hqcard : Fintype.card (ℤ ⧸ Ideal.span {((q : ℕ) : ℤ)}) = q := by
    rw [Fintype.card_congr (Int.quotientSpanNatEquivZMod q).toEquiv]
    exact ZMod.card q
  have e1 : q ^ (Module.finrank (ℤ ⧸ Ideal.span {((q : ℕ) : ℤ)})
      (RingOfIntegers K ⧸ Q₀)) = Fintype.card (RingOfIntegers K ⧸ Q₀) := by
    rw [hcard1, hqcard]
  have e2 : q ^ (Module.finrank (Ov ⧸ IsLocalRing.maximalIdeal Ov)
      ((IntegralClosure Ov M) ⧸
        IsLocalRing.maximalIdeal (IntegralClosure Ov M))) =
      Fintype.card ((IntegralClosure Ov M) ⧸
        IsLocalRing.maximalIdeal (IntegralClosure Ov M)) := by
    rw [hcard2, ← hcardk, hqcard]
  have hpow : q ^ (Module.finrank (ℤ ⧸ Ideal.span {((q : ℕ) : ℤ)})
      (RingOfIntegers K ⧸ Q₀)) =
      q ^ (Module.finrank (Ov ⧸ IsLocalRing.maximalIdeal Ov)
        ((IntegralClosure Ov M) ⧸
          IsLocalRing.maximalIdeal (IntegralClosure Ov M))) := by
    rw [e1, e2, hcardV]
  exact Nat.pow_right_injective hq.two_le hpow

/-- **Transport of a primitive global generator**: if `θ` generates `K`
as a `ℚ`-algebra, then its image generates `M` as a `ℚ_q`-algebra
(every `hMgen`-generator `ι(x)` is a `ℚ`-polynomial in `ι(θ)`). -/
theorem adjoin_algebraMap_eq_top_of_adjoin_eq_top
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField K]
    (M : IntermediateField Kv (AlgebraicClosure Kv))
    [FiniteDimensional Kv M]
    (hMgen : M = IntermediateField.adjoin Kv
      (Set.range fun x : K => AlgebraicClosure.map (algebraMap ℚ Kv)
        (x : AlgebraicClosure ℚ)))
    (φ : RingOfIntegers K →+* IntegralClosure Ov M)
    (hφ : ∀ x : RingOfIntegers K,
      (algebraMap (IntegralClosure Ov M) M (φ x) : AlgebraicClosure Kv) =
      AlgebraicClosure.map (algebraMap ℚ Kv)
        ((algebraMap (RingOfIntegers K) K x : K) : AlgebraicClosure ℚ))
    {θ : RingOfIntegers K}
    (hθtop : Algebra.adjoin ℚ
      {(algebraMap (RingOfIntegers K) K θ : K)} = ⊤) :
    Algebra.adjoin Kv
      {(algebraMap (IntegralClosure Ov M) M (φ θ) : M)} = ⊤ := by
  classical
  have hspan := span_range_algebraMap_comp_eq_top hq K M hMgen φ hφ
  have hgen : ∀ r : RingOfIntegers K,
      (algebraMap (IntegralClosure Ov M) M (φ r) : M) ∈
        Algebra.adjoin Kv {(algebraMap (IntegralClosure Ov M) M (φ θ) : M)} := by
    intro r
    have hrmem : (algebraMap (RingOfIntegers K) K r : K) ∈
        Algebra.adjoin ℚ {(algebraMap (RingOfIntegers K) K θ : K)} := by
      rw [hθtop]
      exact Algebra.mem_top
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hrmem
    obtain ⟨p, hp⟩ := hrmem
    have hM : (algebraMap (IntegralClosure Ov M) M (φ r) : M) =
        Polynomial.aeval (algebraMap (IntegralClosure Ov M) M (φ θ) : M)
          (p.map (algebraMap ℚ Kv)) := by
      apply (algebraMap M (AlgebraicClosure Kv)).injective
      rw [← Polynomial.aeval_algebraMap_apply (AlgebraicClosure Kv)
        (algebraMap (IntegralClosure Ov M) M (φ θ) : M)
        (p.map (algebraMap ℚ Kv))]
      have hcoe : ∀ z : M, algebraMap M (AlgebraicClosure Kv) z =
          (z : AlgebraicClosure Kv) := fun z => rfl
      rw [hcoe, hcoe, hφ r, hφ θ]
      rw [Polynomial.aeval_def, Polynomial.eval₂_map,
        Subsingleton.elim ((algebraMap Kv (AlgebraicClosure Kv)).comp
          (algebraMap ℚ Kv)) (algebraMap ℚ (AlgebraicClosure Kv)),
        ← Polynomial.aeval_def]
      -- transport the `ℚ`-polynomial identity `p(θ) = r` through `ι`
      have hp' : Polynomial.aeval ((algebraMap (RingOfIntegers K) K θ)) p =
          algebraMap (RingOfIntegers K) K r := hp
      have hcoe2 : ∀ z : K, algebraMap K (AlgebraicClosure ℚ) z =
          (z : AlgebraicClosure ℚ) := fun z => rfl
      have hι := congrArg (fun z : K =>
        AlgebraicClosure.map (algebraMap ℚ Kv) (z : AlgebraicClosure ℚ)) hp'
      rw [← hι]
      rw [show (((Polynomial.aeval ((algebraMap (RingOfIntegers K) K θ))) p : K) :
          AlgebraicClosure ℚ) = algebraMap K (AlgebraicClosure ℚ)
            ((Polynomial.aeval ((algebraMap (RingOfIntegers K) K θ))) p) from rfl,
        ← Polynomial.aeval_algebraMap_apply (AlgebraicClosure ℚ)
          ((algebraMap (RingOfIntegers K) K θ)) p]
      rw [hcoe2]
      rw [Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.hom_eval₂]
      congr 1
      exact Subsingleton.elim _ _
    rw [hM, Algebra.adjoin_singleton_eq_range_aeval]
    exact ⟨p.map (algebraMap ℚ Kv), rfl⟩
  have hle : Submodule.span Kv
      (Set.range fun r : RingOfIntegers K =>
        (algebraMap (IntegralClosure Ov M) M (φ r) : M)) ≤
      Subalgebra.toSubmodule (Algebra.adjoin Kv
        {(algebraMap (IntegralClosure Ov M) M (φ θ) : M)}) := by
    rw [Submodule.span_le]
    rintro _ ⟨r, rfl⟩
    exact hgen r
  rw [eq_top_iff]
  rintro x -
  exact hle (by rw [hspan]; exact Submodule.mem_top)

end Dense

section LocalConductor

set_option backward.isDefEq.respectTransparency false in
set_option synthInstance.maxHeartbeats 1000000 in
set_option maxHeartbeats 2000000 in
/-- **Conductor triviality and the local different** (the
Kummer–Dedekind computation over the complete base): if `x ∈ 𝒪_M`
generates `M` over `ℚ_q` and `ℤ[x]` is dense in `𝒪_M`, then
`𝒪_M = 𝒪_q[x]` (Nakayama against the density at the level of one power
of `q`), so the conductor of `x` is the unit ideal and
`conductor_mul_differentIdeal` computes the local different as the
principal ideal on `g'(x)`, `g = minpoly_{𝒪_q} x`. -/
theorem differentIdeal_eq_span_of_dense
    (M : IntermediateField Kv (AlgebraicClosure Kv))
    [FiniteDimensional Kv M]
    (x : IntegralClosure Ov M)
    (hx : Algebra.adjoin Kv
      {(algebraMap (IntegralClosure Ov M) M x : M)} = ⊤)
    (hdens : ∀ (y : IntegralClosure Ov M) (j : ℕ),
      ∃ h : Polynomial ℤ, y - Polynomial.aeval x h ∈
        IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ j) :
    differentIdeal Ov (IntegralClosure Ov M) =
      Ideal.span {Polynomial.aeval x
        (Polynomial.derivative (minpoly Ov x))} := by
  classical
  haveI : IsFractionRing (IntegralClosure Ov M) M :=
    IsIntegralClosure.isFractionRing_of_finite_extension Ov Kv M
      (IntegralClosure Ov M)
  haveI : Module.Finite Ov (IntegralClosure Ov M) :=
    IsIntegralClosure.finite Ov Kv M (IntegralClosure Ov M)
  haveI : CharZero Kv :=
    charZero_of_injective_algebraMap (algebraMap ℚ Kv).injective
  haveI : CharZero M :=
    charZero_of_injective_algebraMap (algebraMap Kv M).injective
  have hqB0 : ((q : ℕ) : IntegralClosure Ov M) ≠ 0 := by
    intro h0
    refine (Nat.cast_ne_zero.mpr hq.ne_zero : ((q : ℕ) : M) ≠ 0) ?_
    rw [← map_natCast (algebraMap (IntegralClosure Ov M) M) q, h0, map_zero]
  -- `𝔪_M^{n₁} = (q)` for some `n₁` (DVR ideal classification)
  obtain ⟨π, hπirr⟩ :=
    IsDiscreteValuationRing.exists_irreducible (IntegralClosure Ov M)
  obtain ⟨n₁, hn₁⟩ := IsDiscreteValuationRing.ideal_eq_span_pow_irreducible
    (s := Ideal.span {((q : ℕ) : IntegralClosure Ov M)})
    (by rw [Ne, Ideal.span_singleton_eq_bot]; exact hqB0) hπirr
  have hpow : IsLocalRing.maximalIdeal (IntegralClosure Ov M) ^ n₁ =
      Ideal.span {((q : ℕ) : IntegralClosure Ov M)} := by
    rw [hπirr.maximalIdeal_eq, Ideal.span_singleton_pow, ← hn₁]
  -- Nakayama: `𝒪_q[x] = 𝒪_M`
  have hadj : Algebra.adjoin Ov ({x} : Set (IntegralClosure Ov M)) = ⊤ := by
    set N₀ : Submodule Ov (IntegralClosure Ov M) :=
      Subalgebra.toSubmodule (Algebra.adjoin Ov ({x} : Set (IntegralClosure Ov M)))
      with hN₀def
    have hmem : ∀ hpoly : Polynomial ℤ, Polynomial.aeval x hpoly ∈ N₀ := by
      intro hpoly
      have h1 : Polynomial.aeval x hpoly =
          Polynomial.aeval x (hpoly.map (algebraMap ℤ Ov)) := by
        rw [Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.eval₂_map,
          Subsingleton.elim ((algebraMap Ov (IntegralClosure Ov M)).comp
            (algebraMap ℤ Ov)) (algebraMap ℤ (IntegralClosure Ov M))]
      rw [h1]
      have h2 : Polynomial.aeval x (hpoly.map (algebraMap ℤ Ov)) ∈
          Algebra.adjoin Ov ({x} : Set (IntegralClosure Ov M)) := by
        rw [Algebra.adjoin_singleton_eq_range_aeval]
        exact ⟨hpoly.map (algebraMap ℤ Ov), rfl⟩
      exact h2
    have htop : ∀ y : IntegralClosure Ov M,
        y ∈ N₀ ⊔ (IsLocalRing.maximalIdeal Ov • ⊤ :
          Submodule Ov (IntegralClosure Ov M)) := by
      intro y
      obtain ⟨hpoly, hy⟩ := hdens y n₁
      rw [hpow, Ideal.mem_span_singleton] at hy
      obtain ⟨m, hm⟩ := hy
      have hyeq : y = Polynomial.aeval x hpoly +
          ((q : ℕ) : IntegralClosure Ov M) * m := by
        linear_combination hm
      rw [hyeq]
      refine Submodule.add_mem _ (Submodule.mem_sup_left (hmem hpoly))
        (Submodule.mem_sup_right ?_)
      have hq' : ((q : ℕ) : IntegralClosure Ov M) * m = ((q : ℕ) : Ov) • m := by
        rw [Algebra.smul_def, map_natCast]
      rw [hq']
      refine Submodule.smul_mem_smul ?_ Submodule.mem_top
      rw [maximalIdeal_adicCompletionIntegers_eq_span hq]
      exact Ideal.mem_span_singleton_self _
    -- pass to the quotient and apply Nakayama
    have hQle : (⊤ : Submodule Ov ((IntegralClosure Ov M) ⧸ N₀)) ≤
        IsLocalRing.maximalIdeal Ov • ⊤ := by
      intro qy _
      obtain ⟨y, rfl⟩ := N₀.mkQ_surjective qy
      obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp (htop y)
      have h4 : N₀.mkQ y = N₀.mkQ b := by
        rw [← hab, map_add]
        have h5 : N₀.mkQ a = 0 := (Submodule.Quotient.mk_eq_zero N₀).mpr ha
        rw [Submodule.mkQ_apply] at h5 ⊢
        rw [h5, zero_add]
      rw [h4]
      have h6 : N₀.mkQ b ∈ Submodule.map N₀.mkQ
          (IsLocalRing.maximalIdeal Ov • ⊤ :
            Submodule Ov (IntegralClosure Ov M)) :=
        Submodule.mem_map_of_mem hb
      rw [Submodule.map_smul''] at h6
      exact Submodule.smul_mono le_rfl le_top h6
    have hfg : (⊤ : Submodule Ov ((IntegralClosure Ov M) ⧸ N₀)).FG :=
      Module.Finite.fg_top
    have hjac : IsLocalRing.maximalIdeal Ov ≤ (⊥ : Ideal Ov).jacobson := by
      rw [IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal Ov) bot_ne_top]
    have hbot := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot
      (IsLocalRing.maximalIdeal Ov) ⊤ hfg hQle hjac
    rw [eq_top_iff]
    rintro y -
    have h7 : N₀.mkQ y ∈ (⊤ : Submodule Ov ((IntegralClosure Ov M) ⧸ N₀)) :=
      Submodule.mem_top
    rw [hbot, Submodule.mem_bot] at h7
    exact (Submodule.Quotient.mk_eq_zero N₀).mp h7
  -- the conductor is the unit ideal, so the different is principal
  have hcond : conductor Ov x = ⊤ := conductor_eq_top_of_adjoin_eq_top hadj
  have hmul := conductor_mul_differentIdeal Ov Kv M x hx
  rw [hcond, Ideal.top_mul] at hmul
  exact hmul

/-- **The constant coefficient of the minimal polynomial of a local
unit is a unit**: the integral norm `intNorm 𝒪_q 𝒪_M` is a monoid
homomorphism, so it carries the unit `x` to a unit of `𝒪_q`, and it
computes (up to sign) the constant coefficient of the minimal
polynomial of the primitive element `x`. -/
theorem isUnit_coeff_zero_minpoly
    (M : IntermediateField Kv (AlgebraicClosure Kv))
    [FiniteDimensional Kv M]
    (x : IntegralClosure Ov M)
    (hx : Algebra.adjoin Kv
      {(algebraMap (IntegralClosure Ov M) M x : M)} = ⊤)
    (hxu : IsUnit x) :
    IsUnit ((minpoly Ov x).coeff 0) := by
  classical
  haveI : IsFractionRing (IntegralClosure Ov M) M :=
    IsIntegralClosure.isFractionRing_of_finite_extension Ov Kv M
      (IntegralClosure Ov M)
  -- the unit is carried to a unit of `𝒪_q` by the integral norm
  have hnormunit : IsUnit (Algebra.intNorm Ov (IntegralClosure Ov M) x) :=
    hxu.map (Algebra.intNorm Ov (IntegralClosure Ov M))
  -- the power basis of `M` generated by `x`
  have hxM_int : IsIntegral Kv (algebraMap (IntegralClosure Ov M) M x) :=
    IsIntegral.of_finite Kv _
  let pb0 := Algebra.adjoin.powerBasis hxM_int
  let e : Algebra.adjoin Kv
      ({(algebraMap (IntegralClosure Ov M) M x : M)} : Set M) ≃ₐ[Kv] M :=
    (Subalgebra.equivOfEq _ _ hx).trans Subalgebra.topEquiv
  let pb : PowerBasis Kv M := pb0.map e
  have hgen : pb.gen = (algebraMap (IntegralClosure Ov M) M x : M) := by
    show e pb0.gen = _
    rw [Algebra.adjoin.powerBasis_gen]
    rfl
  -- the norm computes the constant coefficient of the minimal polynomial
  have hnorm := Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
  rw [hgen] at hnorm
  -- transport along `algebraMap Ov Kv`
  have hxint : IsIntegral Ov x := IsIntegralClosure.isIntegral Ov M x
  have hminp : minpoly Kv (algebraMap (IntegralClosure Ov M) M x) =
      (minpoly Ov x).map (algebraMap Ov Kv) :=
    minpoly.isIntegrallyClosed_eq_field_fractions Kv M hxint
  have hintnorm := Algebra.algebraMap_intNorm (A := Ov) (K := Kv) (L := M)
    (B := IntegralClosure Ov M) (x := x)
  rw [hnorm, hminp, Polynomial.coeff_map] at hintnorm
  -- conclude: `intNorm x = ±(coeff 0)` in `𝒪_q`
  have hsign : Algebra.intNorm Ov (IntegralClosure Ov M) x =
      (-1) ^ pb.dim * ((minpoly Ov x).coeff 0) := by
    apply IsFractionRing.injective Ov Kv
    rw [hintnorm, map_mul, map_pow, map_neg, map_one]
  rw [hsign] at hnormunit
  exact (IsUnit.mul_iff.mp hnormunit).2

end LocalConductor

section Counting

/-- **Injectivity of the embedded-conjugate map**: for a primitive
`θ`, distinct Galois substitutions give distinct `ι`-images of the
conjugates `σθ` (rigidity of the primitive element plus injectivity of
the field embeddings). -/
theorem conjugate_algebraMap_injective
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField K]
    {θ : RingOfIntegers K}
    (hθtop : Algebra.adjoin ℚ
      {(algebraMap (RingOfIntegers K) K θ : K)} = ⊤) :
    Function.Injective (fun σ : K ≃ₐ[ℚ] K =>
      AlgebraicClosure.map (algebraMap ℚ Kv)
        ((algebraMap (RingOfIntegers K) K (σ • θ) : K) :
          AlgebraicClosure ℚ)) := by
  intro σ τ h
  have h1 : σ (algebraMap (RingOfIntegers K) K θ) =
      τ (algebraMap (RingOfIntegers K) K θ) := by
    have h2 := (AlgebraicClosure.map (algebraMap ℚ Kv)).injective h
    have h3 := (algebraMap K (AlgebraicClosure ℚ)).injective
      (a₁ := (algebraMap (RingOfIntegers K) K (σ • θ) : K))
      (a₂ := (algebraMap (RingOfIntegers K) K (τ • θ) : K)) h2
    exact h3
  have h4 : (τ⁻¹ * σ) (algebraMap (RingOfIntegers K) K θ) =
      algebraMap (RingOfIntegers K) K θ := by
    have h5 : τ⁻¹ (σ (algebraMap (RingOfIntegers K) K θ)) =
        τ⁻¹ (τ (algebraMap (RingOfIntegers K) K θ)) := congrArg _ h1
    rwa [← AlgEquiv.mul_apply, ← AlgEquiv.mul_apply, inv_mul_cancel,
      AlgEquiv.one_apply] at h5
  have h6 : τ⁻¹ * σ = 1 := by
    have h7 : Algebra.adjoin ℚ
        ({(algebraMap (RingOfIntegers K) K θ : K)} : Set K) ≤
        AlgHom.equalizer (τ⁻¹ * σ : K ≃ₐ[ℚ] K).toAlgHom (AlgHom.id ℚ K) :=
      Algebra.adjoin_le (Set.singleton_subset_iff.mpr h4)
    refine AlgEquiv.ext fun y => ?_
    have hy : y ∈ Algebra.adjoin ℚ
        ({(algebraMap (RingOfIntegers K) K θ : K)} : Set K) := by
      rw [hθtop]
      exact Algebra.mem_top
    exact h7 hy
  rw [← one_mul σ, ← mul_inv_cancel τ, mul_assoc, h6, mul_one]

/-- **The mapped minimal polynomial is the nodal polynomial of the
embedded conjugates** (Serre, *Corps Locaux* III §6, base-changed along
`ι`): for a primitive algebraic integer `θ` of the Galois number field
`K`, the image of `minpoly ℤ θ` in `ℚ_qᵃˡᵍ[X]` splits as the product of
`X − ι(σθ)` over `σ ∈ Gal(K/ℚ)`. -/
theorem map_minpoly_eq_prod_X_sub_C
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField K]
    [IsGalois ℚ K]
    {θ : RingOfIntegers K}
    (hθtop : Algebra.adjoin ℚ
      {(algebraMap (RingOfIntegers K) K θ : K)} = ⊤) :
    (minpoly ℤ θ).map (Int.castRingHom (AlgebraicClosure Kv)) =
      ∏ σ : K ≃ₐ[ℚ] K,
        (X - C (AlgebraicClosure.map (algebraMap ℚ Kv)
          ((algebraMap (RingOfIntegers K) K (σ • θ) : K) :
            AlgebraicClosure ℚ))) := by
  classical
  have hint : IsIntegral ℤ θ := Algebra.IsIntegral.isIntegral θ
  have hintK : IsIntegral ℚ (algebraMap (RingOfIntegers K) K θ : K) :=
    IsIntegral.of_finite ℚ _
  set θK : K := algebraMap (RingOfIntegers K) K θ with hθKdef
  set v : (K ≃ₐ[ℚ] K) → K := fun σ => σ θK with hvdef
  -- injectivity of the conjugate map (rigidity of the primitive element)
  have hvinj : Function.Injective v := by
    intro σ τ hστ
    have h1 : (τ⁻¹ * σ) θK = θK := by
      have h2 : τ⁻¹ (σ θK) = τ⁻¹ (τ θK) := congrArg _ hστ
      rwa [← AlgEquiv.mul_apply, ← AlgEquiv.mul_apply, inv_mul_cancel,
        AlgEquiv.one_apply] at h2
    have h3 : τ⁻¹ * σ = 1 := by
      have h4 : Algebra.adjoin ℚ ({θK} : Set K) ≤
          AlgHom.equalizer (τ⁻¹ * σ : K ≃ₐ[ℚ] K).toAlgHom (AlgHom.id ℚ K) :=
        Algebra.adjoin_le (Set.singleton_subset_iff.mpr h1)
      refine AlgEquiv.ext fun y => ?_
      have hy : y ∈ Algebra.adjoin ℚ ({θK} : Set K) := by
        rw [hθtop]
        exact Algebra.mem_top
      exact h4 hy
    rw [← one_mul σ, ← mul_inv_cancel τ, mul_assoc, h3, mul_one]
  -- the mapped minimal polynomial splits over `K` with the conjugates as roots
  set P : Polynomial K := (minpoly ℚ θK).map (algebraMap ℚ K) with hPdef
  have hPmonic : P.Monic := (minpoly.monic hintK).map _
  have hPsplits : P.Splits := by
    rw [hPdef]
    exact Normal.splits inferInstance θK
  have hPdeg : P.natDegree = Fintype.card (K ≃ₐ[ℚ] K) := by
    have hadj : IntermediateField.adjoin ℚ {θK} = ⊤ := by
      refine IntermediateField.toSubalgebra_injective ?_
      rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
        hintK.isAlgebraic, IntermediateField.top_toSubalgebra]
      exact hθtop
    have hdeg : (minpoly ℚ θK).natDegree = Module.finrank ℚ K := by
      rw [← IntermediateField.adjoin.finrank hintK, hadj]
      exact IntermediateField.finrank_top'
    have h2 : P.natDegree = (minpoly ℚ θK).natDegree := by
      rw [hPdef]
      exact Polynomial.natDegree_map_eq_of_injective
        (algebraMap ℚ K).injective _
    rw [h2, hdeg, ← Nat.card_eq_fintype_card]
    exact (IsGalois.card_aut_eq_finrank ℚ K).symm
  have hroots : P.roots = Finset.univ.val.map v := by
    symm
    refine Multiset.eq_of_le_of_card_le ?_ ?_
    · rw [Multiset.le_iff_count]
      intro a
      by_cases ha : a ∈ Finset.univ.val.map v
      · rw [Multiset.count_eq_one_of_mem (Finset.univ.nodup.map hvinj) ha]
        rw [Nat.one_le_iff_ne_zero, Ne, Multiset.count_eq_zero, not_not]
        obtain ⟨σ, -, rfl⟩ := Multiset.mem_map.mp ha
        rw [Polynomial.mem_roots (hPmonic.ne_zero)]
        rw [Polynomial.IsRoot, hPdef, Polynomial.eval_map,
          ← Polynomial.aeval_def, hvdef]
        have h2 : Polynomial.aeval (σ θK) (minpoly ℚ θK) =
            σ (Polynomial.aeval θK (minpoly ℚ θK)) :=
          Polynomial.aeval_algHom_apply σ.toAlgHom θK (minpoly ℚ θK)
        rw [h2, minpoly.aeval, map_zero]
      · rw [Multiset.count_eq_zero_of_notMem ha]
        exact Nat.zero_le _
    · rw [Multiset.card_map, ← Finset.card_def, Finset.card_univ,
        Polynomial.splits_iff_card_roots.mp hPsplits, hPdeg]
  -- `P` is the product of the linear factors at the conjugates
  have hProd : P = ∏ σ : K ≃ₐ[ℚ] K, (X - C (v σ)) := by
    have h1 := hPsplits.eq_prod_roots_of_monic hPmonic
    rw [hroots] at h1
    rw [h1, Finset.prod_eq_multiset_prod, Multiset.map_map]
    rfl
  -- `P` is the `ℤ → K` image of the integral minimal polynomial
  have hPint : P = (minpoly ℤ θ).map (algebraMap ℤ K) := by
    rw [hPdef, minpoly.isIntegrallyClosed_eq_field_fractions ℚ K hint,
      Polynomial.map_map]
    all_goals
      exact congrArg (fun f : ℤ →+* K => (minpoly ℤ θ).map f)
        (Subsingleton.elim _ _)
  -- base-change everything along `κ = ι ∘ (K ↪ ℚᵃˡᵍ)`
  set κ : K →+* AlgebraicClosure Kv :=
    (AlgebraicClosure.map (algebraMap ℚ Kv)).comp
      (algebraMap K (AlgebraicClosure ℚ))
  have hmapmap : (minpoly ℤ θ).map (Int.castRingHom (AlgebraicClosure Kv)) =
      ((minpoly ℤ θ).map (algebraMap ℤ K)).map κ := by
    rw [Polynomial.map_map]
    all_goals
      exact congrArg
        (fun f : ℤ →+* AlgebraicClosure Kv => (minpoly ℤ θ).map f)
        (Subsingleton.elim _ _)
  rw [hmapmap, ← hPint, hProd, Polynomial.map_prod]
  refine Finset.prod_congr rfl fun σ _ => ?_
  rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
  all_goals congr 2

set_option backward.isDefEq.respectTransparency false in
set_option synthInstance.maxHeartbeats 1000000 in
set_option maxHeartbeats 1000000 in
/-- **Unit value of the complementary local factor** (the heart of the
completion invariance of the different; Serre, *Corps Locaux* II §3
Th. 1 packaged as root-counting): write the mapped global minimal
polynomial as `F = g·h` over `𝒪_q` with `g = minpoly (φθ)`.  Then
`h(φθ)` is a unit of `𝒪_M`.  The roots of `g` are `ι`-images of
conjugates `σθ`; a root with `σ ∉ D(Q₀)` would put the (unit, by
`isUnit_coeff_zero_minpoly`) constant coefficient of `g` inside the
maximal ideal of the integral closure of `𝒪_q` in `ℚ_qᵃˡᵍ` (since
`σθ ∈ Q₀` for `σ ∉ D`), so the roots of `g` are `D`-conjugates; the
count `deg g = [M:ℚ_q] = e·f = #D` (local fundamental identity,
Hilbert's `#D = e·f`, and the two transports above) forces the roots of
`g` to exhaust `D`, so every root of `h` has `σ ∉ D` and contributes a
unit factor `φ(θ) − ι(σθ)` (as `θ ∉ Q₀` but `σθ ∈ Q₀`). -/
theorem isUnit_aeval_cofactor
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField K]
    [IsGalois ℚ K]
    (M : IntermediateField Kv (AlgebraicClosure Kv))
    [FiniteDimensional Kv M]
    (hMgen : M = IntermediateField.adjoin Kv
      (Set.range fun x : K => AlgebraicClosure.map (algebraMap ℚ Kv)
        (x : AlgebraicClosure ℚ)))
    (φ : RingOfIntegers K →+* IntegralClosure Ov M)
    (hφ : ∀ x : RingOfIntegers K,
      (algebraMap (IntegralClosure Ov M) M (φ x) : AlgebraicClosure Kv) =
      AlgebraicClosure.map (algebraMap ℚ Kv)
        ((algebraMap (RingOfIntegers K) K x : K) : AlgebraicClosure ℚ))
    {θ : RingOfIntegers K}
    (hθtop : Algebra.adjoin ℚ
      {(algebraMap (RingOfIntegers K) K θ : K)} = ⊤)
    (hθmem : ∀ σ : K ≃ₐ[ℚ] K,
      σ • (Ideal.comap φ (IsLocalRing.maximalIdeal (IntegralClosure Ov M)))
        ≠ Ideal.comap φ (IsLocalRing.maximalIdeal (IntegralClosure Ov M)) →
      θ ∈ σ • (Ideal.comap φ
        (IsLocalRing.maximalIdeal (IntegralClosure Ov M))))
    (hθQ : θ ∉ Ideal.comap φ
      (IsLocalRing.maximalIdeal (IntegralClosure Ov M)))
    {h : Polynomial Ov}
    (hFgh : (minpoly ℤ θ).map (Int.castRingHom Ov) = minpoly Ov (φ θ) * h) :
    IsUnit (Polynomial.aeval (φ θ) h) := by
  classical
  -- ambient instances
  haveI : IsFractionRing (IntegralClosure Ov M) M :=
    IsIntegralClosure.isFractionRing_of_finite_extension Ov Kv M
      (IntegralClosure Ov M)
  haveI : Module.Finite Ov (IntegralClosure Ov M) :=
    IsIntegralClosure.finite Ov Kv M (IntegralClosure Ov M)
  haveI hmaxprime : (IsLocalRing.maximalIdeal (IntegralClosure Ov M)).IsPrime :=
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime
  set Q₀ : Ideal (RingOfIntegers K) :=
    Ideal.comap φ (IsLocalRing.maximalIdeal (IntegralClosure Ov M)) with hQ₀def
  haveI hQ₀prime : Q₀.IsPrime := Ideal.IsPrime.comap φ
  have hq0R : ((q : ℕ) : RingOfIntegers K) ∈ Q₀ := by
    rw [hQ₀def, Ideal.mem_comap, map_natCast]
    exact natCast_mem_maximalIdeal hq M
  have hqR0 : ((q : ℕ) : RingOfIntegers K) ≠ 0 := Nat.cast_ne_zero.mpr hq.ne_zero
  have hQ₀bot : Q₀ ≠ ⊥ := by
    intro h0
    refine hqR0 ?_
    rw [← Ideal.mem_bot, ← h0]
    exact hq0R
  haveI hQ₀max : Q₀.IsMaximal := hQ₀prime.isMaximal hQ₀bot
  -- the embedded-conjugate function
  set w : (K ≃ₐ[ℚ] K) → AlgebraicClosure Kv := fun σ =>
    AlgebraicClosure.map (algebraMap ℚ Kv)
      ((algebraMap (RingOfIntegers K) K (σ • θ) : K) : AlgebraicClosure ℚ)
    with hwdef
  have hwinj : Function.Injective w := conjugate_algebraMap_injective hq K hθtop
  -- passage to the integral closure `B'' ⊆ Ω` and its maximal ideal
  have hmemB'' : ∀ b : IntegralClosure Ov M,
      algebraMap M (AlgebraicClosure Kv)
        (algebraMap (IntegralClosure Ov M) M b) ∈
        integralClosure Ov (AlgebraicClosure Kv) := by
    intro b
    exact (IsIntegralClosure.isIntegral Ov M b).map
      ((IsScalarTower.toAlgHom Ov M (AlgebraicClosure Kv)).comp
        (IsScalarTower.toAlgHom Ov (IntegralClosure Ov M) M))
  have hwval : ∀ r : RingOfIntegers K,
      algebraMap M (AlgebraicClosure Kv)
        (algebraMap (IntegralClosure Ov M) M (φ r)) =
      AlgebraicClosure.map (algebraMap ℚ Kv)
        ((algebraMap (RingOfIntegers K) K r : K) : AlgebraicClosure ℚ) := by
    intro r
    exact hφ r
  have hwmem' : ∀ σ : K ≃ₐ[ℚ] K,
      w σ ∈ integralClosure Ov (AlgebraicClosure Kv) := by
    intro σ
    have h1 := hmemB'' (φ (σ • θ))
    rwa [hwval (σ • θ)] at h1
  -- `B''` is a local ring; membership descends and lifts along `Q₀`
  haveI hVR : ValuationRing (IntegralClosure Ov (AlgebraicClosure Kv)) :=
    valuationRing_integralClosure hq.toHeightOneSpectrumRingOfIntegersRat
  haveI hB''max : (IsLocalRing.maximalIdeal
      (IntegralClosure Ov (AlgebraicClosure Kv))).IsMaximal :=
    IsLocalRing.maximalIdeal.isMaximal _
  set ρ : IntegralClosure Ov M →+* IntegralClosure Ov (AlgebraicClosure Kv) :=
    RingHom.codRestrict ((algebraMap M (AlgebraicClosure Kv)).comp
      (algebraMap (IntegralClosure Ov M) M))
      (integralClosure Ov (AlgebraicClosure Kv)).toSubring
      (fun b => hmemB'' b) with hρdef
  letI := ρ.toAlgebra
  haveI httower : IsScalarTower Ov (IntegralClosure Ov M)
      (IntegralClosure Ov (AlgebraicClosure Kv)) := by
    refine IsScalarTower.of_algebraMap_eq' ?_
    refine RingHom.ext fun c => ?_
    refine Subtype.ext ?_
    have e1 : Subtype.val (algebraMap Ov
        (IntegralClosure Ov (AlgebraicClosure Kv)) c) =
        algebraMap Ov (AlgebraicClosure Kv) c := rfl
    have e2 : Subtype.val (((algebraMap (IntegralClosure Ov M)
        (IntegralClosure Ov (AlgebraicClosure Kv))).comp
          (algebraMap Ov (IntegralClosure Ov M))) c) =
        algebraMap M (AlgebraicClosure Kv)
          (algebraMap (IntegralClosure Ov M) M
            (algebraMap Ov (IntegralClosure Ov M) c)) := by
