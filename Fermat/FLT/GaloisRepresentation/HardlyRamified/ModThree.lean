    | algebraMap c => exact AlgEquiv.commutes σ c
    | add a b ha hb iha ihb => rw [map_add, iha, ihb]
    | inv a ha iha => rw [map_inv₀, iha]
    | mul a b ha hb iha ihb => rw [map_mul, iha, ihb]
