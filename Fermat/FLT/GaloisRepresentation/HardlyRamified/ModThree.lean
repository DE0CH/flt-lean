    ⟨Multiplicative.ofAdd (Finsupp.single W₀ (1 : ℤ)), ?_, ?_⟩⟩
  · rw [SetLike.mem_coe, hIm']
    intro W hW
    have hne : W ≠ W₀ := fun h => hW₀mmE (h ▸ hW)
    show Finsupp.single W₀ (1 : ℤ) W = 0
