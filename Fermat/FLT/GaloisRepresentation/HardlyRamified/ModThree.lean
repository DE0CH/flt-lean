        have hsingle : Multiplicative.ofAdd (Finsupp.single W b)
            = (Multiplicative.ofAdd (Finsupp.single W (1 : ℤ))) ^ b := by
          rw [← ofAdd_zsmul, Finsupp.smul_single]
          simp
        rw [hsingle, map_zpow, map_zpow, map_zpow, hbasisα W hW]
