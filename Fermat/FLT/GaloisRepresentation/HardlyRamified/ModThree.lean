    intro x hx
    rw [hK] at hx
    induction hx using IntermediateField.adjoin_induction with
    | mem y hy => exact IntermediateField.subset_adjoin _ _ ⟨y, hy, rfl⟩
    | algebraMap c =>
        rw [AlgebraicClosure.map_algebraMap]
        exact (IntermediateField.adjoin _ _).algebraMap_mem _
    | add a b ha hb iha ihb => rw [map_add]; exact add_mem iha ihb
    | inv a ha iha => rw [map_inv₀]; exact inv_mem iha
    | mul a b ha hb iha ihb => rw [map_mul]; exact mul_mem iha ihb
  -- `M` is generated by the finite set `ι '' s`, hence finite over `ℚ₃`
  have hMeq : M = IntermediateField.adjoin
      (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
        Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat)
      (ι '' ↑s) := by
    refine le_antisymm ?_ ?_
    · rw [hMdef, IntermediateField.adjoin_le_iff]
      rintro _ ⟨x, rfl⟩
      exact hsub' _ x.2
    · rw [IntermediateField.adjoin_le_iff]
      rintro _ ⟨y, hy, rfl⟩
      exact hsub y (hK ▸ IntermediateField.subset_adjoin _ _ hy)
  haveI hfdM : FiniteDimensional
      (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
        Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat) M := by
    rw [hMeq]
    haveI : Finite (ι '' (↑s : Set (AlgebraicClosure ℚ))) :=
      (s.finite_toSet.image ι).to_subtype
    exact IntermediateField.finiteDimensional_adjoin
      fun x _ => Algebra.IsIntegral.isIntegral x
  -- the fixing condition consumed by `hloc`
  have hMfix : ∀ σ : Γ (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
      Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat),
      Field.absoluteGaloisGroup.map (algebraMap ℚ
        (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
          Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat)) σ ∈
        K.fixingSubgroup → ∀ x ∈ M, σ x = x := by
    intro σ hσ x hx
    rw [hMdef] at hx
    induction hx using IntermediateField.adjoin_induction with
    | mem y hy =>
        obtain ⟨z, rfl⟩ := hy
        have hfixz : (Field.absoluteGaloisGroup.map f σ)
            (z : AlgebraicClosure ℚ) = z :=
          (IntermediateField.mem_fixingSubgroup_iff K
            ((Field.absoluteGaloisGroup.map f) σ)).mp hσ
            (z : AlgebraicClosure ℚ) z.2
        calc σ (ι (z : AlgebraicClosure ℚ))
            = ι ((Field.absoluteGaloisGroup.map f σ) (z : AlgebraicClosure ℚ)) :=
