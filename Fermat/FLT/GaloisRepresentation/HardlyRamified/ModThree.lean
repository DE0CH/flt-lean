    have hNmem : Multiplicative.ofAdd (E • Finsupp.single v₀ (1 : ℤ)) ∈ N := by
      have hgenN : Multiplicative.ofAdd
          (Finsupp.single v₀ (orderOf (χ (globalFrob v₀)) : ℤ)) ∈ N := by
        rw [hN]
        exact Subgroup.subset_closure ⟨v₀, hv₀S, rfl⟩
