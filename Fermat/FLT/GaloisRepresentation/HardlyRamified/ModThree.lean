/-- **CLAUSE 5, INVERTIBILITY OF THE NORMALISED JACOBIAN** (PROVEN 2026-07-28;
created 2026-07-28): `Q(w)` is invertible over `𝒪_E` for every `w ∈ 𝔪^h`.

Short, given the presentation: a matrix over the LOCAL ring `𝒪_E` is invertible
iff its determinant is a unit iff its reduction mod `𝔪` is invertible; and
`w ∈ 𝔪^h` forces `Q(w) ≡ Q(0) mod 𝔪`, whose image in the residue field is the
image of `α (Q_ij)` under the residue map that `map_eq_zero`/`residue_eq_zero`
identify with `ū`.  So the clause is `isUnit_det` transported along a ring
homomorphism, which preserves units.

WHAT THE PROOF ACTUALLY NEEDED, and it is the one step the sketch above glosses:
`α` is an ARBITRARY `𝒪₃ᵥ`-algebra map out of the power series ring, with no
continuity hypothesis available (and none is stated anywhere in this development —
`𝒪₃ᵥ[[X]]` carries no topology here).  So "the image of `α (Q_ij)` in the residue
field is the constant term of `Q_ij`" is not automatic; it is a theorem, and it is
where the FINITENESS of the variable set `Fin h` is spent.  It is now
`MvPowerSeries.algHom_apply_eq_constantCoeff`, added to
`Fermat/FLT/Mathlib/RingTheory/MvPowerSeries/AdicEval.lean` together with the
combinatorial lemma it rests on,
`MvPowerSeries.mem_span_range_X_of_constantCoeff_eq_zero` (a power series in
FINITELY many variables with zero constant term lies in the ideal generated by the
variables — decompose by the LEAST variable occurring, and apply `X_dvd_iff`).

FINITENESS IS LOAD-BEARING AND NOT DECORATIVE: for an infinite variable set the
span lemma is FALSE — `X₀ + X₁ + ⋯` has zero constant term and lies in no finitely
generated subideal of `span (range X)` — and with it the whole identification of
`α` modulo `𝔪` fails.  The other three leaves of this decomposition
(`separation_of_isFontainePresentation`,
`exists_algHom_of_isFontainePresentation`,
`mem_of_algHom_of_isFontainePresentation`) each need the same identification, and
those two lemmas plus `MvPowerSeries.mk_pow_one_adicEvalOfMem` are stated
base-generically so that they can be reused verbatim. -/
theorem isUnit_det_of_isFontainePresentation
    {A : Type} [CommRing A] [Algebra 𝒪₃ᵥ A] [Module.Flat 𝒪₃ᵥ A]
    [Module.Finite 𝒪₃ᵥ A]
    {E : IntermediateField ℚ₃ᵥ ℚ₃ᵥᵃˡᵍ} [FiniteDimensional ℚ₃ᵥ E]
    [IsAdicComplete (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E))
      (IntegralClosure 𝒪₃ᵥ E)]
    {ū : A →ₐ[𝒪₃ᵥ] (IntegralClosure 𝒪₃ᵥ E ⧸
      IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1)}
    {h : ℕ} {x : Fin h → A} {J : Ideal A}
    {P : Fin h → MvPowerSeries (Fin h) 𝒪₃ᵥ}
    {Q : Fin h → Fin h → MvPowerSeries (Fin h) 𝒪₃ᵥ}
    {α : MvPowerSeries (Fin h) 𝒪₃ᵥ →ₐ[𝒪₃ᵥ] A ⧸ J}
    (hpres : IsFontainePresentation A E ū h x J P Q α)
    (w : Fin h → IntegralClosure 𝒪₃ᵥ E)
    (hw : ∀ i, w i ∈ IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) :
    IsUnit (Matrix.of fun a b => MvPowerSeries.adicEvalOfMem
      (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) w (Q a b)).det := by
  classical
  -- NOTE: do NOT `set O := IntegralClosure 𝒪₃ᵥ E` here.  Abstracting that type shadows
  -- `w` (its type mentions it) while leaving `hw` pointing at the old copy, and every
  -- rewrite below then fails with a `w✝`-vs-`w` mismatch.  The type is spelled out.
  -- `ū` kills `J` (`map_eq_zero`), so it factors through the local factor `A ⧸ J`.
  let ū' : (A ⧸ J) →ₐ[𝒪₃ᵥ]
      (IntegralClosure 𝒪₃ᵥ E ⧸ IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1) :=
    Ideal.Quotient.liftₐ J ū hpres.map_eq_zero
  have hū' : ∀ a : A, ū' (Ideal.Quotient.mk J a) = ū a := fun a => rfl
  -- `ū' ∘ α` kills every variable (`map_X` then `residue_eq_zero`), hence IS the
  -- constant term — this is where finiteness of `Fin h` is spent.
  have hkill : ∀ i, (ū'.comp α) (MvPowerSeries.X i) = 0 := by
    intro i
    rw [AlgHom.comp_apply, hpres.map_X i, hū', hpres.residue_eq_zero i]
  have hcc : ∀ f : MvPowerSeries (Fin h) 𝒪₃ᵥ, ū' (α f) =
      algebraMap 𝒪₃ᵥ
        (IntegralClosure 𝒪₃ᵥ E ⧸ IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1)
        (MvPowerSeries.constantCoeff f) := fun f =>
    MvPowerSeries.algHom_apply_eq_constantCoeff (ū'.comp α) hkill f
  -- Modulo `𝔪`, the evaluated Jacobian IS the image of the presentation Jacobian.
  have hmat : ((Matrix.of fun i j => α (Q i j)).map
        (ū' : (A ⧸ J) →+*
          (IntegralClosure 𝒪₃ᵥ E ⧸
            IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1))) =
      (Matrix.of fun a b => MvPowerSeries.adicEvalOfMem
        (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) w (Q a b)).map
          (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1)) := by
    ext a b
    simp only [Matrix.map_apply, Matrix.of_apply, RingHom.coe_coe]
    rw [MvPowerSeries.mk_pow_one_adicEvalOfMem _ hw, hcc]
  -- Transport `isUnit_det` along the ring map `ū'`, then read it back through `hmat`.
  have h1 : IsUnit (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1)
      (Matrix.of fun a b => MvPowerSeries.adicEvalOfMem
        (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) w (Q a b)).det) := by
    rw [RingHom.map_det, RingHom.mapMatrix_apply, ← hmat, ← RingHom.mapMatrix_apply,
      ← RingHom.map_det]
    exact hpres.isUnit_det.map (ū' : (A ⧸ J) →+*
      (IntegralClosure 𝒪₃ᵥ E ⧸ IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1))
  -- `𝒪_E` is LOCAL, so invertible modulo the maximal ideal implies invertible.
  haveI hmax : (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1).IsMaximal := by
    rw [pow_one]; exact IsLocalRing.maximalIdeal.isMaximal (IntegralClosure 𝒪₃ᵥ E)
  haveI : Field (IntegralClosure 𝒪₃ᵥ E ⧸
      IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1) := Ideal.Quotient.field _
  refine IsLocalRing.notMem_maximalIdeal.mp fun hy => ?_
  have hzero : Ideal.Quotient.mk (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1)
      (Matrix.of fun a b => MvPowerSeries.adicEvalOfMem
        (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) w (Q a b)).det = 0 := by
    rw [Ideal.Quotient.eq_zero_iff_mem, pow_one]
    exact hy
  rw [hzero] at h1
  exact not_isUnit_zero h1

