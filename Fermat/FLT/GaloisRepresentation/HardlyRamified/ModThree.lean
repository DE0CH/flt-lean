/-- **CLAUSE 2, SOLUTIONS ARE POINTS** (PROVEN 2026-07-28): a tuple
`w ∈ 𝔪^h` with `P(w) ≡ 0 mod 𝔪^k` comes from an `𝒪₃ᵥ`-algebra map
`A → 𝒪_E/𝔪^k` over `ū` sending `xᵢ ↦ wᵢ`.

This is the universal property of `𝒪₃ᵥ[[X]]/(P)` at a topologically nilpotent
tuple, and with `MvPowerSeries.adicEvalOfMem` in hand it is short: substitution
at `w` is an `𝒪₃ᵥ`-algebra map `𝒪₃ᵥ[[X]] → 𝒪_E`, its reduction mod `𝔪^k` kills
every `Pᵢ` by hypothesis, hence kills `ker α = (P₁,…,P_h)` by `ker_eq`, hence
descends along `α` by `AlgHom.liftOfSurjective`; compose with `A ↠ A ⧸ J`.

NOTE this clause — unlike its two neighbours — is TRUE without the
`idempotent_generator` field, because the map it PRODUCES is built through
`A ⧸ J` and therefore kills `J` by construction.  The final normalisation
clause `factorₐ ∘ v = ū` is a second, easier application of power-series
rigidity, at nilpotency index `1`: both sides kill `J` and both send `X i` to
`0` in `𝒪_E/𝔪`, since `w i ∈ 𝔪` and `ū (x i) = 0`. -/
theorem exists_algHom_of_isFontainePresentation
    {A : Type} [CommRing A] [Algebra 𝒪₃ᵥ A] [Module.Flat 𝒪₃ᵥ A]
    [Module.Finite 𝒪₃ᵥ A]
    {E : IntermediateField ℚ₃ᵥ ℚ₃ᵥᵃˡᵍ} [FiniteDimensional ℚ₃ᵥ E]
    [IsAdicComplete (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E))
      (IntegralClosure 𝒪₃ᵥ E)]
    {ū : A →ₐ[𝒪₃ᵥ] (IntegralClosure 𝒪₃ᵥ E ⧸
      IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1)}
    {h : ℕ} {x : Fin h → A} {J : Ideal A}
    {P : Fin h → MvPowerSeries (Fin h) 𝒪₃ᵥ}
    {Q : Fin h → Fin h → MvPowerSeries (Fin h) 𝒪₃ᵥ}
    {α : MvPowerSeries (Fin h) 𝒪₃ᵥ →ₐ[𝒪₃ᵥ] A ⧸ J}
    (hpres : IsFontainePresentation A E ū h x J P Q α)
    (k : ℕ) (hk : 1 ≤ k) (w : Fin h → IntegralClosure 𝒪₃ᵥ E)
    (hw : ∀ i, w i ∈ IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E))
    (hF : ∀ i, MvPowerSeries.adicEvalOfMem
        (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) w (P i) ∈
      IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k) :
    ∃ v : A →ₐ[𝒪₃ᵥ] (IntegralClosure 𝒪₃ᵥ E ⧸
      IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k),
      (∀ i, v (x i) = Ideal.Quotient.mk
        (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k) (w i)) ∧
      (Ideal.Quotient.factorₐ 𝒪₃ᵥ (Ideal.pow_le_pow_right
        (I := IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) hk)).comp v = ū := by
  classical
  set β : MvPowerSeries (Fin h) 𝒪₃ᵥ →ₐ[𝒪₃ᵥ]
      (IntegralClosure 𝒪₃ᵥ E ⧸ IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k) :=
    (Ideal.Quotient.mkₐ 𝒪₃ᵥ (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k)).comp
      (MvPowerSeries.adicEvalOfMem (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) w)
    with hβ
  have hβX : ∀ i, β (MvPowerSeries.X i) = Ideal.Quotient.mk
      (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k) (w i) := by
    intro i
    rw [hβ]
    show Ideal.Quotient.mk _ (MvPowerSeries.adicEvalOfMem _ w (MvPowerSeries.X i)) = _
    rw [MvPowerSeries.adicEvalOfMem_X _ hw]
  have H : RingHom.ker (α : MvPowerSeries (Fin h) 𝒪₃ᵥ →+* A ⧸ J) ≤
      RingHom.ker (β : MvPowerSeries (Fin h) 𝒪₃ᵥ →+*
        (IntegralClosure 𝒪₃ᵥ E ⧸ IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k)) := by
    rw [show RingHom.ker (α : MvPowerSeries (Fin h) 𝒪₃ᵥ →+* A ⧸ J) = RingHom.ker α from rfl,
      hpres.ker_eq, Ideal.span_le]
    rintro y ⟨i, rfl⟩
    show β (P i) = 0
    rw [hβ]
    show Ideal.Quotient.mk _ (MvPowerSeries.adicEvalOfMem _ w (P i)) = 0
    exact (Ideal.Quotient.eq_zero_iff_mem).mpr (hF i)
  set γ := AlgHom.liftOfSurjective α hpres.surjective β H with hγ
  have hγα : ∀ f, γ (α f) = β f := fun f => AlgHom.liftOfSurjective_apply α _ β H f
  refine ⟨γ.comp (Ideal.Quotient.mkₐ 𝒪₃ᵥ J), fun i => ?_, ?_⟩
  · show γ (Ideal.Quotient.mk J (x i)) = _
    rw [← hpres.map_X i, hγα, hβX i]
  · set Vu := Ideal.Quotient.liftₐ J ū hpres.map_eq_zero with hVu
    have hVul : ∀ a : A, Vu (Ideal.Quotient.mk J a) = ū a := fun _ => rfl
    have key : ((Ideal.Quotient.factorₐ 𝒪₃ᵥ (Ideal.pow_le_pow_right
        (I := IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) hk)).comp γ).comp α =
        Vu.comp α := by
      refine MvPowerSeries.algHom_ext_of_pow_eq_bot
        (⊥ : Ideal (IntegralClosure 𝒪₃ᵥ E ⧸
          IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1)) 1 (by simp)
        (fun i => ?_) (fun i => ?_)
      · show (Ideal.Quotient.factorₐ 𝒪₃ᵥ (Ideal.pow_le_pow_right
            (I := IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) hk))
            (γ (α (MvPowerSeries.X i))) ∈
          (⊥ : Ideal (IntegralClosure 𝒪₃ᵥ E ⧸
            IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1))
        rw [hγα, hβX i, Ideal.mem_bot,
          factorₐ_pow_apply_mk (R := 𝒪₃ᵥ) (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) hk,
          Ideal.Quotient.eq_zero_iff_mem, pow_one]
        exact hw i
      · show (Ideal.Quotient.factorₐ 𝒪₃ᵥ (Ideal.pow_le_pow_right
            (I := IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) hk)) (γ (α (MvPowerSeries.X i))) =
          Vu (α (MvPowerSeries.X i))
        rw [hγα, hβX i, hpres.map_X i, hVul, hpres.residue_eq_zero i,
          factorₐ_pow_apply_mk (R := 𝒪₃ᵥ) (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) hk,
          Ideal.Quotient.eq_zero_iff_mem, pow_one]
        exact hw i
    refine AlgHom.ext fun a => ?_
    show (Ideal.Quotient.factorₐ 𝒪₃ᵥ (Ideal.pow_le_pow_right
            (I := IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) hk)) (γ (Ideal.Quotient.mk J a)) = ū a
    rw [← hVul a]
    obtain ⟨f, hf⟩ := hpres.surjective (Ideal.Quotient.mk J a)
    rw [← hf]
    exact AlgHom.congr_fun key f

