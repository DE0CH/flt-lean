        _ = (r.num : ℚ) * ((r.den : ℕ) : ℚ) := by rw [hnum]; ring
        _ = ((b : ℕ) : ℚ) ^ 2 * (d : ℚ) := hbdq.symm
    rw [hkey]
    exact map_intCast (algebraMap ℚ K) d
