theorem card_inertia_inf_fixingSubgroup_mul_add_sum_le_sum_card_inertia
    (L : IntermediateField ℚ₃ᵥ ℚ₃ᵥᵃˡᵍ) [FiniteDimensional ℚ₃ᵥ L]
    [IsGalois ℚ₃ᵥ L]
