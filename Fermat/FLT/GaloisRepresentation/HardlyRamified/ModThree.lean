          simp only [id_eq]
          linarith
        · have h1 := (Real.self_lt_sinh_iff.mpr h).le
          have h2 : Real.sinh (x/2) ≤ Real.cosh (x/2) := by
            have h3 := Real.cosh_sub_sinh (x/2)
