      ‖(1 : DirichletCharacter ℂ 1)
          ((Nat.card (NumberField.RingOfIntegers K ⧸ P.asIdeal) : ℕ) :
            ZMod 1) *
        (Nat.card (NumberField.RingOfIntegers K ⧸ P.asIdeal) : ℂ) ^ (-s)‖ ≤
