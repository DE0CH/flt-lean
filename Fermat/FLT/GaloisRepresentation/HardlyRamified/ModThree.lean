    have hs2 : 0 < Real.sinh (x / 2) := Real.sinh_pos_iff.mpr (by linarith)
    have hc : Real.cosh (x / 2) ≠ 0 := (Real.cosh_pos _).ne'
    simp only []
    rw [poitouF, hsx]
    field_simp
    ring
