/-- **CLAUSE 3, POINTS ARE SOLUTIONS** (PROVEN 2026-07-28, after being REFUTED
as first stated — see the FALSITY AUDIT on `IsFontainePresentation` above): the
coordinates of a map over `ū` lie in `𝔪` and solve `P ≡ 0 mod 𝔪^k`.

The converse of `exists_algHom_of_isFontainePresentation`.  `wᵢ ∈ 𝔪` because
`residue_eq_zero` says `ū (xᵢ) = 0`; and `Pᵢ(w) ≡ 0` because substitution at `w`
composed to `𝒪_E/𝔪^k` agrees with `ṽ ∘ α`, while `α (Pᵢ) = 0` by `ker_eq`.

TWO CORRECTIONS to the route this docstring used to record, both of them
load-bearing:

* `ṽ` — the map induced by `v` on `A ⧸ J` — EXISTS only because `J` is generated
  by an idempotent.  Without that field the leaf is false: `A = ℤ₃[X]/((X³−3X)²)`
  with `J = (x³ − 3x)`, `h = 1`, `P₁ = X³ − 3X`, `Q₁₁ = X² − 1`, `𝒪_E = ℤ₃[√3]`,
  `k = 5` and `v : x ↦ √3 + 3` satisfies every hypothesis, and
  `P₁(√3 + 3) = 2·(√3)⁴ + 3(√3)⁵ + (√3)⁶` has valuation `4`, not `≥ 5`.
* "both are `𝒪₃ᵥ`-algebra maps out of `𝒪₃ᵥ[[X]]` sending `Xᵢ` to the same
  element" does NOT by itself give equality — a power series ring is not
  generated by its variables and no continuity is assumed.  What makes the two
  maps equal is that the common images lie in the image of `𝔪`, which is
  nilpotent of index `k` in `𝒪_E/𝔪^k`; that is
  `MvPowerSeries.algHom_ext_of_pow_eq_bot`. -/
theorem mem_of_algHom_of_isFontainePresentation
    {A : Type} [CommRing A] [Algebra 𝒪₃ᵥ A] [Module.Flat 𝒪₃ᵥ A]
    [Module.Finite 𝒪₃ᵥ A]
    {E : IntermediateField ℚ₃ᵥ ℚ₃ᵥᵃˡᵍ} [FiniteDimensional ℚ₃ᵥ E]
    [IsAdicComplete (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E))
      (IntegralClosure 𝒪₃ᵥ E)]
    {ū : A →ₐ[𝒪₃ᵥ] (IntegralClosure 𝒪₃ᵥ E ⧸
      IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1)}
    {h : ℕ} {x : Fin h → A} {J : Ideal A}
    {P : Fin h → MvPowerSeries (Fin h) 𝒪₃ᵥ}
    {Q : Fin h → Fin h → MvPowerSeries (Fin h) 𝒪₃ᵥ}
    {α : MvPowerSeries (Fin h) 𝒪₃ᵥ →ₐ[𝒪₃ᵥ] A ⧸ J}
    (hpres : IsFontainePresentation A E ū h x J P Q α)
    (k : ℕ) (hk : 1 ≤ k)
    (v : A →ₐ[𝒪₃ᵥ] (IntegralClosure 𝒪₃ᵥ E ⧸
      IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k))
    (w : Fin h → IntegralClosure 𝒪₃ᵥ E)
    (hv : (Ideal.Quotient.factorₐ 𝒪₃ᵥ (Ideal.pow_le_pow_right
      (I := IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) hk)).comp v = ū)
    (hvw : ∀ i, v (x i) = Ideal.Quotient.mk
      (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k) (w i)) :
    (∀ i, w i ∈ IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) ∧
      (∀ i, MvPowerSeries.adicEvalOfMem
          (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) w (P i) ∈
        IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k) := by
  classical
  have hw : ∀ i, w i ∈ IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) := by
    intro i
    have h1 : (Ideal.Quotient.factorₐ 𝒪₃ᵥ (Ideal.pow_le_pow_right
        (I := IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) hk)) (v (x i)) = 0 := by
      rw [← AlgHom.comp_apply, hv]
      exact hpres.residue_eq_zero i
    rw [hvw i, factorₐ_pow_apply_mk (R := 𝒪₃ᵥ) (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) hk,
      Ideal.Quotient.eq_zero_iff_mem, pow_one] at h1
    exact h1
  refine ⟨hw, fun i => ?_⟩
  have hJv := apply_eq_zero_of_mem_of_isFontainePresentation hpres hk v hv
  set Vt := Ideal.Quotient.liftₐ J v hJv with hVt
  have hl : ∀ a : A, Vt (Ideal.Quotient.mk J a) = v a := fun _ => rfl
  set β : MvPowerSeries (Fin h) 𝒪₃ᵥ →ₐ[𝒪₃ᵥ]
      (IntegralClosure 𝒪₃ᵥ E ⧸ IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k) :=
    (Ideal.Quotient.mkₐ 𝒪₃ᵥ (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k)).comp
      (MvPowerSeries.adicEvalOfMem (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E)) w)
    with hβ
  have hβX : ∀ i, β (MvPowerSeries.X i) = Ideal.Quotient.mk
      (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k) (w i) := by
    intro j
    rw [hβ]
    show Ideal.Quotient.mk _ (MvPowerSeries.adicEvalOfMem _ w (MvPowerSeries.X j)) = _
    rw [MvPowerSeries.adicEvalOfMem_X _ hw]
  have hcomp : Vt.comp α = β := by
    refine MvPowerSeries.algHom_ext_of_pow_eq_bot
      (Ideal.map (Ideal.Quotient.mk
        (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ k))
        (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E) ^ 1)) k
      (map_pow_one_pow_eq_bot _ k) (fun j => ?_) (fun j => ?_)
    · show Vt (α (MvPowerSeries.X j)) ∈ _
      rw [hpres.map_X j, hl, hvw j]
      exact Ideal.mem_map_of_mem _ (by rw [pow_one]; exact hw j)
    · show Vt (α (MvPowerSeries.X j)) = β (MvPowerSeries.X j)
      rw [hpres.map_X j, hl, hvw j, hβX j]
  have hPker : P i ∈ RingHom.ker α := by
    rw [hpres.ker_eq]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hβP : β (P i) = 0 := by
    rw [← hcomp]
    show Vt (α (P i)) = 0
    rw [show α (P i) = 0 from hPker, map_zero]
  rw [hβ] at hβP
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  exact hβP

