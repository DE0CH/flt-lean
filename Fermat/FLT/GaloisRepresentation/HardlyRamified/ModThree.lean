  have hγI : Ideal.span ({γ} : Set (NumberField.RingOfIntegers F)) ≠ ⊥ := by
    simpa [Ideal.span_singleton_eq_bot] using hγ0
  obtain ⟨g, h, hIgh, hhnn, hgsupp⟩ :=
    exists_coprimePart_factorization_ray_class (Ideal.span {γ}) nn hγI
