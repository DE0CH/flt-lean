    have h9 : ((3 : ℕ) : IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers ℚ
        Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat) * (3 * Y ^ 2) =
        ((3 : ℕ) : IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers ℚ
