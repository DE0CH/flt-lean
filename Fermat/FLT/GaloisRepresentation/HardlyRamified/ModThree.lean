      have hveq : -(((N P : ℕ) : ℂ) ^ (-z) * Complex.log ((N P : ℕ) : ℂ) * (-1)) =
          (Real.log (N P) : ℂ) * ((N P : ℕ) : ℂ) ^ (-z) := by
