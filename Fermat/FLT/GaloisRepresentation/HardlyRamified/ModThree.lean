          ((((Pm.2 : ℝ) + 1) * Real.log (Ideal.absNorm Pm.1.1) : ℝ) : ℂ)))).symm.trans
    ?_ |>.symm
  refine tsum_congr fun Pm => ?_
  show (Real.log (Ideal.absNorm (e Pm.1).1) : ℂ) *
      Complex.exp (-s *
        ((((Pm.2 : ℝ) + 1) * Real.log (Ideal.absNorm (e Pm.1).1) : ℝ) : ℂ)) = F Pm
