sur ℤ*, Invent. Math. 81 (1985), Thm. A and §§1–3; Moon–Taguchi, Doc.
Math. Extra Vol. Kato (2003), §2): `ℚ₃(V)` is generated by the points
of the finite flat group scheme `G/ℤ₃` killed by `3` prolonging
`ρ|_{Γ ℚ₃}`, and Fontaine's Thm. A bounds the different of its
subextensions by `v_M(𝔡_{M/ℚ₃}) ≤ e·(1 + 1/2) − 1`, i.e.
`2d + 2 ≤ 3e`.  Sharpness at `M = ℚ₃(ζ₃, u^{1/3})`: `e = 6`,
`v(𝔡) = 8`, equality `18 = 18`. -/
theorem two_mul_local_differentIdeal_exponent_add_two_le_of_flat_at_three
    {k : Type u} [Finite k] [Field k]
    [Algebra ℤ_[3] k] [TopologicalSpace k] [DiscreteTopology k]
    (V : Type*) [AddCommGroup V] [Module k V] [Module.Finite k V]
    [Module.Free k V]
    (hV : Module.rank k V = 2) {ρ : GaloisRep ℚ k V}
    (hρ : IsHardlyRamified (show Odd 3 by decide) hV ρ)
    (b : Module.Basis (Fin 2) (AlgebraicClosure k)
      ((AlgebraicClosure k) ⊗[k] V))
    (e : AlgebraicClosure k ≃+* Dickson.K 3)
    (u : Γ ℚ →* GL (Fin 2) (Dickson.K 3))
    (hu : ∀ g, ((u g : GL (Fin 2) (Dickson.K 3)) :
      Matrix (Fin 2) (Fin 2) (Dickson.K 3)) =
      (LinearMap.toMatrix b b ((Slop.OddRep.baseChange (AlgebraicClosure k)
        (MonoidHomClass.toMonoidHom ρ)) g)).map e)
    (M : IntermediateField
      (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
        Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat)
      (AlgebraicClosure (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
        Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat)))
    [FiniteDimensional (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
      Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat) M]
    (hM : ∀ σ : Γ (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
        Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat),
      u (Field.absoluteGaloisGroup.map (algebraMap ℚ
        (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
          Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat)) σ) = 1 →
      ∀ x ∈ M, σ x = x)
    (d : ℕ)
    (hd : IsLocalRing.maximalIdeal (IntegralClosure
        (IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers ℚ
          Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat) M) ^ d ∣
      differentIdeal
        (IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers ℚ
          Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat)
        (IntegralClosure
          (IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers ℚ
            Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat) M)) :
    2 * d + 2 ≤ 3 * Ideal.ramificationIdx'
      (IsLocalRing.maximalIdeal
        (IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers ℚ
          Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat))
      (IsLocalRing.maximalIdeal (IntegralClosure
        (IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers ℚ
          Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat) M)) := by
  classical
  -- (1) unpack flatness into the explicit finite flat Hopf package
  obtain ⟨G, i1, i2, i3, i4, i5, f, hbij⟩ :=
    hasFlatProlongationAt_three_of_isFlatAt V hρ.isFlat
  letI := i1
  letI := i2
  letI := i3
  letI := i4
  letI := i5
  let g := Equiv.ofBijective f hbij
  have hfs : ∀ x : V, f (g.symm x) = x := fun x => g.apply_symm_apply x
  -- the coefficient field has characteristic `3`
  have h3V : ∀ w : V, w + w + w = 0 := by
    intro w
    have h3k : (3 : k) = 0 := three_eq_zero_of_finite_padicIntThree_algebra
    have h1 : ((3 : ℕ) : k) • w = (3 : ℕ) • w := Nat.cast_smul_eq_nsmul k 3 w
    rw [show ((3 : ℕ) : k) = (3 : k) from by norm_cast, h3k, zero_smul] at h1
    have h2 : (3 : ℕ) • w = w + w + w := by
      rw [show (3 : ℕ) = 2 + 1 from rfl, add_nsmul, two_nsmul, one_nsmul]
    rw [← h2]
    exact h1.symm
  -- (2) the geometric points of the package are killed by `3`
  have hkill : ∀ χ : ℚ₃ᵥ ⊗[𝒪₃ᵥ] G →ₐ[ℚ₃ᵥ] ℚ₃ᵥᵃˡᵍ, χ * χ * χ = 1 := by
    intro χ
    have h0 : Additive.ofMul χ + Additive.ofMul χ + Additive.ofMul χ =
        (0 : Additive (ℚ₃ᵥ ⊗[𝒪₃ᵥ] G →ₐ[ℚ₃ᵥ] ℚ₃ᵥᵃˡᵍ)) := by
      apply g.injective
      show f (Additive.ofMul χ + Additive.ofMul χ + Additive.ofMul χ) = f 0
      rw [map_add f, map_add f, map_zero f]
      exact h3V (f (Additive.ofMul χ))
    have h1 := congrArg Additive.toMul h0
    rwa [toMul_add, toMul_add, toMul_zero, toMul_ofMul] at h1
  -- (3) the two spellings of the local action agree: ring homs out of
  -- `ℚ` are unique
  have hbridge : ∀ (τ : Γ (ℚ₃ᵥ)) (w : V),
      (ρ.toLocal Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat) τ w =
      ρ (Field.absoluteGaloisGroup.map (algebraMap ℚ (ℚ₃ᵥ)) τ) w := by
    intro τ w
    rw [GaloisRep.toLocal_apply]
    exact congrArg (fun (h : ℚ →+* (ℚ₃ᵥ)) =>
      ρ (Field.absoluteGaloisGroup.map h τ) w) (Subsingleton.elim _ _)
  -- (4) the kernel-field glue: a substitution fixing every point acts
  -- trivially on `V`, hence is killed by `u`, hence fixes `M` by `hM`
  have hMpkg : ∀ σ : Γ (ℚ₃ᵥ),
      (∀ χ : ℚ₃ᵥ ⊗[𝒪₃ᵥ] G →ₐ[ℚ₃ᵥ] ℚ₃ᵥᵃˡᵍ, σ • χ = χ) →
      ∀ x ∈ M, σ x = x := by
    intro σ hσ
    refine hM σ ?_
    -- the local substitution acts trivially on `V`
    have hfixV : ∀ w : V,
        ρ (Field.absoluteGaloisGroup.map (algebraMap ℚ (ℚ₃ᵥ)) σ) w = w := by
      intro w
      have h2 : Additive.toMul (σ • g.symm w) =
          σ • Additive.toMul (g.symm w) := rfl
      have h3 : Additive.toMul (σ • g.symm w) = Additive.toMul (g.symm w) := by
        rw [h2]
        exact hσ _
      have h1 : σ • g.symm w = g.symm w := Additive.toMul.injective h3
      have h4 : f (σ • g.symm w) = f (g.symm w) := by rw [h1]
      rw [map_smul f, hfs] at h4
      have h5 : (ρ.toLocal
          Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat) σ w = w := h4
      exact (hbridge σ w).symm.trans h5
    -- hence the matrix realization kills the global lift: the matrix
    -- transport of the identity is the identity
    have hend : (MonoidHomClass.toMonoidHom ρ :
        Representation k (Γ ℚ) V)
        (Field.absoluteGaloisGroup.map (algebraMap ℚ (ℚ₃ᵥ)) σ) = 1 := by
      refine LinearMap.ext fun w => ?_
      rw [Module.End.one_apply]
      exact hfixV w
    apply Units.ext
    rw [Units.val_one,
      hu (Field.absoluteGaloisGroup.map (algebraMap ℚ (ℚ₃ᵥ)) σ)]
    have hbc : (Slop.OddRep.baseChange (AlgebraicClosure k)
        (MonoidHomClass.toMonoidHom ρ))
        (Field.absoluteGaloisGroup.map (algebraMap ℚ (ℚ₃ᵥ)) σ) =
        ((MonoidHomClass.toMonoidHom ρ :
          Representation k (Γ ℚ) V)
          (Field.absoluteGaloisGroup.map (algebraMap ℚ (ℚ₃ᵥ)) σ)).baseChange
          (AlgebraicClosure k) := rfl
    rw [hbc, hend, Module.End.one_eq_id, LinearMap.baseChange_id,
      ← Module.End.one_eq_id, LinearMap.toMatrix_one,
      Matrix.map_one _ (map_zero e) (map_one e)]
  -- (5) the scheme-theoretic Fontaine bound closes the estimate
  exact two_mul_local_differentIdeal_exponent_add_two_le_of_hopf_package
    G hkill M hMpkg d hd

end FontaineHopfBound

