      Subgroup.card_subgroup_dvd_card _
    obtain ⟨m, hm⟩ := hdvd1
    have hcard : Nat.card kˣ = Fintype.card k - 1 := by
      rw [Nat.card_eq_fintype_card, Fintype.card_units]
    have hcast : ((Nat.card kˣ : ℕ) : k) = -1 := by
