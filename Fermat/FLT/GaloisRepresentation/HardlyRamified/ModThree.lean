      have h1 : ψ g = χ g := by
        have h2 : ψ g / χ g = 1 := hg
        exact div_eq_one.mp h2
      exact congrArg Units.val h1
    show c g * ((χ g : k))⁻¹ = 0
    rw [h0 g hψχ, zero_mul]
  -- `b` is constant on the fibers of `η`
