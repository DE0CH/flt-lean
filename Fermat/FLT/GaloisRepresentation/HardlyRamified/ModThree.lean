      (b : ℤ) ^ 2 * d = r.num * (r.den : ℤ) := by
    rcases Int.natAbs_eq (r.num * (r.den : ℤ)) with h | h
    · refine ⟨(a : ℤ), Int.squarefree_natCast.mpr hasq, ?_⟩
      rw [h, ← hab]
      push_cast
      ring
    · refine ⟨-(a : ℤ), ?_, ?_⟩
      · intro z hz
