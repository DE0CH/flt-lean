      have h2 : (0 : ℝ) < (j : ℝ) + 2 := by positivity
      have hexp : y ^ 2 / 2 * (1 / ((j : ℝ) + 1) ^ 2 - 1 / ((j : ℝ) + 2) ^ 2) -
