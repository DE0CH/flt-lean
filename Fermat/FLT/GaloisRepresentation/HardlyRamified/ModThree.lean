    (L ≃ₐ[ℚ₃ᵥ] L) ⊓ (IntermediateField.comap L.val M).fixingSubgroup) * d with hPdef
  rw [Finset.sum_range_succ, Finset.sum_range_succ, hgn, hhn]
  omega

