              (I := IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E))
              (show j ≤ n + N by omega))).comp u :=
            (factor_trans (n + N) (j + N) j (by omega) (by omega) u).symm
        _ = _ := hu

