        | .sr _ => Multiplicative.ofAdd 1
      map_one' := rfl
      map_mul' := by
        rintro (i | i) (j | j) <;>
          simp only [DihedralGroup.r_mul_r, DihedralGroup.r_mul_sr,
            DihedralGroup.sr_mul_r, DihedralGroup.sr_mul_sr] <;> decide }
  -- the quadratic character of `Γ ℚ` cut out by the rotation subgroup
