      (n + 1)).inertia (L ≃ₐ[ℚ₃ᵥ] L)) = 1 := by rw [hn, Subgroup.card_bot]
  have hhn : Nat.card ↥((IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ L) ^
      (n + 1)).inertia (L ≃ₐ[ℚ₃ᵥ] L) ⊓
