      intro w
      have h2 : Additive.toMul (σ • g.symm w) =
          σ • Additive.toMul (g.symm w) := rfl
      have h3 : Additive.toMul (σ • g.symm w) = Additive.toMul (g.symm w) := by
        rw [h2]
        exact hσ _
      have h1 : σ • g.symm w = g.symm w := Additive.toMul.injective h3
      have h4 : f (σ • g.symm w) = f (g.symm w) := by rw [h1]
      rw [map_smul f, hfs] at h4
      have h5 : (ρ.toLocal
          Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat) σ w = w := h4
      exact (hbridge σ w).symm.trans h5
    -- hence the matrix realization kills the global lift: the matrix
    -- transport of the identity is the identity
    have hend : (MonoidHomClass.toMonoidHom ρ :
        Representation k (Γ ℚ) V)
        (Field.absoluteGaloisGroup.map (algebraMap ℚ (ℚ₃ᵥ)) σ) = 1 := by
      refine LinearMap.ext fun w => ?_
      rw [Module.End.one_apply]
      exact hfixV w
    apply Units.ext
    rw [Units.val_one,
      hu (Field.absoluteGaloisGroup.map (algebraMap ℚ (ℚ₃ᵥ)) σ)]
    have hbc : (Slop.OddRep.baseChange (AlgebraicClosure k)
        (MonoidHomClass.toMonoidHom ρ))
        (Field.absoluteGaloisGroup.map (algebraMap ℚ (ℚ₃ᵥ)) σ) =
        ((MonoidHomClass.toMonoidHom ρ :
          Representation k (Γ ℚ) V)
          (Field.absoluteGaloisGroup.map (algebraMap ℚ (ℚ₃ᵥ)) σ)).baseChange
          (AlgebraicClosure k) := rfl
    rw [hbc, hend, Module.End.one_eq_id, LinearMap.baseChange_id,
      ← Module.End.one_eq_id, LinearMap.toMatrix_one,
      Matrix.map_one _ (map_zero e) (map_one e)]
  -- (5) the scheme-theoretic Fontaine bound closes the estimate
  exact two_mul_local_differentIdeal_exponent_add_two_le_of_hopf_package
    G hkill M hMpkg d hd

end FontaineHopfBound

