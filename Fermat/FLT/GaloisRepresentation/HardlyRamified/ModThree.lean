    rw [Real.le_log_iff_exp_le (by positivity)]
    have h146 : (1.46 : ℝ) ≤ 16 * Real.pi / 33 := by
      have hpi : (3.14 : ℝ) < Real.pi := Real.pi_gt_d2
      linarith
    linarith [hexp]
