theorem map_maximalIdeal_eq_maximalIdeal_pow_card_inertia_inf
    (L : IntermediateField ℚ₃ᵥ ℚ₃ᵥᵃˡᵍ) [FiniteDimensional ℚ₃ᵥ L]
