    ext g
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
    constructor
    · intro h
      have h0 : lam (b g.1) = 0 := by
        rwa [hchdef, MonoidHom.coe_mk, OneHom.coe_mk, ofAdd_eq_one] at h
      exact ⟨MonoidHom.mem_ker.mp g.2, h0⟩
    · rintro ⟨h1, h2⟩
      show Multiplicative.ofAdd (lam (b g.1)) = 1
      rw [h2, ofAdd_zero]
