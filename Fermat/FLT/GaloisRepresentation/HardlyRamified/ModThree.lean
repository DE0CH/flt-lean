    · exact ((Complex.continuous_exp.comp (by fun_prop)).div_const _).continuousOn
    · exact fun x _ => (hr₂der x).ofReal_comp
    · exact fun x _ => hvder x
    · exact (Complex.continuous_ofReal.comp hrd₂cont).intervalIntegrable _ _
    · exact (Complex.continuous_exp.comp (by fun_prop)).intervalIntegrable _ _
  have hq0 : ((1 + (0:ℝ) / 6) * q 0 : ℝ) = 1 := by
    simp [hq]
  have hqm6 : ((1 + (-6:ℝ) / 6) * q (-6) : ℝ) = 0 := by
    norm_num
  have hq6 : ((1 - (6:ℝ) / 6) * q 6 : ℝ) = 0 := by
    norm_num
  have hq0' : ((1 - (0:ℝ) / 6) * q 0 : ℝ) = 1 := by
    simp [hq]
  have hval : poitouPhi (5 / 4 + t * Complex.I) =
      -(∫ x in (-6:ℝ)..0, ((rd₁ x : ℝ) : ℂ) *
        (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I)))
      - ∫ x in (0:ℝ)..6, ((rd₂ x : ℝ) : ℂ) *
        (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I)) := by
    rw [hstep1, hstep2, hcongr₁, hcongr₂, hibp₁, hibp₂, hq0, hqm6, hq6, hq0']
    push_cast
    ring
  have hw : ∀ x : ℝ, ‖Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) /
      ((t : ℂ) * Complex.I) ^ 2‖ = 1 / t ^ 2 := by
    intro x
    rw [norm_div, Complex.norm_exp_ofReal_mul_I, norm_pow, norm_mul, Complex.norm_I,
      mul_one, Complex.norm_real, Real.norm_eq_abs, sq_abs]
  have hibp₁₂ : (∫ x in (-6:ℝ)..0, ((rd₁ x : ℝ) : ℂ) *
        (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I))) =
      ((rd₁ (0:ℝ) : ℝ) : ℂ) *
        (Complex.exp (((t * (0:ℝ) : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2) -
      ((rd₁ (-6:ℝ) : ℝ) : ℂ) *
        (Complex.exp (((t * (-6:ℝ) : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2) -
      ∫ x in (-6:ℝ)..0, ((rdd₁ x : ℝ) : ℂ) *
        (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2) := by
    refine intervalIntegral.integral_mul_deriv_eq_deriv_mul_of_hasDerivAt
      (u := fun x : ℝ => ((rd₁ x : ℝ) : ℂ))
      (v := fun x : ℝ =>
        Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2)
      (u' := fun x : ℝ => ((rdd₁ x : ℝ) : ℂ))
      (v' := fun x : ℝ =>
        Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I)) ?_ ?_ ?_ ?_ ?_ ?_
    · exact (Complex.continuous_ofReal.comp hrd₁cont).continuousOn
    · exact ((Complex.continuous_exp.comp (by fun_prop)).div_const _).continuousOn
    · exact fun x _ => (hrd₁der x).ofReal_comp
    · exact fun x _ => hv₂der x
    · exact (Complex.continuous_ofReal.comp hrdd₁cont).intervalIntegrable _ _
    · exact ((Complex.continuous_exp.comp (by fun_prop)).div_const _).intervalIntegrable _ _
  have hibp₂₂ : (∫ x in (0:ℝ)..6, ((rd₂ x : ℝ) : ℂ) *
        (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I))) =
      ((rd₂ (6:ℝ) : ℝ) : ℂ) *
        (Complex.exp (((t * (6:ℝ) : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2) -
      ((rd₂ (0:ℝ) : ℝ) : ℂ) *
        (Complex.exp (((t * (0:ℝ) : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2) -
      ∫ x in (0:ℝ)..6, ((rdd₂ x : ℝ) : ℂ) *
        (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2) := by
    refine intervalIntegral.integral_mul_deriv_eq_deriv_mul_of_hasDerivAt
      (u := fun x : ℝ => ((rd₂ x : ℝ) : ℂ))
      (v := fun x : ℝ =>
        Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2)
      (u' := fun x : ℝ => ((rdd₂ x : ℝ) : ℂ))
      (v' := fun x : ℝ =>
        Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I)) ?_ ?_ ?_ ?_ ?_ ?_
    · exact (Complex.continuous_ofReal.comp hrd₂cont).continuousOn
    · exact ((Complex.continuous_exp.comp (by fun_prop)).div_const _).continuousOn
    · exact fun x _ => (hrd₂der x).ofReal_comp
    · exact fun x _ => hv₂der x
    · exact (Complex.continuous_ofReal.comp hrdd₂cont).intervalIntegrable _ _
    · exact ((Complex.continuous_exp.comp (by fun_prop)).div_const _).intervalIntegrable _ _
  have hbnd₁ : ‖∫ x in (-6:ℝ)..0, ((rd₁ x : ℝ) : ℂ) *
      (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I))‖ ≤
      (|rd₁ 0| + |rd₁ (-6)| + ∫ x in (-6:ℝ)..0, |rdd₁ x|) / t ^ 2 := by
    rw [hibp₁₂]
    have h0 : ‖((rd₁ (0:ℝ) : ℝ) : ℂ) *
        (Complex.exp (((t * (0:ℝ) : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2)‖ =
        |rd₁ 0| * (1 / t ^ 2) := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, hw]
    have h6 : ‖((rd₁ (-6:ℝ) : ℝ) : ℂ) *
        (Complex.exp (((t * (-6:ℝ) : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2)‖ =
        |rd₁ (-6)| * (1 / t ^ 2) := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, hw]
    have hI : ‖∫ x in (-6:ℝ)..0, ((rdd₁ x : ℝ) : ℂ) *
        (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2)‖ ≤
        (∫ x in (-6:ℝ)..0, |rdd₁ x|) * (1 / t ^ 2) := by
      refine (intervalIntegral.norm_integral_le_integral_norm
        (by norm_num : (-6:ℝ) ≤ 0)).trans (le_of_eq ?_)
      rw [show (fun x : ℝ => ‖((rdd₁ x : ℝ) : ℂ) *
          (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2)‖) =
          fun x : ℝ => |rdd₁ x| * (1 / t ^ 2) from funext fun x => by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, hw],
        intervalIntegral.integral_mul_const]
    have ht2 : t ^ 2 ≠ 0 := pow_ne_zero _ ht
    refine ((norm_sub_le _ _).trans (add_le_add ((norm_sub_le _ _).trans
      (le_of_eq (by rw [h0, h6]))) hI)).trans (le_of_eq ?_)
    field_simp
  have hbnd₂ : ‖∫ x in (0:ℝ)..6, ((rd₂ x : ℝ) : ℂ) *
      (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I))‖ ≤
      (|rd₂ 6| + |rd₂ 0| + ∫ x in (0:ℝ)..6, |rdd₂ x|) / t ^ 2 := by
    rw [hibp₂₂]
    have h0 : ‖((rd₂ (6:ℝ) : ℝ) : ℂ) *
        (Complex.exp (((t * (6:ℝ) : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2)‖ =
        |rd₂ 6| * (1 / t ^ 2) := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, hw]
    have h6 : ‖((rd₂ (0:ℝ) : ℝ) : ℂ) *
        (Complex.exp (((t * (0:ℝ) : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2)‖ =
        |rd₂ 0| * (1 / t ^ 2) := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, hw]
    have hI : ‖∫ x in (0:ℝ)..6, ((rdd₂ x : ℝ) : ℂ) *
        (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2)‖ ≤
        (∫ x in (0:ℝ)..6, |rdd₂ x|) * (1 / t ^ 2) := by
      refine (intervalIntegral.norm_integral_le_integral_norm
        (by norm_num : (0:ℝ) ≤ 6)).trans (le_of_eq ?_)
      rw [show (fun x : ℝ => ‖((rdd₂ x : ℝ) : ℂ) *
          (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I) ^ 2)‖) =
          fun x : ℝ => |rdd₂ x| * (1 / t ^ 2) from funext fun x => by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, hw],
        intervalIntegral.integral_mul_const]
    have ht2 : t ^ 2 ≠ 0 := pow_ne_zero _ ht
    refine ((norm_sub_le _ _).trans (add_le_add ((norm_sub_le _ _).trans
      (le_of_eq (by rw [h0, h6]))) hI)).trans (le_of_eq ?_)
    field_simp
  rw [hval]
  calc ‖-(∫ x in (-6:ℝ)..0, ((rd₁ x : ℝ) : ℂ) *
        (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I)))
      - ∫ x in (0:ℝ)..6, ((rd₂ x : ℝ) : ℂ) *
        (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I))‖
      ≤ ‖∫ x in (-6:ℝ)..0, ((rd₁ x : ℝ) : ℂ) *
          (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I))‖ +
        ‖∫ x in (0:ℝ)..6, ((rd₂ x : ℝ) : ℂ) *
          (Complex.exp (((t * x : ℝ) : ℂ) * Complex.I) / ((t : ℂ) * Complex.I))‖ :=
      (norm_sub_le _ _).trans (by rw [norm_neg])
    _ ≤ (|rd₁ 0| + |rd₁ (-6)| + ∫ x in (-6:ℝ)..0, |rdd₁ x|) / t ^ 2 +
        (|rd₂ 6| + |rd₂ 0| + ∫ x in (0:ℝ)..6, |rdd₂ x|) / t ^ 2 := add_le_add hbnd₁ hbnd₂
    _ = (|rd₁ 0| + |rd₁ (-6)| + (∫ x in (-6:ℝ)..0, |rdd₁ x|) +
        (|rd₂ 6| + |rd₂ 0| + ∫ x in (0:ℝ)..6, |rdd₂ x|)) / t ^ 2 := (add_div _ _ _).symm

/-- **Integrability of `Φ` along the line `Re s = 5/4`** (PROVEN
2026-07-24 — leaf (b₂ᵢᵢ·3·B) of the prime-edge decomposition, the
quadratic-decay brick of the termwise Fourier inversion): the
second-parts-integration decay `‖Φ(5/4+it)‖ ≤ M/t²`
(`poitouPhi_line_decay_sq`, for `|t| ≥ 1`) and the trivial bound
`poitouPhi_line_norm_le_const` (for `|t| ≤ 1`) give the integrable
majorant `K·(1+t²)⁻¹` (`integrable_inv_one_add_sq`), with
measurability from `poitouPhi_line_continuous` — the same endgame as
the PROVEN `poitouPoleTerm_integrable`. -/
theorem poitouPhi_line_integrable :
    Integrable fun t : ℝ => poitouPhi (5 / 4 + t * Complex.I) := by
  obtain ⟨M, hM0, hM⟩ := poitouPhi_line_decay_sq
  set C : ℝ := ∫ x : ℝ, ‖poitouG x‖ with hC
  have hC0 : 0 ≤ C := by
    rw [hC]
    exact integral_nonneg fun x => norm_nonneg _
  set K : ℝ := max (2 * C) (2 * M) with hK
  refine (integrable_inv_one_add_sq.const_mul K).mono'
    poitouPhi_line_continuous.aestronglyMeasurable ?_
  refine Filter.Eventually.of_forall fun t => ?_
  have hmain : ‖poitouPhi (5 / 4 + t * Complex.I)‖ * (1 + t ^ 2) ≤ K := by
    rcases le_total |t| 1 with hcase | hcase
    · have h1 : ‖poitouPhi (5 / 4 + t * Complex.I)‖ ≤ C := by
        rw [hC]
        exact poitouPhi_line_norm_le_const t
      have h2 : (1 : ℝ) + t ^ 2 ≤ 2 := by
        nlinarith [abs_nonneg t, abs_mul_abs_self t, sq_abs t]
      calc ‖poitouPhi (5 / 4 + t * Complex.I)‖ * (1 + t ^ 2) ≤ C * 2 :=
            mul_le_mul h1 h2 (by positivity) hC0
        _ = 2 * C := by ring
        _ ≤ K := le_max_left _ _
    · have htpos : (0:ℝ) < |t| := lt_of_lt_of_le zero_lt_one hcase
      have ht0 : t ≠ 0 := abs_pos.mp htpos
      have hM2 : 0 ≤ M / t ^ 2 := div_nonneg hM0 (by positivity)
      have h2 : (1:ℝ) + t ^ 2 ≤ 2 * t ^ 2 := by
        nlinarith [abs_nonneg t, abs_mul_abs_self t, sq_abs t]
      calc ‖poitouPhi (5 / 4 + t * Complex.I)‖ * (1 + t ^ 2)
          ≤ M / t ^ 2 * (2 * t ^ 2) :=
            mul_le_mul (hM t ht0) h2 (by positivity) hM2
        _ = 2 * M := by
            have ht2 : t ^ 2 ≠ 0 := pow_ne_zero _ ht0
            field_simp
        _ ≤ K := le_max_right _ _
  rw [← div_eq_mul_inv, le_div_iff₀ (by positivity : (0:ℝ) < 1 + t ^ 2)]
  exact hmain

/-- **Fourier inversion at a shifted point: the paired line integral
of `Φ` against `e^{−sx}`** (PROVEN 2026-07-24 — Poitou p. 6-04, the
evaluation `∫_ℝ Φ(5/4+it)·e^{−(5/4+it)x} dt = 2π·F(x)·e^{−x/2}` used
by Lemme 2 and, at `x = 0`, `integral_poitouPhi_line`): by
`fourier_poitouG` the edge restriction of `Φ` is the Fourier
transform of the integrable, continuous, compactly supported
`poitouG`, so Fourier inversion
(`Integrable.fourierInv_fourier_eq`, with `𝓕 poitouG` integrable by
`poitouPhi_line_integrable` after the linear substitution
`t = −2πξ`) evaluates the inverse transform at the point `x` to
`poitouG x = F(x)·e^{3x/4}`; the prefactor `e^{−5x/4}` from
`e^{−(5/4+it)x} = e^{−5x/4}·e^{−itx}` recombines to `F(x)·e^{−x/2}`. -/
theorem integral_poitouPhi_line_mul_exp (x : ℝ) :
    (∫ t : ℝ, poitouPhi (5 / 4 + t * Complex.I) *
        Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))) =
      ((2 * Real.pi * (poitouF x * Real.exp (-(x / 2))) : ℝ) : ℂ) := by
  have hFInt : Integrable (𝓕 poitouG) := by
    have hne : (-(2 * Real.pi) : ℝ) ≠ 0 := by simp [Real.pi_ne_zero]
    have h1 : Integrable fun ξ : ℝ =>
        poitouPhi (5 / 4 + (((-(2 * Real.pi)) * ξ : ℝ) : ℂ) * Complex.I) :=
      poitouPhi_line_integrable.comp_mul_left' hne
    refine h1.congr (Filter.Eventually.of_forall fun ξ => ?_)
    rw [fourier_poitouG]
    norm_num
  have hinv : 𝓕⁻ (𝓕 poitouG) x = poitouG x :=
    poitouG_integrable.fourierInv_fourier_eq hFInt continuous_poitouG.continuousAt
  have hL : 𝓕⁻ (𝓕 poitouG) x =
      ∫ ξ : ℝ, Complex.exp (((-2 * Real.pi * ξ * -x : ℝ) : ℂ) * Complex.I) •
        𝓕 poitouG ξ := by
    rw [Real.fourierInv_eq_fourier_neg, Real.fourier_real_eq_integral_exp_smul]
  have hchange : (∫ ξ : ℝ,
        Complex.exp (((-2 * Real.pi * ξ * -x : ℝ) : ℂ) * Complex.I) • 𝓕 poitouG ξ) =
      |((-(2 * Real.pi))⁻¹)| • ∫ t : ℝ, poitouPhi (5 / 4 + t * Complex.I) *
        Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I) := by
    rw [show (fun ξ : ℝ =>
        Complex.exp (((-2 * Real.pi * ξ * -x : ℝ) : ℂ) * Complex.I) • 𝓕 poitouG ξ) =
        fun ξ : ℝ => (fun t : ℝ => poitouPhi (5 / 4 + t * Complex.I) *
          Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I)) ((-(2 * Real.pi)) * ξ) from
      funext fun ξ => by
        rw [fourier_poitouG, smul_eq_mul, mul_comm]
        push_cast
        ring_nf]
    exact MeasureTheory.Measure.integral_comp_mul_left
      (fun t : ℝ => poitouPhi (5 / 4 + t * Complex.I) *
        Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I)) (-(2 * Real.pi))
  have habs : |((-(2 * Real.pi))⁻¹)| = (2 * Real.pi)⁻¹ := by
    rw [abs_inv, abs_neg, abs_of_pos (by positivity)]
  have hg_val : (∫ t : ℝ, poitouPhi (5 / 4 + t * Complex.I) *
      Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I)) =
      ((2 * Real.pi : ℝ) : ℂ) * poitouG x := by
    have h2π : (0:ℝ) < 2 * Real.pi := by positivity
    have hkey : (2 * Real.pi)⁻¹ • (∫ t : ℝ, poitouPhi (5 / 4 + t * Complex.I) *
        Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I)) = poitouG x := by
      rw [← habs, ← hchange, ← hL, hinv]
    calc (∫ t : ℝ, poitouPhi (5 / 4 + t * Complex.I) *
          Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I))
        = ((2 * Real.pi) * (2 * Real.pi)⁻¹) •
          (∫ t : ℝ, poitouPhi (5 / 4 + t * Complex.I) *
            Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I)) := by
          rw [mul_inv_cancel₀ h2π.ne', one_smul]
      _ = (2 * Real.pi) • ((2 * Real.pi)⁻¹ •
          (∫ t : ℝ, poitouPhi (5 / 4 + t * Complex.I) *
            Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I))) := by
          rw [mul_smul]
      _ = (2 * Real.pi) • poitouG x := by rw [hkey]
      _ = ((2 * Real.pi : ℝ) : ℂ) * poitouG x := Complex.real_smul
  have hsplit : ∀ t : ℝ, poitouPhi (5 / 4 + t * Complex.I) *
      Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ))) =
      ((Real.exp (-(5 / 4 * x)) : ℝ) : ℂ) *
        (poitouPhi (5 / 4 + t * Complex.I) *
          Complex.exp (((-(t * x) : ℝ) : ℂ) * Complex.I)) := by
    intro t
    rw [show -((5 / 4 + t * Complex.I) * (x : ℂ)) =
        ((-(5 / 4 * x) : ℝ) : ℂ) + ((-(t * x) : ℝ) : ℂ) * Complex.I by
      push_cast; ring, Complex.exp_add, ← Complex.ofReal_exp]
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hsplit), integral_const_mul,
    hg_val, poitouG, ← Complex.ofReal_mul, ← Complex.ofReal_mul]
  have hexp : Real.exp (-(5 / 4 * x)) * Real.exp (3 / 4 * x) = Real.exp (-(x / 2)) := by
    rw [← Real.exp_add]; congr 1; ring
  congr 1
  linear_combination (2 * Real.pi * poitouF x) * hexp

/-- **Fourier inversion at the origin: the full line integral of `Φ`
is `2π`** (PROVEN 2026-07-24 — the specialization `x = 0` of
`integral_poitouPhi_line_mul_exp`, since `poitouF 0 = 1`; this is
Poitou's `π⁻¹ ∫_ℝ Φ(5/4+it) dt = 2`). -/
theorem integral_poitouPhi_line :
    (∫ t : ℝ, poitouPhi (5 / 4 + t * Complex.I)) = ((2 * Real.pi : ℝ) : ℂ) := by
  have h := integral_poitouPhi_line_mul_exp 0
  simp only [Complex.ofReal_zero, mul_zero, neg_zero, Complex.exp_zero, mul_one] at h
  rw [h]
  norm_num [poitouF, odlyzkoTestFn, Real.cosh_zero]

/-- **Contraction bound for `1 − e^{−z}` on the closed right
half-plane** (PROVEN 2026-07-24 — elementary brick for the Gauss-kernel
majorant): for `Re z ≥ 0`, `‖1 − e^{−z}‖ ≤ ‖z‖`, by the fundamental
theorem of calculus `1 − e^{−z} = ∫₀¹ z·e^{−uz} du` and
`‖e^{−uz}‖ = e^{−u·Re z} ≤ 1` on the integration range. Sharper than
mathlib's `Complex.norm_exp_sub_one_le` (which needs `‖z‖ ≤ 1`): the
half-plane hypothesis replaces the smallness hypothesis, which is what
the vertical-line application `z = (5/4 + it)x` with `|t|` large
requires. -/
theorem norm_one_sub_cexp_neg_le {z : ℂ} (hz : 0 ≤ z.re) :
    ‖1 - Complex.exp (-z)‖ ≤ ‖z‖ := by
  have hder : ∀ u ∈ Set.uIcc (0:ℝ) 1,
      HasDerivAt (fun v : ℝ => Complex.exp (-((v:ℂ) * z)))
        (Complex.exp (-((u:ℂ) * z)) * (-z)) u := by
    intro u _
    have h1 : HasDerivAt (fun v : ℝ => ((v:ℂ) * z)) z u := by
      simpa using (Complex.ofRealCLM.hasDerivAt (x := u)).mul_const z
    simpa using (h1.neg).cexp
  have hcont : IntervalIntegrable (fun u : ℝ => Complex.exp (-((u:ℂ) * z)) * (-z))
      MeasureTheory.volume 0 1 := by
    apply Continuous.intervalIntegrable
    fun_prop
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt hder hcont
  have hval : (1:ℂ) - Complex.exp (-z) =
      -(∫ u in (0:ℝ)..1, Complex.exp (-((u:ℂ) * z)) * (-z)) := by
    rw [hFTC]
    push_cast
    simp
  rw [hval, norm_neg]
  refine (intervalIntegral.norm_integral_le_of_norm_le_const (C := ‖z‖) ?_).trans (by simp)
  intro u hu
  rw [Set.uIoc_of_le zero_le_one] at hu
  rw [norm_mul, norm_neg, Complex.norm_exp]
  have hre : (-((u:ℂ) * z)).re = -(u * z.re) := by simp [Complex.mul_re]
  rw [hre]
  have hle : Real.exp (-(u * z.re)) ≤ 1 :=
    Real.exp_le_one_iff.2 (neg_nonpos.2 (mul_nonneg hu.1.le hz))
  exact mul_le_of_le_one_left (norm_nonneg z) hle

/-- **Separated majorant for the Gauss kernel on the line
`Re s = 5/4`** (PROVEN 2026-07-24 — the pointwise brick of the Fubini
hypothesis `poitouPhi_mul_gaussKernel_integrable`): for `x > 0`,
`‖(e^{−x} − e^{−(5/4+it)x})/(1 − e^{−x})‖ ≤
√(9/4+|t|) · (4·e^{−x/2}/√x)` — a product of a `t`-factor and an
`x`-factor. On `x ≤ 1` interpolate `min(a,b) ≤ √(ab)` between the
numerator bounds `(9/4+|t|)x` (from `norm_one_sub_cexp_neg_le`) and
`2e^{−x}`, against the denominator lower bound `1 − e^{−x} ≥ x·e^{−x}`;
on `x ≥ 1` use `‖num‖ ≤ 2e^{−x}` against `1 − e^{−x} ≥ 1/2` and
`√x ≤ e^{x/2}`. -/
theorem poitouGaussKernel_norm_le (t : ℝ) {x : ℝ} (hx : 0 < x) :
    ‖(Complex.exp (-(x : ℂ)) -
        Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))) /
      (1 - Complex.exp (-(x : ℂ)))‖ ≤
    Real.sqrt (9 / 4 + |t|) * (4 * (Real.exp (-(x / 2)) / Real.sqrt x)) := by
  have hme : Real.exp (-x) * Real.exp x = 1 := by
    rw [← Real.exp_add]; simp
  have hden_eq : (1 : ℂ) - Complex.exp (-(x:ℂ)) = ((1 - Real.exp (-x) : ℝ) : ℂ) := by
    rw [show -(x:ℂ) = ((-x : ℝ) : ℂ) by push_cast; ring, ← Complex.ofReal_exp]
    push_cast
    ring
  have hexp1 : Real.exp (-x) < 1 := Real.exp_lt_one_iff.2 (by linarith)
  have hden_pos : (0:ℝ) < 1 - Real.exp (-x) := by linarith
  have hden_norm : ‖(1:ℂ) - Complex.exp (-(x:ℂ))‖ = 1 - Real.exp (-x) := by
    rw [hden_eq, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hden_pos]
  have hdenlow : x * Real.exp (-x) ≤ 1 - Real.exp (-x) := by
    nlinarith [mul_le_mul_of_nonneg_right (Real.add_one_le_exp x) (Real.exp_pos (-x)).le, hme]
  have hnum2 : ‖Complex.exp (-(x:ℂ)) -
      Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))‖ ≤ 2 * Real.exp (-x) := by
    refine (norm_sub_le _ _).trans ?_
    rw [Complex.norm_exp, Complex.norm_exp]
    have h1 : (-(x:ℂ)).re = -x := by simp
    have h2 : (-((5 / 4 + t * Complex.I) * (x : ℂ))).re = -(5 / 4 * x) := by
      simp [Complex.mul_re]
    rw [h1, h2]
    have h3 : Real.exp (-(5 / 4 * x)) ≤ Real.exp (-x) := Real.exp_le_exp.2 (by linarith)
    linarith
  have hnum1 : ‖Complex.exp (-(x:ℂ)) -
      Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))‖ ≤ (9 / 4 + |t|) * x := by
    have ha : ‖Complex.exp (-(x:ℂ)) - 1‖ ≤ x := by
      rw [show Complex.exp (-(x:ℂ)) - 1 = -((1:ℂ) - Complex.exp (-(x:ℂ))) by ring,
        norm_neg, hden_norm]
      linarith [Real.add_one_le_exp (-x)]
    have hb : ‖(1:ℂ) - Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))‖ ≤
        (5 / 4 + |t|) * x := by
      have hre : ((5 / 4 + t * Complex.I) * (x : ℂ)).re = 5 / 4 * x := by
        simp [Complex.mul_re]
      refine (norm_one_sub_cexp_neg_le (by rw [hre]; positivity)).trans ?_
      rw [norm_mul]
      have hnx : ‖(x:ℂ)‖ = x := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hx]
      have hns : ‖(5 / 4 + t * Complex.I : ℂ)‖ ≤ 5 / 4 + |t| := by
        refine (norm_add_le _ _).trans (le_of_eq ?_)
        rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real,
          show (5/4 : ℂ) = ((5/4 : ℝ) : ℂ) by norm_num, Complex.norm_real,
          Real.norm_eq_abs, Real.norm_eq_abs,
          abs_of_pos (by norm_num : (0:ℝ) < 5/4)]
      rw [hnx]
      exact mul_le_mul_of_nonneg_right hns hx.le
    calc ‖Complex.exp (-(x:ℂ)) - Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))‖
        = ‖(Complex.exp (-(x:ℂ)) - 1) +
            ((1:ℂ) - Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ))))‖ := by
          ring_nf
      _ ≤ ‖Complex.exp (-(x:ℂ)) - 1‖ +
            ‖(1:ℂ) - Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))‖ :=
          norm_add_le _ _
      _ ≤ x + (5 / 4 + |t|) * x := add_le_add ha hb
      _ = (9 / 4 + |t|) * x := by ring
  rw [norm_div, hden_norm]
  set N : ℝ := ‖Complex.exp (-(x:ℂ)) -
      Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))‖ with hN
  have hN0 : 0 ≤ N := norm_nonneg _
  have hK0 : 0 ≤ N / (1 - Real.exp (-x)) := div_nonneg hN0 hden_pos.le
  have hxe : (0:ℝ) < x * Real.exp (-x) := by positivity
  rcases le_total x 1 with hx1 | hx1
  · -- x ≤ 1 : interpolate the two bounds under one square root
    have hKa : N / (1 - Real.exp (-x)) ≤ (9 / 4 + |t|) * Real.exp x := by
      calc N / (1 - Real.exp (-x)) ≤ ((9 / 4 + |t|) * x) / (x * Real.exp (-x)) := by
            gcongr
          _ = (9 / 4 + |t|) * Real.exp x := by
            rw [div_eq_iff hxe.ne']
            linear_combination (-(9 / 4 + |t|) * x) * hme
    have hKb : N / (1 - Real.exp (-x)) ≤ 2 / x := by
      calc N / (1 - Real.exp (-x)) ≤ (2 * Real.exp (-x)) / (x * Real.exp (-x)) := by
            gcongr
          _ = 2 / x := mul_div_mul_right _ _ (Real.exp_ne_zero _)
    have hsq : (N / (1 - Real.exp (-x))) ^ 2 ≤ ((9 / 4 + |t|) * Real.exp x) * (2 / x) := by
      rw [sq]
      exact mul_le_mul hKa hKb hK0 (by positivity)
    have he2 : Real.exp x * Real.exp x ≤ 8 := by
      nlinarith [Real.exp_one_lt_d9, Real.exp_le_exp.2 hx1, (Real.exp_pos x).le,
        (Real.exp_pos 1).le]
    have hT2 : (Real.sqrt (9 / 4 + |t|) * (4 * (Real.exp (-(x / 2)) / Real.sqrt x))) ^ 2 =
        (9 / 4 + |t|) * (16 * (Real.exp (-x) / x)) := by
      have h1 : Real.sqrt (9 / 4 + |t|) ^ 2 = 9 / 4 + |t| :=
        Real.sq_sqrt (by positivity)
      have h2 : Real.sqrt x ^ 2 = x := Real.sq_sqrt hx.le
      have h3 : Real.exp (-(x / 2)) ^ 2 = Real.exp (-x) := by
        rw [sq, ← Real.exp_add]
        congr 1
        ring
      rw [mul_pow, mul_pow, div_pow, h1, h2, h3]
      ring
    have hsq2 : (N / (1 - Real.exp (-x))) ^ 2 ≤
        (Real.sqrt (9 / 4 + |t|) * (4 * (Real.exp (-(x / 2)) / Real.sqrt x))) ^ 2 := by
      refine hsq.trans ?_
      rw [hT2]
      calc (9 / 4 + |t|) * Real.exp x * (2 / x)
          = (9 / 4 + |t|) / x * (2 * Real.exp x) := by ring
        _ ≤ (9 / 4 + |t|) / x * (16 * Real.exp (-x)) := by
            refine mul_le_mul_of_nonneg_left ?_ (by positivity)
            nlinarith [mul_le_mul_of_nonneg_right he2 (Real.exp_pos (-x)).le, hme,
              (Real.exp_pos x).le, (Real.exp_pos (-x)).le]
        _ = (9 / 4 + |t|) * (16 * (Real.exp (-x) / x)) := by ring
    have := Real.sqrt_le_sqrt hsq2
    rwa [Real.sqrt_sq hK0, Real.sqrt_sq (by positivity)] at this
  · -- 1 ≤ x : exponential regime
    have hden2 : (1:ℝ) / 2 ≤ 1 - Real.exp (-x) := by
      have h1 : Real.exp (-x) ≤ Real.exp (-1) := Real.exp_le_exp.2 (by linarith)
      have hme1 : Real.exp (-1) * Real.exp 1 = 1 := by
        rw [← Real.exp_add]; simp
      have h2 : Real.exp (-1) < 1 / 2 := by
        nlinarith [Real.exp_one_gt_d9, (Real.exp_pos (-1)).le, hme1]
      linarith
    have hK4 : N / (1 - Real.exp (-x)) ≤ 4 * Real.exp (-x) := by
      calc N / (1 - Real.exp (-x)) ≤ (2 * Real.exp (-x)) / (1 / 2) := by
            gcongr
          _ = 4 * Real.exp (-x) := by ring
    have hsx : (0:ℝ) < Real.sqrt x := Real.sqrt_pos.2 hx
    have hsxe : Real.sqrt x ≤ Real.exp (x / 2) := by
      have h1 : x ≤ Real.exp x := by linarith [Real.add_one_le_exp x]
      have h2 : Real.sqrt x ≤ Real.sqrt (Real.exp x) := Real.sqrt_le_sqrt h1
      rwa [show Real.exp x = Real.exp (x / 2) ^ 2 by
          rw [sq, ← Real.exp_add]; congr 1; ring,
        Real.sqrt_sq (Real.exp_pos _).le] at h2
    have hsplit : Real.exp (-x) * Real.exp (x / 2) = Real.exp (-(x / 2)) := by
      rw [← Real.exp_add]
      congr 1
      ring
    have h6 : 4 * Real.exp (-x) ≤ 6 * (Real.exp (-(x / 2)) / Real.sqrt x) := by
      rw [mul_div_assoc', le_div_iff₀ hsx]
      nlinarith [mul_le_mul_of_nonneg_left hsxe (by positivity : (0:ℝ) ≤ 4 * Real.exp (-x)),
        hsplit, (Real.exp_pos (-(x / 2))).le]
    have h32 : (3:ℝ) / 2 ≤ Real.sqrt (9 / 4 + |t|) := by
      have h1 : Real.sqrt (9 / 4) ≤ Real.sqrt (9 / 4 + |t|) :=
        Real.sqrt_le_sqrt (by linarith [abs_nonneg t])
      have h94 : Real.sqrt (9 / 4 : ℝ) = 3 / 2 := by
        rw [show (9/4 : ℝ) = (3/2) ^ 2 by norm_num,
          Real.sqrt_sq (by norm_num : (0:ℝ) ≤ 3/2)]
      linarith
    calc N / (1 - Real.exp (-x)) ≤ 4 * Real.exp (-x) := hK4
      _ ≤ 6 * (Real.exp (-(x / 2)) / Real.sqrt x) := h6
      _ = (3 / 2) * (4 * (Real.exp (-(x / 2)) / Real.sqrt x)) := by ring
      _ ≤ Real.sqrt (9 / 4 + |t|) * (4 * (Real.exp (-(x / 2)) / Real.sqrt x)) :=
          mul_le_mul_of_nonneg_right h32 (by positivity)

/-- **Integrability of the weighted line profile
`‖Φ(5/4+it)‖·√(9/4+|t|)`** (PROVEN 2026-07-24 — the `t`-factor of the
separated Tonelli majorant for
`poitouPhi_mul_gaussKernel_integrable`): the quadratic decay
`poitouPhi_line_decay_sq` beats the `√|t|` weight, leaving `|t|^{−3/2}`
decay, integrable by the Japanese-bracket criterion
`integrable_one_add_norm` with exponent `3/2 > 1 = dim ℝ`; near `t = 0`
the trivial bound `poitouPhi_line_norm_le_const` applies. -/
theorem poitouPhi_sqrt_weight_integrable :
    Integrable fun t : ℝ =>
      ‖poitouPhi (5 / 4 + t * Complex.I)‖ * Real.sqrt (9 / 4 + |t|) := by
  obtain ⟨M, hM0, hM⟩ := poitouPhi_line_decay_sq
  set C : ℝ := ∫ x : ℝ, ‖poitouG x‖ with hCdef
  have hC0 : 0 ≤ C := integral_nonneg fun x => norm_nonneg _
  set A : ℝ := max (6 * C) (6 * M) with hAdef
  have hbase : Integrable fun t : ℝ => (1 + ‖t‖) ^ (-((3:ℝ)/2)) :=
    integrable_one_add_norm (by rw [Module.finrank_self]; norm_num)
  refine ((hbase.const_mul A).mono' ?_ ?_)
  · exact (poitouPhi_line_continuous.norm.mul
      (Real.continuous_sqrt.comp (continuous_const.add continuous_abs))).aestronglyMeasurable
  · refine Filter.Eventually.of_forall fun t => ?_
    have hb : (0:ℝ) < 1 + |t| := by positivity
    have hrpow : (1 + ‖t‖) ^ (-((3:ℝ)/2)) = ((1 + |t|) * Real.sqrt (1 + |t|))⁻¹ := by
      rw [Real.norm_eq_abs, Real.rpow_neg hb.le]
      congr 1
      rw [show ((3:ℝ)/2) = 1 + 1/2 by norm_num, Real.rpow_add hb, Real.rpow_one,
        ← Real.sqrt_eq_rpow]
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), hrpow, ← div_eq_mul_inv,
      le_div_iff₀ (by positivity), mul_assoc]
    rcases le_total |t| 1 with ht | ht
    · have hΦ : ‖poitouPhi (5 / 4 + t * Complex.I)‖ ≤ C := poitouPhi_line_norm_le_const t
      have hs1 : Real.sqrt (9 / 4 + |t|) ≤ 2 := by
        nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 9/4 + |t| by positivity),
          Real.sqrt_nonneg (9/4 + |t|)]
      have hs2 : Real.sqrt (1 + |t|) ≤ 3 / 2 := by
        nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 1 + |t| by positivity),
          Real.sqrt_nonneg (1 + |t|)]
      have hstep : Real.sqrt (9 / 4 + |t|) * ((1 + |t|) * Real.sqrt (1 + |t|)) ≤ 6 := by
        calc Real.sqrt (9 / 4 + |t|) * ((1 + |t|) * Real.sqrt (1 + |t|))
            ≤ 2 * (2 * (3 / 2)) := by
              gcongr
              linarith
          _ = 6 := by norm_num
      calc ‖poitouPhi (5 / 4 + t * Complex.I)‖ *
            (Real.sqrt (9 / 4 + |t|) * ((1 + |t|) * Real.sqrt (1 + |t|)))
          ≤ C * 6 := mul_le_mul hΦ hstep (by positivity) hC0
        _ = 6 * C := by ring
        _ ≤ A := le_max_left _ _
    · have ht0 : t ≠ 0 := abs_pos.mp (by linarith)
      have hΦ : ‖poitouPhi (5 / 4 + t * Complex.I)‖ ≤ M / t ^ 2 := hM t ht0
      have hu2 : Real.sqrt |t| ^ 2 = |t| := Real.sq_sqrt (abs_nonneg t)
      have hs1 : Real.sqrt (9 / 4 + |t|) ≤ 2 * Real.sqrt |t| := by
        calc Real.sqrt (9 / 4 + |t|) ≤ Real.sqrt (4 * |t|) :=
              Real.sqrt_le_sqrt (by linarith)
          _ = 2 * Real.sqrt |t| := by
              rw [show (4:ℝ) = 2 ^ 2 by norm_num, Real.sqrt_mul (by positivity),
                Real.sqrt_sq (by norm_num : (0:ℝ) ≤ 2)]
      have hs2 : Real.sqrt (1 + |t|) ≤ (3 / 2) * Real.sqrt |t| := by
        calc Real.sqrt (1 + |t|) ≤ Real.sqrt ((9 / 4) * |t|) :=
              Real.sqrt_le_sqrt (by linarith)
          _ = (3 / 2) * Real.sqrt |t| := by
              rw [show (9/4:ℝ) = (3/2) ^ 2 by norm_num, Real.sqrt_mul (by positivity),
                Real.sqrt_sq (by norm_num : (0:ℝ) ≤ 3/2)]
      have h1t : 1 + |t| ≤ 2 * Real.sqrt |t| ^ 2 := by
        rw [hu2]
        linarith
      have hstep : Real.sqrt (9 / 4 + |t|) * ((1 + |t|) * Real.sqrt (1 + |t|)) ≤
          6 * t ^ 2 := by
        calc Real.sqrt (9 / 4 + |t|) * ((1 + |t|) * Real.sqrt (1 + |t|))
            ≤ (2 * Real.sqrt |t|) *
                ((2 * Real.sqrt |t| ^ 2) * ((3 / 2) * Real.sqrt |t|)) := by
              gcongr
          _ = 6 * (Real.sqrt |t| ^ 2) ^ 2 := by ring
          _ = 6 * t ^ 2 := by rw [hu2, sq_abs]
      calc ‖poitouPhi (5 / 4 + t * Complex.I)‖ *
            (Real.sqrt (9 / 4 + |t|) * ((1 + |t|) * Real.sqrt (1 + |t|)))
          ≤ (M / t ^ 2) * (6 * t ^ 2) :=
            mul_le_mul hΦ hstep (by positivity) (div_nonneg hM0 (sq_nonneg t))
        _ = 6 * M := by
            field_simp
        _ ≤ A := le_max_right _ _

/-- **Integrability of `e^{−x/2}/√x` on `(0, ∞)`** (PROVEN 2026-07-24
— the `x`-factor of the separated Tonelli majorant for
`poitouPhi_mul_gaussKernel_integrable`, a scaled `Γ(1/2)` integrand):
on `(0,1]` it is dominated by the integrable `x^{−1/2}`
(`intervalIntegral.intervalIntegrable_rpow'`), on `(1,∞)` by the
integrable `e^{−x/2}` (`exp_neg_integrableOn_Ioi`). -/
theorem integrableOn_exp_neg_half_div_sqrt :
    IntegrableOn (fun x : ℝ => Real.exp (-(x / 2)) / Real.sqrt x) (Set.Ioi (0:ℝ)) := by
  have hmeas : Measurable fun x : ℝ => Real.exp (-(x / 2)) / Real.sqrt x := by
    fun_prop
  have h1 : IntegrableOn (fun x : ℝ => Real.exp (-(x / 2)) / Real.sqrt x)
      (Set.Ioc (0:ℝ) 1) := by
    have hbase : IntegrableOn (fun x : ℝ => x ^ (-(1/2) : ℝ)) (Set.Ioc (0:ℝ) 1) :=
      (intervalIntegral.intervalIntegrable_rpow' (by norm_num)).1
    refine hbase.mono' hmeas.aestronglyMeasurable.restrict ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with x hx
    have hx0 : (0:ℝ) < x := hx.1
    have hs : (0:ℝ) < Real.sqrt x := Real.sqrt_pos.2 hx0
    have hxr : x ^ (-(1/2) : ℝ) = (Real.sqrt x)⁻¹ := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_neg hx0.le]
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), hxr, div_eq_mul_inv]
    exact mul_le_of_le_one_left (by positivity)
      (Real.exp_le_one_iff.2 (by linarith))
  have h2 : IntegrableOn (fun x : ℝ => Real.exp (-(x / 2)) / Real.sqrt x)
      (Set.Ioi (1:ℝ)) := by
    refine (exp_neg_integrableOn_Ioi 1 (by norm_num : (0:ℝ) < 1/2)).mono'
      hmeas.aestronglyMeasurable.restrict ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with x hx
    have hx1 : (1:ℝ) < x := hx
    have hs1 : (1:ℝ) ≤ Real.sqrt x := by
      rw [show (1:ℝ) = Real.sqrt 1 by simp]
      exact Real.sqrt_le_sqrt (by linarith)
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    calc Real.exp (-(x / 2)) / Real.sqrt x ≤ Real.exp (-(x / 2)) / 1 := by
          gcongr
      _ = Real.exp (-(1/2) * x) := by
          rw [div_one]
          congr 1
          ring
  have hu := h1.union h2
  rwa [Set.Ioc_union_Ioi_eq_Ioi zero_le_one] at hu

/-- **Joint integrability of `Φ` against the Gauss kernel** (PROVEN
2026-07-24 — sub-leaf (b₂ᵢᵢ·2·C) of the decomposition of
`poitouGammaEdge_tendsto`; the Fubini hypothesis of Poitou's Lemme 2):
the pointwise separated majorant `poitouGaussKernel_norm_le` bounds the
integrand by the product of the `t`-integrable
`‖Φ(5/4+it)‖·√(9/4+|t|)` (`poitouPhi_sqrt_weight_integrable`) and the
`x`-integrable `4·e^{−x/2}/√x` (`integrableOn_exp_neg_half_div_sqrt`),
which is product-integrable by `Integrable.mul_prod`. -/
theorem poitouPhi_mul_gaussKernel_integrable :
    Integrable
      (Function.uncurry fun (t : ℝ) (x : ℝ) =>
        poitouPhi (5 / 4 + t * Complex.I) *
          ((Complex.exp (-(x : ℂ)) -
              Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))) /
            (1 - Complex.exp (-(x : ℂ)))))
      (volume.prod (volume.restrict (Set.Ioi (0 : ℝ)))) := by
  have hmeas : AEStronglyMeasurable
      (Function.uncurry fun (t : ℝ) (x : ℝ) =>
        poitouPhi (5 / 4 + t * Complex.I) *
          ((Complex.exp (-(x : ℂ)) -
              Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))) /
            (1 - Complex.exp (-(x : ℂ)))))
      (volume.prod (volume.restrict (Set.Ioi (0 : ℝ)))) := by
    have h1 : Measurable fun p : ℝ × ℝ => poitouPhi (5 / 4 + p.1 * Complex.I) :=
      (poitouPhi_line_continuous.comp continuous_fst).measurable
    have h2 : Measurable fun p : ℝ × ℝ =>
        (Complex.exp (-(p.2 : ℂ)) -
            Complex.exp (-((5 / 4 + p.1 * Complex.I) * (p.2 : ℂ)))) /
          (1 - Complex.exp (-(p.2 : ℂ))) := by
      fun_prop
    exact (h1.mul h2).aestronglyMeasurable
  have hInt : Integrable (fun p : ℝ × ℝ =>
      (‖poitouPhi (5 / 4 + p.1 * Complex.I)‖ * Real.sqrt (9 / 4 + |p.1|)) *
        (4 * (Real.exp (-(p.2 / 2)) / Real.sqrt p.2)))
      (volume.prod (volume.restrict (Set.Ioi (0 : ℝ)))) :=
    poitouPhi_sqrt_weight_integrable.mul_prod
      (integrableOn_exp_neg_half_div_sqrt.const_mul 4)
  refine hInt.mono' hmeas ?_
  have hae : ∀ᵐ p : ℝ × ℝ
      ∂(volume.prod (volume.restrict (Set.Ioi (0 : ℝ)))), 0 < p.2 := by
    have hprodeq : (volume : Measure ℝ).prod (volume.restrict (Set.Ioi (0:ℝ))) =
        ((volume : Measure ℝ).prod (volume : Measure ℝ)).restrict
          (Set.univ ×ˢ Set.Ioi (0:ℝ)) := by
      rw [← Measure.prod_restrict, Measure.restrict_univ]
    rw [hprodeq]
    filter_upwards [ae_restrict_mem (MeasurableSet.univ.prod measurableSet_Ioi)] with p hp
    exact hp.2
  filter_upwards [hae] with p hp
  obtain ⟨t, x⟩ := p
  simp only [Function.uncurry_apply_pair]
  rw [norm_mul]
  have hker := poitouGaussKernel_norm_le t (x := x) hp
  calc ‖poitouPhi (5 / 4 + t * Complex.I)‖ *
        ‖(Complex.exp (-(x : ℂ)) -
            Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))) /
          (1 - Complex.exp (-(x : ℂ)))‖
      ≤ ‖poitouPhi (5 / 4 + t * Complex.I)‖ *
          (Real.sqrt (9 / 4 + |t|) * (4 * (Real.exp (-(x / 2)) / Real.sqrt x))) :=
        mul_le_mul_of_nonneg_left hker (norm_nonneg _)
    _ = (‖poitouPhi (5 / 4 + t * Complex.I)‖ * Real.sqrt (9 / 4 + |t|)) *
          (4 * (Real.exp (-(x / 2)) / Real.sqrt x)) := by ring

/-- **Poitou's Lemme 2: the paired line integral of `Φ` against the
Gauss integral** (PROVEN 2026-07-24 over the Fubini sub-leaf
`poitouPhi_mul_gaussKernel_integrable`; Poitou pp. 6-05–6-06, the
computation of formula (5)): Fubini swaps the `t`- and `x`-integrals;
for fixed `x > 0` the inner `t`-integral evaluates by the two Fourier
inversion values `integral_poitouPhi_line` and
`integral_poitouPhi_line_mul_exp` to
`2π·(e^{−x} − F(x)e^{−x/2})/(1 − e^{−x})`, and
`1 − e^{−x} = e^{−x/2}·2 sinh(x/2)` turns the quotient into
`(e^{−x/2} − F(x))/(2 sinh(x/2))`. -/
theorem integral_poitouPhi_line_mul_gauss :
    (∫ t : ℝ, poitouPhi (5 / 4 + t * Complex.I) *
        gaussDigammaIntegral (5 / 4 + t * Complex.I)) =
      ((2 * Real.pi * ∫ x in Set.Ioi (0 : ℝ),
          (Real.exp (-(x / 2)) - poitouF x) / (2 * Real.sinh (x / 2)) : ℝ) : ℂ) := by
  have hinner : ∀ x ∈ Set.Ioi (0:ℝ), (∫ t : ℝ,
      poitouPhi (5 / 4 + t * Complex.I) *
        ((Complex.exp (-(x : ℂ)) -
            Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))) /
          (1 - Complex.exp (-(x : ℂ))))) =
      ((2 * Real.pi * ((Real.exp (-(x / 2)) - poitouF x) /
        (2 * Real.sinh (x / 2))) : ℝ) : ℂ) := by
    intro x hx
    have hx0 : (0:ℝ) < x := hx
    have hexp1 : Real.exp (-x) < 1 := Real.exp_lt_one_iff.2 (by linarith)
    have hcast : Complex.exp (-(x : ℂ)) = ((Real.exp (-x) : ℝ) : ℂ) := by
      simp [Complex.ofReal_exp]
    have hB : Integrable (fun t : ℝ =>
        poitouPhi (5 / 4 + t * Complex.I) *
          Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))) := by
      refine (poitouPhi_line_integrable.norm.mul_const
        (Real.exp (-(5 / 4 * x)))).mono' ?_ ?_
      · exact (poitouPhi_line_continuous.mul
          (Complex.continuous_exp.comp (by fun_prop))).aestronglyMeasurable
      · refine Filter.Eventually.of_forall fun t => ?_
        rw [norm_mul, Complex.norm_exp]
        have hre : (-((5 / 4 + t * Complex.I) * (x : ℂ))).re = -(5 / 4 * x) := by
          simp [Complex.mul_re]
        rw [hre]
    have hA : Integrable (fun t : ℝ =>
        poitouPhi (5 / 4 + t * Complex.I) * Complex.exp (-(x : ℂ))) :=
      poitouPhi_line_integrable.mul_const _
    have hsplit : ∀ t : ℝ, poitouPhi (5 / 4 + t * Complex.I) *
        ((Complex.exp (-(x : ℂ)) -
            Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))) /
          (1 - Complex.exp (-(x : ℂ)))) =
        (poitouPhi (5 / 4 + t * Complex.I) * Complex.exp (-(x : ℂ)) -
          poitouPhi (5 / 4 + t * Complex.I) *
            Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))) *
          (1 - Complex.exp (-(x : ℂ)))⁻¹ := fun t => by ring
    rw [integral_congr_ae (Filter.Eventually.of_forall hsplit), integral_mul_const,
      integral_sub hA hB, integral_mul_const, integral_poitouPhi_line,
      integral_poitouPhi_line_mul_exp x, hcast]
    have hs : (0:ℝ) < Real.sinh (x / 2) := Real.sinh_pos_iff.2 (by linarith)
    have hd : 2 * Real.sinh (x / 2) = Real.exp (x / 2) - Real.exp (-(x / 2)) := by
      rw [Real.sinh_eq]; ring
    have hee : Real.exp (x / 2) * Real.exp (-(x / 2)) = 1 := by
      rw [← Real.exp_add]; norm_num
    have hex : Real.exp (-(x / 2)) * Real.exp (-(x / 2)) = Real.exp (-x) := by
      rw [← Real.exp_add]; congr 1; ring
    have hkey2 : (Real.exp (-x) - poitouF x * Real.exp (-(x / 2))) *
        (2 * Real.sinh (x / 2)) =
        (Real.exp (-(x / 2)) - poitouF x) * (1 - Real.exp (-x)) := by
      rw [hd]
      linear_combination (Real.exp (-(x / 2)) - poitouF x) * hee +
        (poitouF x - Real.exp (x / 2)) * hex
    have hreal : (2 * Real.pi * Real.exp (-x) -
          2 * Real.pi * (poitouF x * Real.exp (-(x / 2)))) *
        (1 - Real.exp (-x))⁻¹ =
        2 * Real.pi * ((Real.exp (-(x / 2)) - poitouF x) / (2 * Real.sinh (x / 2))) := by
      have h1w : (0:ℝ) < 1 - Real.exp (-x) := by linarith
      have h2s : (0:ℝ) < 2 * Real.sinh (x / 2) := by linarith
      rw [← div_eq_mul_inv, show 2 * Real.pi *
          ((Real.exp (-(x / 2)) - poitouF x) / (2 * Real.sinh (x / 2))) =
          (2 * Real.pi * (Real.exp (-(x / 2)) - poitouF x)) /
            (2 * Real.sinh (x / 2)) by ring,
        div_eq_div_iff h1w.ne' h2s.ne']
      linear_combination (2 * Real.pi) * hkey2
    rw [← hreal]
    push_cast
    ring
  calc (∫ t : ℝ, poitouPhi (5 / 4 + t * Complex.I) *
        gaussDigammaIntegral (5 / 4 + t * Complex.I))
      = ∫ t : ℝ, ∫ x in Set.Ioi (0:ℝ), poitouPhi (5 / 4 + t * Complex.I) *
          ((Complex.exp (-(x : ℂ)) -
              Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))) /
            (1 - Complex.exp (-(x : ℂ)))) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
        beta_reduce
        rw [gaussDigammaIntegral_def, integral_const_mul]
    _ = ∫ x in Set.Ioi (0:ℝ), ∫ t : ℝ, poitouPhi (5 / 4 + t * Complex.I) *
          ((Complex.exp (-(x : ℂ)) -
              Complex.exp (-((5 / 4 + t * Complex.I) * (x : ℂ)))) /
            (1 - Complex.exp (-(x : ℂ)))) :=
        MeasureTheory.integral_integral_swap poitouPhi_mul_gaussKernel_integrable
    _ = ∫ x in Set.Ioi (0:ℝ), ((2 * Real.pi * ((Real.exp (-(x / 2)) - poitouF x) /
          (2 * Real.sinh (x / 2))) : ℝ) : ℂ) :=
        setIntegral_congr_fun measurableSet_Ioi hinner
    _ = ((∫ x in Set.Ioi (0:ℝ), 2 * Real.pi * ((Real.exp (-(x / 2)) - poitouF x) /
          (2 * Real.sinh (x / 2))) : ℝ) : ℂ) := integral_complex_ofReal
    _ = ((2 * Real.pi * ∫ x in Set.Ioi (0 : ℝ),
          (Real.exp (-(x / 2)) - poitouF x) / (2 * Real.sinh (x / 2)) : ℝ) : ℂ) := by
        rw [integral_const_mul]

/-- **The sinh-quotient of the exponential cutoff, closed form**
(PROVEN 2026-07-24): for `x > 0`,
`(1 − e^{−x/2})/(2 sinh(x/2)) = e^{−x/2}/(1 + e^{−x/2})` —
multiply numerator and denominator by `e^{−x/2}`. -/
theorem one_sub_exp_div_sinh_eq {x : ℝ} (hx : 0 < x) :
    (1 - Real.exp (-(x / 2))) / (2 * Real.sinh (x / 2)) =
      Real.exp (-(x / 2)) / (1 + Real.exp (-(x / 2))) := by
  have hee : Real.exp (x / 2) * Real.exp (-(x / 2)) = 1 := by
    rw [← Real.exp_add]; norm_num
  have hs : (0:ℝ) < Real.sinh (x / 2) := Real.sinh_pos_iff.2 (by linarith)
  have hpos : (0:ℝ) < 1 + Real.exp (-(x / 2)) := by positivity
  have hd : 2 * Real.sinh (x / 2) = Real.exp (x / 2) - Real.exp (-(x / 2)) := by
    rw [Real.sinh_eq]; ring
  have hdpos : (0:ℝ) < Real.exp (x / 2) - Real.exp (-(x / 2)) := by
    rw [← hd]; linarith
  rw [hd, div_eq_div_iff hdpos.ne' hpos.ne']
  linear_combination -hee

/-- **Integrability of `e^{−x/2}/(1 + e^{−x/2})` on `(0, ∞)`**
(PROVEN 2026-07-24): dominated by the integrable `e^{−x/2}`. -/
theorem integrableOn_exp_div_one_add_exp :
    IntegrableOn (fun x : ℝ => Real.exp (-(x / 2)) / (1 + Real.exp (-(x / 2))))
      (Set.Ioi (0 : ℝ)) := by
  refine (exp_neg_integrableOn_Ioi 0 (by norm_num : (0:ℝ) < 1/2)).mono' ?_ ?_
  · have hc : Continuous fun x : ℝ => Real.exp (-(x / 2)) / (1 + Real.exp (-(x / 2))) := by
      refine Continuous.div (by fun_prop) (by fun_prop) fun _ => ?_
      positivity
    exact hc.aestronglyMeasurable.restrict
  · refine (ae_restrict_iff' measurableSet_Ioi).2
      (Filter.Eventually.of_forall fun x _ => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    have hh : Real.exp (-(1/2) * x) = Real.exp (-(x / 2)) := by
      congr 1; ring
    rw [hh]
    exact div_le_self (Real.exp_pos _).le (by linarith [Real.exp_pos (-(x / 2))])

/-- **Integrability of `(1 − e^{−x/2})/(2 sinh(x/2))` on `(0, ∞)`**
(PROVEN 2026-07-24): transport of `integrableOn_exp_div_one_add_exp`
along the pointwise identity `one_sub_exp_div_sinh_eq`. -/
theorem integrableOn_one_sub_exp_div_sinh :
    IntegrableOn (fun x : ℝ => (1 - Real.exp (-(x / 2))) / (2 * Real.sinh (x / 2)))
      (Set.Ioi (0 : ℝ)) :=
  integrableOn_exp_div_one_add_exp.congr_fun
    (fun _ hx => (one_sub_exp_div_sinh_eq hx).symm) measurableSet_Ioi

/-- **The constant-extraction integral: `∫₀^∞ (1 − e^{−x/2})/(2 sinh(x/2))
= log 4`** (PROVEN 2026-07-24 — Poitou p. 6-06, the constant of
formula (5); the bookkeeping `log 2π + log 4 = log 8π` is recorded in
the target `poitouGammaEdge_tendsto`): rewrite the integrand as
`e^{−x/2}/(1 + e^{−x/2})` (`one_sub_exp_div_sinh_eq`), which has
antiderivative `−2 log(1 + e^{−x/2})`; the improper fundamental
theorem of calculus (`MeasureTheory.integral_Ioi_of_hasDerivAt_of_tendsto`)
gives `0 − (−2 log 2) = 2 log 2 = log 4`. -/
theorem integral_one_sub_exp_div_sinh_eq_log_four :
    (∫ x in Set.Ioi (0:ℝ), (1 - Real.exp (-(x / 2))) / (2 * Real.sinh (x / 2))) =
      Real.log 4 := by
  rw [setIntegral_congr_fun measurableSet_Ioi
    (fun x hx => one_sub_exp_div_sinh_eq hx)]
  have hderiv : ∀ x ∈ Set.Ioi (0:ℝ),
      HasDerivAt (fun y : ℝ => -2 * Real.log (1 + Real.exp (-(y / 2))))
        (Real.exp (-(x / 2)) / (1 + Real.exp (-(x / 2)))) x := by
    intro x _
    have h1 : HasDerivAt (fun y : ℝ => -(y / 2)) (-(1/2)) x :=
      ((hasDerivAt_id x).div_const 2).neg
    have h2 : HasDerivAt (fun y : ℝ => Real.exp (-(y / 2)))
        (Real.exp (-(x / 2)) * -(1/2)) x := h1.exp
    have h3 : HasDerivAt (fun y : ℝ => 1 + Real.exp (-(y / 2)))
        (Real.exp (-(x / 2)) * -(1/2)) x := h2.const_add 1
    have h4 : HasDerivAt (fun y : ℝ => Real.log (1 + Real.exp (-(y / 2))))
        ((Real.exp (-(x / 2)) * -(1/2)) / (1 + Real.exp (-(x / 2)))) x :=
      h3.log (by positivity)
    have h5 := h4.const_mul (-2 : ℝ)
    have h6 : Real.exp (-(x / 2)) / (1 + Real.exp (-(x / 2))) =
        -2 * ((Real.exp (-(x / 2)) * -(1/2)) / (1 + Real.exp (-(x / 2)))) := by
      ring
    rw [h6]
    exact h5
  have hcont : ContinuousWithinAt
      (fun y : ℝ => -2 * Real.log (1 + Real.exp (-(y / 2)))) (Set.Ici 0) 0 := by
    have h1 : ContinuousAt (fun y : ℝ => 1 + Real.exp (-(y / 2))) 0 := by fun_prop
    exact (continuousAt_const.mul (h1.log (by positivity))).continuousWithinAt
  have htends : Tendsto (fun y : ℝ => -2 * Real.log (1 + Real.exp (-(y / 2))))
      atTop (nhds 0) := by
    have h0 : Tendsto (fun y : ℝ => -(y / 2)) atTop atBot :=
      Filter.tendsto_neg_atTop_atBot.comp (tendsto_id.atTop_div_const (by norm_num))
    have h1 : Tendsto (fun y : ℝ => Real.exp (-(y / 2))) atTop (nhds 0) :=
      Real.tendsto_exp_atBot.comp h0
    have h2 : Tendsto (fun y : ℝ => 1 + Real.exp (-(y / 2))) atTop (nhds 1) := by
      simpa using h1.const_add 1
    have h3 : Tendsto (fun y : ℝ => Real.log (1 + Real.exp (-(y / 2))))
        atTop (nhds 0) := by
      have h4 := h2.log one_ne_zero
      simpa using h4
    simpa using h3.const_mul (-2 : ℝ)
  have h := MeasureTheory.integral_Ioi_of_hasDerivAt_of_tendsto hcont hderiv
    integrableOn_exp_div_one_add_exp htends
  rw [h]
  have h4 : Real.log 4 = 2 * Real.log 2 := by
    rw [show (4:ℝ) = 2 ^ 2 by norm_num, Real.log_pow]
    push_cast
    ring
  rw [h4]
  norm_num

/-- **Integrability of `(1 − F)/(2 sinh(x/2))` on `(0, ∞)`**
(PROVEN 2026-07-24; the integrand of the target limit value): on
`(0, 6]` the quotient is bounded by `1` — the kink cancellation
`1 − F(x) ≤ (cosh(x/2) − 1) + x/6 ≤ 2 sinh(x/2)` via
`cosh t − sinh t = e^{−t} ≤ 1` and `x/6 ≤ x/2 ≤ sinh(x/2)` — and on
`[6, ∞)` the numerator is `1` (`odlyzkoTestFn` vanishes) while
`2 sinh(x/2) = e^{x/2}(1 − e^{−x}) ≥ e^{x/2}/2`, giving the
integrable majorant `2e^{−x/2}`. -/
theorem integrableOn_one_sub_poitouF_div_sinh :
    IntegrableOn (fun x : ℝ => (1 - poitouF x) / (2 * Real.sinh (x / 2)))
      (Set.Ioi (0 : ℝ)) := by
  have hmeas : AEStronglyMeasurable
      (fun x : ℝ => (1 - poitouF x) / (2 * Real.sinh (x / 2))) volume := by
    refine Measurable.aestronglyMeasurable ?_
    exact (measurable_const.sub continuous_poitouF.measurable).div
      ((Real.continuous_sinh.comp (continuous_id.div_const 2)).measurable.const_mul 2)
  have hIoc : IntegrableOn (fun x : ℝ => (1 - poitouF x) / (2 * Real.sinh (x / 2)))
      (Set.Ioc (0:ℝ) 6) := by
    refine Measure.integrableOn_of_bounded (M := 1) ?_ hmeas ?_
    · simp [Real.volume_Ioc]
    · refine (ae_restrict_iff' measurableSet_Ioc).2
        (Filter.Eventually.of_forall fun x hx => ?_)
      obtain ⟨hx0, hx6⟩ := hx
      have hs : (0:ℝ) < Real.sinh (x / 2) := Real.sinh_pos_iff.2 (by linarith)
      have hcosh1 : (1:ℝ) ≤ Real.cosh (x / 2) := Real.one_le_cosh _
      have hodl : odlyzkoTestFn x = 1 - x / 6 := by
        rw [odlyzkoTestFn, abs_of_pos hx0, max_eq_left (by linarith)]
      have hF : poitouF x = (1 - x / 6) / Real.cosh (x / 2) := by
        rw [poitouF, hodl]
      have hFle : poitouF x ≤ 1 := by
        rw [hF, div_le_one (by linarith)]
        linarith
      have hkeyb : 1 - poitouF x ≤ 2 * Real.sinh (x / 2) := by
        have h1 : Real.cosh (x / 2) - 1 ≤ Real.sinh (x / 2) := by
          have hcs := Real.cosh_sub_sinh (x / 2)
          have h2 : Real.exp (-(x / 2)) ≤ 1 := Real.exp_le_one_iff.2 (by linarith)
          linarith
        have h2 : x / 6 ≤ Real.sinh (x / 2) := by
          have h3 : x / 2 ≤ Real.sinh (x / 2) := Real.self_le_sinh_iff.2 (by linarith)
          linarith
        have h4 : 1 - poitouF x ≤ Real.cosh (x / 2) - (1 - x / 6) := by
          have h6 : 1 - (1 - x / 6) / Real.cosh (x / 2) =
              (Real.cosh (x / 2) - (1 - x / 6)) / Real.cosh (x / 2) := by
            field_simp
          have h5 : (Real.cosh (x / 2) - (1 - x / 6)) / Real.cosh (x / 2) ≤
              Real.cosh (x / 2) - (1 - x / 6) :=
            div_le_self (by linarith) hcosh1
          rw [hF, h6]
          exact h5
        linarith
      rw [Real.norm_eq_abs,
        abs_of_nonneg (div_nonneg (by linarith) (by positivity))]
      rw [div_le_one (by positivity)]
      exact hkeyb
  have hIoi6 : IntegrableOn (fun x : ℝ => (1 - poitouF x) / (2 * Real.sinh (x / 2)))
      (Set.Ioi (6:ℝ)) := by
    refine ((exp_neg_integrableOn_Ioi 6 (by norm_num : (0:ℝ) < 1/2)).const_mul 2).mono'
      hmeas.restrict ?_
    refine (ae_restrict_iff' measurableSet_Ioi).2
      (Filter.Eventually.of_forall fun x hx => ?_)
    have hx6 : (6:ℝ) < x := hx
    have hs : (0:ℝ) < Real.sinh (x / 2) := Real.sinh_pos_iff.2 (by linarith)
    have hF0 : poitouF x = 0 := by
      have hz : odlyzkoTestFn x = 0 := by
        rw [odlyzkoTestFn, max_eq_right]
        rw [abs_of_pos (by linarith : (0:ℝ) < x)]
        linarith
      rw [poitouF, hz, zero_div]
    rw [hF0, sub_zero, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    rw [div_le_iff₀ (by positivity)]
    have hE : Real.exp (-(1/2) * x) * Real.exp (x / 2) = 1 := by
      rw [← Real.exp_add]
      rw [show -(1/2 : ℝ) * x + x / 2 = 0 by ring, Real.exp_zero]
    have hEx : Real.exp (-(1/2) * x) * Real.exp (-(x / 2)) = Real.exp (-x) := by
      rw [← Real.exp_add]; congr 1; ring
    have hlt : Real.exp (-x) ≤ 1/2 := by
      have h7 := Real.add_one_le_exp x
      rw [Real.exp_neg, inv_le_comm₀ (Real.exp_pos x) (by norm_num)]
      norm_num
      linarith
    rw [Real.sinh_eq]
    nlinarith [hE, hEx, hlt]
  have h := hIoc.union hIoi6
  rwa [Set.Ioc_union_Ioi_eq_Ioi (by norm_num : (0:ℝ) ≤ 6)] at h

/-- **Poitou's Lemmes 1–2: the archimedean edge converges to the
digamma terms** (DECOMPOSED and ASSEMBLED 2026-07-24 — leaf (b₂ᵢᵢ·2)
of the decomposition of
`DedekindContinuation.poitouEdge_sub_poleEdge_tendsto`; Poitou
pp. 6-04–6-06, Lemme 1, Lemme 2 and formula (5)).  The proof is glue
over this section's bricks: the pointwise Gauss rewrite
`digamma_eq_neg_euler_add_gaussIntegral` (sub-leaf A — labelled
sorried here until 2026-07-27, which was STALE: it is PROVEN and
`sorryAx`-free) splits
the integrand into the constant part `r₂·(−γ − log 2π)·Φ` and the
pairing part `r₂·Φ·gaussDigammaIntegral`; the constant part
integrates over the line to `2π·r₂·(−γ − log 2π)` by
`integral_poitouPhi_line` (PROVEN, Fourier inversion at the origin,
over the line-integrability sub-leaf B `poitouPhi_line_integrable`);
the pairing part integrates to `2π·r₂·(J − log 4)`, with
`J = ∫₀^∞ (1−F)/(2 sinh(x/2))` the target integral, by
`integral_poitouPhi_line_mul_gauss` (PROVEN over the Fubini sub-leaf
