          = t • Finsupp.single v₀ (orderOf (χ (globalFrob v₀)) : ℤ) := by
        rw [Finsupp.smul_single, Finsupp.smul_single, smul_eq_mul, smul_eq_mul, mul_one, ht,
          mul_comm]
      rw [hsm, ofAdd_zsmul]
      exact Subgroup.zpow_mem _ hgenN _
