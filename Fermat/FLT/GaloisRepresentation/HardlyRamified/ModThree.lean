      Complex.log (-z) = Complex.log z - (Real.pi : ℂ) * Complex.I := by
    intro z hz
    apply Complex.ext
    · rw [Complex.sub_re, Complex.log_re, Complex.log_re, norm_neg]
      simp
    · rw [Complex.sub_im, Complex.log_im, Complex.log_im,
        Complex.arg_neg_eq_arg_sub_pi_of_im_pos hz]
