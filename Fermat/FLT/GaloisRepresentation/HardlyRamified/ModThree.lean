          Complex.exp ((s - 1 / 2) * (x : ℂ))) =
      ∫ x in (0:ℝ)..6, (((1 - x / 6) * q x : ℝ) : ℂ) *
        Complex.exp ((s - 1 / 2) * (x : ℂ)) := by
    refine intervalIntegral.integral_congr fun x hx => ?_
    rw [Set.uIcc_of_le (by norm_num : (0:ℝ) ≤ 6)] at hx
    have hodl : odlyzkoTestFn x = 1 - x / 6 := by
