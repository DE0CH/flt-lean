          ℚ Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat)
        (IntermediateField.adjoin (IsDedekindDomain.HeightOneSpectrum.adicCompletion
          ℚ Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat) {ζ})) := by
