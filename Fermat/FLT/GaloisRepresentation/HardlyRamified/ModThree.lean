          have h1 : Finsupp.single v (f v) = f v • Finsupp.single v (1 : ℤ) := by
            rw [Finsupp.smul_single, smul_eq_mul, mul_one]
          rw [h1, ofAdd_zsmul, map_zpow, hUv v (hsupp v hv), ← zpow_mul,
            mul_comm (g v) (f v)])]
      rw [hprodzpow, hE]
