    ∃ (P' : Fin h → MvPowerSeries (Fin h) 𝒪₃ᵥ)
      (Q : Fin h → Fin h → MvPowerSeries (Fin h) 𝒪₃ᵥ),
      RingHom.ker α = Ideal.span (Set.range P') ∧
      (∀ i j, MvPowerSeries.pderiv j (P' i) = 3 * Q i j) ∧
