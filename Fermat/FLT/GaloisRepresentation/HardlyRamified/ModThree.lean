    (d : ℤ)
    (hd : d = -1 ∨ d = 2 ∨ d = -2 ∨ d = 3 ∨ d = -3 ∨ d = 6 ∨ d = -6)
    (x : AlgebraicClosure ℚ) (hx : x ^ 2 = (d : AlgebraicClosure ℚ))
    [NumberField (IntermediateField.adjoin ℚ {x})]
    (I : Ideal (NumberField.RingOfIntegers
      (IntermediateField.adjoin ℚ {x})))
