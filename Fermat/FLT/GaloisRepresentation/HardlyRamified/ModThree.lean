      ¬ W.asIdeal ∣ mmE →
      φ (𝔑 (Multiplicative.ofAdd (Finsupp.single W (1 : ℤ))))
        = φ' (Multiplicative.ofAdd (Finsupp.single W (1 : ℤ))) := by
    intro W hW
    refine Units.ext ?_
