          (algebraMap (IntegralClosure 𝒪₃ᵥ ↥M) ↥M))
        (integralClosure 𝒪₃ᵥ
          ↥(reifySubextension Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat M L))
        (fun x => (Algebra.IsIntegral.isIntegral (R := 𝒪₃ᵥ) x).map
