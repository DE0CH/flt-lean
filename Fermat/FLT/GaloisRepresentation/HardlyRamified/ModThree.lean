  refine ⟨mm, hmm, hmmsupp, Im, A, P, N, d, hcrux, sup_le hPIm hNIm, hNA, hidx₁, hidx₂, ?_⟩
  intro δ hδ0 hδpos hδmem
  refine ⟨?_, ?_⟩
  · rw [hP]
    exact Subgroup.subset_closure ⟨δ, hδ0, hδpos, hδmem, rfl⟩
  · intro hmem
    rw [hA] at hmem
    have hker : φ (d δ) = 1 := MonoidHom.mem_ker.mp (Subgroup.mem_inf.mp hmem).1
    have h := hφd δ hδ0
    rw [hker] at h
    simpa using h.symm

