    exact isIntegral_algebraMap
  rw [show Q.inertia (K ≃ₐ[ℚ] K) = Q.toAddSubgroup.inertia (K ≃ₐ[ℚ] K)
    from rfl, AddSubgroup.mem_inertia]
  intro y
