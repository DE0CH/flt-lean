    have hUker : ∀ g ∈ Kρ, η g = 1 ∧ b g = 0 :=
      fun g hg => ⟨hηKρ g hg, (hker g hg).2.2⟩
    have hbunr' : ∀ (q : ℕ) (hq : q.Prime), q ≠ 2 →
