    (hN' : N' = Subgroup.closure {y | ∃ w : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers E), ¬ (w.asIdeal ∣ mmE) ∧
      y = Multiplicative.ofAdd
        (Finsupp.single w (orderOf (χ (ι (globalFrob w))) : ℤ))})
