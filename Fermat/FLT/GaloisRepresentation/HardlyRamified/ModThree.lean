          intro W' hW'
          have hne : W' ≠ W := fun h => hWg (h ▸ hW')
          rw [Finsupp.mem_support_iff, Finsupp.add_apply,
            Finsupp.single_eq_of_ne hne, zero_add]
          exact Finsupp.mem_support_iff.mp hW'
