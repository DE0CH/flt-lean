    intro g
    rcases huniv g with rfl | hgσ
    · rfl
    · rw [hgσ]
      show σ (x₁ ^ 2) = x₁ ^ 2
      rw [map_pow, hx₁σ]
      ring
  obtain ⟨r, hr⟩ := Algebra.IsInvariant.isInvariant (A := ℚ)
    (G := K ≃ₐ[ℚ] K) (x₁ ^ 2) hfixsq
  have hr0 : r ≠ 0 := by
    intro h
    rw [h, map_zero] at hr
    exact pow_ne_zero 2 hx₁0 hr.symm
