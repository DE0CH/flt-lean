          Nat.prime_two.toHeightOneSpectrumRingOfIntegersRat)) σ) = 1 ∧
      χ₀ (Field.absoluteGaloisGroup.map (algebraMap ℚ
        (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
          Nat.prime_two.toHeightOneSpectrumRingOfIntegersRat)) σ) = 1) :
