    have hord₀ : orderOf (φ (Multiplicative.ofAdd (Finsupp.single v₀ (1 : ℤ))))
        = orderOf (χ (globalFrob v₀)) := by
      rw [← hφv v₀, orderOf_units]
    have hEdvd : (orderOf (χ (globalFrob v₀)) : ℤ) ∣ E := by
      rw [← hord₀, orderOf_dvd_iff_zpow_eq_one, ← hφx]
      exact hxker
    obtain ⟨t, ht⟩ := hEdvd
