    rw [hibp₂₂]
    have hA : ‖((rd₂ (6:ℝ) : ℝ) : ℂ) *
        (Complex.exp ((s - 1 / 2) * ((6:ℝ) : ℂ)) / (s - 1 / 2) ^ 2)‖ ≤
