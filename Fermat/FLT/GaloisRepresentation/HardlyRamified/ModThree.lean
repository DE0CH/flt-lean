    intro τ hτ
    -- `e τ` fixes each generator `z ∈ t` …
    have hfixt : ∀ z ∈ (↑t : Set (AlgebraicClosure ℚ)), (e τ) z = z := by
      intro z hz
      have hzW : ψ.symm z ∈ W :=
