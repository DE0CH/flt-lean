      have h1 : γ - 1 ∈ P := (sup_le hmP hnnP) hγmem
      have h2 : γ ∈ P := hgP (hγg (Ideal.mem_span_singleton_self γ))
      have hone : (1 : NumberField.RingOfIntegers F) ∈ P := by
        have := sub_mem h2 h1
