    (A : Type) [CommRing A] [Algebra 𝒪₃ᵥ A] [Module.Flat 𝒪₃ᵥ A]
    [Module.Finite 𝒪₃ᵥ A]
    (hΩ : ∀ ω : Ω[A⁄𝒪₃ᵥ], (3 : ℕ) • ω = 0)
    (hfon : IsFontaineAlgebra A)
    (h : ℕ) (J : Ideal A)
    (P : Fin h → MvPowerSeries (Fin h) 𝒪₃ᵥ)
    (α : MvPowerSeries (Fin h) 𝒪₃ᵥ →ₐ[𝒪₃ᵥ] A ⧸ J)
    (hidem : ∃ ε : A, IsIdempotentElem ε ∧ J = Ideal.span {ε})
    (hloc : IsLocalRing (A ⧸ J))
    (hsurj : Function.Surjective α)
    (hker : RingHom.ker α = Ideal.span (Set.range P))
    (hmin : ∀ i j, MvPowerSeries.constantCoeff (σ := Fin h) (R := 𝒪₃ᵥ)
