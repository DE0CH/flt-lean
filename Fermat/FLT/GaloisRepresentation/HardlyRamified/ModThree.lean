      (x : ℂ) + ((-T : ℝ) : ℂ) * Complex.I ≠ ρ := by
    intro x ρ hρ heq
    have h2 := (hZ_in ρ hρ).2
    rw [← heq, him_bot x, abs_neg, abs_of_pos hT] at h2
