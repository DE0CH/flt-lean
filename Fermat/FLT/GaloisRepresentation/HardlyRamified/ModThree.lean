    (_hmmEm : Ideal.span {(m : NumberField.RingOfIntegers E)} ∣ mmE)
    (hmmEext : mm.map (algebraMap (NumberField.RingOfIntegers F)
      (NumberField.RingOfIntegers E)) ∣ mmE)
