    IntermediateField.eq_adjoin_of_eq_algebra_adjoin _ _ _ hs.symm
  -- the image field `M := ℚ₃(ι K)`
  set M : IntermediateField
      (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
        Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat)
      (AlgebraicClosure (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
        Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat)) :=
    IntermediateField.adjoin _
      (Set.range fun x : K => ι (x : AlgebraicClosure ℚ)) with hMdef
  -- `ι` carries all of `K` into `M`
  have hsub : ∀ x ∈ K, ι x ∈ M := fun x hx =>
    IntermediateField.subset_adjoin _ _ ⟨⟨x, hx⟩, rfl⟩
  -- `ι K` already lies in the subfield generated by the finite set `ι '' s`
  have hsub' : ∀ x ∈ K, ι x ∈ IntermediateField.adjoin
      (IsDedekindDomain.HeightOneSpectrum.adicCompletion ℚ
        Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat)
