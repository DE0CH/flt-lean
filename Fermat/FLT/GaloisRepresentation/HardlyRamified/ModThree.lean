    MeasureTheory.integral_add hint1 hint2]
  congr 1
  have hposq : ∀ x : ℝ, 0 < Real.cosh (x/2) / (1 + Real.cosh (x/2)) := by
    intro x
    have hc := Real.cosh_pos (x/2)
    exact div_pos hc (by linarith)
