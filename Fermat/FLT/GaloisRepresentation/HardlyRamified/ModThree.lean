    intro g hg
    have hconjker : ρ (σ₀⁻¹ * g * σ₀) = 1 := by
      rw [map_mul, map_mul, hg, mul_one, ← map_mul, inv_mul_cancel, map_one]
    rw [hνdef]
    simp only
    rw [hχker g hg, hχker _ hconjker, inv_one, mul_one]
  -- (4) the values of `ν` lie in `𝔽̄₃ˣ`, hence have order prime to `3`
