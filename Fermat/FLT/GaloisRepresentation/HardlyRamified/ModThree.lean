  have hbq : ((b : ℕ) : ℚ) ≠ 0 := by exact_mod_cast hb0
  have hdenq : ((r.den : ℕ) : ℚ) ≠ 0 := by exact_mod_cast r.den_nz
  have hc₀0 : c₀ ≠ 0 := div_ne_zero hdenq hbq
