  have hLHS : algebraMap (IntegralClosure 𝒪₃ᵥ ↥L) ↥L
      (Polynomial.aeval θ
        (Polynomial.derivative (minpoly (IntegralClosure 𝒪₃ᵥ ↥M') θ))) =
      Polynomial.eval θK (Polynomial.derivative P) := by
