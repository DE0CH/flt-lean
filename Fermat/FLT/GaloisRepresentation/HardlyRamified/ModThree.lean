    have hcomap : (IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ
          ↥(reifySubextension
            Nat.prime_three.toHeightOneSpectrumRingOfIntegersRat M L))).comap jO =
        IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ ↥M) := by
