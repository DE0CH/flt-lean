    intro g hg
    rw [map_mul, map_mul, hg, mul_one, map_inv, inv_mul_cancel]
  have hHinv : ∀ g : Γ ℚ, θ' g = 1 → θ' g⁻¹ = 1 := by
    intro g hg
    rw [map_inv, hg, inv_one]
  have hHmul : ∀ g h : Γ ℚ, θ' g = 1 → θ' h = 1 → θ' (g * h) = 1 := by
    intro g h hg hh
    rw [map_mul, hg, hh, mul_one]
