              (I := IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E))
              (show j ≤ j + N by omega))).comp
            ((Ideal.Quotient.factorₐ 𝒪₃ᵥ (Ideal.pow_le_pow_right
              (I := IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ E))
              (show j + N ≤ n + N by omega))).comp u) := by
