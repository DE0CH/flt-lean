      (IntegralClosure 𝒪₃ᵥ ↥(IntermediateField.comap L.val M)) ^ d ∣
      differentIdeal 𝒪₃ᵥ
        (IntegralClosure 𝒪₃ᵥ ↥(IntermediateField.comap L.val M)) := by
    show IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ
