theorem exists_algEquiv_ringHom_apply_eq_ray_class
    {Ω : Type*} [Field Ω] (ι₁ ι₂ : AlgebraicClosure ℚ →+* Ω) :
    ∃ c : Γ ℚ, ∀ y : AlgebraicClosure ℚ, ι₁ (c y) = ι₂ y := by
