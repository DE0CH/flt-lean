        rw [hc₀def]
        field_simp
      calc ((b : ℕ) : ℚ) ^ 2 * (c₀ ^ 2 * r)
          = (((b : ℕ) : ℚ) * c₀) ^ 2 * r := by ring
        _ = ((r.den : ℕ) : ℚ) ^ 2 * r := by rw [hbc]
        _ = (r.num : ℚ) * ((r.den : ℕ) : ℚ) := by rw [hnum]; ring
