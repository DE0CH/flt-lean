    intro g hg
    exact mul_ne_zero (hχne0 g hg) (inv_ne_zero (hχne0 _ (hHconj g hg)))
  have hνanti : ∀ g : Γ ℚ, θ' g = 1 → ν (σ₀⁻¹ * g * σ₀) = (ν g)⁻¹ := by
    intro g hg
    have hexp : σ₀⁻¹ * (σ₀⁻¹ * g * σ₀) * σ₀ =
        (σ₀ * σ₀)⁻¹ * g * (σ₀ * σ₀) := by group
    rw [hνdef]
    simp only
    rw [hexp, hχHconj g (σ₀ * σ₀) hg hσ₀sq, mul_inv, inv_inv]
    ring
  -- (3) `ν` is trivial on the normal subgroup `ker ρ`
