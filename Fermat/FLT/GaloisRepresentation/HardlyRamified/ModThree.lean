  have hdvd := pow_card_inertia_inf_mul_add_sum_dvd_local_differentIdeal
    L M hML n hn d hd
  have hle := le_sum_card_inertia_sub_one_of_pow_dvd_local_differentIdeal
    L n hn _ hdvd
