  have hgsplit : ∑ i ∈ Finset.range n,
      Nat.card ↥((IsLocalRing.maximalIdeal (IntegralClosure 𝒪₃ᵥ L) ^ (i + 1)).inertia
        (L ≃ₐ[ℚ₃ᵥ] L)) =
