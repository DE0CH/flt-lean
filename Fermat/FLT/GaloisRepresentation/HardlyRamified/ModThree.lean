    apply hx₁bot
    have h1 : x₁ = algebraMap ℚ K c₀⁻¹ * (algebraMap ℚ K c₀ * x₁) := by
      rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hc₀0, map_one, one_mul]
    rw [h1]
    exact mul_mem (IntermediateField.algebraMap_mem _ c₀⁻¹) hmem
