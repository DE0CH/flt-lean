theorem exists_obstructionCocycle_smallExtension_section
    (hℓ5 : 5 ≤ ℓ)
    {ρbar : GaloisRep ℚ k V} (h : IsHardlyRamified hℓOdd hdim ρbar)
    (hirr : ρbar.IsIrreducible)
