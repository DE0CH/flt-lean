    exists_hilbertTraceDescent ℓ hℓ5 F hlk hirrF 𝒟 h𝒟 f hf
  refine ⟨𝒟', ?_, ht'⟩
  intro 𝒟''
  obtain ⟨f, hf1, hf2, hf3⟩ := h𝒟 𝒟''
  refine ⟨f.comp ι, ?_, ?_, ?_⟩
  · rw [RingHom.comp_assoc, hι1, hf1]
  · rw [← RingHom.comp_assoc, hf2, hι2]
  · intro g
    rw [← Polynomial.map_map, hι3 g, hf3 g]

