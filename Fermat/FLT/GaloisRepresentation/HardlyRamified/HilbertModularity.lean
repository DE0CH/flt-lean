    exists_unimodular_eigenrow_of_subring_hilbert hab (hεsq g₀) hE1 hE2 hunit1sub
  set π : (Fin 2 → C) →ₗ[C] C :=
    p • LinearMap.proj 0 + q • LinearMap.proj 1 with hπdef
