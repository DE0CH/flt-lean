def HilbertInertiaTrivialAt {F : Type u} [Field F] [NumberField F]
    (w : HeightOneSpectrum (𝓞 F)) (N : Subgroup (Γ F)) : Prop :=
  ∀ σ ∈ localInertiaGroup w,
    Field.absoluteGaloisGroup.map (algebraMap F (w.adicCompletion F)) σ ∈ N

