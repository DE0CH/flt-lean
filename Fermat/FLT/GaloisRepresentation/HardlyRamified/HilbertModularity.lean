            isAdic := hadic
            isAdicComplete := hcomplete
            ρ := ρuniv
            isHilbertRaisedLevelHardlyRamified := hHR
            π := πuniv
            π_surjective := hπsurj
            resid := hres }, ?_⟩
  exact HilbertAuxDeformationDatum.isWeaklyUniversal_of_finiteFrames hbase _ huniv

