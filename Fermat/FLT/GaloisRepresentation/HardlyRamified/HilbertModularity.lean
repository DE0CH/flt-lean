    intro g c
    show (ε g • (1 : Module.End C C)) c = ε g * c
    rw [LinearMap.smul_apply, Module.End.one_apply, smul_eq_mul]
  refine ⟨π, hπsurjC, δ, fun g v => ?_, ?_, ?_⟩
  · rw [hπequi, hδapp]
