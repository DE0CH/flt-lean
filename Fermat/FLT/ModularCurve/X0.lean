      < Real.exp (-(2 * Real.pi / Real.sqrt M)) := by
  rcases le_thirty_or_mem_kenkuLargeDivisors hN hMN with h | h
  · exact frickeTailSum_tail_lt_head_of_le_thirty hM h hb
