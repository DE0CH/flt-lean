       jmX : RelPoint strX (𝟙 SpecQ) → OnePoint ℚ
       jmX_section : ∀ y, jmX (sectionAlong j h.comm y) = (hj.jm y : OnePoint ℚ)
       isCusp_iff  : ∀ x, h.IsCusp x ↔ jmX x = ∞

