      Spec.map (CommRingCat.ofHom (algebraMap (ZMod p) Γ(A.Y, ⊤))) = A.Y.isoSpec.inv ≫ A.str →
        IsRegularRing Γ(A.Y, ⊤) ∧ Algebra.FiniteType (ZMod p) Γ(A.Y, ⊤) ∧
