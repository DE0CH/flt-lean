theorem fg_relPoint_of_abelianScheme {J : Scheme.{0}} {jstr : J ⟶ SpecQ}
    (ab : AbelianSchemeStruct jstr) :
    letI := ab.addCommGroup (𝟙 SpecQ)
    AddGroup.FG (RelPoint jstr (𝟙 SpecQ)) := by
