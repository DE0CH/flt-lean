theorem nontrivial_zmod_of_reductionBase {ℓ : ℕ} {R : Subring ℚ} {toF : R →+* ZMod ℓ}
    (hbase : IsReductionBase ℓ R toF) : Nontrivial (ZMod ℓ) := by
  refine ⟨⟨1, 0, ?_⟩⟩
  rw [← map_one toF, Ne, hbase.ker_eq_nonunits 1]
  exact fun h => h isUnit_one

