theorem exists_gamma0GITPresentation_of_cover (N : ℕ) (hN : 0 < N)
    (n : ℕ) (hn : 3 ≤ n)
    (hcov : ∀ {T : Scheme.{0}}, (T ⟶ SpecQ) → ∀ d : Gamma0Datum N T,
