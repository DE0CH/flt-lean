    (D : IsHeckeIsotypicDecomposition N hX jac) (F : IsAtkinLehnerFactorwise D wJ hwJ)
    (_hnew : ∀ (M : ℕ), M ∣ N → M ≠ N → ∀ (g : CuspForm (Gamma0GL M) 2) (b : ℕ → ℂ),
