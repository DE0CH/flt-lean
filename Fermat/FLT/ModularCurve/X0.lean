theorem cuspPeriod_ne_zero_of_isFrickeEigenform (N : ℕ) (hN : N ∈ kenkuLevels)
    (M : ℕ) (hMN : M ∣ N) (b : ℕ → ℂ) (hb : IsFrickeEigenform M b)
    (hnew : IsNewEigenformAt M b) :
