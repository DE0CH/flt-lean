theorem frickeSign_eq_neg_one_of_isNewEigenformAt (N : ℕ) (hN : N ∈ kenkuLevels) (M : ℕ)
    (hMN : M ∣ N) (hM : M ≠ 0) (g : CuspForm (Gamma0GL M) 2) (b : ℕ → ℂ)
    (hb : IsWeightTwoEigenform M g b) (hnew : IsNewEigenformAt M b)
