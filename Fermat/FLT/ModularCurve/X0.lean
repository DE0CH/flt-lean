    (g : (E⁄(AlgebraicClosure ℚ)).Point) (hg : addOrderOf g = N)
    (haut : ∀ σ : Field.absoluteGaloisGroup ℚ,
      ∃ (C : WeierstrassCurve.VariableChange (AlgebraicClosure ℚ))
