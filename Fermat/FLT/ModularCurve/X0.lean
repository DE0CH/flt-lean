        + (c8 : ℚ) * (w.num : ℚ) ^ 8 * ((w.den : ℕ) : ℚ) ^ 6
        + (c7 : ℚ) * (w.num : ℚ) ^ 7 * ((w.den : ℕ) : ℚ) ^ 7
        + (c6 : ℚ) * (w.num : ℚ) ^ 6 * ((w.den : ℕ) : ℚ) ^ 8
        + (c5 : ℚ) * (w.num : ℚ) ^ 5 * ((w.den : ℕ) : ℚ) ^ 9
