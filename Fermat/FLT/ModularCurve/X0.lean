theorem not_isWeightTwoEigenform_of_properDivisor_oneSixtyNine (M : ℕ) (hM : M ∣ 169)
    (hMne : M ≠ 169) (g : CuspForm (Gamma0GL M) 2) (b : ℕ → ℂ) :
