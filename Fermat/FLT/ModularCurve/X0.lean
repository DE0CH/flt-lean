theorem card_relPoint_x0_eichlerShimura (N ℓ : ℕ) (hN : 0 < N) (hℓ : ℓ.Prime)
    (hℓN : ¬ ℓ ∣ N)
    {X Y : Scheme.{0}} {strX : X ⟶ SpecF ℓ} {strY : Y ⟶ SpecF ℓ} {j : Y ⟶ X}
