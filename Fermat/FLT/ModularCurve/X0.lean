theorem not_stableCyclic_sq_of_isogenyClassPrime {p : ℕ}
    (hp : p ∈ ({11, 17, 19, 37, 43, 67, 163} : Finset ℕ))
    (E : WeierstrassCurve ℚ) [E.IsElliptic]
    (g : (E⁄(AlgebraicClosure ℚ)).Point) (hg : addOrderOf g = p ^ 2)
