is exactly what `IsJacobianOf` asserts. -/
theorem exists_albaneseQuotientAbelianImage_x0OneSixtyNine {X Y J : Scheme.{0}}
    {strX : X ⟶ SpecQ} {strY : Y ⟶ SpecQ} {jY : Y ⟶ X}
    (_hX : IsX0Compactification 169 strX strY jY)
    {jstr : J ⟶ SpecQ} {abJ : AbelianSchemeStruct jstr} {o : RelPoint strX (𝟙 SpecQ)}
    (jac : IsJacobianOf strX abJ o)
    (hA : HasRankZeroAbelianImage strX) :
    ∃ (B : Scheme.{0}) (bstr : B ⟶ SpecQ) (_abB : AbelianSchemeStruct bstr)
      (π : J ⟶ B) (hπ : π ≫ bstr = jstr),
      AlgebraicGeometry.Surjective π ∧ Finite (RelPoint bstr (𝟙 SpecQ)) ∧
        Function.Injective (fun x : RelPoint strX (𝟙 SpecQ) =>
          RelPoint.post π hπ (jac.aj (𝟙 SpecQ) x)) := by
  obtain ⟨A, astr, abA, c, hcnat, hfin, hinj⟩ := hA
  -- the constant `c o`, read at an arbitrary base point `g`
  let a₀ : ∀ {T : Scheme.{0}} (g : T ⟶ SpecQ), RelPoint astr g :=
    fun {T} g => RelPoint.pre g (Category.comp_id g) (c SpecQ (𝟙 SpecQ) o)
  -- naturality of that constant: both sides are `h ≫ g ≫ (c o).1`
  have ha₀ : ∀ {T' T : Scheme.{0}} (h : T' ⟶ T) {g : T ⟶ SpecQ} {g' : T' ⟶ SpecQ}
      (hg : h ≫ g = g'), RelPoint.pre h hg (a₀ g) = a₀ g' := by
    intro T' T h g g' hg
    apply Subtype.ext
    show h ≫ g ≫ (c SpecQ (𝟙 SpecQ) o).1 = g' ≫ (c SpecQ (𝟙 SpecQ) o).1
    rw [← Category.assoc, hg]
  -- `c' := c − c o` is natural, and it kills the Abel–Jacobi base point `o`
  have hnat : ∀ {T' T : Scheme.{0}} (h : T' ⟶ T) {g : T ⟶ SpecQ} {g' : T' ⟶ SpecQ}
      (hg : h ≫ g = g') (x : RelPoint strX g),
      abA.add (c T' g' (RelPoint.pre h hg x)) (abA.neg (a₀ g'))
        = RelPoint.pre h hg (abA.add (c T g x) (abA.neg (a₀ g))) := by
    intro T' T h g g' hg x
    rw [abA.pre_add, hcnat T' T h g g' hg x, abA.pre_neg, ha₀]
  have hzero : abA.add (c SpecQ (𝟙 SpecQ) o) (abA.neg (a₀ (𝟙 SpecQ)))
      = abA.zero (𝟙 SpecQ) := by
    have hid : a₀ (𝟙 SpecQ) = c SpecQ (𝟙 SpecQ) o := Subtype.ext (Category.id_comp _)
    rw [hid, abA.add_comm, abA.neg_add]
  -- the UNIVERSAL PROPERTY of the Jacobian, applied to the translate
  obtain ⟨u, ⟨hu1, hu2⟩, -⟩ :=
    jac.universal abA (fun {T} g x => abA.add (c T g x) (abA.neg (a₀ g))) hnat hzero
  -- `u` is a homomorphism, by RIGIDITY: it takes `0` to `0` because `c'` kills `o`
  have hadd : IsAdditiveOn abJ abA u hu1 := by
    refine isAdditiveOn_of_post_zero abJ abA hu1 ?_
    have h0 := hu2 (𝟙 SpecQ) o
    rw [hzero] at h0
    apply Subtype.ext
    show (abJ.zero (𝟙 SpecQ)).1 ≫ u = (abA.zero (𝟙 SpecQ)).1
    rw [← jac.aj_base]
    exact h0.symm
  -- the IMAGE of `u`: an abelian subvariety of `A` receiving `J` surjectively
  obtain ⟨B, bstr, abB, π, hπ, ι, hι, hsurj, -, hmono, hcomp⟩ :=
    exists_surjectiveAbelianImage_of_isAdditiveOn abJ abA u hu1 hadd
  haveI := hmono
  haveI := hfin
  have hpost : ∀ {T : Scheme.{0}} {g : T ⟶ SpecQ} (z : RelPoint jstr g),
      RelPoint.post ι hι (RelPoint.post π hπ z) = RelPoint.post u hu1 z := by
    intro T g z
    apply Subtype.ext
    show (z.1 ≫ π) ≫ ι = z.1 ≫ u
    rw [Category.assoc, hcomp]
  -- `ι` is a monomorphism, hence injective on relative points at every test object
  have hιinj : ∀ {T : Scheme.{0}} {g : T ⟶ SpecQ},
      Function.Injective (fun y : RelPoint bstr g => RelPoint.post ι hι y) := by
    intro T g y z hyz
    exact Subtype.ext ((cancel_mono ι).mp (congrArg Subtype.val hyz))
  refine ⟨B, bstr, abB, π, hπ, hsurj, Finite.of_injective _ hιinj, ?_⟩
  intro x y hxy
  have hxy' : RelPoint.post π hπ (jac.aj (𝟙 SpecQ) x)
      = RelPoint.post π hπ (jac.aj (𝟙 SpecQ) y) := hxy
  have h1 : RelPoint.post u hu1 (jac.aj (𝟙 SpecQ) x)
      = RelPoint.post u hu1 (jac.aj (𝟙 SpecQ) y) := by
    rw [← hpost, ← hpost, hxy']
  have h2 : abA.add (c SpecQ (𝟙 SpecQ) x) (abA.neg (a₀ (𝟙 SpecQ)))
      = abA.add (c SpecQ (𝟙 SpecQ) y) (abA.neg (a₀ (𝟙 SpecQ))) := by
    apply Subtype.ext
    rw [hu2 (𝟙 SpecQ) x, hu2 (𝟙 SpecQ) y]
    exact congrArg Subtype.val h1
  -- cancelling the translation returns the injectivity `hA` already carries
  refine hinj ?_
  letI := abA.addCommGroup (𝟙 SpecQ)
  exact add_right_cancel (a := c SpecQ (𝟙 SpecQ) x) (b := abA.neg (a₀ (𝟙 SpecQ)))
    (c := c SpecQ (𝟙 SpecQ) y) h2

/-! #### Néron–Ogg–Šafarevič in quotient form, and the generic machinery
it needs

