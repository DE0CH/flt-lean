  have hle := card_le_numRationalCusps_x0OneSixtyNine hX
    (hasRankZeroAbelianImage_x0OneSixtyNine hX) (insert (sectionAlong jY hX.comm y) s)
  rw [Finset.card_insert_of_notMem hp, hscard] at hle
  omega

