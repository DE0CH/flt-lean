       genJ := jm.genJ
       spX := cm.spX
       spJ := jm.spJ
       genX_nat := cm.genX_nat
       genJ_nat := jm.genJ_nat
       spX_nat := cm.spX_nat
       spJ_nat := jm.spJ_nat
       genJ_add := jm.genJ_add
       spJ_add := jm.spJ_add
       genX_aj := jm.genX_aj
       spX_aj := jm.spX_aj
       neronJ := jm.neronJ
