theorem exists_coarseModuliY0_of_pos (N : ℕ) (hN : 0 < N) :
    ∃ (Y : Scheme.{0}) (str : Y ⟶ SpecQ), Nonempty (IsCoarseModuliY0 N str) := by
  obtain ⟨A⟩ := exists_gamma0Atlas N hN
  exact ⟨A.Y, A.str, ⟨A.toIsCoarseModuliY0⟩⟩

