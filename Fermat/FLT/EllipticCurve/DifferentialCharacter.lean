    (hone : E * (C W'.a₁ * A + C W'.a₃ * B) = Cx * B * (C W.a₁ * X + C W.a₃))
    (hcurve : B ^ 3 * (Cx ^ 2 * (X ^ 3 + C W.a₂ * X ^ 2 + C W.a₄ * X + C W.a₆) + D ^ 2
        + Cx * D * (C W.a₁ * X + C W.a₃))
      = E ^ 2 * (A ^ 3 + C W'.a₂ * A ^ 2 * B + C W'.a₄ * A * B ^ 2 + C W'.a₆ * B ^ 3)) :
    ∃ c : F, (derivative A * B - A * derivative B) * (C W.a₁ * X + C W.a₃)
