    rootMultiplicity_add b hpq
  have h2 : min ((p + q).rootMultiplicity b) ((-q).rootMultiplicity b)
      ≤ p.rootMultiplicity b := by
    have := rootMultiplicity_add (p := p + q) (q := -q) b (by simpa using hp)
    simpa using this
  rw [rootMultiplicity_neg'] at h2
  omega

