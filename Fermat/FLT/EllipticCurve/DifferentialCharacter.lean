  obtain ⟨hgφ, A, B, Cx, Dx, E, hB, hE, hrel, hcert⟩ := hφ
  obtain ⟨hgψ, A', B', C', D', E', hB', hE', hrel', hcert'⟩ := hψ
  have hratφ : IsRationalMap φ := ⟨A, B, Cx, Dx, E, hB, hE, hrel⟩
  have hratψ : IsRationalMap ψ := ⟨A', B', C', D', E', hB', hE', hrel'⟩
