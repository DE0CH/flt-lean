    have hb₂ : B₂.eval (veluPointX P) ≠ 0 := fun hc => hBadP (by rw [hc]; ring)
    have hg₁ : G₁.eval (veluPointX P) ≠ 0 := fun hc => hBadP (by rw [hc]; ring)
    have hg₂ : G₂.eval (veluPointX P) ≠ 0 := fun hc => hBadP (by rw [hc]; ring)
