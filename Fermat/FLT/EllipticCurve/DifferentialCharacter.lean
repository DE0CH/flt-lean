    have hgcd : GCDMonoid.gcd A B ≠ 0 := fun h => hB (gcd_eq_zero_iff A B |>.mp h).2
    exact ⟨GCDMonoid.gcd A B, A / GCDMonoid.gcd A B, B / GCDMonoid.gcd A B, hgcd,
