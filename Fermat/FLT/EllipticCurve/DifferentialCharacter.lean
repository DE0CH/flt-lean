    {φ : W.Point →+ W'.Point} {c c' : F}
    (h : IsDiffChar φ c) (h' : IsDiffChar φ c') : c = c' := by
  classical
  by_cases hφ0 : φ = 0
  · rw [h.1 hφ0, h'.1 hφ0]
  by_contra hne
  obtain ⟨-, A₁, B₁, C₁, D₁, G₁, hB₁, hG₁, hcert₁, hdiff₁⟩ := h
  obtain ⟨-, A₂, B₂, C₂, D₂, G₂, hB₂, hG₂, hcert₂, hdiff₂⟩ := h'
  have hrat : IsRationalMap φ := ⟨A₁, B₁, C₁, D₁, G₁, hB₁, hG₁, hcert₁⟩
