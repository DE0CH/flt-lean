    have hpsisq : E ^ 2 * (4 * A ^ 3 + (C W'.a₁ ^ 2 + 4 * C W'.a₂) * A ^ 2 * B
          + (4 * C W'.a₄ + 2 * C W'.a₁ * C W'.a₃) * A * B ^ 2
          + (C W'.a₃ ^ 2 + 4 * C W'.a₆) * B ^ 3)
        = Cx ^ 2 * B ^ 3 * (4 * X ^ 3 + (C W.a₁ ^ 2 + 4 * C W.a₂) * X ^ 2
          + (4 * C W.a₄ + 2 * C W.a₁ * C W.a₃) * X + (C W.a₃ ^ 2 + 4 * C W.a₆)) := by
      simp only [map_ofNat] at hone
