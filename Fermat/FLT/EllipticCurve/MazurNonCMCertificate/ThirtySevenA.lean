/-- **Row `p = 37`, `j = −9317`: `Ψ₃₇ mod 1259` has no monic divisor of degree `36`.**

This is what `Fermat.not_monic_dvd_preΨ_mod_nonCMModelThirtySevenA` in `X0.lean` consumes. -/
theorem not_monic_dvd_preΨ_thirtySevenA_mod (G : (ZMod 1259)[X]) (hG : G.Monic)
    (hdeg : G.natDegree = 36) : ¬ G ∣ thirtySevenAMod.preΨ' 37 := by
  have hc : (37 : ZMod 1259) ≠ 0 := by decide
  have hmk : ∀ d : ℕ, d ∣ 37 → d ≤ 36 → d ∣ 1 := by
    intro d hd hle
    interval_cases d <;> revert hd <;> decide
  have hDdeg : dPolyThirtySevenA.natDegree = 18 := by rw [dPolyThirtySevenA]; compute_degree!
  have hD0 : dPolyThirtySevenA ≠ 0 := fun h => by rw [h, natDegree_zero] at hDdeg; omega
  have hDlt : dPolyThirtySevenA.natDegree < 36 := by omega
  -- the `Fact` must come AFTER the `decide`s above; see the `p = 17` row.
  haveI : Fact (Nat.Prime 1259) := ⟨by norm_num⟩
  exact not_monic_dvd_of_smallDegreePart' hc preΨ'_thirtySeven_ThirtySevenA hmk
    dvd_X_pow_card_pow_sub_X_hPolyThirtySevenA isCoprime_hPolyThirtySevenA hD0 hDlt G hG hdeg

