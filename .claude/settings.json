{
  "permissions": {
    "allow": [
      "Edit(**)",
      "Bash(grep *)",
      "Bash(head *)",
      "WebSearch",
      "mcp__annas-mcp__search_annas",
      "mcp__annas-mcp__download_annas",
      "Read(//tmp/**)",
      "Bash(lake exe cache get)",
      "Bash(lake exe cache get:*)",
      "Bash(cd * && lake exe cache get)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push*--force*)",
      "Bash(git push*-f)",
      "Bash(git push*-f *)"
    ],
    "denyExplanations": {
      "lake": "BANNED (Deyao, 2026-07-22): all lake/lean/elan CLI invocations are denied except `lake exe cache get` (mathlib artifact fetch for a fresh worktree). Use the per-worktree report MCP (`report-flt-lean-N`: `diagnostics`, `build`) \u2014 its diagnostics are the trusted verification gate for everything, and the servers compile imports on demand. The `lean-lsp` MCP was REMOVED 2026-07-25 (it did not work and was not needed), so it is no longer an alternative. Headless scripts use the detached report server."
    },
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "defaultMode": "acceptEdits",
  "env": {
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "1000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/worktree-pool-hook.py\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/post-merge-reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/check-sorries.py\"",
            "timeout": 3600,
            "statusMessage": "Checking the FLT loop exit condition (sorries + sorry gate)"
          }
        ]
      }
    ]
  }
}